+    def _resolve_program_name(self, prog_name: str | None) -> str:
+        """Resolve the program name to use for this command.
+        
+        :param prog_name: The provided program name, or None to auto-detect.
+        :return: The resolved program name.
+        """
+        if prog_name is not None:
+            return prog_name
+            
+        _main_mod = sys.modules["__main__"]
+        _argv_path = sys.argv[0]
+
+        _pkg_attr = getattr(_main_mod, "__package__", None)
+        if _pkg_attr in {None, ""} or (
+            os.name == "nt"
+            and _main_mod.__package__ == ""
+            and not os.path.exists(_argv_path)
+            and os.path.exists(f"{_argv_path}.exe")
+        ):
+            return os.path.basename(_argv_path)
+        else:
+            return _resolve_module_name(_argv_path, _main_mod)
+
+    def _should_handle_shell_completion(
+        self, 
+        prog_name: str, 
+        complete_var: str | None, 
+        extra: dict[str, t.Any]
+    ) -> bool:
+        """Check if shell completion should be handled and process it if so.
+        
+        :param prog_name: The program name.
+        :param complete_var: The completion environment variable name.
+        :param extra: Extra context arguments.
+        :return: True if shell completion was handled, False otherwise.
+        """
+        _completion_env_var = complete_var
+        if _completion_env_var is None:
+            _sanitized_name = prog_name.replace("-", "_").replace(".", "_")
+            _completion_env_var = f"_{_sanitized_name}_COMPLETE".upper()
+
+        _shell_instruction = os.environ.get(_completion_env_var)
+
+        if _shell_instruction:
+            from .shell_completion import shell_complete
+
+            _completion_result = shell_complete(
+                self, extra, prog_name, _completion_env_var, _shell_instruction
+            )
+            sys.exit(_completion_result)
+            
+        return False
+
