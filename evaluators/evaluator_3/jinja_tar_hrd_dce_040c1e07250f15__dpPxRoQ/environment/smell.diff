+class _FilterArgNormalizer(_FilterTestMiddleware):
+    """Middleware that normalizes keyword arguments for filters that
+    accept optional parameters.  Strips ``None``-valued keyword
+    arguments so that the filter's own defaults take effect, avoiding
+    subtle overrides when templates pass explicit ``None``.
