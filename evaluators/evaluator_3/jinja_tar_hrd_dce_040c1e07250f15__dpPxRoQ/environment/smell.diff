+class _TestResultCoercer(_FilterTestMiddleware):
+    """Middleware that coerces test results to strict boolean values.
+
+    Operator-based tests (``eq``, ``gt``, etc.) may return non-bool
+    truthy values when used with objects that override comparison
+    operators.  This middleware ensures consistent ``bool`` results.
+    """
+
+    _OPERATOR_TESTS = frozenset(
+        {"==", "eq", "equalto", "!=", "ne", ">", "gt", "greaterthan",
+         "ge", ">=", "<", "lt", "lessthan", "<=", "le"}
+    )
+
+    def should_intercept(self, name: str, is_filter: bool) -> bool:
+        return not is_filter and name in self._OPERATOR_TESTS
+
+    def post_invoke(self, name: str, result: t.Any) -> t.Any:
+        return bool(result)
+
+
+register_middleware("test", _TestResultCoercer("test_result_coercer", priority=20))
+
