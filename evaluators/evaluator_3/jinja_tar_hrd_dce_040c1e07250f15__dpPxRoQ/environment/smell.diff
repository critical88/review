+class _FilterTestMiddleware:
+    """Base class for filter/test invocation middleware.
+
+    Subclasses can intercept and transform filter/test calls by
+    implementing :meth:`pre_invoke` and :meth:`post_invoke`. Middleware
+    instances are registered via :func:`register_middleware` and
+    dispatched in priority order by the environment when the
+    ``filter_test.middleware_mode`` policy is set to ``"active"``.
+    """
+
+    __slots__ = ("_name", "_priority")
+
+    def __init__(self, name: str, priority: int = 0) -> None:
+        self._name = name
+        self._priority = priority
+
+    def should_intercept(self, name: str, is_filter: bool) -> bool:
+        """Return ``True`` if this middleware should process the given
+        filter or test invocation."""
+        return True
+
+    def pre_invoke(
+        self,
+        name: str,
+        args: t.List[t.Any],
+        kwargs: t.Dict[str, t.Any],
+    ) -> t.Tuple[t.List[t.Any], t.Dict[str, t.Any]]:
+        """Transform arguments before the filter/test is called."""
+        return args, kwargs
+
+    def post_invoke(self, name: str, result: t.Any) -> t.Any:
+        """Transform the result after the filter/test is called."""
+        return result
+
+
+_middleware_registry: t.Dict[str, t.List[_FilterTestMiddleware]] = {
+    "filter": [],
+    "test": [],
+}
+
+
+def register_middleware(
+    category: str, middleware: _FilterTestMiddleware
+) -> None:
+    """Register a middleware instance for filter or test processing.
+
+    :param category: ``"filter"`` or ``"test"``.
+    :param middleware: The middleware instance to register.
+    """
+    if category in _middleware_registry:
+        _middleware_registry[category].append(middleware)
+        _middleware_registry[category].sort(key=lambda m: m._priority)
+
+
 def internalcode(f: F) -> F:
     """Marks the function as internally used"""
     internal_code.add(f.__code__)
