@@ -561,6 +561,22 @@ class Aligner(Generic[T_Alignable]):
             )
         )
 
+    def _resolve_result_mode(self) -> str:
+        """Resolve the alignment result mode by consulting each aligned object.
+
+        Each object contributes its preferred mode based on the current join
+        strategy and copy semantics. Returns one of "override", "passthrough",
+        or "reindex".
+        """
+        modes: set[str] = set()
+        for obj in self.objects:
+            mode = obj._preferred_align_result_mode(self.join, self.copy)
+            modes.add(mode)
+        if len(modes) == 1:
+            return modes.pop()
+        # heterogeneous preferences fall back to full reindex
+        return "reindex"
+
     def align(self) -> None:
         if not self.indexes and len(self.objects) == 1:
             # fast path for the trivial case
@@ -574,9 +590,10 @@ class Aligner(Generic[T_Alignable]):
         self.align_indexes()
         self.assert_unindexed_dim_sizes_equal()
 
-        if self.join == "override":
+        result_mode = self._resolve_result_mode()
+        if result_mode == "override":
             self.override_indexes()
-        elif self.join == "exact" and not self.copy:
+        elif result_mode == "passthrough":
             self.results = self.objects
         else:
             self.reindex_all()
