diff --git a/xarray/core/dataarray.py b/xarray/core/dataarray.py
index 4dc897c1..e843577a 100644
--- a/xarray/core/dataarray.py
+++ b/xarray/core/dataarray.py
@@ -1867,6 +1867,18 @@ class DataArray(
 
         return _broadcast_helper(args[1], exclude, dims_map, common_coords)
 
+    def _preferred_align_result_mode(self, join: str, copy: bool) -> str:
+        """Return the preferred alignment result mode for this data array.
+
+        Called by ``Aligner._resolve_result_mode`` to collaboratively determine
+        how alignment results should be produced.
+        """
+        if join == "override":
+            return "override"
+        elif join == "exact" and not copy:
+            return "passthrough"
+        return "reindex"
