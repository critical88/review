+class _AlignmentProcessor:
+    """Internal helper class to process alignment operations and reduce shotgun surgery."""
+
+    def __init__(self, aligner: Aligner):
+        self.aligner = aligner
+        
+    def process(self):
+        """Process the alignment in a more structured way to reduce shotgun surgery."""
+        if not self.aligner.indexes and len(self.aligner.objects) == 1:
+            # fast path for the trivial case
+            (obj,) = self.aligner.objects
+            self.aligner.results = (obj.copy(deep=self.aligner.copy),)
+            return
+
+        # Step 1: Find matching indexes
+        self.aligner.find_matching_indexes()
+        
+        # Step 2: Find matching unindexed dimensions
+        self.aligner.find_matching_unindexed_dims()
+        
+        # Step 3: Assert no index conflict
+        self.aligner.assert_no_index_conflict()
+        
+        # Step 4: Align indexes
+        self.aligner.align_indexes()
+        
+        # Step 5: Assert unindexed dim sizes equal
+        self.aligner.assert_unindexed_dim_sizes_equal()
+
+        # Step 6: Apply result mode
+        result_mode = self.aligner._resolve_result_mode()
+        if result_mode == "override":
+            self.aligner.override_indexes()
+        elif result_mode == "passthrough":
+            self.aligner.results = self.aligner.objects
+        else:
+            self.aligner.reindex_all()
