diff --git a/src/jinja2/utils.py b/src/jinja2/utils.py
index 7c922629..9938c24a 100644
--- a/src/jinja2/utils.py
+++ b/src/jinja2/utils.py
@@ -189,6 +189,29 @@ def object_type_repr(obj: t.Any) -> str:
     return f"{cls.__module__}.{cls.__name__} object"
 
 
+def build_undefined_description(
+    hint: t.Optional[str],
+    obj: t.Any,
+    name: t.Optional[str],
+    _missing_sentinel: t.Any = None,
+) -> str:
+    """Build a human-readable description for an undefined reference.
+
+    This centralises the message-formatting logic that is also used inline
+    in hot paths (macro invocation, attribute access) so that both code
+    sites produce identical diagnostics.  The ``_missing_sentinel`` parameter
+    must be the runtime's ``missing`` singleton when called from outside
+    this module.
+    """
+    if hint is not None:
+        return hint
+    if _missing_sentinel is not None and obj is _missing_sentinel:
+        return f"{name!r} is undefined"
+    if not isinstance(name, str):
+        return f"{object_type_repr(obj)} has no element {name!r}"
+    return f"{object_type_repr(obj)!r} has no attribute {name!r}"
+
+
 def pformat(obj: t.Any) -> str:
     """Format an object using :func:`pprint.pformat`."""
     from pprint import pformat
