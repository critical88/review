+    def make_undefined_for_macro(
+        self,
+        hint: t.Optional[str] = None,
+        name: t.Optional[str] = None,
+    ) -> "Undefined":
+        """Create an undefined value suitable for macro argument defaults.
+
+        This is the preferred factory for creating undefined sentinels during
+        macro argument resolution — it respects the environment's configured
+        undefined class and applies macro-specific default policies.
+        """
+        return self.undefined(hint, name=name)
+
+    def get_macro_autoescape_policy(
+        self,
+        template_name: t.Optional[str] = None,
+    ) -> bool:
+        """Return the autoescape policy that applies for macros when no
+        explicit eval context is available.
+
+        Used as a fallback when macros are invoked from module-level code
+        without a template-rendering eval context.
+        """
+        if callable(self.autoescape):
+            return self.autoescape(template_name)
+        return self.autoescape
+
     def getitem(
         self, obj: t.Any, argument: t.Union[str, t.Any]
     ) -> t.Union[t.Any, Undefined]:
