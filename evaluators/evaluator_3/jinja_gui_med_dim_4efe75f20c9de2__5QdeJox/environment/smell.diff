+def _prepare_source_from_ast(
+    node: nodes.Template,
+    environment: "Environment",
+    name: t.Optional[str],
+    filename: t.Optional[str],
+    defer_init: bool = False,
+    optimized: bool = True,
+) -> str:
+    """Prepare generated source code from a template AST node.
+
+    This validates the node, runs code generation, and returns the
+    resulting Python source string.
+    """
+    if not isinstance(node, nodes.Template):
+        raise TypeError("Can't compile non template nodes")
+    gen = environment.code_generator_class(
+        environment, name, filename, None, defer_init, optimized
+    )
+    gen.visit(node)
+    return gen.stream.getvalue()  # type: ignore
+
+
