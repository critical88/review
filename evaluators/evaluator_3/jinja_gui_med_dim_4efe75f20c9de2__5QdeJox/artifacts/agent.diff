+    def _parse_for_compile(
+        self,
+        source: str,
+        name: t.Optional[str],
+        filename: t.Optional[str],
+    ) -> nodes.Template:
+        """Internal parsing function for compile which sets up the parser with
+        all extensions and preprocessing required.
+        """
+        # Preprocessing: apply all extension preprocessors to the raw
+        # template source before tokenization.
+        preprocessed = reduce(
+            lambda s, e: e.preprocess(s, name, filename),
+            self.iter_extensions(),
+            str(source),
+        )
+        token_stream = self.lexer.tokenize(
+            preprocessed, name, filename, state=None
+        )
+        for ext in self.iter_extensions():
+            token_stream = ext.filter_stream(token_stream)  # type: ignore
+            if not isinstance(token_stream, TokenStream):
+                token_stream = TokenStream(token_stream, name, filename)
+
+        parser_obj = Parser.__new__(Parser)
+        parser_obj.environment = self
+        parser_obj.stream = token_stream
+        parser_obj.name = name
+        parser_obj.filename = filename
+        parser_obj.closed = False
+        parser_obj.extensions = {}
+        for extension in self.iter_extensions():
+            for tag in extension.tags:
+                parser_obj.extensions[tag] = extension.parse
+        parser_obj._last_identifier = 0
+        parser_obj._tag_stack = []
+        parser_obj._end_token_stack = []
+
+        parsed_body = parser_obj.subparse()
+        ast_node = nodes.Template(parsed_body, lineno=1)
+        ast_node.set_environment(self)
+        return ast_node
+
+    def _generate_for_compile(
+        self,
+        source: nodes.Template,
+        name: t.Optional[str],
+        filename: t.Optional[str],
+        defer_init: bool = False,
+    ) -> str:
+        """Internal generation function for compile which uses _prepare_source_from_ast."""
+        return _prepare_source_from_ast(
+            source,
+            self,
+            name,
+            filename,
+            defer_init=defer_init,
+            optimized=self.optimized,
+        )
+
+    def _compile_for_compile(
+        self,
+        source: str,
+        filename: t.Optional[str],
+    ) -> CodeType:
+        """Internal compilation function for compile which compiles the source."""
+        compile_target = filename if filename is not None else (
+            _DEFAULT_TEMPLATE_FILENAME
+        )
+        return compile(source, compile_target, "exec")
+
