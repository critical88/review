+class EvalContextStateManager:
+    """Manages the evaluation context state stack for saving and reverting
+    eval context state during template rendering."""
+
+    def __init__(self, eval_ctx: EvalContext) -> None:
+        self.eval_ctx = eval_ctx
+        self._state_stack: t.List[t.Mapping[str, t.Any]] = []
+
+    def save_state(self) -> t.Mapping[str, t.Any]:
+        """Save the current eval context state and push it onto the stack."""
+        state = self.eval_ctx.save()
+        self._state_stack.append(state)
+        return state
+
+    def revert_state(self, old: t.Mapping[str, t.Any]) -> None:
+        """Revert the eval context to a previously saved state."""
+        if self._state_stack and self._state_stack[-1] is old:
+            self._state_stack.pop()
+        self.eval_ctx.revert(old)
+
+
+class BlockOutputRenderer:
+    """Handles rendering of block output with appropriate escaping based on
+    the evaluation context."""
+
+    def __init__(self, eval_ctx: EvalContext) -> None:
+        self.eval_ctx = eval_ctx
+
+    def render(self, raw_output: str) -> str:
+        """Render block output, applying markup escaping if autoescape is enabled."""
+        if self.eval_ctx.autoescape:
+            return Markup(raw_output)
+        return raw_output
+
+
