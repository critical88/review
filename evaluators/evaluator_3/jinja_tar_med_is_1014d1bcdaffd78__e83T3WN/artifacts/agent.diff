+class ClearableBytecodeCache(BytecodeCache):
+    """Interface for bytecode caches that support clearing."""
+
+    def clear(self) -> None:
+        """Clears the cache.  This method should be implemented to allow
+        applications to clear the bytecode cache used by a particular environment.
+        """
+        raise NotImplementedError()
+
