+class FreshnessCheckingBytecodeCache(BytecodeCache):
+    """Interface for bytecode caches that support cache freshness checking."""
+
+    def check_cache_freshness(
+        self, bucket: Bucket, source_hint: t.Optional[str] = None
+    ) -> bool:
+        """Verify that a cached bucket is still consistent with the
+        expected state.  Returns ``True`` if the bucket can be trusted.
+
+        Subclasses that store metadata alongside the bytecode (e.g. 
+        filesystem timestamps or remote TTLs) should override this to 
+        perform deeper validation.
+        """
+        if bucket.code is None:
+            return False
+        if source_hint is not None:
+            expected = sha1(source_hint.encode("utf-8")).hexdigest()
+            return bucket.checksum == expected
+        return True
+
+
+class StatsReportingBytecodeCache(BytecodeCache):
+    """Interface for bytecode caches that support statistics reporting."""
 
