+class _FormatCoordinator:
+    """Helper that encapsulates formatting state manipulation and text wrapping.
+
+    This extracts the formatting-related responsibilities out of the large
+    Context class while preserving the original behavior and the public
+    :attr:`_format_state` dictionary interface.
+    """
+
+    def __init__(self, format_state: dict[str, t.Any]) -> None:
+        self._state = format_state
+
+    def compute_dl_widths(
+        self,
+        widths: tuple[int, ...],
+        formatter_width: int,
+        current_indent: int,
+        col_max: int = 30,
+        col_spacing: int = 2,
+    ) -> tuple[int, int]:
+        """Compute column widths for definition list formatting.
+
+        Delegates to :func:`click.formatting.measure_table`/wrapping logic while
+        keeping the same state keys in :attr:`Context._format_state`.
+        """
+        first_col = min(widths[0], col_max) + col_spacing
+        text_width = max(formatter_width - first_col - 2, 10)
+        self._state.update({
+            "dl_first_col": first_col,
+            "dl_text_width": text_width,
+            "dl_current_indent": current_indent,
+            "formatter_width": formatter_width,
+        })
+        return first_col, text_width
+
+    def wrap_text(
+        self, text: str, width: int, indent: int, preserve_paragraphs: bool = True
+    ) -> str:
+        """Wrap text for help output while tracking formatting state.
+
+        Preserves the exact behavior of the previous implementation but centralizes
+        the state writes here.
+        """
+        from .formatting import wrap_text
+
+        indent_str = " " * indent
+        self._state["last_wrap_width"] = width
+        self._state["last_wrap_indent"] = indent
+        return wrap_text(
+            text,
+            width,
+            initial_indent=indent_str,
+            subsequent_indent=indent_str,
+            preserve_paragraphs=preserve_paragraphs,
+        )
+
