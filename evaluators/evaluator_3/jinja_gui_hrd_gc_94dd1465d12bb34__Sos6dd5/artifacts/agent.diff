+class CallableInvoker:
+    """Handles callable invocation with context injection.
+    
+    Manages the complex logic of calling template functions with automatic
+    injection of context, eval_context, or environment based on decorators,
+    separating this concern from the broader Context responsibilities.
+    """
+
+    @staticmethod
+    def invoke(
+        context: "Context",
+        __obj: t.Callable[..., t.Any],
+        *args: t.Any,
+        **kwargs: t.Any,
+    ) -> t.Union[t.Any, "Undefined"]:
+        """Call the callable with proper context injection."""
+        if __debug__:
+            __traceback_hide__ = True
+
+        # Allow callable classes to take a context
+        if (
+            hasattr(__obj, "__call__")
+            and _PassArg.from_obj(__obj.__call__) is not None
+        ):
+            __obj = __obj.__call__
+
+        pass_arg = _PassArg.from_obj(__obj)
+
+        if pass_arg is _PassArg.context:
+            # the active context should have access to variables set in
+            # loops and blocks without mutating the context itself
+            active_context = context
+            if kwargs.get("_loop_vars"):
+                active_context = context.derived(kwargs["_loop_vars"])
+            if kwargs.get("_block_vars"):
+                active_context = context.derived(kwargs["_block_vars"])
+            args = (active_context,) + args
+        elif pass_arg is _PassArg.eval_context:
+            args = (context.eval_ctx,) + args
+        elif pass_arg is _PassArg.environment:
+            args = (context.environment,) + args
+
+        kwargs.pop("_block_vars", None)
+        kwargs.pop("_loop_vars", None)
+
+        try:
+            return __obj(*args, **kwargs)
+        except StopIteration:
+            return context.environment.undefined(
+                "value was undefined because a callable raised a"
+                " StopIteration exception"
+            )
+
+
+class VariableResolver:
+    """Handles variable lookup and resolution logic.
+    
+    Encapsulates the strategy for finding variables in the template context,
+    searching through local variables, parent scope, and handling the
+    missing value sentinel.
+    """
+
+    @staticmethod
+    def resolve_or_missing(
+        vars: t.Dict[str, t.Any], parent: t.Dict[str, t.Any], key: str
+    ) -> t.Any:
+        """Look up a variable by name, or return a missing sentinel."""
+        if key in vars:
+            return vars[key]
+        if key in parent:
+            return parent[key]
+        return missing
+
+    @staticmethod
+    def contains(vars: t.Dict[str, t.Any], parent: t.Dict[str, t.Any], name: str) -> bool:
+        """Check if a variable exists in this context."""
+        return name in vars or name in parent
+
+    @staticmethod
+    def get_all(vars: t.Dict[str, t.Any], parent: t.Dict[str, t.Any]) -> t.Dict[str, t.Any]:
+        """Return the complete variable dict."""
+        if not vars:
+            return parent
+        if not parent:
+            return vars
+        return dict(parent, **vars)
+
+
+class BlockManager:
+    """Manages template block inheritance and resolution.
+    
+    Handles the organization and lookup of template blocks for inheritance,
+    providing a clear separation of block management concerns from the
+    broader context responsibilities.
+    """
+
+    def __init__(
+        self, blocks: t.Dict[str, t.Callable[["Context"], t.Iterator[str]]]
+    ) -> None:
+        self.blocks = {k: [v] for k, v in blocks.items()}
+
+    def get_super(
+        self,
+        name: str,
+        current: t.Callable[["Context"], t.Iterator[str]],
+        context: "Context",
+    ) -> t.Union["BlockReference", "Undefined"]:
+        """Get a reference to the parent block."""
+        try:
+            blocks = self.blocks[name]
+            index = blocks.index(current) + 1
+            blocks[index]
+        except LookupError:
+            return context.environment.undefined(
+                f"there is no parent block called {name!r}.", name="super"
+            )
+        return BlockReference(name, context, blocks, index)
+
+    def get_block_reference(
+        self, name: str, context: "Context"
+    ) -> "BlockReference":
+        """Get a reference to a named block."""
+        blocks = self.blocks[name]
+        return BlockReference(name, context, blocks, 0)
+
+    def update_blocks(self, blocks: t.Dict[str, t.List[t.Callable]]) -> None:
+        """Update blocks mapping during template inheritance."""
+        self.blocks.update(blocks)
+
+    def copy_blocks(self) -> t.Dict[str, t.List[t.Callable]]:
+        """Create a copy of the blocks mapping."""
+        return {k: list(v) for k, v in self.blocks.items()}
+
