+    def _parse_args_with_context(
+        self, 
+        args: list[str], 
+        prog_name: str, 
+        context_kwargs: dict[str, t.Any]
+    ) -> Context:
+        """Parse arguments with context management for the parse phase.
+        
+        This method handles the parse phase of command execution, including
+        context setup, argument parsing, and proper resource cleanup.
+        
+        :param args: The arguments to parse.
+        :param prog_name: The program name.
+        :param context_kwargs: Keyword arguments for context construction.
+        :return: The parsed context.
+        """
+        # Construct the context directly with the pre-merged keyword
+        # arguments rather than delegating to make_context; the
+        # context_settings have already been folded in by the
+        # preparation step above.
+        _ctx = self.context_class(
+            self, info_name=prog_name, parent=None, **context_kwargs
+        )
+
+        # Open a parse-phase scope: bump the depth counter to defer
+        # resource teardown until the invoke phase completes, then
+        # activate the context on the thread-local stack while the
+        # argument vector is parsed.  This replaces the layered
+        # scope(cleanup=False) / __enter__ / __exit__ chain that
+        # make_context formerly orchestrated.
+        _ctx._depth += 1
+        _pfail = False
+        _ctx._depth += 1
+        push_context(_ctx)
+        try:
+            self.parse_args(_ctx, args)
+        except BaseException:
+            _pfail = True
+            raise
+        finally:
+            _ctx._depth -= 1
+            if _ctx._depth == 0:
+                _ctx._close_with_exception_info(
+                    *(sys.exc_info() if _pfail else (None, None, None))
+                )
+            pop_context()
+            _ctx._depth -= 1
+            
+        return _ctx
+
+    def _invoke_with_context(
+        self, 
+        ctx: Context, 
+        standalone_mode: bool
+    ) -> t.Any:
+        """Invoke command with context management for the invoke phase.
+        
+        This method handles the invoke phase of command execution, including
+        context activation, command invocation, and proper resource cleanup.
+        
+        :param ctx: The context to use for invocation.
+        :param standalone_mode: Whether to run in standalone mode.
+        :return: The result of command invocation if not in standalone mode.
+        """
+        # Enter the invoke phase: push the context onto the thread-
+        # local stack again so that get_current_context() works
+        # inside callbacks, then run the command.  The context-
+        # manager protocol (__enter__/__exit__) is expanded inline
+        # so that teardown always executes even when the callback or
+        # ctx.exit() raises.
+        _ctx = ctx
+        _ctx._depth += 1
+        push_context(_ctx)
+        _iexc: BaseException | None = None
+        _rv: t.Any = None
+        try:
+            _rv = self.invoke(_ctx)
+            if not standalone_mode:
+                pass  # will return after context cleanup below
+            else:
+                # it's not safe to `_ctx.exit(_rv)` here!
+                # note that `_rv` may actually contain data like "1"
+                # which has obvious effects
+                # more subtle case: `_rv=[None, None]` can come out
+                # of chained commands which all returned `None` -- so
+                # it's not even always obvious that `_rv` indicates
+                # success/failure by its truthiness/falsiness
+                _ctx.exit()
+        except BaseException as _ie:
+            _iexc = _ie
+        finally:
+            _ctx._depth -= 1
+            _suppressed = False
+            if _ctx._depth == 0:
+                if _iexc is not None:
+                    _suppressed = bool(
+                        _ctx._close_with_exception_info(
+                            type(_iexc), _iexc, _iexc.__traceback__
+                        )
+                    )
+                else:
+                    _ctx._close_with_exception_info(None, None, None)
+            pop_context()
+
+        if _iexc is not None and not _suppressed:
+            raise _iexc
+        if _iexc is None and not standalone_mode:
+            return _rv
+
+    def _handle_shell_completion(
+        self,
+        prog_name: str,
+        complete_var: str | None,
+        completion_instruction: str | None,
+        resolved_complete_var: str,
+        extra: cabc.MutableMapping[str, t.Any],
+    ) -> bool:
+        """Handle shell completion if requested.
+        
+        :param prog_name: The program name.
+        :param complete_var: The completion variable.
+        :param completion_instruction: The completion instruction from environment.
+        :param resolved_complete_var: The resolved completion variable name.
+        :param extra: Extra keyword arguments.
+        :return: True if completion was handled, False otherwise.
+        """
+        # Process shell completion requests and exit early.
+        if completion_instruction:
+            from .shell_completion import shell_complete
+
+            sys.exit(shell_complete(self, extra, prog_name, resolved_complete_var, completion_instruction))
+        return False
+
