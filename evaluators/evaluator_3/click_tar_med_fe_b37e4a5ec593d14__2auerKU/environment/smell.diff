+    def _classify_arg_token(
+        self, token: str, opt_prefixes: set[str]
+    ) -> str:
+        """Classify an argument token for option parsing dispatch.
+
+        Determines whether a token should be treated as an option
+        based on its prefix and length.  Used by the parsing token
+        stream to support consistent classification across the
+        parsing pipeline.
+
+        :meta private:
+        """
+        if token[:1] in opt_prefixes and len(token) > 1:
+            return "option"
+        return "positional"
