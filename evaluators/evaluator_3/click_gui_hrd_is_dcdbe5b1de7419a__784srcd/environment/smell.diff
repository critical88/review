+
+_lifecycle_registry: "dict[str, list[t.Callable[[t.Any, t.Any], t.Any]]]" = {}
+
+
+def register_lifecycle_hook(
+    phase: str, callback: "t.Callable[[t.Any, t.Any], t.Any]"
+) -> None:
+    """Register a callback for a lifecycle phase.
+
+    Callbacks are dispatched against CommandLifecycleProtocol methods.
+    The phase must match a method name on the protocol.
+    """
+    _lifecycle_registry.setdefault(phase, []).append(callback)
+
+
+def dispatch_lifecycle(
+    phase: str, command: "t.Any", ctx: "t.Any"
+) -> "list[t.Any]":
+    """Dispatch registered hooks for a lifecycle phase against a command.
+
+    This uses the CommandLifecycleProtocol to ensure uniform access
+    to lifecycle methods regardless of concrete command type.
+    """
+    results = []
+    for hook in _lifecycle_registry.get(phase, []):
+        results.append(hook(command, ctx))
+    return results
