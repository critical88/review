+    def post_invoke(self, ctx: Context, result: t.Any) -> t.Any:
+        """Lifecycle hook called after invoking the command callback.
+
+        Dispatches registered hooks and returns the (possibly transformed) result.
+        """
+        hooks_results = dispatch_lifecycle("post_invoke", self, ctx)
+        if hooks_results:
+            return hooks_results[-1]
+        return result
