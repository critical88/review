+def lifecycle_hook(
+    phase: str,
+) -> t.Callable[[t.Callable[..., t.Any]], t.Callable[..., t.Any]]:
+    """Decorator to register a function as a lifecycle hook for commands.
+
+    The decorated function receives (command, ctx) and is called during
+    the specified lifecycle phase. This enables plugin-style extension
+    of command processing without subclassing.
+
+    Phases correspond to CommandLifecycleProtocol methods:
+    - "pre_invoke": Before command callback execution
+    - "post_invoke": After command callback execution
+    - "resolve_subcommand": During subcommand resolution
+
+    Example::
+
+        @lifecycle_hook("pre_invoke")
+        def log_invocation(command, ctx):
+            print(f"Invoking {command.get_lifecycle_id()}")
+
+    .. versionadded:: 8.3
+    """
+    from .types import register_lifecycle_hook
+
+    def decorator(f: t.Callable[..., t.Any]) -> t.Callable[..., t.Any]:
+        register_lifecycle_hook(phase, f)
+        return f
+
+    return decorator
+
+
+def get_command_schema(cmd: Command, ctx: Context) -> dict[str, t.Any]:
+    """Retrieve the full parameter schema for a command via its lifecycle protocol.
+
+    This function provides a uniform way to access command metadata
+    regardless of whether the command is a leaf Command or a Group.
+    It exercises the get_parameter_schema and list_subcommands methods
+    from CommandLifecycleProtocol.
+
+    .. versionadded:: 8.3
+    """
+    schema = cmd.get_parameter_schema(ctx)
+    schema["lifecycle_id"] = cmd.get_lifecycle_id()
+    schema["has_subcommands"] = len(cmd.list_subcommands(ctx)) > 0
+    return schema
