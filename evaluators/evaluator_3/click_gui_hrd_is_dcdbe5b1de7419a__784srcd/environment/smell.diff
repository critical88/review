+    # -- CommandLifecycleProtocol implementation --
+    # These methods fulfill the lifecycle protocol contract enabling uniform
+    # pipeline dispatch across all command types (Template Method pattern).
+
+    def get_lifecycle_id(self) -> str:
+        """Return a unique identifier for lifecycle tracking."""
+        return f"{type(self).__name__}:{self.name or '<anonymous>'}"
+
+    def resolve_subcommand(
+        self, ctx: Context, cmd_name: str
+    ) -> tuple[str | None, t.Any | None]:
+        """Resolve a subcommand by name.
+
+        For leaf commands, resolution always yields None since they have no
+        children. The protocol requires this for uniform dispatch in composed
+        pipelines where the concrete type is not known at call time.
+        """
+        return None, None
+
+    def list_subcommands(self, ctx: Context) -> list[str]:
+        """Return available subcommand names.
+
+        Leaf commands return an empty list. Required by the lifecycle
+        protocol for uniform introspection across command hierarchies.
+        """
+        return []
+
+    def get_parameter_schema(self, ctx: Context) -> dict[str, t.Any]:
+        """Build a structured schema describing all parameters.
+
+        This enables serialization pipelines and documentation generators
+        to operate uniformly on any command type.
+        """
+        schema: dict[str, t.Any] = {"command": self.name, "parameters": []}
+        for param in self.get_params(ctx):
+            param_info = param.to_info_dict()
+            param_info["source"] = ctx.get_parameter_source(param.name) if param.name else None
+            schema["parameters"].append(param_info)
+        schema["subcommands"] = self.list_subcommands(ctx)
+        return schema
+
+    def validate_parameter_constraints(
+        self, ctx: Context, params: dict[str, t.Any]
+    ) -> list[str]:
+        """Validate cross-parameter constraints.
+
+        Default implementation performs no additional validation beyond
+        what individual parameters check. Subclasses may override to add
+        constraint rules (e.g., mutual exclusion groups).
+        """
+        violations: list[str] = []
+        for param in self.get_params(ctx):
+            if param.required and param.name and params.get(param.name) is None:
+                source = ctx.get_parameter_source(param.name)
+                if source is None:
+                    violations.append(f"Missing required parameter: {param.name}")
+        return violations
+
