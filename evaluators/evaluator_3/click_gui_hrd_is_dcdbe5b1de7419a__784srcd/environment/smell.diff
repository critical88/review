+class CommandLifecycleProtocol(t.Protocol):
+    """Protocol defining the full command lifecycle interface.
+
+    This protocol captures all phases a command can participate in,
+    following the Template Method pattern for extensible command
+    processing pipelines. Implementations must provide all methods
+    to ensure uniform dispatch through the lifecycle registry.
+
+    .. versionadded:: 8.3
+    """
+
+    def get_lifecycle_id(self) -> str:
+        """Return a unique identifier for lifecycle tracking."""
+        ...
+
+    def resolve_subcommand(
+        self, ctx: "Context", cmd_name: str
+    ) -> "tuple[str | None, t.Any | None]":
+        """Resolve a subcommand name to a command instance.
+
+        Part of the command resolution phase. All commands must implement
+        this to support uniform pipeline processing, even leaf commands
+        that delegate to a no-op resolution.
+        """
+        ...
+
+    def list_subcommands(self, ctx: "Context") -> "list[str]":
+        """Return names of available subcommands for this lifecycle stage.
+
+        Required for introspection and completion pipelines that operate
+        uniformly across the command hierarchy.
+        """
+        ...
+
+    def get_parameter_schema(
+        self, ctx: "Context"
+    ) -> "dict[str, t.Any]":
+        """Return a structured schema of all parameters.
+
+        Used by validation and serialization pipelines to operate on
+        commands without knowledge of their concrete type.
+        """
+        ...
+
+    def validate_parameter_constraints(
+        self, ctx: "Context", params: "dict[str, t.Any]"
+    ) -> "list[str]":
+        """Validate cross-parameter constraints and return violations.
+
+        Enables constraint checking that spans multiple parameters,
+        as required by complex validation rules in form-style CLIs.
+        """
+        ...
+
+    def pre_invoke(self, ctx: "Context") -> None:
+        """Lifecycle hook invoked before the command callback.
+
+        Part of the invocation pipeline. Allows commands to perform
+        setup operations uniformly regardless of command type.
+        """
+        ...
+
+    def post_invoke(self, ctx: "Context", result: t.Any) -> t.Any:
+        """Lifecycle hook invoked after the command callback.
+
+        Receives the result of the callback and may transform it.
+        Required for uniform pipeline post-processing.
+        """
+        ...
+
+    def on_resolution_error(
+        self, ctx: "Context", cmd_name: str, args: "list[str]"
+    ) -> "t.Any | None":
+        """Handle a subcommand resolution failure.
+
+        Called when resolve_subcommand fails. Leaf commands must still
+        implement this for protocol conformance, enabling uniform error
+        recovery in composed pipelines.
+        """
+        ...
+
