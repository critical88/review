+class BaseBytecodeCache(abc.ABC):
+    """Minimal interface for bytecode cache backends.
+    
+    This class defines the essential methods that all bytecode cache
+    implementations must provide. Subclasses should implement at least
+    :meth:`load_bytecode` and :meth:`dump_bytecode`.
+    
+    For a full-featured cache with utility methods, use :class:`BytecodeCache`
+    instead.
+    """
+
+    @abc.abstractmethod
+    def load_bytecode(self, bucket: Bucket) -> None:
+        """Load bytecode into a bucket from the cache.
+        
+        Subclasses must override this method. If they are not able to find
+        code in the cache for the bucket, it must not do anything.
+        """
+        raise NotImplementedError()
+
+    @abc.abstractmethod
+    def dump_bytecode(self, bucket: Bucket) -> None:
+        """Write bytecode from a bucket back to the cache.
+        
+        Subclasses must override this method. If unable to write the bytecode,
+        it must raise an exception.
+        """
+        raise NotImplementedError()
+
+
+class BytecodeCache(BaseBytecodeCache):
+    """Full-featured bytecode cache with utility methods.
+    
+    To implement your own bytecode cache you can subclass this class
     and override :meth:`load_bytecode` and :meth:`dump_bytecode`.  Both of
