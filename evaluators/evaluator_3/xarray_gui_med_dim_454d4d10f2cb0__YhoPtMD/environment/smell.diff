 MergeElement = tuple[Variable, Optional[Index]]
 
 
+def _resolve_merge_element_conflicts(
+    name: Hashable,
+    elements_list: list[MergeElement],
+    compat: CompatOptions,
+    combine_attrs: CombineAttrsOptions,
+    equals_cache: dict[Any, bool] | None,
+    index_cmp_cache: dict[tuple[int, int], bool | None],
+) -> tuple[Variable, Optional[Index], bool]:
+    """Resolve a single merge element from a list of variable/index candidates.
+
+    Determines the canonical variable and index for a given name by checking
+    index compatibility and variable equality. Used by the dataset concat
+    inline merge path.
+
+    Returns
+    -------
+    variable : Variable
+    index : Index or None
+    has_index : bool
+    """
+    if equals_cache is None:
+        equals_cache = {}
+
+    indexed_elements = [
+        (variable, index)
+        for variable, index in elements_list
+        if index is not None
+    ]
+    if indexed_elements:
+        variable, index = indexed_elements[0]
+        for other_var, other_index in indexed_elements[1:]:
+            if not indexes_equal(
+                index, other_index, variable, other_var, index_cmp_cache
+            ):
+                raise MergeError(
+                    f"conflicting values/indexes on objects to be combined fo coordinate {name!r}\n"
+                    f"first index: {index!r}\nsecond index: {other_index!r}\n"
+                    f"first variable: {variable!r}\nsecond variable: {other_var!r}\n"
+                )
+        if compat == "identical":
+            for other_variable, _ in indexed_elements[1:]:
+                if not dict_equiv(variable.attrs, other_variable.attrs):
+                    raise MergeError(
+                        "conflicting attribute values on combined "
+                        f"variable {name!r}:\nfirst value: {variable.attrs!r}\nsecond value: {other_variable.attrs!r}"
+                    )
+        merged_var = variable
+        merged_var.attrs = merge_attrs(
+            [var.attrs for var, _ in indexed_elements],
+            combine_attrs=combine_attrs,
+        )
+        return merged_var, index, True
+    else:
+        variables = [variable for variable, _ in elements_list]
+        try:
+            resolved = unique_variable(
+                name, variables, compat, equals_cache.get(name, None)
+            )
+        except MergeError:
+            if compat != "minimal":
+                raise
+            else:
+                return variables[0], None, False
+
+        resolved.attrs = merge_attrs(
+            [var.attrs for var in variables], combine_attrs=combine_attrs
+        )
+        return resolved, None, False
+
+
