+def _collect_alignable_targets_from_mapping(
+    variables,
+    position: int,
+    indexes: Mapping[Any, Any],
+    is_alignable: Callable[[Any], bool],
+    positions: list,
+    keys: list,
+    targets: list,
+    not_replaced: object,
+):
+    """Extract alignable values from a mapping.
+
+    Side-effects: appends to positions, keys, targets lists. Returns a copy
+    of the mapping with alignable entries replaced by the sentinel
+    ``not_replaced``. This centralizes the previously inlined logic so that
+    deep_align remains concise and the behavior is easier to test or reuse.
+    """
+    current_out = {}
+    for k, v in variables.items():
+        if is_alignable(v) and k not in indexes:
+            # Skip variables in indexes for alignment, because these should be
+            # overwritten instead (see related issues in repository history).
+            positions.append(position)
+            keys.append(k)
+            targets.append(v)
+            current_out[k] = not_replaced
+        else:
+            current_out[k] = v
+    return current_out
+
