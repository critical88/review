+def _resolve_update_conflicts(
+    mapping: dict[Hashable, Any],
+    dataset_coord_names: set[Hashable],
+    dataset_variables: Mapping[Hashable, Variable],
+) -> dict[Hashable, Any]:
+    """Resolve conflicting coordinates when updating a dataset with a mapping.
+
+    For each DataArray value in the mapping, inspect its internal coordinate
+    variables and dimensions to find non-dimension coordinates that conflict
+    with the target dataset's existing coordinates. Drop those conflicting
+    coordinates from the DataArray before returning the cleaned mapping.
+
+    Parameters
+    ----------
+    mapping : dict
+        A mutable dict of variable name -> values (may include DataArrays).
+    dataset_coord_names : set
+        Set of coordinate names from the target dataset.
+    dataset_variables : mapping
+        Variables mapping from the target dataset (used for coord presence check).
+
+    Returns
+    -------
+    dict
+        The mapping with conflicting coordinates removed from DataArray values.
+    """
+    from xarray.core.dataarray import DataArray
+
+    for key, value in mapping.items():
+        if isinstance(value, DataArray):
+            # Access the underlying variable dimensions directly to determine
+            # which coordinates are non-dimensional
+            value_dim_set = set(value._variable.dims)
+            # Walk through the DataArray's internal coordinate dict to find
+            # coordinates that are non-dimensional and conflict with the target
+            conflicting = [
+                coord_name
+                for coord_name in value._coords
+                if coord_name not in value_dim_set
+                and coord_name in dataset_coord_names
+                and coord_name in dataset_variables
+            ]
+            if conflicting:
+                mapping[key] = value.drop_vars(conflicting)
+    return mapping
+
+
