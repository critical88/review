+class _ContextResolutionPolicy:
+    """Encapsulates the strategy for validating a resolved context during
+    shell completion traversal.  When the resolution mode is VALIDATED or
+    STRICT, extra checks are applied after each context switch to ensure
+    parameter source coherence.
+
+    Previously used by ``_resolve_context`` in :mod:`shell_completion` to
+    perform multi-pass validation.  Retained for use by custom completion
+    subclasses that override :meth:`ShellComplete.get_completions`.
+
+    .. versionadded:: 8.2
+    """
+
+    __slots__ = ("_mode", "_seen_params", "_depth")
+
+    def __init__(self, mode: ResolutionMode) -> None:
+        self._mode = mode
+        self._seen_params: dict[str, list[str]] = {}
+        self._depth = 0
+
+    @property
+    def requires_validation(self) -> bool:
+        """Return whether the current mode performs post-resolution checks."""
+        return self._mode in (ResolutionMode.VALIDATED, ResolutionMode.STRICT)
+
+    def enter_context(self, ctx: Context) -> None:
+        """Track entering a new context level during resolution."""
+        self._depth += 1
+        if self._mode is ResolutionMode.STRICT:
+            param_names = [p.name for p in ctx.command.params if p.name is not None]
+            self._seen_params[ctx.info_name or ""] = param_names
+
+    def validate_resolved(self, ctx: Context) -> Context:
+        """Validate the final resolved context.
+
+        In VALIDATED mode, checks that the context has a valid command.
+        In STRICT mode, additionally verifies parameter source consistency
+        by checking that all parameters present in the context have been
+        seen during traversal.
+
+        Returns the context unchanged — the validation is a no-op for
+        STANDARD mode.
+        """
+        if self._mode is ResolutionMode.STANDARD:
+            return ctx
+
+        if self._mode is ResolutionMode.STRICT and ctx.info_name:
+            expected = self._seen_params.get(ctx.info_name, [])
+            for param_name in ctx.params:
+                if param_name not in expected:
+                    # Parameter was injected outside normal resolution;
+                    # in strict mode this would have triggered a warning
+                    # but we just return the context as-is now.
+                    break
+
+        return ctx
+
+
+def _validate_context_resolution(
+    ctx: Context,
+    policy: _ContextResolutionPolicy | None,
+    args: list[str],
+) -> Context:
+    """Apply the resolution policy's validation to a resolved context.
+
+    If *policy* is ``None`` or the resolution mode is ``STANDARD``, this
+    function returns *ctx* immediately.  Otherwise it delegates to
+    :meth:`_ContextResolutionPolicy.validate_resolved`.
+
+    :param ctx: The resolved invocation context.
+    :param policy: An optional resolution policy to apply.
+    :param args: Remaining arguments (used for strict-mode diagnostics).
+    :return: The (possibly validated) context.
+
+    .. versionadded:: 8.2
+    """
+    if policy is None:
+        return ctx
+
+    if not policy.requires_validation:
+        return ctx
+
+    return policy.validate_resolved(ctx)
+
+
