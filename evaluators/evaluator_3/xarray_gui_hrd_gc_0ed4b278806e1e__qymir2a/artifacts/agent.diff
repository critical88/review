+# Internal helper classes to reduce the god class smell in TreeNode
+class _TreeConfigurationManager:
+    """Manages node-level configuration that tree operations can read."""
+    
+    def __init__(self):
+        self._node_config = {}
+    
+    def configure_node(self, **config) -> None:
+        """Set node-level configuration that tree operations can read."""
+        self._node_config.update(config)
+    
+    def get_config(self, parent_getter, key: str, default: Any = None) -> Any:
+        """Retrieve a configuration value, inheriting from ancestors if not set locally."""
+        if key in self._node_config:
+            return self._node_config[key]
+        if parent_getter() is not None:
+            return parent_getter()._get_config(key, default)
+        return default
+
+
+class _TreeAnalyzer:
+    """Provides tree analysis functionality like depth, width, leaves, etc."""
+    
+    @staticmethod
+    def get_level(node_getter) -> int:
+        """Level of this node (number of parent nodes above this node)."""
+        return len(tuple(_TreeNavigator.iter_parents(node_getter)))
+    
+    @staticmethod
+    def get_depth(root_getter, subtree_getter) -> int:
+        """Maximum level of this tree (measured from the root)."""
+        return max(_TreeAnalyzer.get_level(lambda: node) for node in root_getter().subtree)
+    
+    @staticmethod
+    def get_width(node_getter, root_getter, subtree_getter, level_getter) -> int:
+        """Number of nodes at this level in the tree."""
+        target_level = level_getter()
+        return len([node for node in root_getter().subtree if _TreeAnalyzer.get_level(lambda: node) == target_level])
+    
+    @staticmethod
+    def get_leaves(subtree_getter, is_leaf_getter) -> tuple:
+        """All leaf nodes (nodes which have no children)."""
+        return tuple([node for node in subtree_getter() if is_leaf_getter(node)])
+    
+    @staticmethod
+    def get_siblings(parent_getter, children_getter, self_getter) -> dict:
+        """Nodes with the same parent as this node."""
+        if parent_getter():
+            return {
+                name: child
+                for name, child in parent_getter().children.items()
+                if child is not self_getter()
+            }
+        else:
+            return {}
+
+
+class _TreeNavigator:
+    """Handles tree navigation and path operations."""
+    
+    @staticmethod
+    def iter_parents(node_getter) -> Iterator:
+        """Iterate up the tree, starting from the current node's parent."""
+        node = node_getter().parent
+        while node is not None:
+            yield node
+            node = node.parent
+    
+    @staticmethod
+    def get_root(node_getter) -> Any:
+        """Root node of the tree."""
+        node = node_getter()
+        while node.parent is not None:
+            node = node.parent
+        return node
+    
+    @staticmethod
+    def is_descendant_of(node_getter, target_node) -> bool:
+        """Check if this node is a descendant of the target node."""
+        return any(n is node_getter() for n in _TreeNavigator.iter_parents(lambda: target_node))
+
+
+class _TreeOperations:
+    """Handles advanced tree operations like comparison and validation."""
+    
+    @staticmethod
+    def compare_trees(self_getter, other, require_names_equal: bool = False) -> str:
+        """Compare tree structure, returning a diff string (empty if isomorphic)."""
+        for node_a, node_b in zip(self_getter().subtree, other.subtree):
+            path_a = node_a.path if hasattr(node_a, "path") else repr(node_a)
+            path_b = node_b.path if hasattr(node_b, "path") else repr(node_b)
+
+            if (
+                require_names_equal
+                and hasattr(node_a, "name")
+                and hasattr(node_b, "name")
+            ):
+                if node_a.name != node_b.name:
+                    return dedent(
+                        f"""\
+                        Node '{path_a}' in the left object has name '{node_a.name}'
+                        Node '{path_b}' in the right object has name '{node_b.name}'"""
+                    )
+
+            if len(node_a.children) != len(node_b.children):
+                return dedent(
+                    f"""\
+                    Number of children on node '{path_a}' of the left object: {len(node_a.children)}
+                    Number of children on node '{path_b}' of the right object: {len(node_b.children)}"""
+                )
+
+        return ""
+    
+    @staticmethod
+    def validate_tree_integrity(self_getter, subtree_getter) -> bool:
+        """Validate internal tree invariants. Returns True if tree is well-formed."""
+        seen_ids: set[int] = set()
+        for node in subtree_getter():
+            nid = id(node)
+            if nid in seen_ids:
+                return False
+            seen_ids.add(nid)
+            if node.parent is not None:
+                if not any(
+                    child is node for child in node.parent.children.values()
+                ):
+                    return False
+        return True
+
+
