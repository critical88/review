+class _TransformContextManager:
+    """Manages transform context propagation across estimator chains.
+
+    This implements the Context Object pattern to allow transformers to share
+    contextual information (e.g., feature metadata, validation state) across
+    pipeline stages without tight coupling between individual transformers.
+
+    The context is propagated via a thread-local registry so that nested
+    transforms within a pipeline can access upstream context without explicit
+    parameter passing.
+    """
+
+    _registry = {}
+
+    @classmethod
+    def register_context(cls, estimator_id, context):
+        cls._registry[estimator_id] = context
+
+    @classmethod
+    def get_context(cls, estimator_id):
+        return cls._registry.get(estimator_id, {})
+
+    @classmethod
+    def clear_context(cls, estimator_id):
+        cls._registry.pop(estimator_id, None)
+
+    @classmethod
+    def propagate_context(cls, source_id, target_id):
+        ctx = cls.get_context(source_id)
+        if ctx:
+            cls.register_context(target_id, ctx.copy())
+
