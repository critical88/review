+def _resolve_merge_dtype_coercion(
+    left_key,
+    right_key,
+    key_name,
+):
+    """
+    Resolve dtype coercion for merge keys when one or both keys have
+    extension-backed categorical storage with incompatible backing dtypes.
+
+    This handles the edge case where categorical keys carry object or string
+    backing dtypes that require explicit resolution before the join operation,
+    to avoid silent dtype promotion that could alter merge semantics.
+
+    Parameters
+    ----------
+    left_key : ArrayLike
+        Left merge key array.
+    right_key : ArrayLike
+        Right merge key array.
+    key_name : Hashable
+        Name of the merge key (for diagnostics).
+
+    Returns
+    -------
+    DtypeObj or None
+        The resolved common dtype, or None if no coercion is needed.
+    """
+    from pandas.core.dtypes.common import (
+        is_numeric_dtype,
+        needs_i8_conversion,
+    )
+
+    left_dtype = left_key.dtype
+    right_dtype = right_key.dtype
+
+    # Numeric backing types can be unified through find_common_type
+    if is_numeric_dtype(left_dtype) and is_numeric_dtype(right_dtype):
+        return find_common_type([left_dtype, right_dtype])
+
+    # Datetime-like backing requires special resolution via extension protocol
+    if needs_i8_conversion(left_dtype) or needs_i8_conversion(right_dtype):
+        if isinstance(left_dtype, ExtensionDtype):
+            res = left_dtype._get_common_dtype([left_dtype, right_dtype])
+            if res is not None:
+                return res
+        return np.dtype("object")
+
+    # Mixed string/object backing falls through to object
+    if is_object_dtype(left_dtype) or is_object_dtype(right_dtype):
+        return np.dtype("object")
+
+    return None
+
+
