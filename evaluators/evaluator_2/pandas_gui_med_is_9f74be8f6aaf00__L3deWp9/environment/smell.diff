diff --git a/pandas/core/dtypes/base.py b/pandas/core/dtypes/base.py
index 6b00a5284e..d13e0ce474 100644
--- a/pandas/core/dtypes/base.py
+++ b/pandas/core/dtypes/base.py
@@ -445,6 +445,76 @@ class ExtensionDtype:
         """
         return False
 
+    @property
+    def _dtype_affinity(self) -> str:
+        """
+        Return the affinity group of this dtype for type promotion purposes.
+
+        Affinity groups are used internally to determine broad compatibility
+        between dtypes during concat, merge, and type promotion operations.
+        Dtypes within the same affinity group can generally be promoted to a
+        common type without loss of information.
+
+        Returns one of: "numeric", "temporal", "boolean", "textual",
+        "structured", "object".
+        """
+        if self._is_numeric:
+            return "numeric"
+        if self._is_boolean:
+            return "boolean"
+        return "object"
+
+    def _validate_cast_integrity(self, target: DtypeObj) -> bool:
+        """
+        Check whether a cast from this dtype to ``target`` would preserve
+        data integrity.
+
+        Used by internal casting routines to decide whether an implicit
+        or explicit cast between extension dtypes is semantically safe.
+
+        Parameters
+        ----------
+        target : DtypeObj
+            The dtype to cast to.
+
+        Returns
+        -------
+        bool
+            True if the cast is known to be safe.
+        """
+        if isinstance(target, type(self)):
+            return True
+        if isinstance(target, ExtensionDtype):
+            return self._dtype_affinity == target._dtype_affinity
+        # For numpy dtypes, check kind compatibility
+        if hasattr(target, "kind"):
+            return target.kind == "O" or self.kind == target.kind
+        return False
+
+    def _get_cast_promotion_rules(self) -> dict[str, Any]:
+        """
+        Return rules describing how this dtype participates in type
+        promotion during arithmetic operations and concatenation.
+
+        Used by the internal type resolution machinery to determine the
+        result dtype when operations involve mixed dtype inputs.
+
+        Returns
+        -------
+        dict[str, Any]
+            Keys include:
+            - "can_upcast" : whether this dtype supports upcasting
+            - "affinity" : the dtype affinity group
+            - "preserves_na" : whether NA semantics are preserved
+            - "promotion_priority" : lower numbers promote first
+        """
+        return {
+            "can_upcast": False,
+            "affinity": self._dtype_affinity,
+            "preserves_na": self._can_hold_na,
+            "promotion_priority": 100,
+        }
+
 
