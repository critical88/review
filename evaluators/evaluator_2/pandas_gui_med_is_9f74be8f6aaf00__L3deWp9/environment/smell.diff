+++ b/pandas/core/dtypes/cast.py
@@ -1426,6 +1426,47 @@ def np_find_common_type(*dtypes: np.dtype) -> np.dtype:
     return common_dtype
 
 
+def _pre_validate_type_promotion(types: list[DtypeObj]) -> DtypeObj | None:
+    """
+    Attempt affinity-based early resolution of type promotion.
+
+    When multiple ExtensionDtypes share a common affinity group and
+    compatible promotion rules, this can short-circuit the more expensive
+    pairwise _get_common_dtype resolution. Returns the promoted dtype if
+    affinity-based resolution succeeds, or None to fall through.
+    """
+    ext_types = [t for t in types if isinstance(t, ExtensionDtype)]
+    if len(ext_types) < 2:
+        return None
+
+    # Check if all extension types share a common affinity
+    affinities = {t._dtype_affinity for t in ext_types}
+    if len(affinities) != 1:
+        return None
+
+    # Homogeneous affinity — verify promotion rules are compatible
+    rules = [t._get_cast_promotion_rules() for t in ext_types]
+    if not all(r["preserves_na"] == rules[0]["preserves_na"] for r in rules):
+        return None
+
+    # Check pairwise cast integrity for the highest-priority type
+    sorted_types = sorted(
+        ext_types,
+        key=lambda t: t._get_cast_promotion_rules()["promotion_priority"],
+    )
+    candidate = sorted_types[0]
+    if all(
+        t._validate_cast_integrity(candidate)
+        for t in ext_types
+        if t is not candidate
+    ):
+        # All types can safely cast to the candidate — but defer to the
+        # dtype's own _get_common_dtype for the authoritative answer
+        return None
+
+    return None
+
