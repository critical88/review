diff --git a/numpy/_core/numeric.py b/numpy/_core/numeric.py
index 964447fa0d..d8cfede553 100644
--- a/numpy/_core/numeric.py
+++ b/numpy/_core/numeric.py
@@ -2730,6 +2730,29 @@ def astype(x, dtype, /, *, copy=True, device=None):
     return x.astype(dtype, copy=copy)
 
 
+def _accumulate_index_product(indices, idx_dict):
+    """Compute the product of sizes for the given indices from a dictionary."""
+    result = 1
+    for idx in indices:
+        result *= idx_dict[idx]
+    return result
+
+
+def _validate_blas_operands(left_str, right_str, result_indices):
+    """Validate that two operand strings are eligible for BLAS contraction.
+
+    Checks for repeated indices on the same input and implicit summation
+    or dimension collapse patterns that prevent BLAS usage.
+    """
+    for c in set(left_str + right_str):
+        nl, nr = left_str.count(c), right_str.count(c)
+        if (nl > 1) or (nr > 1) or (nl + nr > 2):
+            return False
+        if nl + nr - 1 == int(c in result_indices):
+            return False
+    return True
+
+
 inf = PINF
 nan = NAN
