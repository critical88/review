+def _resolve_lda_solver(
+    estimator: "LinearDiscriminantAnalysis", solver_name: str
+) -> Callable:
+    """Resolve the solver entry-point for :class:`LinearDiscriminantAnalysis`.
+
+    Returns the bound method on ``estimator`` matching ``solver_name`` using
+    the canonical registry exposed by :func:`sklearn.utils.extmath
+    ._lda_solver_registry`.
+    """
+    registry = _lda_solver_registry()
+    method_name = registry[solver_name]
+    return getattr(estimator, method_name)
