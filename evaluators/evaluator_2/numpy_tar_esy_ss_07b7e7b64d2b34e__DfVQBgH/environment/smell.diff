+def _check_wrapfunc_fallback(obj, method, bound, args, kwds, wrapit_func):
+    from numpy._core.overrides import _get_fallback_mode
+    if bound is None:
+        return True, wrapit_func(obj, method, *args, **kwds)
+    try:
+        result = bound(*args, **kwds)
+        return False, result
+    except TypeError:
+        if _get_fallback_mode():
+            return True, wrapit_func(obj, method, *args, **kwds)
+        raise
