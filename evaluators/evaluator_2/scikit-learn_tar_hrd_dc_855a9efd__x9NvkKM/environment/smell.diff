+import threading
+
+_mask_config_local = threading.local()
+
+
+def set_mask_config(value_to_mask, sentinel_kind, copy):
+    """Store mask configuration for the current thread.
+
+    This allows downstream mask operations to access the sentinel metadata
+    without passing every parameter explicitly.  Used by distance functions
+    that need to coordinate mask creation across separate X / Y arrays.
+
+    Parameters
+    ----------
+    value_to_mask : scalar
+        The sentinel value representing missing data.
+    sentinel_kind : str
+        One of ``'nan'``, ``'numeric'``, ``'non_numeric'``.
+    copy : bool
+        Whether the caller intends to operate on copies of the input data.
+    """
+    _mask_config_local.value_to_mask = value_to_mask
+    _mask_config_local.sentinel_kind = sentinel_kind
+    _mask_config_local.copy = copy
+
+
+def get_mask_config():
+    """Retrieve the current thread-local mask configuration.
+
+    Returns
+    -------
+    config : dict or None
+        Dictionary with keys ``'value_to_mask'``, ``'sentinel_kind'``, and
+        ``'copy'``, or ``None`` if no configuration has been set.
+    """
+    try:
+        return {
+            "value_to_mask": _mask_config_local.value_to_mask,
+            "sentinel_kind": _mask_config_local.sentinel_kind,
+            "copy": _mask_config_local.copy,
+        }
+    except AttributeError:
+        return None
+
+
+def clear_mask_config():
+    """Clear the thread-local mask configuration."""
+    for attr in ("value_to_mask", "sentinel_kind", "copy"):
+        try:
+            delattr(_mask_config_local, attr)
+        except AttributeError:
+            pass
