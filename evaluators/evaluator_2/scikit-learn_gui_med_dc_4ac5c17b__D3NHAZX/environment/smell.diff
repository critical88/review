+def prepare_scoring_labels(targets, apply_class_mapping, class_labels=None):
+    """Apply class label mapping to encoded targets for scorer evaluation.
+
+    Parameters
+    ----------
+    targets : ndarray
+        Encoded target values.
+    apply_class_mapping : bool
+        Whether to map encoded targets back to original class labels.
+    class_labels : ndarray or None
+        The class labels used for mapping encoded indices.
+
+    Returns
+    -------
+    ndarray
+        Mapped targets if applicable, otherwise the original array.
+    """
+    if apply_class_mapping and class_labels is not None:
+        return class_labels[targets.astype(int)]
+    return targets
+
+
+def evaluate_split_score(
+    scorer,
+    estimator,
+    split_features,
+    split_targets,
+    split_weights=None,
+):
+    """Evaluate a scorer on a data split.
+
+    Parameters
+    ----------
+    scorer : callable
+        Scoring callable with signature ``(estimator, X, y)``.
+    estimator : BaseEstimator
+        Fitted estimator instance.
+    split_features : ndarray of shape (n_samples, n_features)
+        Feature matrix for the split.
+    split_targets : ndarray of shape (n_samples,)
+        Target values for the split.
+    split_weights : ndarray of shape (n_samples,) or None
+        Per-sample weights.
+
+    Returns
+    -------
+    score : float
+    """
+    if split_weights is None:
+        return scorer(estimator, split_features, split_targets)
+    return scorer(
+        estimator, split_features, split_targets, sample_weight=split_weights
+    )
+
