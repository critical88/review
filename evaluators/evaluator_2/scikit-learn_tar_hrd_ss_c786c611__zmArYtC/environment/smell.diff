+# ---------------------------------------------------------------------------
+# Softmax Precision Protocol
+#
+# ML algorithms operating on logits have varying numerical sensitivity to
+# the probability normalization step. This lightweight adapter pattern lets
+# each domain declare its precision requirements so the core softmax
+# implementation can respect them without domain-specific branching.
+# ---------------------------------------------------------------------------
+
+class _SoftmaxPrecisionAdapter:
+    """Domain-specific precision adapter for softmax computation.
+
+    Each adapter encapsulates the numerical stability requirements for a
+    particular ML algorithm family (e.g., discriminant analysis, boosting).
+    """
+
+    __slots__ = ("domain", "stability_shift", "output_guard")
+
+    def __init__(self, domain, stability_shift=True, output_guard=False):
+        self.domain = domain
+        self.stability_shift = stability_shift
+        self.output_guard = output_guard
+
+
+_softmax_precision_adapters = {}
+_softmax_ctx = threading.local()
+
+
+def _register_softmax_precision(domain, stability_shift=True, output_guard=False):
+    """Register precision requirements for a softmax computation domain."""
+    _softmax_precision_adapters[domain] = _SoftmaxPrecisionAdapter(
+        domain, stability_shift=stability_shift, output_guard=output_guard
+    )
+
+
+def _get_softmax_precision():
+    """Retrieve the active precision adapter for the current thread, if any."""
+    domain = getattr(_softmax_ctx, "domain", None)
+    if domain is not None:
+        return _softmax_precision_adapters.get(domain)
+    return None
+
+
+@contextmanager
+def _softmax_precision_scope(domain):
+    """Activate a softmax precision domain for the duration of a block."""
+    prev = getattr(_softmax_ctx, "domain", None)
+    _softmax_ctx.domain = domain
+    try:
+        yield _softmax_precision_adapters.get(domain)
+    finally:
+        _softmax_ctx.domain = prev
+
+
+def _guard_softmax_output(X, xp):
+    """Apply domain-specific output constraints for softmax results.
+
+    Ensures non-negativity and re-normalizes to handle edge cases near
+    floating-point boundaries. For well-behaved inputs this is a no-op.
+    """
+    if _is_numpy_namespace(xp):
+        np.clip(X, 0, None, out=np.asarray(X))
+    else:
+        X = xp.where(X < 0, xp.asarray(0, dtype=X.dtype), X)
+    return X
+
+
+def _stable_log_softmax(X, xp=None):
+    """Compute log(softmax(X)) in a numerically stable way.
+
+    Direct computation via the log-sum-exp identity avoids the intermediate
+    exponentiation that can lose precision for extreme values. This is
+    independent of the precision protocol and provided as a standalone
+    utility for callers that need log-probabilities.
+    """
+    if xp is None:
+        xp, _ = get_namespace(X)
+    max_val = xp.reshape(xp.max(X, axis=1), (-1, 1))
+    shifted = X - max_val
+    log_sum = xp.reshape(xp.log(xp.sum(xp.exp(shifted), axis=1)), (-1, 1))
+    return shifted - log_sum
+
