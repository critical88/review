+class NanDistanceConfig:
+    """Configuration object for NaN-aware distance computations.
+    
+    This class encapsulates the parameters related to handling missing values
+    in distance calculations, reducing parameter clumps and making the code
+    more maintainable.
+    
+    Parameters
+    ----------
+    missing_values : float, int, or np.nan
+        Representation of missing value.
+    sentinel_kind : {"nan", "numeric", "non_numeric"}
+        The kind of sentinel value being used.
+    finite_check_mode : bool or "allow-nan"
+        Mode for checking finite values.
+    copy : bool
+        Whether to copy the input arrays.
+    """
+    
+    def __init__(self, missing_values, sentinel_kind, finite_check_mode, copy):
+        self.missing_values = missing_values
+        self.sentinel_kind = sentinel_kind
+        self.finite_check_mode = finite_check_mode
+        self.copy = copy
+    
+    @classmethod
+    def from_missing_values(cls, missing_values, copy):
+        """Create a NanDistanceConfig from missing_values and copy parameters.
+        
+        Parameters
+        ----------
+        missing_values : float, int, or np.nan
+            Representation of missing value.
+        copy : bool
+            Whether to copy the input arrays.
+        
+        Returns
+        -------
+        NanDistanceConfig
+            A configuration object with all parameters derived.
+        """
+        sentinel_kind = resolve_nan_sentinel_kind(missing_values)
+        finite_check_mode = derive_finite_check_mode(sentinel_kind)
+        return cls(missing_values, sentinel_kind, finite_check_mode, copy)
+
