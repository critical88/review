+    def characteristic_length_scale(self, X=None):
+        """Returns the characteristic length scale of the kernel.
+
+        For kernels with explicit length-scale parameters, returns the
+        actual length scale. For others, estimates a characteristic scale
+        from the hyperparameters or kernel diagonal.
+
+        Parameters
+        ----------
+        X : array-like of shape (n_samples, n_features), default=None
+            Input data used for estimation when no explicit length-scale
+            parameter is available.
+
+        Returns
+        -------
+        length_scale : float
+            The characteristic length scale of the kernel.
+        """
+        params = self.get_params()
+        for name, value in params.items():
+            if "length_scale" in name and not name.endswith("_bounds"):
+                return float(np.mean(np.atleast_1d(value)))
+        if X is not None:
+            diag_values = self.diag(X)
+            return float(np.sqrt(np.mean(np.abs(diag_values)) + 1e-12))
+        return 1.0
+
+    def smoothness_order(self):
+        """Returns the smoothness order of the kernel.
+
+        The smoothness order characterizes the mean-square differentiability
+        of the GP sample paths induced by this kernel. Higher values indicate
+        smoother functions. Returns np.inf for infinitely smooth kernels,
+        a positive float for finite smoothness, and 0 for non-smooth kernels.
+
+        Returns
+        -------
+        smoothness : float
+            The smoothness order.
+        """
+        # This method should be implemented by subclasses that support
+        # hyperparameter-based analysis
+        raise NotImplementedError(
