+    @staticmethod
+    def _compute_idf_weights(X, smooth_idf=True):
+        """Compute inverse document frequency weights from a count matrix.
+
+        Parameters
+        ----------
+        X : sparse matrix of shape (n_samples, n_features)
+            A matrix of term/token counts.
+
+        smooth_idf : bool, default=True
+            Smooth idf weights by adding one to document frequencies.
+
+        Returns
+        -------
+        idf : ndarray of shape (n_features,)
+            The inverse document frequency vector.
+        """
+        if not sp.issparse(X):
+            X = sp.csr_matrix(X)
+        dtype = X.dtype if X.dtype in (np.float64, np.float32) else np.float64
+
+        n_samples, _ = X.shape
+        df = _document_frequency(X)
+        df = df.astype(dtype, copy=False)
+
+        df += float(smooth_idf)
+        n_samples += int(smooth_idf)
+
+        idf = np.full_like(df, fill_value=n_samples, dtype=dtype)
+        idf /= df
+        np.log(idf, out=idf)
+        idf += 1.0
+
+        return idf
+
+    @staticmethod
+    def _apply_tfidf_weighting(X, idf=None, sublinear_tf=False, norm="l2"):
+        """Apply TF-IDF weighting to a term-frequency matrix.
+
+        Parameters
+        ----------
+        X : sparse matrix of shape (n_samples, n_features)
+            A matrix of term/token counts or frequencies (CSR format).
+
+        idf : ndarray of shape (n_features,), default=None
+            Precomputed IDF weights. If None, no IDF weighting is applied.
+
+        sublinear_tf : bool, default=False
+            Apply sublinear tf scaling, i.e. replace tf with 1 + log(tf).
+
+        norm : {'l1', 'l2'} or None, default='l2'
+            Norm used to normalize term vectors.
+
+        Returns
+        -------
+        X : sparse matrix of shape (n_samples, n_features)
+            The TF-IDF weighted matrix.
+        """
+        if not sp.issparse(X):
+            X = sp.csr_matrix(X, dtype=X.dtype)
+
+        if sublinear_tf:
+            np.log(X.data, X.data)
+            X.data += 1.0
+
+        if idf is not None:
+            X.data *= idf[X.indices]
+
+        if norm is not None:
+            X = normalize(X, norm=norm, copy=False)
+
+        return X
+
