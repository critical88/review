+def score_estimator(estimator, X, y, **score_params):
+    """Compute score for an estimator using type-aware scoring delegation.
+
+    This function encapsulates the scoring logic for composite estimators,
+    implementing the Strategy pattern to select the appropriate metric
+    based on the estimator's type. It centralizes scoring logic that would
+    otherwise be duplicated across meta-estimators.
+
+    Parameters
+    ----------
+    estimator : estimator object
+        The estimator to score with.
+
+    X : array-like
+        Transformed data to score on.
+
+    y : array-like
+        True labels or target values.
+
+    **score_params : dict
+        Additional parameters to pass to the scoring method.
+
+    Returns
+    -------
+    score : float
+        The computed score.
+    """
+    from sklearn.utils._tags import _resolve_scoring_context
+
+    scoring_context = _resolve_scoring_context(estimator)
+    delegate = _get_pipeline_score_delegate(estimator, scoring_context)
+
+    if delegate is not None:
+        return delegate(X, y, **score_params)
+
+    return estimator.score(X, y, **score_params)
+
