+def _compute_scatter_eig(cov_within, cov_total):
+    """Eigendecomposition of between-class scatter relative to within-class scatter.
+
+    Parameters
+    ----------
+    cov_within : ndarray of shape (n_features, n_features)
+        Within-class covariance matrix.
+
+    cov_total : ndarray of shape (n_features, n_features)
+        Total covariance matrix.
+
+    Returns
+    -------
+    evals : ndarray of shape (n_features,)
+        Eigenvalues in descending order.
+
+    evecs : ndarray of shape (n_features, n_features)
+        Eigenvectors ordered by descending eigenvalue.
+    """
+    between_scatter = cov_total - cov_within
+    evals, evecs = linalg.eigh(between_scatter, cov_within)
+    desc_order = np.argsort(evals)[::-1]
+    return evals[desc_order], evecs[:, desc_order]
+
