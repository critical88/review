+    def _apply_tfidf_weighting(self, X, idf, sublinear_tf, norm):
+        """Apply TF-IDF weighting to a term-frequency matrix.
+
+        Parameters
+        ----------
+        X : sparse matrix of shape (n_samples, n_features)
+            A matrix of term/token counts or frequencies (CSR format).
+
+        idf : ndarray of shape (n_features,), default=None
+            Precomputed IDF weights. If None, no IDF weighting is applied.
+
+        sublinear_tf : bool, default=False
+            Apply sublinear tf scaling, i.e. replace tf with 1 + log(tf).
+
+        norm : {'l1', 'l2'} or None, default='l2'
+            Norm used to normalize term vectors.
+
+        Returns
+        -------
+        X : sparse matrix of shape (n_samples, n_features)
+            The TF-IDF weighted matrix.
+        """
+        if not sp.issparse(X):
+            X = sp.csr_matrix(X, dtype=X.dtype)
+
+        if sublinear_tf:
+            np.log(X.data, X.data)
+            X.data += 1.0
+
+        if idf is not None:
+            X.data *= idf[X.indices]
+
+        if norm is not None:
+            X = normalize(X, norm=norm, copy=False)
+
+        return X
+
