+    def _compute_idf_weights(self, X, smooth_idf):
+        """Compute inverse document frequency weights from a count matrix.
+
+        Parameters
+        ----------
+        X : sparse matrix of shape (n_samples, n_features)
+            A matrix of term/token counts.
+
+        smooth_idf : bool, default=True
+            Smooth idf weights by adding one to document frequencies.
+
+        Returns
+        -------
+        idf : ndarray of shape (n_features,)
+            The inverse document frequency vector.
+        """
+        if not sp.issparse(X):
+            X = sp.csr_matrix(X)
+        dtype = X.dtype if X.dtype in (np.float64, np.float32) else np.float64
+
+        n_samples, _ = X.shape
+        df = _document_frequency(X)
+        df = df.astype(dtype, copy=False)
+
+        df += float(smooth_idf)
+        n_samples += int(smooth_idf)
+
+        idf = np.full_like(df, fill_value=n_samples, dtype=dtype)
+        idf /= df
+        np.log(idf, out=idf)
+        idf += 1.0
+
+        return idf
 
         return self
 
