+def _resolve_scoring_context(estimator):
+    """Resolve scoring context from estimator tags for composite estimators.
+
+    This implements the Strategy pattern for scoring delegation in
+    meta-estimators. The scoring context determines which metric function
+    and prediction method should be used based on the estimator type tags.
+
+    Parameters
+    ----------
+    estimator : estimator object
+        The estimator to resolve scoring context for.
+
+    Returns
+    -------
+    context : dict
+        A dictionary with keys:
+        - 'estimator_type': str or None
+        - 'uses_predict': bool, whether scoring requires predict output
+        - 'scoring_config': dict, additional config from the estimator
+    """
+    tags = get_tags(estimator)
+    context = {
+        "estimator_type": tags.estimator_type,
+        "uses_predict": tags.estimator_type in ("classifier", "regressor"),
+    }
+    if hasattr(estimator, "_scoring_config"):
+        context["scoring_config"] = estimator._scoring_config
+    else:
+        context["scoring_config"] = {}
+    return context
