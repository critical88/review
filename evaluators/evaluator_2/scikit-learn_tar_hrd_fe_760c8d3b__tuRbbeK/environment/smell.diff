+_SCORING_DELEGATES = {
+    "classifier": {
+        "metric_func": lambda: accuracy_score,
+        "response_method": "predict",
+    },
+    "regressor": {
+        "metric_func": lambda: r2_score,
+        "response_method": "predict",
+    },
+}
+
