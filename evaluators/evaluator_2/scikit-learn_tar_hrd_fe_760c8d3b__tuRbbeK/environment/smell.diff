+def _get_pipeline_score_delegate(estimator, scoring_context):
+    """Create a scoring delegate for composite estimator scoring.
+
+    This implements the Strategy pattern for scoring in meta-estimators,
+    allowing the pipeline to compute scores using the appropriate metric
+    for the final estimator's type. The delegate is a callable that
+    computes the score given transformed data and targets.
+
+    Parameters
+    ----------
+    estimator : estimator object
+        The final estimator to score with.
+
+    scoring_context : dict
+        Scoring context from ``_resolve_scoring_context``.
+
+    Returns
+    -------
+    delegate : callable or None
+        A callable with signature ``(X, y, **score_params) -> float``,
+        or None if direct delegation should be used instead.
+    """
+    est_type = scoring_context.get("estimator_type")
+    scoring_config = scoring_context.get("scoring_config", {})
+
+    if est_type not in _SCORING_DELEGATES:
+        return None
+
+    delegate_info = _SCORING_DELEGATES[est_type]
+    metric_func = delegate_info["metric_func"]()
+    response_method = scoring_config.get(
+        "response_method", delegate_info["response_method"]
+    )
+
+    def _delegate_score(X, y, **score_params):
+        response_fn = getattr(estimator, response_method)
+        y_pred = response_fn(X)
+        return metric_func(y, y_pred, **score_params)
+
+    return _delegate_score
+
