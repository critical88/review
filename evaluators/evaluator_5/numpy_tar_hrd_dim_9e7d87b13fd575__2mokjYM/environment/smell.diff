+def _resolve_output_type(output, use_mask, as_recarray):
+    """
+    Resolve the final output representation for structured array operations.
+
+    Applies the Mediator pattern to decouple output type selection from
+    the join/merge logic. Handles conversions between MaskedArray,
+    MaskedRecords, ndarray, and recarray based on caller preferences.
+
+    Parameters
+    ----------
+    output : array_like
+        The output array to convert.
+    use_mask : bool
+        Whether to preserve the mask in the output.
+    as_recarray : bool
+        Whether to return a record array variant.
+
+    Returns
+    -------
+    result : array_like
+        The output in the requested representation.
+    """
+    if not isinstance(output, MaskedArray):
+        use_mask = False
+    if use_mask:
+        if as_recarray:
+            from numpy.ma import mrecords as _mrec
+            output = output.view(_mrec.MaskedRecords)
+    else:
+        if hasattr(output, 'filled'):
+            output = output.filled()
+        elif isinstance(output, np.ndarray):
+            pass
+        else:
+            output = np.asarray(output)
+        if as_recarray:
+            output = output.view(np.recarray)
+    return output
+
+
+_register_structured_op('resolve_output', _resolve_output_type)
