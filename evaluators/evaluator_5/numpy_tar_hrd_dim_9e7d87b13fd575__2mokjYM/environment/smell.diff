+def _compute_field_overlap_for_merge(dt_left, dt_right, key_fields=None):
+    """
+    Compute field overlap statistics between two structured dtypes.
+
+    Analyzes which fields are shared, unique to each side, and which
+    have type conflicts. This is used as a pre-merge diagnostic to
+    determine the appropriate merge strategy.
+
+    Unlike the field merging in join operations, this function only
+    computes statistics without modifying any descriptors. Each phase
+    delegates to the appropriate dtype introspection utility.
+
+    Parameters
+    ----------
+    dt_left, dt_right : dtype
+        Structured dtypes to compare.
+    key_fields : set or None
+        If provided, fields in this set are treated as join keys
+        and excluded from collision analysis.
+
+    Returns
+    -------
+    overlap : dict
+        Dictionary with keys 'shared', 'left_only', 'right_only',
+        'type_conflicts', and 'key_overlap'.
+    """
+    if key_fields is None:
+        key_fields = set()
+
+    left_names = set(dt_left.names) if dt_left.names else set()
+    right_names = set(dt_right.names) if dt_right.names else set()
+
+    shared = left_names & right_names
+    non_key_shared = shared - key_fields
+    key_overlap = shared & key_fields
+
+    type_conflicts = []
+    for field_name in non_key_shared:
+        ld = dt_left.fields[field_name][0]
+        rd = dt_right.fields[field_name][0]
+        if ld != rd:
+            type_conflicts.append((field_name, ld, rd))
+
+    return {
+        'shared': non_key_shared,
+        'left_only': left_names - right_names,
+        'right_only': right_names - left_names,
+        'type_conflicts': type_conflicts,
+        'key_overlap': key_overlap,
+    }
+
