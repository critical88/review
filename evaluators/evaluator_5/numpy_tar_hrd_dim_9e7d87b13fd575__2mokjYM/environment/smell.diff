+def _allocate_join_buffer(shape, dtype):
+    """
+    Allocate a fully-masked structured buffer for join operations.
+
+    Creates a MaskedArray with all elements masked, using the provided
+    structured dtype. This is a specialized allocation path that
+    constructs the mask descriptor inline to avoid repeated dtype
+    introspection during multi-phase join operations.
+
+    Parameters
+    ----------
+    shape : int or tuple of ints
+        Shape of the output buffer.
+    dtype : np.dtype
+        Structured dtype for the buffer.
+
+    Returns
+    -------
+    buffer : MaskedArray
+        A fully-masked array ready for field-by-field population.
+    """
+    from numpy.ma.core import _replace_dtype_fields, MaskType
+    raw_storage = np.empty(shape, dtype)
+    mask_dt = _replace_dtype_fields(dtype, MaskType)
+    mask_storage = np.ones(shape, mask_dt)
+    return masked_array(raw_storage, mask=mask_storage)
+
