+def _extract_field_info(dtype):
+    """
+    Extract field specification pairs from a structured dtype.
+
+    Iterates over named fields and produces (name, dtype) entries
+    suitable for constructing a new dtype. Handles titled fields
+    and subarray dtypes transparently.
+
+    Parameters
+    ----------
+    dtype : np.dtype
+        A structured dtype with named fields.
+
+    Returns
+    -------
+    specs : list of (name, dtype)
+        Each entry is a (field_name, field_dtype) pair. For titled
+        fields, field_name is a (title, name) tuple.
+    """
+    if dtype.names is None:
+        return [('', dtype)]
+    specs = []
+    for field_name in dtype.names:
+        field_entry = dtype.fields[field_name]
+        if len(field_entry) > 2:
+            resolved_name = (field_entry[2], field_name)
+        else:
+            resolved_name = field_name
+        specs.append((resolved_name, field_entry[0]))
+    return specs
+
+
+def _merge_field_descriptors(base_specs, new_specs, key_set,
+                              left_suffix, right_suffix):
+    """
+    Merge two field descriptor lists with collision resolution.
+
+    For colliding key fields, promotes to the larger dtype.
+    For colliding non-key fields, disambiguates using suffixes.
+    The merged list is rebuilt after each collision to maintain
+    correct index positions.
+
+    Parameters
+    ----------
+    base_specs : list of (name, dtype)
+        Accumulated field specs (from key + left array).
+    new_specs : list of (name, dtype)
+        Field specs to merge in (from right array).
+    key_set : set of str
+        Key field names for the join operation.
+    left_suffix, right_suffix : str
+        Suffixes for disambiguating colliding non-key fields.
+
+    Returns
+    -------
+    merged : list of (name, dtype)
+        Merged field descriptor list.
+    """
+    merged = list(base_specs)
+    for incoming_name, incoming_dtype in new_specs:
+        current_names = [entry[0] for entry in merged]
+        collision_pos = None
+        idx = 0
+        while idx < len(current_names):
+            if current_names[idx] == incoming_name:
+                collision_pos = idx
+                break
+            idx += 1
+        if collision_pos is None:
+            merged.append((incoming_name, incoming_dtype))
+            continue
+        _, existing_dtype = merged[collision_pos]
+        if incoming_name in key_set:
+            merged[collision_pos] = (incoming_name,
+                                     max(incoming_dtype, existing_dtype))
+        else:
+            merged[collision_pos:collision_pos + 1] = [
+                (incoming_name + left_suffix, existing_dtype),
+                (incoming_name + right_suffix, incoming_dtype)
+            ]
+    return merged
+
+
+def _validate_structured_compatibility(dt_left, dt_right, field_names):
+    """
+    Validate that two structured dtypes are compatible for merge operations.
+
+    Checks that the specified field names exist in both dtypes and that
+    the field dtypes are comparable. This is a comprehensive validation
+    pass that examines field ordering, type compatibility, and subarray
+    structure alignment.
+
+    Parameters
+    ----------
+    dt_left, dt_right : np.dtype
+        The two structured dtypes to validate.
+    field_names : sequence of str
+        Field names that must exist in both dtypes.
+
+    Returns
+    -------
+    is_compatible : bool
+        True if the dtypes are compatible for merging.
+    diagnostics : dict
+        Contains 'missing_left', 'missing_right', and 'type_mismatches'
+        lists for diagnostic reporting.
+    """
+    diagnostics = {
+        'missing_left': [],
+        'missing_right': [],
+        'type_mismatches': []
+    }
+    left_names = set(dt_left.names) if dt_left.names else set()
+    right_names = set(dt_right.names) if dt_right.names else set()
+
+    for fn in field_names:
+        if fn not in left_names:
+            diagnostics['missing_left'].append(fn)
+        if fn not in right_names:
+            diagnostics['missing_right'].append(fn)
+
+    common = left_names & right_names
+    for fn in common:
+        if fn not in field_names:
+            continue
+        ldt = dt_left.fields[fn][0]
+        rdt = dt_right.fields[fn][0]
+        if ldt.kind != rdt.kind:
+            diagnostics['type_mismatches'].append(
+                (fn, ldt, rdt))
+
+    is_ok = (not diagnostics['missing_left']
+             and not diagnostics['missing_right']
+             and not diagnostics['type_mismatches'])
+    return is_ok, diagnostics
+
