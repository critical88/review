+def resolve_combine_column_dtype(
+    series,
+    other_series,
+    col,
+    self_columns,
+):
+    """
+    Determine the target dtype for a column during DataFrame.combine and
+    cast both series to the resolved dtype.
+
+    This centralizes the dtype negotiation logic for combine operations,
+    handling the special case where a column only exists in the `other`
+    DataFrame (in which case we attempt to promote the NaN-filled series
+    to the other's dtype) as well as the common case where both DataFrames
+    contain the column (in which case we find the common dtype).
+
+    Parameters
+    ----------
+    series : Series
+        Column data from the aligned `self` DataFrame.
+    other_series : Series
+        Column data from the aligned `other` DataFrame.
+    col : Hashable
+        The column label being processed.
+    self_columns : Index
+        The original (pre-alignment) column index of the `self` DataFrame.
+
+    Returns
+    -------
+    tuple[Series, Series, DtypeObj]
+        The (possibly cast) series, other_series, and the resolved dtype.
+    """
+    this_dtype = series.dtype
+    other_dtype = other_series.dtype
+
+    if col not in self_columns:
+        # Column only exists in `other` — try to promote the NaN series
+        new_dtype = other_dtype
+        try:
+            series = series.astype(new_dtype, copy=False)
+        except ValueError:
+            pass
+    else:
+        new_dtype = find_common_type([this_dtype, other_dtype])
+        series = series.astype(new_dtype, copy=False)
+        other_series = other_series.astype(new_dtype, copy=False)
+
+    return series, other_series, new_dtype
