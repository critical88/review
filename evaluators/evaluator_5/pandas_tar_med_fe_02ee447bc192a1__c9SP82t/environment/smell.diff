+def prepare_combine_series_pair(
+    this_col,
+    other_col,
+    fill_value,
+    overwrite,
+):
+    """
+    Prepare a pair of aligned column Series for a combine operation by
+    computing NA masks, applying fill values, and checking whether the
+    column should be skipped (kept from the left DataFrame unchanged).
+
+    Parameters
+    ----------
+    this_col : Series
+        Column from the aligned `self` DataFrame.
+    other_col : Series
+        Column from the aligned `other` DataFrame.
+    fill_value : scalar or None
+        Value to fill NaNs with before applying the combine function.
+        If None, no filling is performed.
+    overwrite : bool
+        If False, columns where `other_col` is entirely NA will be
+        preserved from `this_col` rather than being combined.
+
+    Returns
+    -------
+    tuple[Series, Series, bool]
+        The (possibly filled) this_col, other_col, and a boolean
+        ``skip`` flag.  When ``skip`` is True the caller should use
+        `this_col` directly as the result for this column.
+    """
+    from pandas.core.dtypes.missing import isna
+
+    this_mask = isna(this_col)
+    other_mask = isna(other_col)
+
+    # If overwrite=False and the other column is entirely NA,
+    # the caller should keep the original column.
+    if not overwrite and other_mask.all():
+        return this_col.copy(), other_col, True
+
+    do_fill = fill_value is not None
+    if do_fill:
+        this_col = this_col.copy()
+        other_col = other_col.copy()
+        this_col[this_mask] = fill_value
+        other_col[other_mask] = fill_value
+
+    return this_col, other_col, False
