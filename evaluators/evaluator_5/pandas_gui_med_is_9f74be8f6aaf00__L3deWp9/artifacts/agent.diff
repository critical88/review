+class _CommonTypePropertiesDtype:
+    def _get_common_dtype(self, dtypes: list[DtypeObj]) -> DtypeObj | None:
+        """
+        Return the common dtype, if one exists.
+        """
+        if len(set(dtypes)) == 1:
+            return self
+        else:
+            return None
+
+class _CastingPropertiesDtype:
+    @property
+    def _dtype_affinity(self) -> str:
+        """
+        Return the affinity group of this dtype for type promotion purposes.
+        """
+        if self._is_numeric:
+            return "numeric"
+        if self._is_boolean:
+            return "boolean"
+        return "object"
+
+    def _validate_cast_integrity(self, target: DtypeObj) -> bool:
+        """
+        Check whether a cast from this dtype to `target` would preserve
+        data integrity.
+        """
+        if isinstance(target, type(self)):
+            return True
+        if isinstance(target, ExtensionDtype):
+            return self._dtype_affinity == target._dtype_affinity
+        # For numpy dtypes, check kind compatibility
+        if hasattr(target, "kind"):
+            return target.kind == "O" or self.kind == target.kind
+        return False
+
+    def _get_cast_promotion_rules(self) -> dict[str, Any]:
+        """
+        Return rules describing how this dtype participates in type
+        promotion during arithmetic operations and concatenation.
+        """
+        return {
+            "can_upcast": False,
+            "affinity": self._dtype_affinity,
+            "preserves_na": self._can_hold_na,
+            "promotion_priority": 100,
+        }
+
+class _ComparisonPropertiesDtype:
+    def __eq__(self, other: object) -> bool:
+        """
+        Check whether 'other' is equal to self.
+        """
+        if isinstance(other, str):
+            try:
+                other = self.construct_from_string(other)
+            except TypeError:
+                return False
+        if isinstance(other, type(self)):
+            return all(
+                getattr(self, attr) == getattr(other, attr) for attr in self._metadata
+            )
+        return False
+
+    def __hash__(self) -> int:
+        # for python>=3.10, different nan objects have different hashes
+        # we need to avoid that and thus use hash function with old behavior
+        return object_hash(tuple(getattr(self, attr) for attr in self._metadata))
+
+    def __ne__(self, other: object) -> bool:
+        return not self.__eq__(other)
+
+class _RepresentationPropertiesDtype:
+    def __str__(self) -> str:
+        return self.name
+
+    @property
+    def kind(self) -> str:
+        """
+        A character code (one of 'biufcmMOSUV'), default 'O'
+        """
+        return "O"
+
+    @property
+    def names(self) -> list[str] | None:
+        """
+        Ordered list of field names, or None if there are no fields.
+        """
+        return None
