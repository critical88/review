@@ -2752,6 +2752,34 @@ def extend_all(module):
 from .numerictypes import *
 from .umath import *
 
+from .printoptions import (
+    resolve_float_rendering as _resolve_float_rendering,
+    resolve_layout as _resolve_layout,
+)
+
+
+def _get_display_config(precision=None, floatmode=None, suppress=None,
+                        sign=None, linewidth=None, edgeitems=None,
+                        threshold=None):
+    """Resolve display configuration parameters from individual overrides.
+
+    This provides a unified way to resolve print configuration when
+    individual parameters are passed as overrides (e.g., from array2string
+    keyword arguments). Each parameter group is resolved independently.
+    """
+    p, fm, s, sgn = _resolve_float_rendering(precision, floatmode,
+                                              suppress, sign)
+    lw, ei, th = _resolve_layout(linewidth, edgeitems, threshold)
+    return {
+        'precision': p,
+        'floatmode': fm,
+        'suppress': s,
+        'sign': sgn,
+        'linewidth': lw,
+        'edgeitems': ei,
+        'threshold': th,
+    }
+
 extend_all(fromnumeric)
 extend_all(umath)
 extend_all(numerictypes)
