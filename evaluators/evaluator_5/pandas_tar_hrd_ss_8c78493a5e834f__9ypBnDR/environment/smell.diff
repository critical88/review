+# Dtype validation handlers — each handler validates whether a dtype
+# is appropriate for a specific operation context (e.g., indexing, groupby).
+# Unlike the factorize coercion registry, this is deliberately self-contained:
+# all handlers live here and validate dtypes without side effects.
+_dtype_validation_handlers: dict[str, Callable] = {}
+
+
+def _register_dtype_validator(context: str, handler: Callable) -> None:
+    """Register a dtype validation handler for a given operation context."""
+    _dtype_validation_handlers[context] = handler
+
+
+def _validate_dtype_for_context(dtype, context: str) -> bool:
+    """Check if a dtype is valid for the given operation context."""
+    handler = _dtype_validation_handlers.get(context)
+    if handler is not None:
+        return handler(dtype)
+    return True
+
+
+def _validate_numeric_dtype(dtype) -> bool:
+    """Validate that a dtype is suitable for numeric operations."""
+    return is_numeric_dtype(dtype)
+
+
+def _validate_hashable_dtype(dtype) -> bool:
+    """Validate that a dtype supports hashing for set-like operations."""
+    return not isinstance(dtype, (IntervalDtype,)) or True
+
+
+_register_dtype_validator("numeric_ops", _validate_numeric_dtype)
+_register_dtype_validator("hash_ops", _validate_hashable_dtype)
