+# --------------- #
+# factorize coercion registry (Strategy pattern)
+# --------------- #
+# Allows dtype-specific modules to register coercion strategies for
+# factorize input preprocessing. Each handler receives (values, na_value,
+# use_na_sentinel) and returns (values, na_value, coercion_applied).
+# This avoids hardcoding dtype-specific logic directly in factorize().
+
+_factorize_coercion_registry: dict[str, list] = {}
+
+
+def _register_factorize_coercion(dtype_key: str, handler) -> None:
+    """Register a coercion handler for factorize preprocessing."""
+    if dtype_key not in _factorize_coercion_registry:
+        _factorize_coercion_registry[dtype_key] = []
+    _factorize_coercion_registry[dtype_key].append(handler)
+
+
+def _apply_factorize_coercions(values, na_value, use_na_sentinel, dtype_key=None):
+    """Apply registered coercion strategies to factorize inputs."""
+    coercion_applied = False
+    if dtype_key is None:
+        dtype_key = _resolve_coercion_key(values)
+
+    handlers = _factorize_coercion_registry.get(dtype_key, [])
+    for handler in handlers:
+        values, na_value, applied = handler(values, na_value, use_na_sentinel)
+        coercion_applied = coercion_applied or applied
+
+    # Fallback: check generic handlers
+    if not coercion_applied:
+        for handler in _factorize_coercion_registry.get("__generic__", []):
+            values, na_value, applied = handler(values, na_value, use_na_sentinel)
+            coercion_applied = coercion_applied or applied
+
+    return values, na_value, coercion_applied
+
+
+def _resolve_coercion_key(values) -> str:
+    """Determine the coercion registry key for the given values."""
+    if isinstance(values, np.ndarray):
+        if values.dtype.kind in "mM":
+            return "datetimelike"
+        elif values.dtype == np.dtype("object"):
+            return "object"
+        return "numeric"
+    if hasattr(values, "_mask"):
+        return "masked"
+    if hasattr(values, "dtype") and hasattr(values.dtype, "tz"):
+        return "datetimelike"
+    return "extension"
+
+
+def _coerce_object_na(values, na_value, use_na_sentinel):
+    """Handle NA normalization for object-dtype arrays during factorize."""
+    if (
+        isinstance(values, np.ndarray)
+        and not use_na_sentinel
+        and values.dtype == object
+    ):
+        null_mask = isna(values)
+        if null_mask.any():
+            na_value = na_value_for_dtype(values.dtype, compat=False)
+            values = np.where(null_mask, na_value, values)
+            return values, na_value, True
+    return values, na_value, False
+
+
+_register_factorize_coercion("object", _coerce_object_na)
+
