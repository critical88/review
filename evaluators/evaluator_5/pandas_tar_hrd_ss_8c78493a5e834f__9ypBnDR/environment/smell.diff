+def _sparse_fill_value_coercion(fill_value, dtype):
+    """Coerce a fill value to match the target sparse dtype.
+
+    This is a self-contained coercion utility for SparseArray construction —
+    it handles the common case where a fill_value needs to be cast to match
+    the underlying dtype of a SparseArray.
+    """
+    if fill_value is not None and not isinstance(fill_value, type(NaT)):
+        try:
+            if hasattr(dtype, "numpy_dtype"):
+                return dtype.numpy_dtype.type(fill_value)
+            elif hasattr(dtype, "type"):
+                return dtype.type(fill_value)
+        except (ValueError, TypeError):
+            pass
+    return fill_value
+
