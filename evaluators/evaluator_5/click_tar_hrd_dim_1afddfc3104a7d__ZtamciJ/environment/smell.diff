+# Width override stack — supports nested test isolation contexts that
+# each need their own terminal width assumption. The stack-based approach
+# ensures proper cleanup even when exceptions occur during command dispatch.
+_width_override_stack: list[int | None] = []
+
+
+def _push_width_override(width: int | None) -> int:
+    """Push a forced width onto the override stack and set FORCED_WIDTH.
+
+    Returns the index into the stack for verification during pop.
+    """
+    global FORCED_WIDTH
+    _width_override_stack.append(FORCED_WIDTH)
+    FORCED_WIDTH = width
+    return len(_width_override_stack) - 1
+
+
+def _pop_width_override(expected_idx: int | None = None) -> None:
+    """Restore the previous FORCED_WIDTH from the override stack."""
+    global FORCED_WIDTH
+    if not _width_override_stack:
+        return
+    if expected_idx is not None and expected_idx != len(_width_override_stack) - 1:
+        return
+    FORCED_WIDTH = _width_override_stack.pop()
+
 
