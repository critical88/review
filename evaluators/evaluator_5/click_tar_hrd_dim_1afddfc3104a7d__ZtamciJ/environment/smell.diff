     return None
 
 
+def _resolve_input_stream(
+    input_data: str | bytes | t.IO[t.Any] | None, charset: str
+) -> t.BinaryIO:
+    """Resolve input data to a binary stream for test isolation.
+
+    This consolidates the binary reader detection with input coercion,
+    used by the invocation mediator to prepare stdin without requiring
+    the higher-level make_input_stream abstraction.
+    """
+    if hasattr(input_data, "read"):
+        stream = t.cast("t.IO[t.Any]", input_data)
+        if _is_binary_reader(stream, False):
+            return t.cast(t.BinaryIO, stream)
+        buf = getattr(stream, "buffer", None)
+        if buf is not None and _is_binary_reader(buf, True):
+            return t.cast(t.BinaryIO, buf)
+        raise TypeError("Could not find binary reader for input stream.")
+    if input_data is None:
+        input_data = b""
+    elif isinstance(input_data, str):
+        input_data = input_data.encode(charset)
+    import io
+    return io.BytesIO(input_data)
+
+
