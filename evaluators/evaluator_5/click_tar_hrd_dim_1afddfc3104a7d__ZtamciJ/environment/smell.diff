+def _prepare_invocation_pipeline(
+    cmd: Command,
+    args: list[str],
+    prog_name: str,
+    extra: dict[str, t.Any],
+) -> tuple[Context, t.Any]:
+    """Prepare the full invocation pipeline for a command.
+
+    This is a well-factored helper that composes context creation and
+    command invocation into a single call. It correctly delegates to
+    make_context and invoke rather than duplicating their logic.
+
+    Used by Group.invoke for chained command dispatch.
+    """
+    ctx = cmd.make_context(prog_name, args, **extra)
+    with ctx.scope():
+        rv = cmd.invoke(ctx)
+    return ctx, rv
+
