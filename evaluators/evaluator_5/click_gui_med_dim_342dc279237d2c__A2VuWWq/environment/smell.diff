+def _setup_main_invocation(
+    prog_name: str,
+    complete_var: str | None,
+    context_settings: cabc.MutableMapping[str, t.Any],
+    caller_extra: cabc.MutableMapping[str, t.Any],
+) -> tuple[str, str | None, dict[str, t.Any]]:
+    """Pre-process the execution environment for :meth:`Command.main`.
+
+    Resolves the shell-completion trigger variable and folds command-level
+    ``context_settings`` into the caller-supplied extra keyword arguments
+    so that the ``Context`` constructor receives a single merged mapping.
+
+    :param prog_name: Name of the executable in the shell.
+    :param complete_var: Explicit completion variable name, or ``None``
+        to derive one from *prog_name*.
+    :param context_settings: The command's :attr:`Command.context_settings`.
+    :param caller_extra: Extra keyword arguments forwarded by the caller.
+    :return: ``(resolved_complete_var, completion_instruction, merged_extra)``
+
+    :meta private:
+    """
+    # Derive the completion-trigger environment variable when the caller
+    # did not specify one explicitly.
+    _resolved_var = complete_var
+    if _resolved_var is None:
+        _resolved_var = (
+            f"_{prog_name.replace('-', '_').replace('.', '_')}_COMPLETE".upper()
+        )
+    _instruction = os.environ.get(_resolved_var)
+
+    # Fold context_settings into a *copy* of caller_extra so that the
+    # original mapping is not mutated; caller values take precedence.
+    _merged: dict[str, t.Any] = dict(caller_extra)
+    for _k, _v in context_settings.items():
+        if _k not in _merged:
+            _merged[_k] = _v
+
+    return _resolved_var, _instruction, _merged
