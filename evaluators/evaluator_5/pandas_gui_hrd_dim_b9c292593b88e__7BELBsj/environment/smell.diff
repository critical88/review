+class RangeResolutionContext:
+    """
+    Encapsulates range computation state for the Template Method pattern used
+    by DatetimeArray and TimedeltaArray range generators.
+
+    The resolve/compute split allows subclasses to customize bound resolution
+    while reusing overflow-safe arithmetic.
+    """
+
+    __slots__ = ["_start_val", "_end_val", "_stride", "_periods", "_unit"]
+
+    def __init__(self, unit: str = "ns"):
+        self._start_val: int | None = None
+        self._end_val: int | None = None
+        self._stride: int = 0
+        self._periods: int | None = None
+        self._unit = unit
+
+    def resolve_stride(self, freq: BaseOffset) -> int:
+        freq.nanos
+        td = Timedelta(freq)
+        try:
+            td = td.as_unit(self._unit, round_ok=False)
+        except ValueError as err:
+            raise ValueError(
+                f"freq={freq} is incompatible with unit={self._unit}. "
+                "Use a lower freq or a higher unit instead."
+            ) from err
+        self._stride = int(td._value)
+        return self._stride
+
+    def compute_overflow_safe_end(
+        self, endpoint: int, periods: int, stride: int, side: str = "start"
+    ) -> int:
+        return _generate_range_overflow_safe(endpoint, periods, stride, side)
+
+    def compute_signed_end(
+        self, endpoint: int, periods: int, stride: int, side: str
+    ) -> int:
+        return _generate_range_overflow_safe_signed(endpoint, periods, stride, side)
+
+
+def resolve_range_bounds(
+    istart: int | None,
+    iend: int | None,
+    periods: int | None,
+    stride: int,
+) -> tuple[int, int]:
+    """
+    Determine the integer start/end bounds for np.arange, handling the
+    three valid combinations of (start, end, periods).
+    """
+    if periods is None and istart is not None and iend is not None:
+        b = istart
+        e = b + (iend - b) // stride * stride + stride // 2 + 1
+    elif istart is not None and periods is not None:
+        b = istart
+        e = _generate_range_overflow_safe(b, periods, stride, side="start")
+    elif iend is not None and periods is not None:
+        e = iend + stride
+        b = _generate_range_overflow_safe(e, periods, stride, side="end")
+    else:
+        raise ValueError(
+            "at least 'start' or 'end' should be specified if a 'period' is given."
+        )
+    return b, e
+
