+def prepare_period_context(
+    periods: int | float | None,
+    start,
+    end,
+    freq,
+) -> tuple:
+    """
+    Validate the periods parameter and verify that exactly three of
+    (start, end, periods, freq) are specified. Returns the validated
+    periods value and a flag indicating whether freq was provided.
+
+    This is the first phase of the two-phase range initialization
+    pattern: prepare_period_context (validate) -> generate (compute).
+    """
+    validated_periods = validate_periods(periods)
+
+    if freq is None and any(x is None for x in [validated_periods, start, end]):
+        raise ValueError("Must provide freq argument if no data is supplied")
+
+    from pandas.core.common import count_not_none
+
+    if count_not_none(start, end, validated_periods, freq) != 3:
+        raise ValueError(
+            "Of the four parameters: start, end, periods, "
+            "and freq, exactly three must be specified"
+        )
+    return validated_periods, freq is not None
