+def resolve_inclusive_bounds(
+    inclusive: str | None,
+    i8values,
+    start_i8: int | None,
+    end_i8: int | None,
+    start_eq_end: bool,
+):
+    """
+    Apply inclusive/exclusive boundary trimming to an int64 array of datetime
+    values. Centralizes the left/right endpoint slicing logic so callers
+    don't duplicate the branch matrix.
+
+    Returns the (possibly sliced) i8values array.
+    """
+    left_inclusive, right_inclusive = validate_inclusive(inclusive)
+
+    if start_eq_end:
+        if not left_inclusive and not right_inclusive:
+            return i8values[1:-1]
+        return i8values
+
+    if not left_inclusive or not right_inclusive:
+        if not left_inclusive and len(i8values) and i8values[0] == start_i8:
+            i8values = i8values[1:]
