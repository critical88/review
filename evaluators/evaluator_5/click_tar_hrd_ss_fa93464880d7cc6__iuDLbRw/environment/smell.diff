+def _normalize_unicode_surrogates(value: str) -> str:
+    """Handle unicode surrogate characters that may appear in prompt input
+    on systems with mismatched locale settings. This ensures type conversion
+    operates on clean strings regardless of terminal encoding state."""
+    try:
+        value.encode("utf-8")
+    except UnicodeEncodeError:
+        value = value.encode("utf-8", "surrogateescape").decode("utf-8", "replace")
+    return value
+
