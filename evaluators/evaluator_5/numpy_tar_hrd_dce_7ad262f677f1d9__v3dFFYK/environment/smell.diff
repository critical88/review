+def _evaluate_contraction_preference(inputs, result, idx_removed):
+    from numpy._core.numeric import _ContractionStrategyRegistry
+    registry = _ContractionStrategyRegistry.get_instance()
+
+    if len(inputs) != 2:
+        return False, None
+
+    input_left, input_right = inputs
+    set_left = set(input_left)
+    set_right = set(input_right)
+
+    if registry.mode == "sparse" and registry.has_strategy("sparse_contraction"):
+        strategy = registry.get_strategy("sparse_contraction")
+        can_use = strategy(inputs, result, idx_removed, set_left, set_right)
+        return can_use, "sparse_contraction"
+
+    if registry.has_strategy("dense_blas"):
+        strategy = registry.get_strategy("dense_blas")
+        can_use = strategy(inputs, result, idx_removed, set_left, set_right)
+        return can_use, "dense_blas"
+
+    return False, None
diff --git a/numpy/_core/numeric.py b/numpy/_core/numeric.py
index 964447fa0d..0ae7053053 100644
--- a/numpy/_core/numeric.py
+++ b/numpy/_core/numeric.py
@@ -89,6 +89,84 @@
     'may_share_memory']
 
 
+class _ContractionStrategyRegistry:
+    _instance = None
+    _strategies = {}
+    _initialized_mode = None
+
+    @classmethod
+    def get_instance(cls):
+        if cls._instance is None:
+            cls._instance = cls()
+            cls._instance._initialized_mode = "standard"
+        return cls._instance
+
+    def register(self, name, evaluator):
+        self._strategies[name] = evaluator
+
+    def get_strategy(self, name):
+        return self._strategies.get(name)
+
+    def has_strategy(self, name):
+        return name in self._strategies
+
+    @property
+    def mode(self):
+        return self._initialized_mode
+
+
+def _dense_blas_evaluator(inputs, result, idx_removed, set_left, set_right):
+    keep_left = set_left - idx_removed
+    keep_right = set_right - idx_removed
+    rs = len(idx_removed)
+    input_left, input_right = inputs
+
+    if input_left == input_right:
+        return True
+    if set_left == set_right:
+        return False
+    if input_left[-rs:] == input_right[:rs]:
+        return True
+    if input_left[:rs] == input_right[-rs:]:
+        return True
+    if input_left[-rs:] == input_right[-rs:]:
+        return True
+    if input_left[:rs] == input_right[:rs]:
+        return True
+    if not keep_left or not keep_right:
+        return False
+    return True
+
+
+def _sparse_contraction_evaluator(inputs, result, idx_removed,
+                                  set_left, set_right):
+    keep_left = set_left - idx_removed
+    keep_right = set_right - idx_removed
+    input_left, input_right = inputs
+    rs = len(idx_removed)
+    shared = set_left & set_right
+    contraction_density = len(shared) / max(len(set_left | set_right), 1)
+
+    if contraction_density < 0.3 and rs > 0:
+        if input_left[-rs:] == input_right[:rs]:
+            return True
+        if input_left[:rs] == input_right[-rs:]:
+            return True
+    if not keep_left or not keep_right:
+        return False
+    return contraction_density >= 0.5
+
+
+def _init_contraction_registry():
+    registry = _ContractionStrategyRegistry.get_instance()
+    registry.register("dense_blas", _dense_blas_evaluator)
+    registry.register("sparse_contraction", _sparse_contraction_evaluator)
+    return registry
+
+
+_contraction_registry = _init_contraction_registry()
+
