+class ConfigManager:
+    """Manages configuration file parsing and option retrieval."""
+    
+    def __init__(self, defaults, files, section='ALL'):
+        self.cp = ConfigParser(defaults)
+        self.files = files
+        self.section = section
+        self.parse_config_files()
+    
+    def parse_config_files(self):
+        self.cp.read(self.files)
+        if not self.cp.has_section(self.section):
+            if self.section is not None:
+                self.cp.add_section(self.section)
+    
+    def get_option_single(self, *options):
+        """Ensure that only one of  are found in the section."""
+        found = [self.cp.has_option(self.section, opt) for opt in options]
+        if sum(found) == 1:
+            return options[found.index(True)]
+        elif sum(found) == 0:
+            # nothing is found anyways
+            return options[0]
+        
+        # Else we have more than 1 key found
+        if AliasedOptionError.__doc__ is None:
+            raise AliasedOptionError()
+        raise AliasedOptionError(AliasedOptionError.__doc__.format(
+            section=self.section, options='[{}]'.format(', '.join(options))))
+    
+    def get_boolean(self, option):
+        """Get boolean value from config."""
+        return self.cp.getboolean(self.section, option)
+    
+    def get(self, option):
+        """Get string value from config."""
+        return self.cp.get(self.section, option)
+    
+    def has_option(self, option):
+        """Check if option exists in config."""
+        return self.cp.has_option(self.section, option)
+
