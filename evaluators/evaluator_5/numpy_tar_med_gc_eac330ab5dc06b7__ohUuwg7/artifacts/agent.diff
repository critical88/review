+class PathManager:
+    """Manages path resolution and environment variable handling."""
+    
+    def __init__(self, config_manager, dir_env_var=None):
+        self.config_manager = config_manager
+        self.dir_env_var = dir_env_var
+    
+    def get_paths(self, key):
+        """Get paths for a given key, handling environment variables."""
+        dirs = self.config_manager.get(key).split(os.pathsep)
+        
+        env_var = self.dir_env_var
+        if env_var:
+            if is_sequence(env_var):
+                e0 = env_var[-1]
+                for e in env_var:
+                    if e in os.environ:
+                        e0 = e
+                        break
+                if not env_var[0] == e0:
+                    log.info('Setting %s=%s' % (env_var[0], e0))
+                env_var = e0
+            
+            if env_var and env_var in os.environ:
+                d = os.environ[env_var]
+                if d == 'None':
+                    log.info('Disabled: (%s is None)' % (env_var,))
+                    return []
+                if os.path.isfile(d):
+                    dirs = [os.path.dirname(d)] + dirs
+                else:
+                    ds = d.split(os.pathsep)
+                    ds2 = []
+                    for d in ds:
+                        if os.path.isdir(d):
+                            ds2.append(d)
+                            for dd in ['include', 'lib']:
+                                d1 = os.path.join(d, dd)
+                                if os.path.isdir(d1):
+                                    ds2.append(d1)
+                    dirs = ds2 + dirs
+        
+        # Filter out invalid directories and duplicates
+        ret = []
+        for d in dirs:
+            if len(d) > 0 and not os.path.isdir(d):
+                warnings.warn('Specified path %s is invalid.' % d, stacklevel=2)
+                continue
+            
+            if d not in ret:
+                ret.append(d)
+        
+        log.debug('( %s = %s )', key, ':'.join(ret))
+        return ret
+
