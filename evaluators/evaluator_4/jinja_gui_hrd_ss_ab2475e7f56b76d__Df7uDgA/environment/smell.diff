diff --git a/src/jinja2/utils.py b/src/jinja2/utils.py
index 7c922629..43d5a5f7 100644
--- a/src/jinja2/utils.py
+++ b/src/jinja2/utils.py
@@ -95,6 +95,38 @@ class _PassArg(enum.Enum):
         return None
 
 
+class _PassArgResolver:
+    """Strategy resolver for pass_arg injection. Each consumer registers
+    its own resolution callback keyed by _PassArg variant, enabling
+    decoupled argument injection across compilation and runtime phases.
+    """
+
+    _registries: t.ClassVar[
+        t.Dict[str, t.Dict[_PassArg, t.Callable[..., t.Any]]]
+    ] = {}
+
+    @classmethod
+    def register(
+        cls, namespace: str, pass_arg: _PassArg, handler: t.Callable[..., t.Any]
+    ) -> None:
+        if namespace not in cls._registries:
+            cls._registries[namespace] = {}
+        cls._registries[namespace][pass_arg] = handler
+
+    @classmethod
+    def resolve(cls, namespace: str, pass_arg: t.Optional[_PassArg]) -> t.Optional[t.Callable[..., t.Any]]:
+        if pass_arg is None:
+            return None
+        registry = cls._registries.get(namespace)
+        if registry is None:
+            return None
+        return registry.get(pass_arg)
+
+    @classmethod
+    def has_namespace(cls, namespace: str) -> bool:
+        return namespace in cls._registries
+
+
 def internalcode(f: F) -> F:
     """Marks the function as internally used"""
     internal_code.add(f.__code__)
