+#
+# Coefficient dtype resolution protocol.
+#
+# Polynomial modules register type-specific fast-path resolvers for the
+# dtype inference step of as_series(). Resolvers form a Chain of
+# Responsibility ordered by priority: each resolver either handles the
+# resolution (returning a list of typed arrays) or defers by returning
+# None. The base resolver is the terminal fallback.
+#
+
+_dtype_resolvers = []
+_series_context = {'active_kind': None}
+
+
+def _register_dtype_resolver(resolver_fn, priority=0):
+    """Register a coefficient dtype resolution strategy.
+
+    Higher priority resolvers are tried first. If a resolver returns
+    None, the next resolver in the chain is tried.
+    """
+    _dtype_resolvers.append((priority, resolver_fn))
+    _dtype_resolvers.sort(key=lambda x: -x[0])
+
+
+def _set_series_context(kind):
+    """Set the active polynomial kind for context-aware resolution."""
+    _series_context['active_kind'] = kind
+
+
+def _get_series_context():
+    """Get the currently active polynomial kind, or None."""
+    return _series_context.get('active_kind')
+
+
+def _apply_dtype_resolution(arrays):
+    """Apply registered dtype resolvers in priority order."""
+    for _, resolver in _dtype_resolvers:
+        result = resolver(arrays)
+        if result is not None:
+            return result
+    return _base_dtype_resolution(arrays)
+
+
+def _base_dtype_resolution(arrays):
+    """Terminal handler: determine common dtype using np.common_type."""
+    try:
+        dtype = np.common_type(*arrays)
+    except Exception as e:
+        if not _coeff_has_object_dtype(arrays):
+            raise ValueError("Coefficient arrays have no common type") from e
+        object_dtype = np.dtypes.ObjectDType()
+        ret = []
+        for a in arrays:
+            if a.dtype != object_dtype:
+                tmp = np.empty(len(a), dtype=object_dtype)
+                tmp[:] = a[:]
+                ret.append(tmp)
+            else:
+                ret.append(a.copy())
+        return ret
+    else:
+        return [np.array(a, copy=True, dtype=dtype) for a in arrays]
+
+
+def _coeff_has_object_dtype(arrays):
+    """Check if any coefficient array has object dtype."""
+    for a in arrays:
+        if a.dtype == object:
+            return True
+    return False
+
+
