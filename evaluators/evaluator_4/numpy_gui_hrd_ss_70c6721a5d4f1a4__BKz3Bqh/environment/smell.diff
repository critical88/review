+def _herm_dtype_resolver(arrays):
+    """Hermite coefficient dtype fast path.
+
+    For the physicists' Hermite basis, coefficients with uniform floating
+    dtype (any precision ≤ 64-bit) can skip generic type negotiation.
+    """
+    context = pu._get_series_context()
+    if context is not None and context != 'H':
+        return None
+    if not arrays:
+        return None
+    dtype0 = arrays[0].dtype
+    if dtype0.kind in ('f', 'c') and dtype0.itemsize <= 8:
+        if all(a.dtype == dtype0 for a in arrays):
+            return [a.copy() for a in arrays]
+    return None
+
+
+pu._register_dtype_resolver(_herm_dtype_resolver, priority=12)
