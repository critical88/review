+def _unified_dtype_resolver(arrays, context):
+    """Unified dtype resolver for all polynomial types.
+    
+    Replaces the previous chain-of-responsibility pattern with a single
+    function that handles all polynomial types based on context.
+    """
+    if not arrays:
+        return None
+    
+    # Handle based on context (polynomial type)
+    if context == 'T':  # Chebyshev
+        # Chebyshev: uniform float64 coefficient arrays
+        if all(a.dtype == np.float64 for a in arrays):
+            return [a.copy() for a in arrays]
+    
+    elif context == 'H':  # Hermite
+        # Hermite: uniform floating/complex dtype (any precision ≤ 64-bit)
+        dtype0 = arrays[0].dtype
+        if dtype0.kind in ('f', 'c') and dtype0.itemsize <= 8:
+            if all(a.dtype == dtype0 for a in arrays):
+                return [a.copy() for a in arrays]
+    
+    elif context == 'P':  # Legendre
+        # Legendre: uniform complex128 coefficient arrays
+        if all(a.dtype == np.complex128 for a in arrays):
+            return [a.copy() for a in arrays]
+    
+    elif context == 'L':  # Laguerre
+        # Laguerre: integer coefficient arrays -> promote to float64
+        if all(a.dtype.kind == 'i' for a in arrays):
+            return [np.array(a, copy=True, dtype=np.float64) for a in arrays]
+    
+    elif context == 'He':  # HermiteE
+        # HermiteE: no special handling, fall through to base resolution
+        pass
+    
+    elif context is None:  # Standard polynomial or no context
+        # Standard polynomial: single array with floating/complex dtype
+        if len(arrays) == 1:
+            a = arrays[0]
+            if a.dtype.kind in ('f', 'c'):
+                return [a.copy()]
+    
