+def _parse_path_type(optimize):
+    """
+    Parse and validate the optimize parameter for einsum_path.
+    
+    Parameters
+    ----------
+    optimize : {bool, list, tuple, 'greedy', 'optimal'}
+        The optimization parameter passed to einsum_path.
+        
+    Returns
+    -------
+    path_type : str or bool
+        The parsed path type.
+    explicit_einsum_path : bool
+        Whether an explicit einsum path was provided.
+    memory_limit : int or None
+        The memory limit if specified.
+        
+    Raises
+    ------
+    TypeError
+        If the path type is not understood.
+    """
+    path_type = optimize
+    if path_type is True:
+        path_type = 'greedy'
+    if path_type is None:
+        path_type = False
+
+    explicit_einsum_path = False
+    memory_limit = None
+
+    # No optimization or a named path algorithm
+    if (path_type is False) or isinstance(path_type, str):
+        pass
+
+    # Given an explicit path
+    elif len(path_type) and (path_type[0] == 'einsum_path'):
+        explicit_einsum_path = True
+
+    # Path tuple with memory limit
+    elif ((len(path_type) == 2) and isinstance(path_type[0], str) and
+            isinstance(path_type[1], (int, float))):
+        memory_limit = int(path_type[1])
+        path_type = path_type[0]
+
+    else:
+        raise TypeError(f"Did not understand the path: {str(path_type)}")
+        
+    return path_type, explicit_einsum_path, memory_limit
+
+
+def _build_dimension_dict(input_list, operands):
+    """
+    Build dimension dictionary and broadcast indices from input operands.
+    
+    Parameters
+    ----------
+    input_list : list of str
+        List of input subscript strings.
+    operands : list of array_like
+        The operands for the einsum operation.
+        
+    Returns
+    -------
+    dimension_dict : dict
+        Dictionary mapping index characters to their sizes.
+    broadcast_indices : list of sets
+        List of sets containing broadcast indices for each operand.
+        
+    Raises
+    ------
+    ValueError
+        If operand shapes don't match their subscripts or if dimension
+        sizes are inconsistent.
+    """
+    dimension_dict = {}
+    broadcast_indices = [[] for x in range(len(input_list))]
+    
+    for term_idx, term in enumerate(input_list):
+        sh = operands[term_idx].shape
+        if len(sh) != len(term):
+            raise ValueError("Einstein sum subscript %s does not contain the "
+                             "correct number of indices for operand %d."
+                             % (term, term_idx))
+        for char_idx, char in enumerate(term):
+            dim = sh[char_idx]
+
+            # Build out broadcast indices
+            if dim == 1:
+                broadcast_indices[term_idx].append(char)
+
+            if char in dimension_dict.keys():
+                # For broadcasting cases we always want the largest dim size
+                if dimension_dict[char] == 1:
+                    dimension_dict[char] = dim
+                elif dim not in (1, dimension_dict[char]):
+                    raise ValueError("Size of label '%s' for operand %d (%d) "
+                                     "does not match previous terms (%d)."
+                                     % (char, term_idx, dimension_dict[char], dim))
+            else:
+                dimension_dict[char] = dim
+                
+    # Convert broadcast inds to sets
+    broadcast_indices = [set(x) for x in broadcast_indices]
+    
+    return dimension_dict, broadcast_indices
+
+
+def _compute_naive_cost(input_sets, indices, dimension_dict, input_list):
+    """
+    Compute the naive FLOP cost for the einsum contraction.
+    
+    Parameters
+    ----------
+    input_sets : list of sets
+        List of sets representing the indices of each input.
+    indices : set
+        Set of all unique indices in the contraction.
+    dimension_dict : dict
+        Dictionary mapping index characters to their sizes.
+    input_list : list of str
+        List of input subscript strings.
+        
+    Returns
+    -------
+    naive_cost : int
+        The naive FLOP count for the contraction.
+    """
+    inner_product = (sum(len(x) for x in input_sets) - len(indices)) > 0
+    naive_overall_size = 1
+    for i in indices:
+        naive_overall_size *= dimension_dict[i]
+    naive_op_factor = max(1, len(input_list) - 1)
+    if inner_product:
+        naive_op_factor += 1
+    return naive_overall_size * naive_op_factor
+
+
+def _build_contraction_info(contract_inds, input_sets, output_set, dimension_dict,
+                           input_list, broadcast_indices, output_subscript):
+    """
+    Build contraction information for a single contraction step.
+    
+    Parameters
+    ----------
+    contract_inds : tuple of int
+        Indices of the tensors to contract.
+    input_sets : list of sets
+        List of sets representing the indices of each input.
+    output_set : set
+        Set of output indices.
+    dimension_dict : dict
+        Dictionary mapping index characters to their sizes.
+    input_list : list of str
+        List of input subscript strings.
+    broadcast_indices : list of sets
+        List of sets containing broadcast indices for each operand.
+    output_subscript : str
+        Output subscript string.
+        
+    Returns
+    -------
+    contraction_info : tuple
+        Tuple containing (cost, scale, size, contraction_tuple)
+        where contraction_tuple is (contract_inds, idx_removed, einsum_str, 
+        new_input_list, do_blas)
+    new_input_sets : list of sets
+        Updated input sets after contraction.
+    new_input_list : list of str
+        Updated input list after contraction.
+    new_broadcast_indices : list of sets
+        Updated broadcast indices after contraction.
+    """
+    # Make sure we remove inds from right to left
+    contract_inds = tuple(sorted(contract_inds, reverse=True))
+
+    # Compute contraction result, remaining sets, and removed indices
+    idx_contract = set()
+    idx_remain = output_set.copy()
+    remaining = []
+    for ind, value in enumerate(input_sets):
+        if ind in contract_inds:
+            idx_contract |= value
+        else:
+            remaining.append(value)
+            idx_remain |= value
+    out_inds = idx_remain & idx_contract
+    idx_removed = (idx_contract - out_inds)
+    remaining.append(out_inds)
+    new_input_sets = remaining
+
+    # Compute contraction FLOP cost
+    contract_size = 1
+    for i in idx_contract:
+        contract_size *= dimension_dict[i]
+    contract_op_factor = max(1, len(contract_inds) - 1)
+    if idx_removed:
+        contract_op_factor += 1
+    cost = contract_size * contract_op_factor
+
+    scale = len(idx_contract)
+    size = _accumulate_index_product(out_inds, dimension_dict)
+
+    bcast = set()
+    tmp_inputs = []
+    for x in contract_inds:
+        tmp_inputs.append(input_list.pop(x))
+        bcast |= broadcast_indices.pop(x)
+
+    new_bcast_inds = bcast - idx_removed
+
+    # Determine if BLAS can be used for this contraction
+    if not len(idx_removed & bcast):
+        if len(idx_removed) == 0 or len(tmp_inputs) != 2:
+            do_blas = False
+        else:
+            input_left, input_right = tmp_inputs
+            blas_eligible = _validate_blas_operands(
+                input_left, input_right, out_inds
+            )
+            if not blas_eligible:
+                do_blas = False
+            else:
+                set_left = set(input_left)
+                set_right = set(input_right)
+                keep_left = set_left - idx_removed
+                keep_right = set_right - idx_removed
+                rs = len(idx_removed)
+
+                if input_left == input_right:
+                    do_blas = True
+                elif set_left == set_right:
+                    do_blas = False
+                elif input_left[-rs:] == input_right[:rs]:
+                    do_blas = True
+                elif input_left[:rs] == input_right[-rs:]:
+                    do_blas = True
+                elif input_left[-rs:] == input_right[-rs:]:
+                    do_blas = True
+                elif input_left[:rs] == input_right[:rs]:
+                    do_blas = True
+                elif not keep_left or not keep_right:
+                    do_blas = False
+                else:
+                    do_blas = True
+    else:
+        do_blas = False
+
+    # Last contraction
+    if len(new_input_sets) == 1:  # This is the last contraction
+        idx_result = output_subscript
+    else:
+        sort_result = [(dimension_dict[ind], ind) for ind in out_inds]
+        idx_result = "".join([x[1] for x in sorted(sort_result)])
+
+    new_input_list = input_list[:]  # Copy the current input_list
+    new_input_list.append(idx_result)
+    new_broadcast_indices = broadcast_indices[:]  # Copy current broadcast_indices
+    new_broadcast_indices.append(new_bcast_inds)
+    
+    einsum_str = ",".join(tmp_inputs) + "->" + idx_result
+
+    contraction_tuple = (
+        contract_inds, idx_removed, einsum_str, new_input_list[:], do_blas
+    )
+    
+    return (cost, scale, size, contraction_tuple), new_input_sets, new_input_list, new_broadcast_indices
+
