+def _format_path_output(overall_contraction, indices, scale_list, naive_cost, 
+                       opt_cost, size_list, contraction_list, output_subscript):
+    """
+    Format the path output string for einsum_path.
+    
+    Parameters
+    ----------
+    overall_contraction : str
+        The complete contraction string.
+    indices : set
+        Set of all unique indices.
+    scale_list : list of int
+        List of scaling factors for each contraction.
+    naive_cost : float
+        Naive FLOP count.
+    opt_cost : float
+        Optimized FLOP count.
+    size_list : list of int
+        List of intermediate sizes.
+    contraction_list : list of tuples
+        List of contraction tuples.
+    output_subscript : str
+        Output subscript string.
+        
+    Returns
+    -------
+    path_print : str
+        Formatted string representation of the path.
+    """
+    header = ("scaling", "current", "remaining")
+
+    speedup = naive_cost / opt_cost
+    max_i = max(size_list)
+
+    path_print = f"  Complete contraction:  {overall_contraction}\n"
+    path_print += f"         Naive scaling:  {len(indices)}\n"
+    path_print += "     Optimized scaling:  %d\n" % max(scale_list)
+    path_print += f"      Naive FLOP count:  {naive_cost:.3e}\n"
+    path_print += f"  Optimized FLOP count:  {opt_cost:.3e}\n"
+    path_print += f"   Theoretical speedup:  {speedup:3.3f}\n"
+    path_print += f"  Largest intermediate:  {max_i:.3e} elements\n"
+    path_print += "-" * 74 + "\n"
+    path_print += "%6s %24s %40s\n" % header
+    path_print += "-" * 74
+
+    for n, contraction in enumerate(contraction_list):
+        inds, idx_rm, einsum_str, remaining, blas = contraction
+        remaining_str = ",".join(remaining) + "->" + output_subscript
+        path_run = (scale_list[n], einsum_str, remaining_str)
+        path_print += "\n%4d    %24s %40s" % path_run
+        
+    return path_print
+
