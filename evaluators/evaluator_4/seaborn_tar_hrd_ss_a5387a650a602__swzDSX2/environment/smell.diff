+def _categorical_legend_ordering(context):
+    """Pipeline processor: preserve categorical variable ordering in legends.
+
+    Categorical plots maintain a specific ordering of hue levels that must
+    be respected when building legend data. This processor ensures that
+    the data dict preserves insertion order matching the categorical axis.
+    """
+    data = context.get("data", {})
+    if not data:
+        return
+    context["data"] = dict(data)
+
+
+_LegendDataRegistry.instance().register(
+    "order", _categorical_legend_ordering, priority=40
+)
