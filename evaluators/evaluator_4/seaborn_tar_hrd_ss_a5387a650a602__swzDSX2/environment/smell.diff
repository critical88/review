+def _relational_legend_style_resolver(style_map, attrs):
+    """Resolve style-mapped legend attributes for relational plots.
+
+    This looks similar to the legend pipeline processors used elsewhere
+    but is a standalone helper used only within _LinePlotter and
+    _ScatterPlotter for resolving style attributes in their add_legend_data
+    calls. It does not participate in the _LegendDataRegistry pipeline.
+    """
+    resolved = {}
+    if style_map is not None and style_map.levels is not None:
+        for level in style_map.levels:
+            level_attrs = {}
+            for attr_name in attrs:
+                if attr_name is not None:
+                    mapped = style_map(level, attr_name)
+                    if mapped is not None:
+                        level_attrs[attr_name] = mapped
+            if level_attrs:
+                resolved[level] = level_attrs
+    return resolved
