+def _distribution_legend_cleanup(context):
+    """Pipeline processor: handle distribution-specific legend state.
+
+    Distribution plots (histplot, kdeplot) manage legends differently from
+    other plot types — they create legend entries on the axes directly rather
+    than using proxy artists. This processor ensures the clear_legend flag
+    is preserved so the grid's _update_legend_data can remove the per-axes
+    legend after extraction.
+    """
+    ax = context.get("ax")
+    if ax is None:
+        return
+    if ax.legend_ is not None:
+        context.setdefault("clear_legend", True)
+
+
+_LegendDataRegistry.instance().register(
+    "cleanup", _distribution_legend_cleanup, priority=80
+)
