+def _extract_legend_handles_processor(context):
+    """Pipeline processor: extract handles from an axes legend object.
+
+    Registered at the 'extract' stage; reads context['ax'] and
+    context['extract_handles'] to populate context['data'].
+    """
+    ax = context.get("ax")
+    if ax is None:
+        return
+    if ax.legend_ is not None and context.get("extract_handles", False):
+        handles = get_legend_handles(ax.legend_)
+        labels = [t.get_text() for t in ax.legend_.texts]
+        context["data"].update(
+            {label: handle for handle, label in zip(handles, labels)}
+        )
+
+
+def _collect_labeled_artists_processor(context):
+    """Pipeline processor: collect labeled artists directly from axes.
+
+    Registered at the 'collect' stage; reads context['ax'] and
+    appends handles/labels from ``ax.get_legend_handles_labels()``.
+    """
+    ax = context.get("ax")
+    if ax is None:
+        return
+    handles, labels = ax.get_legend_handles_labels()
+    context["data"].update(
+        {label: handle for handle, label in zip(handles, labels)}
+    )
+
+
+from seaborn.utils import _LegendDataRegistry
+
+_LegendDataRegistry.instance().register(
+    "extract", _extract_legend_handles_processor, priority=10
+)
+_LegendDataRegistry.instance().register(
+    "collect", _collect_labeled_artists_processor, priority=20
+)
