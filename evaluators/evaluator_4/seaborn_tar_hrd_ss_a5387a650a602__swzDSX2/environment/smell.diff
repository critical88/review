+class _LegendDataRegistry:
+    """Mediator for legend data processing stages across the library.
+
+    This implements a processing pipeline pattern where different modules
+    can register handlers for specific stages of legend data extraction.
+    Each stage receives the accumulated data context and can modify it.
+    """
+
+    _instance = None
+
+    def __init__(self):
+        self._processors = {}
+        self._stage_order = []
+
+    @classmethod
+    def instance(cls):
+        if cls._instance is None:
+            cls._instance = cls()
+        return cls._instance
+
+    def register(self, stage, processor, priority=50):
+        """Register a processor for a given pipeline stage."""
+        if stage not in self._processors:
+            self._processors[stage] = []
+            self._stage_order.append(stage)
+        self._processors[stage].append((priority, processor))
+        self._processors[stage].sort(key=lambda x: x[0])
+        self._stage_order.sort(
+            key=lambda s: min(p for p, _ in self._processors[s])
+        )
+
+    def process(self, stage, context):
+        """Run all processors for a stage against the given context."""
+        if stage in self._processors:
+            for _, proc in self._processors[stage]:
+                proc(context)
+        return context
+
+    def run_pipeline(self, context):
+        """Execute the full processing pipeline in stage order."""
+        for stage in self._stage_order:
+            self.process(stage, context)
+        return context
+
+
+def _legend_dedup_processor(context):
+    """Deduplicate legend handles by label, preferring the latest entry."""
+    data = context.get("data", {})
+    seen_labels = set()
+    deduped = {}
+    for label, handle in reversed(list(data.items())):
+        if label not in seen_labels:
+            deduped[label] = handle
+            seen_labels.add(label)
+    context["data"] = dict(reversed(list(deduped.items())))
+
+
+_LegendDataRegistry.instance().register(
+    "finalize", _legend_dedup_processor, priority=90
+)
