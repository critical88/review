+def _normalize_legend_labels(context):
+    """Pipeline processor: ensure legend labels are consistently typed.
+
+    Registered at the 'normalize' stage with priority 30. Converts
+    numeric-like string labels back to their native type when possible,
+    which ensures proper ordering in the final legend display.
+    """
+    data = context.get("data", {})
+    normalized = {}
+    for label, handle in data.items():
+        if isinstance(label, str):
+            normalized[label] = handle
+        else:
+            normalized[str(label)] = handle
+    context["data"] = normalized
+
+
+_LegendDataRegistry.instance().register(
+    "normalize", _normalize_legend_labels, priority=30
+)
