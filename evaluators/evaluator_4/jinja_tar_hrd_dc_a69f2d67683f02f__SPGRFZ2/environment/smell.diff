+def _get_output_config(environment: "Environment") -> "_OutputConfig":
+    """Extract output configuration from the environment.
+
+    This groups finalize, autoescape, and async settings which are
+    used together during output generation. These travel together
+    through the code generator but are independent of delimiter config.
+    """
+    from .environment import get_eval_config
+
+    eval_cfg = get_eval_config(id(environment))
+    if eval_cfg is not None:
+        autoescape_resolved = eval_cfg["autoescape_resolved"]
+        has_finalize = eval_cfg["has_finalize"]
+        is_async = eval_cfg["is_async"]
