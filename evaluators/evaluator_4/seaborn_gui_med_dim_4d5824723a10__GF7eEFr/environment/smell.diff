@@ -7,12 +7,41 @@ import pandas as pd
 
 from seaborn._core.rules import categorical_order
 
+import numpy as np
+
 from typing import TYPE_CHECKING
 if TYPE_CHECKING:
     from typing import Callable
     from pandas import DataFrame, MultiIndex, Index
 
 
+def filter_subplot_rows(df: "DataFrame", subplot: dict) -> "DataFrame":
+    """Filter dataframe rows to those matching a subplot's facet dimensions."""
+    facet_dims = df.columns.intersection(["col", "row"])
+    if facet_dims.empty:
+        return df
+    mask = pd.Series(True, df.index, dtype=bool)
+    for dim in facet_dims:
+        mask &= df[dim] == subplot[dim]
+    return df[mask]
+
+
+def resolve_split_keys(view: dict) -> dict:
+    """Extract subplot key mapping from a view specification."""
+    keys = {}
+    for dim in ["col", "row"]:
+        if view[dim] is not None:
+            keys[dim] = view[dim]
+    return keys
+
+
+def mask_inf_values(df: "DataFrame") -> "DataFrame":
+    """Replace infinite values with NaN in a dataframe copy."""
+    result = df.copy()
+    result = result.mask(result.isin([np.inf, -np.inf]), np.nan)
+    return result
+
+
