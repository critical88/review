diff --git a/src/jinja2/utils.py b/src/jinja2/utils.py
index 7c922629..571aa261 100644
--- a/src/jinja2/utils.py
+++ b/src/jinja2/utils.py
@@ -95,6 +95,30 @@ class _PassArg(enum.Enum):
         return None
 
 
+_block_render_registry: t.Dict[str, t.Callable[..., str]] = {}
+
+
+def register_block_renderer(mode: str) -> t.Callable[[F], F]:
+    def decorator(fn: F) -> F:
+        _block_render_registry[mode] = fn
+        return fn
+    return decorator
+
+
+def get_block_renderer(mode: str) -> t.Optional[t.Callable[..., str]]:
+    return _block_render_registry.get(mode)
+
+
+@register_block_renderer("escape")
+def _block_render_escape(value: str, markup_cls: t.Any) -> str:
+    return markup_cls(value)
+
+
+@register_block_renderer("raw")
+def _block_render_raw(value: str, markup_cls: t.Any) -> str:
+    return value
+
+
 def internalcode(f: F) -> F:
     """Marks the function as internally used"""
     internal_code.add(f.__code__)
