+    hue: Optional[VariableSpec] = None
+    col_wrap: Optional[int] = None
+    dropna: bool = False
+    
+    @classmethod
+    def from_params(
+        cls,
+        row: Optional[str] = None,
+        col: Optional[str] = None,
+        hue: Optional[str] = None,
+        row_order: Optional[List] = None,
+        col_order: Optional[List] = None,
+        hue_order: Optional[List] = None,
+        col_wrap: Optional[int] = None,
+        dropna: bool = False,
+    ) -> "FacetConfig":
+        """Create FacetConfig from individual parameters."""
+        return cls(
+            row=VariableSpec(row, row_order) if row is not None else None,
+            col=VariableSpec(col, col_order) if col is not None else None,
+            hue=VariableSpec(hue, hue_order) if hue is not None else None,
+            col_wrap=col_wrap,
+            dropna=dropna,
+        )
+
+
