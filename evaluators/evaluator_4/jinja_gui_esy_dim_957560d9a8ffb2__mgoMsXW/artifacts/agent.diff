+    def _emit_loads(self, frame: Frame) -> None:
+        """Emit the common pattern for handling frame.symbols.loads.
+
+        This consolidates repeated inlined codepaths that set up local
+        variables for loads (resolve, alias, undefined) into a single
+        helper to reduce duplication and make maintenance easier.  The
+        helper preserves exact behavior and order of emission.
+        """
+        undefs: t.List[str] = []
         for target, (action, param) in frame.symbols.loads.items():
             if action == VAR_LOAD_PARAMETER:
+                # parameters are always provided at runtime; nothing to emit
                 pass
             elif action == VAR_LOAD_RESOLVE:
                 self.writeline(f"{target} = {self.get_resolve_func()}({param!r})")
