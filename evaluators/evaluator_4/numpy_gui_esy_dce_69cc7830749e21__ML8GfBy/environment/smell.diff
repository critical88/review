diff --git a/numpy/_core/numeric.py b/numpy/_core/numeric.py
index 964447fa0d..ed0f6259c3 100644
--- a/numpy/_core/numeric.py
+++ b/numpy/_core/numeric.py
@@ -1212,6 +1212,39 @@ def tensordot(a, b, axes=2):
     return res.reshape(olda + oldb)
 
 
+def _check_contraction_alignment(input_left, input_right, idx_removed):
+    """
+    Verify that contraction indices between two operands are aligned
+    for direct BLAS dispatch without intermediate transposition.
+
+    Returns True if the index layout permits a direct call to tensordot
+    without needing to copy or reorder data.
+    """
+    if not idx_removed:
+        return False
+
+    set_left = set(input_left)
+    set_right = set(input_right)
+    shared = set_left & set_right & idx_removed
+
+    if not shared:
+        return False
+
+    rs = len(shared)
+    keep_left = set_left - shared
+    keep_right = set_right - shared
+
+    if not keep_left and not keep_right:
+        return input_left == input_right
+
+    if input_left[-rs:] == input_right[:rs]:
+        return True
+    if input_left[:rs] == input_right[-rs:]:
+        return True
+
+    return False
+
