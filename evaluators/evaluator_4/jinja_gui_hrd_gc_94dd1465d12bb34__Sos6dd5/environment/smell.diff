+class TemplateRenderCoordinator:
+    """Coordinates rendering pipeline stages for template execution.
+
+    This follows the Mediator pattern to decouple template compilation
+    from rendering by providing a single coordination point for the
+    parse-compile-render pipeline.  Each stage is delegated to the
+    environment's own facilities rather than duplicating logic.
+    """
+
+    def __init__(self, environment: "Environment") -> None:
+        self._environment = environment
+
+    def prepare_source(
+        self, source: str, name: t.Optional[str], filename: t.Optional[str]
+    ) -> str:
+        return self._environment.preprocess(source, name, filename)
+
+    def compile_source(
+        self,
+        source: str,
+        name: t.Optional[str] = None,
+        filename: t.Optional[str] = None,
+    ) -> t.Any:
+        return self._environment.compile(source, name, filename)
+
+    def create_render_context(
+        self, template: "Template", vars: t.Optional[t.Dict[str, t.Any]] = None
+    ) -> Context:
+        return template.new_context(vars)
+
+    def render(
+        self, template: "Template", vars: t.Optional[t.Dict[str, t.Any]] = None
+    ) -> str:
+        ctx = self.create_render_context(template, vars)
+        return self._environment.concat(
+            template.root_render_func(ctx)
+        )
+
+
