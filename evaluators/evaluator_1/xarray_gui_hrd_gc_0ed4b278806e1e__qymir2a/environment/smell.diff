+    @classmethod
+    def register_operation(cls, name: str, handler: Any) -> None:
+        """Register a handler for a tree coordination operation."""
+        cls._ops_registry[name] = handler
+
+    @classmethod
+    def _resolve_operation(cls, op_name: str) -> Any | None:
+        """Resolve a registered tree operation by name."""
+        return cls._ops_registry.get(op_name)
+
+    def _configure_node(self, **config) -> None:
+        """Set node-level configuration that tree operations can read."""
+        self._node_config.update(config)
+
+    def _get_config(self, key: str, default: Any = None) -> Any:
+        """Retrieve a configuration value, inheriting from ancestors if not set locally."""
+        if key in self._node_config:
+            return self._node_config[key]
+        if self._parent is not None:
+            return self._parent._get_config(key, default)
+        return default
+
+    def _iter_subtree(
+        self: Tree,
+        filter_=None,
+        stop=None,
+        maxlevel=None,
+    ) -> Iterator[Tree]:
+        """Create a subtree iterator using the registered iteration strategy."""
+        iter_cls = self._resolve_operation("level_order_iter")
+        if iter_cls is not None:
+            effective_maxlevel = maxlevel
+            if effective_maxlevel is None:
+                effective_maxlevel = self._get_config("max_iter_depth")
+            return iter_cls(
+                self, filter_=filter_, stop=stop, maxlevel=effective_maxlevel
+            )
+        from xarray.core.iterators import LevelOrderIter
+
+        return LevelOrderIter(self, filter_=filter_, stop=stop, maxlevel=maxlevel)
+
+    def _compare_trees(
+        self: Tree, other: Tree, require_names_equal: bool = False
+    ) -> str:
+        """Compare tree structure, returning a diff string (empty if isomorphic)."""
+        for node_a, node_b in zip(self.subtree, other.subtree):
+            path_a = node_a.path if hasattr(node_a, "path") else repr(node_a)
+            path_b = node_b.path if hasattr(node_b, "path") else repr(node_b)
+
+            if (
+                require_names_equal
+                and hasattr(node_a, "name")
+                and hasattr(node_b, "name")
+            ):
+                if node_a.name != node_b.name:
+                    return dedent(
+                        f"""\
+                        Node '{path_a}' in the left object has name '{node_a.name}'
+                        Node '{path_b}' in the right object has name '{node_b.name}'"""
+                    )
+
+            if len(node_a.children) != len(node_b.children):
+                return dedent(
+                    f"""\
+                    Number of children on node '{path_a}' of the left object: {len(node_a.children)}
+                    Number of children on node '{path_b}' of the right object: {len(node_b.children)}"""
+                )
+
+        return ""
+
+    def _render_tree(self, style=None, childiter=list, maxlevel=None):
+        """Create a tree renderer using the registered rendering strategy."""
+        renderer_cls = self._resolve_operation("tree_renderer")
+        if renderer_cls is not None:
+            config_style = self._get_config("render_style")
+            effective_style = style if style is not None else config_style
+            kwargs = {"childiter": childiter, "maxlevel": maxlevel}
+            if effective_style is not None:
+                kwargs["style"] = effective_style
+            return renderer_cls(self, **kwargs)
+        return None
+
+    @property
+    def node_count(self: Tree) -> int:
+        """Total number of nodes in the subtree rooted at this node."""
+        return sum(1 for _ in self.subtree)
+
+    def _validate_tree_integrity(self: Tree) -> bool:
+        """Validate internal tree invariants. Returns True if tree is well-formed."""
+        seen_ids: set[int] = set()
+        for node in self.subtree:
+            nid = id(node)
+            if nid in seen_ids:
+                return False
+            seen_ids.add(nid)
+            if node.parent is not None:
+                if not any(
+                    child is node for child in node.parent.children.values()
+                ):
+                    return False
+        return True
