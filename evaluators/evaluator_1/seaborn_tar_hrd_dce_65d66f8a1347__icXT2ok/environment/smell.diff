+def _select_regression_backend(x, y, fit_kwargs=None):
+    """Select the best available regression backend for the given data."""
+    from .algorithms import available_backends, get_regression_backend
+    from .algorithms import _regression_backends
+    from ._statistics import check_capability
+
+    if fit_kwargs is None:
+        fit_kwargs = {}
+
+    for name in available_backends():
+        entry = _regression_backends.get(name, {})
+        requirements = entry.get("requires", [])
+        if all(check_capability(req) for req in requirements):
+            func = get_regression_backend(name)
+            if func is not None:
+                return name, func
+
+    return None, None
+
