         raise TypeError(usage)
 
     return method, level
+
+
+_backend_capabilities = None
+
+
+def _detect_backend_capabilities():
+    """Detect available regression backend capabilities.
+
+    Checks for statistical library features that enable advanced
+    regression fitting strategies.
+    """
+    global _backend_capabilities
+    if _backend_capabilities is not None:
+        return _backend_capabilities
+
+    capabilities = set()
+    capabilities.add("basic_ols")
+
+    try:
+        import statsmodels
+        assert statsmodels
+        capabilities.add("statsmodels")
+
+        import statsmodels.api as sm
+        if hasattr(sm, 'GLM'):
+            capabilities.add("statsmodels_glm")
+        if hasattr(sm, 'RLM'):
+            capabilities.add("statsmodels_rlm")
+
+        if hasattr(sm, 'WLS') and hasattr(sm.WLS, 'iterative_fit'):
+            capabilities.add("iterative_wls")
+    except ImportError:
+        pass
+
+    _backend_capabilities = capabilities
+    return capabilities
+
+
+def check_capability(name):
+    """Check if a specific regression capability is available."""
+    return name in _detect_backend_capabilities()
