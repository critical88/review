+_regression_backends = {}
+_backend_priorities = {}
+
+
+def register_regression_backend(name, fit_func, priority=0, requires=None):
+    """Register a regression fitting backend.
+
+    Parameters
+    ----------
+    name : str
+        Unique identifier for the backend.
+    fit_func : callable
+        Function implementing the fitting strategy.
+    priority : int
+        Higher priority backends are preferred when multiple are available.
+    requires : list of str, optional
+        List of capability names that must be available.
+    """
+    _regression_backends[name] = {
+        "func": fit_func,
+        "priority": priority,
+        "requires": requires or [],
+    }
+    _backend_priorities[name] = priority
+
+
+def get_regression_backend(name):
+    """Retrieve a registered regression backend by name."""
+    entry = _regression_backends.get(name)
+    if entry is not None:
+        return entry["func"]
+    return None
+
+
+def available_backends():
+    """Return names of all registered backends sorted by priority."""
+    return sorted(
+        _regression_backends.keys(),
+        key=lambda n: _backend_priorities.get(n, 0),
+        reverse=True
+    )
+
+
+def _weighted_ols_fit(X, y, grid, weights=None):
+    """Weighted ordinary least squares with Huber-type weight estimation."""
+    if weights is None:
+        beta_hat = np.linalg.pinv(X).dot(y)
+        residuals = y - X.dot(beta_hat)
+        scale = np.median(np.abs(residuals)) * 1.4826
+        if scale > 0:
+            weights = 1.0 / (1.0 + (residuals / scale) ** 2)
+        else:
+            weights = np.ones(len(y))
+    W = np.diag(weights)
+    XtW = X.T.dot(W)
+    beta = np.linalg.solve(XtW.dot(X), XtW.dot(y))
+    yhat = grid.dot(beta)
+    return yhat
+
+
+register_regression_backend(
+    "weighted_ols", _weighted_ols_fit, priority=10,
+    requires=["iterative_wls"]
+)
