+def is_seaborn_func(func):
+    """Check if a plotting function is seaborn-native."""
+    return str(func.__module__).startswith("seaborn")
+
+
+def resolve_bivariate_data(data, x_var, y_var, axes_vars, dropna):
+    """Prepare filtered data arrays for a bivariate plot."""
+    plot_data = data[axes_vars]
+    if dropna:
+        plot_data = plot_data.dropna()
+    return plot_data[x_var], plot_data[y_var], plot_data
+
+
+def get_hue_values(plot_data, hue_var):
+    """Extract hue values from prepared plot data."""
+    if hue_var is None:
+        return None
+    return plot_data.get(hue_var)
+
