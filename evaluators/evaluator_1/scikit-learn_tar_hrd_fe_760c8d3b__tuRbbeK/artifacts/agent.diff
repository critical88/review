+def compute_pipeline_score(estimator, X, y, **score_params):
+    """Compute a score for the final estimator of a pipeline.
+
+    This function centralizes the type-aware scoring strategy previously
+    replicated in :class:`Pipeline`. It resolves the scoring context from
+    the estimator's tags and delegates to an appropriate scoring function
+    when available. If no delegate is applicable, it falls back to the
+    estimator's own ``score`` method.
+
+    Parameters
+    ----------
+    estimator : estimator object
+        The final estimator to score.
+
+    X : array-like
+        Input data (already transformed by the pipeline).
+
+    y : array-like
+        True target values.
+
+    **score_params : dict
+        Additional keyword arguments forwarded to the scoring function.
+
+    Returns
+    -------
+    score : float
+        The computed score.
+    """
+    # Import locally to avoid circular imports at module import time.
+    from sklearn.utils._tags import _resolve_scoring_context
+
+    scoring_context = _resolve_scoring_context(estimator)
+    delegate = _get_pipeline_score_delegate(estimator, scoring_context)
+
+    if delegate is not None:
+        return delegate(X, y, **score_params)
+
+    return estimator.score(X, y, **score_params)
+
+
