+def _characteristic_length_scale(kernel, X=None):
+    """Compute characteristic length scale for a kernel-like object.
+
+    Prefer a kernel-provided method if available, otherwise fall back to the
+    historic heuristic based on a 'length_scale' parameter or the kernel
+    diagonal. This helper allows composed kernels to obtain a characteristic
+    scale without requiring every kernel subclass to implement the method.
+    """
+    if hasattr(kernel, "characteristic_length_scale"):
+        try:
+            return kernel.characteristic_length_scale(X)
+        except TypeError:
+            # Some kernels may define a characteristic_length_scale without
+            # accepting X. Defer to the kernel implementation if possible.
+            return kernel.characteristic_length_scale()
+
+    params = kernel.get_params()
+    for name, value in params.items():
+        if "length_scale" in name and not name.endswith("_bounds"):
+            return float(np.mean(np.atleast_1d(value)))
+    if X is not None:
+        diag_values = kernel.diag(X)
+        return float(np.sqrt(np.mean(np.abs(diag_values)) + 1e-12))
+    return 1.0
+
+
+def _smoothness_order(kernel):
+    """Return the smoothness order for a kernel-like object.
+
+    Try a kernel-provided method first; otherwise use a conservative default
+    based on stationarity.
+    """
+    if hasattr(kernel, "smoothness_order"):
+        return kernel.smoothness_order()
+    if kernel.is_stationary():
+        return 2.0
+    return 0.0
+
+
+def _suggested_regularization(kernel, X):
+    """Return a heuristic suggested regularization for a kernel-like object.
+
+    Prefer a kernel-provided value, otherwise compute a heuristic using the
+    kernel diagonal and the characteristic length scale.
+    """
+    if hasattr(kernel, "suggested_regularization"):
+        return kernel.suggested_regularization(X)
+    K_diag = kernel.diag(X)
+    n_samples = _num_samples(X)
+    diag_range = float(np.max(K_diag) - np.min(K_diag))
+    scale = _characteristic_length_scale(kernel, X)
+    return (diag_range + 1e-10) / (n_samples * scale**2 + 1.0)
+
+
