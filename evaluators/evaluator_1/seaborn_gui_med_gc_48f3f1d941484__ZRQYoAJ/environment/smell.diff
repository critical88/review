+def _resolve_letter_value_k(k_depth, n, outlier_prop, trust_alpha):
+    """Compute the number of letter value levels for a given sample size."""
+    if k_depth == "full":
+        k = int(np.log2(n)) + 1
+    elif k_depth == "tukey":
+        k = int(np.log2(n)) - 3
+    elif k_depth == "proportion":
+        k = int(np.log2(n)) - int(np.log2(n * outlier_prop)) + 1
+    elif k_depth == "trustworthy":
+        normal_quantile_func = np.vectorize(NormalDist().inv_cdf)
+        point_conf = 2 * normal_quantile_func(1 - trust_alpha / 2) ** 2
+        k = int(np.log2(n / point_conf)) + 1
+    else:
+        k = int(k_depth)
+
+    return max(k, 1)
+
