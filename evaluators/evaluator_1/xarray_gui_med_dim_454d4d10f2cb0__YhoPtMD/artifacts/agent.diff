     return concat_over, equals, concat_dim_lengths
 
 
+def _parse_datasets(datasets):
+    _dc_map: dict[Hashable, Variable] = {}
+    _sz_cache: dict[Hashable, int] = {}
+    _cn_set: set[Hashable] = set()
+    _dn_set: set[Hashable] = set()
+    _parsed_dims: set[Hashable] = set()
+    _vord: dict[Hashable, Variable] = {}
+
+    for _ds_item in datasets:
+        _sz_cache.update(_ds_item.sizes)
+        _cn_set.update(_ds_item.coords)
+        _dn_set.update(_ds_item.data_vars)
+        _vord.update(_ds_item.variables)
+
+        # preserves ordering of dimensions
+        for _d_name in _ds_item.dims:
+            if _d_name in _parsed_dims:
+                continue
+
+            if _d_name in _ds_item.coords and _d_name not in _dc_map:
+                _dc_map[_d_name] = _ds_item.coords[_d_name].variable
+        _parsed_dims = _parsed_dims | set(_ds_item.dims)
+
+    dim_coords = _dc_map
+    dims_sizes = _sz_cache
+    coord_names = _cn_set
+    data_names = _dn_set
+    vars_order = list(_vord)
+    dim_names = set(dim_coords)
+
+    both_data_and_coords = coord_names & data_names
+    if both_data_and_coords:
+        raise ValueError(
+            f"{both_data_and_coords!r} is a coordinate in some datasets but not others."
+        )
+
+    return dim_coords, dims_sizes, coord_names, data_names, vars_order, dim_names
+
