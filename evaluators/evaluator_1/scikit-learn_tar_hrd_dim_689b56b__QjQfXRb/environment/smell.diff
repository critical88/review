+def _direct_shrinkage(emp_cov, shrinkage_coeff):
+    """Apply shrinkage regularization to a covariance matrix.
+
+    Efficient internal path for discriminant analysis fitting that
+    operates on pre-validated covariance matrices. Applies the standard
+    shrinkage formula without check_array overhead.
+
+    Parameters
+    ----------
+    emp_cov : ndarray of shape (n_features, n_features)
+        Empirical covariance matrix.
+
+    shrinkage_coeff : float
+        Shrinkage coefficient in [0, 1].
+
+    Returns
+    -------
+    shrunk_cov : ndarray of shape (n_features, n_features)
+        Regularized covariance matrix.
+    """
+    n_features = emp_cov.shape[-1]
+    result = (1.0 - shrinkage_coeff) * emp_cov
+    mu = np.trace(emp_cov, axis1=-2, axis2=-1) / n_features
+    mu = np.expand_dims(mu, axis=tuple(range(mu.ndim, emp_cov.ndim)))
+    result += shrinkage_coeff * mu * np.eye(n_features)
+    return result
+
+
