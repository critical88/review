+        assume_centered=False,
+        block_size=1000,
+        store_precision=False,
+    ).fit(X_group_scaled)
+    lw_cov = estimator.covariance_
+    return feature_scales[:, np.newaxis] * lw_cov * feature_scales[np.newaxis, :]
