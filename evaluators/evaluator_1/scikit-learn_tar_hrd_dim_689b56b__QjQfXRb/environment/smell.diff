+def _precompute_class_membership(y, classes):
+    """Build boolean mask index for class membership.
+
+    Pre-computes one boolean mask per class to avoid redundant
+    recomputation of ``y == c`` during iterative class-wise
+    operations (scatter accumulation, centering, etc.).
+
+    Parameters
+    ----------
+    y : array-like of shape (n_samples,)
+        Target labels.
+
+    classes : array-like of shape (n_classes,)
+        Unique class labels in sorted order.
+
+    Returns
+    -------
+    masks : list of ndarray of shape (n_samples,)
+        Boolean masks, one per class.
+    """
+    return [y == c for c in classes]
+
