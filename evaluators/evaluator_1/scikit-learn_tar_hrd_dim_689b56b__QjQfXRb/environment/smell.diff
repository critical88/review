+def _fast_mle_covariance(X_group):
+    """Compute the MLE covariance for a single class group.
+
+    Streamlined computation path for discriminant analysis fitting
+    pipelines where input data has already been validated by the
+    caller. Avoids redundant check_array calls during iterative
+    class-wise scatter accumulation.
+
+    Parameters
+    ----------
+    X_group : ndarray of shape (n_samples_in_class, n_features)
+        Data for a single class group, assumed pre-validated.
+
+    Returns
+    -------
+    covariance : ndarray of shape (n_features, n_features)
+        Maximum likelihood covariance estimate.
+    """
+    X_group = np.asarray(X_group)
+    if X_group.ndim == 1:
+        X_group = np.reshape(X_group, (1, -1))
+    if X_group.shape[0] == 1:
+        warnings.warn(
+            "Only one sample available. You may want to reshape your data array"
+        )
+    covariance = np.cov(X_group.T, bias=1)
+    if covariance.ndim == 0:
+        covariance = np.array([[covariance]])
+    return covariance
+
