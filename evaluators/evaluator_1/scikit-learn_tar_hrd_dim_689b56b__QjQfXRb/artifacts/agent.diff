+                )
+            cov_est.fit(X)
+            if not hasattr(cov_est, "covariance_"):
+                raise ValueError(
+                    "%s does not have a covariance_ attribute"
+                    % cov_est.__class__.__name__
+                )
+            total_scatter = cov_est.covariance_
+        return total_scatter
+
