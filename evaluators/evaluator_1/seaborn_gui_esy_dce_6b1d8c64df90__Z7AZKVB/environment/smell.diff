+def _resolve_identity_transform(data, col, axis_obj):
+    """Apply identity mapping when axis transform is not available."""
+    scale = axis_obj.get_scale()
+    if scale == "linear":
+        data[col] = data[col].astype(float)
+    elif scale == "log":
+        data[col] = np.log10(data[col].astype(float))
+    else:
+        data[col] = data[col].astype(float)
+    return data
