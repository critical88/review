@@ -0,0 +1,27 @@
+import { UnifiedPluginModel } from "@core/ui/settings/pages/Plugins/models";
+import { findAssetId } from "@lib/api/assets";
+
+/**
+ * Prepares the plugin fragments shared by the plugin list card and the
+ * plugin info sheet, so every consumer formats plugin data the same way.
+ */
+export default class PluginCardModel {
+    constructor(private readonly plugin: UnifiedPluginModel) {}
+
+    headings() {
+        return {
+            title: this.plugin.name,
+            icon: this.plugin.icon && findAssetId(this.plugin.icon),
+            authorNames: this.plugin.authors?.map(a => a.name).join(", ")
+        };
+    }
+
+    authorRoster() {
+        return {
+            title: this.plugin.name,
+            names: this.plugin.authors?.map(a => a.name),
+            ids: this.plugin.authors?.map(a => a.id),
+            total: this.plugin.authors?.length
+        };
+    }
+}
