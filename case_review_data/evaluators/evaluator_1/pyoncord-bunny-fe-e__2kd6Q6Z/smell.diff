@@ -0,0 +1,23 @@
+import { BunnyPluginManifestInternal } from "@lib/addons/plugins/types";
+
+/**
+ * Prepares the presentation data of a plugin repository manifest for the
+ * Plugin Browser page cards, so the cards render the fetched repository
+ * metadata consistently.
+ */
+export default class BrowseablePluginModel {
+    constructor(private readonly manifest: BunnyPluginManifestInternal) {}
+
+    displayText() {
+        return {
+            title: this.manifest.display.name,
+            byline: this.manifest.display.authors?.map(a => a.name).join(", ") || "Unknown",
+            versionLabel: this.manifest.version,
+            description: this.manifest.display.description
+        };
+    }
+
+    identifier() {
+        return this.manifest.id;
+    }
+}
