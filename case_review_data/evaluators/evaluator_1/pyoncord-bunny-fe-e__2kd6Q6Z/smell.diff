diff --git a/src/core/ui/settings/pages/Themes/ThemeCardModel.ts b/src/core/ui/settings/pages/Themes/ThemeCardModel.ts
new file mode 100644
index 0000000..687df0e
--- /dev/null
+++ b/src/core/ui/settings/pages/Themes/ThemeCardModel.ts
@@ -0,0 +1,85 @@
+import { formatString, Strings } from "@core/i18n";
+import { showConfirmationAlert } from "@core/vendetta/alerts";
+import { fetchTheme, removeTheme, selectTheme, themes, VdThemeInfo } from "@lib/addons/themes";
+import { findAssetId } from "@lib/api/assets";
+import { settings } from "@lib/api/settings";
+import { clipboard } from "@metro/common";
+import { showToast } from "@ui/toasts";
+
+/**
+ * Prepares the presentation data of a stored theme for the Themes page
+ * list card, so the card component itself stays a thin view that works
+ * the same way for every theme record.
+ */
+export default class ThemeCardModel {
+    constructor(private readonly info: VdThemeInfo) {}
+
+    descriptionParts() {
+        const { authors } = this.info.data;
+        return {
+            title: this.info.data.name,
+            subtitle: authors ? `by ${authors.map(i => i.name).join(", ")}` : "",
+            description: this.info.data.description ?? "No description."
+        };
+    }
+
+    toggleKind() {
+        return !settings.safeMode?.enabled ? "radio" : undefined;
+    }
+
+    radioSelected() {
+        return themes[this.info.id].selected;
+    }
+
+    applyOrClear(shouldApply: boolean) {
+        try {
+            selectTheme(shouldApply ? this.info : null);
+        } catch (e: any) {
+            console.error("Error while selectAndApply,", e);
+        }
+    }
+
+    overflowActions(onRemoved: () => void) {
+        return [
+            {
+                icon: "ic_sync_24px",
+                label: Strings.REFETCH,
+                onPress: () => {
+                    fetchTheme(this.info.id, this.info.selected).then(() => {
+                        showToast(Strings.THEME_REFETCH_SUCCESSFUL, findAssetId("toast_image_saved"));
+                    }).catch(() => {
+                        showToast(Strings.THEME_REFETCH_FAILED, findAssetId("Small"));
+                    });
+                },
+            },
+            {
+                icon: "copy",
+                label: Strings.COPY_URL,
+                onPress: () => {
+                    clipboard.setString(this.info.id);
+                    showToast.showCopyToClipboard();
+                }
+            },
+            {
+                icon: "ic_message_delete",
+                label: Strings.DELETE,
+                isDestructive: true,
+                onPress: () => showConfirmationAlert({
+                    title: Strings.HOLD_UP,
+                    content: formatString("ARE_YOU_SURE_TO_DELETE_THEME", { name: this.info.data.name }),
+                    confirmText: Strings.DELETE,
+                    cancelText: Strings.CANCEL,
+                    confirmColor: "red",
+                    onConfirm: () => {
+                        removeTheme(this.info.id).then(wasSelected => {
+                            onRemoved();
+                            if (wasSelected) this.applyOrClear(false);
+                        }).catch((e: Error) => {
+                            showToast(e.message, findAssetId("Small"));
+                        });
+                    }
+                })
+            },
+        ];
+    }
+}
