+
+/// Global data that provides mutable access to input values.
+pub trait HasInputs<'a, V> {
+    /// Obtain the inputs from global data.
+    fn inputs(&self) -> Inputs<'a, V>;
+}
+
+impl<'a, V> HasInputs<'a, V> for Inputs<'a, V> {
+    fn inputs(&self) -> Inputs<'a, V> {
+        self
+    }
+}
 
