+/// Where [`jaq_core::ValT`] carries the *structural* contract that the
+/// core term language needs, this trait extends it with the value
+/// *capabilities* that the standard library builds on: sequence
+/// conversion, numerical views, and string/byte access. A value type
+/// implements this trait --- and thus opts into the standard library ---
+/// only if it can meaningfully provide those capabilities; a type
+/// without, say, UTF-8 string or byte access need not implement it.
+pub trait ValT: jaq_core::ValT + Ord + From<f64> + From<usize> {
+    /// Convert the value into a sequence iterator.
+    ///
+    /// If the value is not a sequence, this returns `Err(self)`.
+    fn into_seq<S: FromIterator<Self>>(self) -> Result<S, Self>;
+
+    /// Whether the value is an integer.
+    fn is_int(&self) -> bool;
+
+    /// Optionally convert the value into a machine integer.
+    fn as_isize(&self) -> Option<isize>;
+
+    /// Optionally convert the value into a 64-bit float.
+    fn as_f64(&self) -> Option<f64>;
+
+    /// Whether the value is a string holding valid UTF-8.
+    fn is_utf8_str(&self) -> bool;
+
+    /// Optionally return the value as a byte slice.
+    fn as_bytes(&self) -> Option<&[u8]>;
+
+    /// Optionally return the value as a valid UTF-8 byte slice.
+    fn as_utf8_bytes(&self) -> Option<&[u8]> {
+        self.is_utf8_str().then(|| self.as_bytes()).flatten()
+    }
+
+    /// Return the value as a byte slice or a type error.
+    fn try_as_bytes(&self) -> Result<&[u8], Error<Self>> {
+        self.as_bytes().ok_or_else(|| Error::typ(self.clone(), "string"))
+    }
+
+    /// Return the value as a valid UTF-8 byte slice or a type error.
+    fn try_as_utf8_bytes(&self) -> Result<&[u8], Error<Self>> {
+        self.as_utf8_bytes().ok_or_else(|| Error::typ(self.clone(), "string"))
+    }
+
+    /// Return a sub-slice of the value with the given bytes.
+    fn as_sub_str(&self, sub: &[u8]) -> Self;
+
+    /// Construct a string value from UTF-8 bytes.
+    fn from_utf8_bytes(b: impl AsRef<[u8]> + Send + 'static) -> Self;
+}
 
