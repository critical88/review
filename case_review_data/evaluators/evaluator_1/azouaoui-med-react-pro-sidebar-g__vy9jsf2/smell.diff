+import React from 'react';
+import { createPopper } from '@popperjs/core';
+import type { CSSObject } from '@emotion/styled';
+import { menuClasses, sidebarClasses } from '../utils/utilityClasses';
+
+/**
+ * One place for every cross-cutting decision the sidebar and its menu tree
+ * need: responsive breakpoints, off-canvas layout CSS, menu styling, overlay
+ * positioning, keyboard policies and the open/active coordination between
+ * `SubMenu` levels. Before this existed the same rules were scattered across
+ * the components and hooks, so an RTL or collapse fix had to be chased through
+ * half the package — now the answer for "where does this behavior live?" is
+ * always this class.
+ */
+export class ProSidebarManager {
+  /**
+   * Shared breakpoint table used by the responsive sidebar behavior. Keeping
+   * it next to `resolveBreakpointMediaQuery` means product decisions about
+   * device sizes live with the code that consumes them.
+   */
+  static readonly BREAK_POINTS: Record<
+    Exclude<PredefinedBreakPoint, 'all'>,
+    string
+  > = {
+    xs: '480px',
+    sm: '576px',
+    md: '768px',
+    lg: '992px',
+    xl: '1200px',
+    xxl: '1600px',
+  };
+
+  /**
+   * Memoizes the generated menu-button CSS. The styled `li` elements rebuilt
+   * the same string on every render before the styles moved here.
+   */
+  private readonly menuButtonCssMemo = new Map<string, string>();
+
+  // ---------------------------------------------------------------------------
+  // Shared menu style model
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Resolve the styles for a single element of `menuItemStyles`. The value is
+   * either a style object or a function of the item's state.
+   */
+  resolveElementStyles(
+    styles: MenuItemStyles | undefined,
+    element: keyof MenuItemStyles,
+    params: MenuItemStylesParams,
+  ): CSSObject | undefined {
+    const style = styles?.[element];
+    return typeof style === 'function' ? style(params) : style;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Menu button CSS
+  // ---------------------------------------------------------------------------
+
+  /**
+   * The base button styles shared by `MenuItem` and `SubMenu` triggers.
+   * Cached because every menu item asks for the same handful of variants.
+   */
+  buildMenuButtonCss(props: MenuButtonStyleParams): string {
+    const cacheKey = JSON.stringify(props);
+    const cachedCss = this.menuButtonCssMemo.get(cacheKey);
+    if (cachedCss) {
+      return cachedCss;
+    }
+
+    const { rtl, level, collapsed, disabled, active } = props;
+
+    const css = `
+    display: flex;
+    align-items: center;
+    height: 50px;
+    text-decoration: none;
+    color: inherit;
+    box-sizing: border-box;
+    cursor: pointer;
+
+    ${
+      rtl
+        ? `padding-left: 20px;
+           padding-right: ${level === 0 ? 20 : (collapsed ? level : level + 1) * 20}px;
+            `
+        : `padding-right: 20px;
+           padding-left: ${level === 0 ? 20 : (collapsed ? level : level + 1) * 20}px;
+           `
+    }
+
+    &:hover {
+      background-color: #f3f3f3;
+    }
+
+    ${
+      disabled
+        ? `
+      pointer-events: none;
+      cursor: default;
+      color:#adadad;
+        `
+        : ''
+    }
+
+    ${active ? 'color: #4ea9e8;' : ''}
+
+  `;
+
+    this.menuButtonCssMemo.set(cacheKey, css);
+    return css;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Responsive breakpoint behavior (off-canvas sidebar)
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Translate the user-facing `breakPoint` prop into a CSS media query.
+   * Accepts a predefined breakpoint name or any custom CSS length.
+   */
+  resolveBreakpointMediaQuery(breakPoint?: BreakPoint): string | undefined {
+    if (!breakPoint) return undefined;
+
+    if (breakPoint === 'all') {
+      return `screen`;
+    }
+
+    // predefined breakpoint -> its px value; otherwise treat as a custom value
+    if (breakPoint in ProSidebarManager.BREAK_POINTS) {
+      return `(max-width: ${
+        ProSidebarManager.BREAK_POINTS[breakPoint as Exclude<PredefinedBreakPoint, 'all'>]
+      })`;
+    }
+
+    return `(max-width: ${breakPoint})`;
+  }
+
+  /**
+   * Off-canvas (broken/overlay) layout: fixed and slid off-screen, brought
+   * back in when toggled. Shared by the CSS media query and the runtime
+   * `broken` class so the two never drift. Centralizing it here is what
+   * finally made RTL collapse fixes tractable.
+   */
+  buildOffCanvasLayout({
+    rtl,
+    width,
+    collapsedWidth,
+  }: {
+    rtl?: boolean;
+    width?: string;
+    collapsedWidth?: string;
+  }): string {
+    return `
+  position: fixed;
+  height: 100%;
+  top: 0px;
+  z-index: 100;
+  ${rtl ? `right: -${width};` : `left: -${width};`}
+
+  &.${sidebarClasses.collapsed} {
+    ${rtl ? `right: -${collapsedWidth};` : `left: -${collapsedWidth};`}
+  }
+
+  &.${sidebarClasses.toggled} {
+    ${rtl ? `right: 0;` : `left: 0;`}
+  }
+`;
+  }
+
+  /**
+   * Subscribe a listener to a breakpoint media query and keep it in sync with
+   * the current match. Returns the cleanup, or `undefined` when there is
+   * nothing to subscribe to (no breakpoint, or no DOM to query).
+   */
+  registerBreakpointListener(
+    breakpoint: string | undefined,
+    onMatchChange: (matches: boolean) => void,
+  ): (() => void) | undefined {
+    if (!breakpoint || typeof window === 'undefined') {
+      return undefined;
+    }
+
+    const media = window.matchMedia(breakpoint);
+
+    // notify with the current value; React bails out if it is unchanged.
+    const handleMatch = () => onMatchChange(media.matches);
+
+    // Sync the real value once subscribed (and whenever the query changes).
+    handleMatch();
+
+    media.addEventListener('change', handleMatch);
+    return () => media.removeEventListener('change', handleMatch);
+  }
+
+  /**
+   * `onBreakPoint` must only fire on actual changes; a viewport that already
+   * matches should not emit a spurious initial announcement.
+   */
+  shouldAnnounceBreakpointChange(previous: boolean, current: boolean): boolean {
+    return previous !== current;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Keyboard interaction policies
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Keys that activate the overlay backdrop (same contract as a native
+   * button: Enter or Space).
+   */
+  isBackdropActivationKey(key: string): boolean {
+    return key === 'Enter' || key === ' ';
+  }
+
+  /** The escape hatch shared by the overlay sidebar and the popper flyouts. */
+  isDismissKey(key: string): boolean {
+    return key === 'Escape';
+  }
+
+  /** Keyboard activation for popper submenus (document-level `keyup`). */
+  isPopperToggleKey(key: string): boolean {
+    return key === 'Enter';
+  }
+
+  // ---------------------------------------------------------------------------
+  // Popper (floating submenu) positioning
+  // ---------------------------------------------------------------------------
+
+  /** Where the portaled flyout should live: inside the sidebar root, or body. */
+  resolvePortalHost(buttonRef: React.RefObject<HTMLAnchorElement>): HTMLElement {
+    const root = buttonRef.current?.closest(`.${sidebarClasses.root}`);
+    return (root as HTMLElement | null) ?? document.body;
+  }
+
+  /**
+   * The popper instance is created only when the submenu renders as a popper
+   * (collapsed top-level submenu, or `popover` mode while expanded) and its
+   * content has reached the final DOM location.
+   */
+  shouldMountPopper(
+    popper: boolean,
+    mounted: boolean,
+    contentRef: React.RefObject<HTMLDivElement>,
+    buttonRef: React.RefObject<HTMLAnchorElement>,
+  ): boolean {
+    return Boolean(popper && mounted && contentRef.current && buttonRef.current);
+  }
+
+  /** Anchor options for the floating submenu. */
+  buildPopperOptions() {
+    return {
+      placement: 'right',
+      strategy: 'fixed',
+      modifiers: [
+        {
+          name: 'offset',
+          options: {
+            offset: [0, 5],
+          },
+        },
+      ],
+    } as Parameters<typeof createPopper>[2];
+  }
+
+  /** Create the positioning engine instance behind a floating submenu. */
+  createPopperInstance(
+    buttonRef: React.RefObject<HTMLAnchorElement>,
+    contentRef: React.RefObject<HTMLDivElement>,
+  ): ReturnType<typeof createPopper> | null {
+    const reference = buttonRef.current;
+    const floating = contentRef.current;
+    if (!reference || !floating) {
+      return null;
+    }
+    return createPopper(reference, floating, this.buildPopperOptions());
+  }
+
+  /**
+   * Keep the popper positioned: update when the trigger/content resize and
+   * once the sidebar's collapse/toggle transition settles.
+   */
+  observePopper(
+    popperInstance: ReturnType<typeof createPopper>,
+    contentRef: React.RefObject<HTMLDivElement>,
+    buttonRef: React.RefObject<HTMLAnchorElement>,
+    transitionDuration: number | undefined,
+  ): () => void {
+    let resizeObserver: ResizeObserver | undefined;
+
+    if (contentRef.current && buttonRef.current) {
+      resizeObserver = new ResizeObserver(() => {
+        popperInstance.update();
+      });
+
+      resizeObserver.observe(contentRef.current);
+      resizeObserver.observe(buttonRef.current);
+    }
+
+    const timer = setTimeout(() => {
+      popperInstance.update();
+    }, transitionDuration);
+
+    return () => {
+      resizeObserver?.disconnect();
+      clearTimeout(timer);
+    };
+  }
+
+  /**
+   * Decide what a document-level interaction does to the floating submenu:
+   * open it (its trigger was hit), close it (an outside click, or any menu
+   * item click under `closeOnClick`), or leave it alone (`null`).
+   */
+  resolvePopperVisibility(
+    target: Node,
+    openWhenCollapsed: boolean,
+    closeOnClick: boolean,
+    buttonRef: React.RefObject<HTMLAnchorElement>,
+    contentRef: React.RefObject<HTMLDivElement>,
+  ): boolean | null {
+    if (!openWhenCollapsed && buttonRef.current?.contains(target)) {
+      return true;
+    }
+
+    const isMenuItemClickOutsideSubMenu =
+      closeOnClick &&
+      !(target as HTMLElement).closest(`.${menuClasses.menuItemRoot}`)?.classList.contains(
+        menuClasses.subMenuRoot,
+      );
+
+    const isClickOutsideContent = !contentRef.current?.contains(target) && openWhenCollapsed;
+
+    if (isMenuItemClickOutsideSubMenu || isClickOutsideContent) {
+      return false;
+    }
+
+    return null;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Menu tree coordination (accordions and active-state cascade)
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Register `defaultOpen` with a parent accordion on mount. If multiple
+   * siblings register, the last one wins; warn so it's not silent.
+   */
+  registerDefaultOpen(accordion: AccordionContextValue, id: string): void {
+    if (!accordion) {
+      return;
+    }
+
+    if (accordion.defaultOpenRegisteredRef.current !== null) {
+      console.warn(
+        '[react-pro-sidebar] Multiple SubMenus have `defaultOpen` inside an accordion group; only the last-rendered one will be open.',
+      );
+    }
+    accordion.defaultOpenRegisteredRef.current = id;
+    accordion.setActive(id, true);
+  }
+
+  /** Single-open policy: opening one submenu releases the previously open id. */
+  nextAccordionActiveId(prev: string | null, id: string, isOpen: boolean): string | null {
+    if (isOpen) {
+      return id;
+    }
+    return prev === id ? null : prev;
+  }
+
+  /**
+   * Track active descendants so a submenu can highlight while any child is
+   * active, then report its own effective-active state up to its parent.
+   */
+  nextActiveDescendantSet(
+    prev: Set<string>,
+    childId: string,
+    isActive: boolean,
+  ): Set<string> {
+    if (isActive === prev.has(childId)) {
+      return prev;
+    }
+    const next = new Set(prev);
+    if (isActive) {
+      next.add(childId);
+    } else {
+      next.delete(childId);
+    }
+    return next;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Content visibility
+  // ---------------------------------------------------------------------------
+
+  /**
+   * While a submenu is hidden its subtree is `inert` so its links stay out of
+   * the tab order and the accessibility tree.
+   *
+   * `inert` is a real boolean attribute in React 19 — passing the string
+   * "true" there logs a warning — but React 18 doesn't recognize `inert` and
+   * only renders its string form (it drops a boolean `true`). Pick the
+   * representation the running React version renders as a present attribute.
+   */
+  buildInertProps(visible: boolean): object {
+    if (visible) {
+      return {};
+    }
+    const inertValue: true | 'true' = parseInt(React.version, 10) >= 19 ? true : 'true';
+    return { inert: inertValue } as object;
+  }
+}
+
+/**
+ * Singleton shared by the sidebar and menu internals. The manager holds no
+ * per-component state beyond its caches, so one instance serves every render
+ * tree (including SSR, where constructing it has no side effects).
+ */
+export const proSidebarManager = new ProSidebarManager();
+
+// ---------------------------------------------------------------------------
+// Shared types
+// ---------------------------------------------------------------------------
+
+/**
+ * Accepts a predefined breakpoint (with editor autocomplete) or any custom CSS
+ * length such as `'450px'`. The `string & {}` keeps the literal suggestions
+ * while still allowing arbitrary strings.
+ */
+export type PredefinedBreakPoint = 'xs' | 'sm' | 'md' | 'lg' | 'xl' | 'xxl' | 'all';
+export type BreakPoint = PredefinedBreakPoint | (string & {});
+
+export type ElementStyles = CSSObject | ((params: MenuItemStylesParams) => CSSObject | undefined);
+
+export interface MenuItemStyles {
+  root?: ElementStyles;
+  button?: ElementStyles;
+  label?: ElementStyles;
+  prefix?: ElementStyles;
+  suffix?: ElementStyles;
+  icon?: ElementStyles;
+  subMenuContent?: ElementStyles;
+  SubMenuExpandIcon?: ElementStyles;
+}
+
+export interface MenuItemStylesParams {
+  level: number;
+  disabled: boolean;
+  active: boolean;
+  isSubmenu: boolean;
+  open?: boolean;
+}
+
+export interface MenuButtonStyleParams {
+  level: number;
+  collapsed?: boolean;
+  rtl?: boolean;
+  disabled?: boolean;
+  active?: boolean;
+}
+
+/**
+ * Internal context used to coordinate single-open (accordion) behavior across
+ * sibling `SubMenu`s at a given level. A `null` value means no accordion is
+ * active at this level.
+ */
+export type AccordionContextValue = {
+  activeId: string | null;
+  setActive: (id: string, isOpen: boolean) => void;
+  /**
+   * Synchronously-mutable ref used during mount to detect when more than one
+   * `SubMenu` registers `defaultOpen` in the same accordion group (sibling
+   * effects in the same commit otherwise can't see each other's state updates).
+   */
+  defaultOpenRegisteredRef: React.MutableRefObject<string | null>;
+} | null;
+
+/**
+ * Internal context used to cascade the `active` state up the tree: a child
+ * (MenuItem or SubMenu) reports its active state to the nearest parent SubMenu,
+ * which marks itself active when any descendant is active. `null` at the top
+ * level (no parent SubMenu to report to).
+ */
+export type SubMenuActiveContextValue = {
+  registerActive: (id: string, active: boolean) => void;
+} | null;
