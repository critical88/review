diff --git a/tests/test_gate_identity.py b/tests/test_gate_identity.py
new file mode 100644
index 0000000..8b69664
--- /dev/null
+++ b/tests/test_gate_identity.py
@@ -0,0 +1,192 @@
+"""Regression tests for the DeviceIdentity refactor.
+
+The identity of a child device (model, did, type and the assorted hardware
+addresses / firmware versions) is now carried as a single ``DeviceIdentity``
+value instead of bare tuples and parallel arguments. These tests pin the
+field mapping so the renames and normalization cannot silently drift.
+"""
+
+import asyncio
+
+from custom_components.xiaomi_gateway3.core.const import BLE, GATEWAY, MATTER, MESH, ZIGBEE
+from custom_components.xiaomi_gateway3.core.device import hex_to_ieee
+from custom_components.xiaomi_gateway3.core.gate.base import XGateway
+from custom_components.xiaomi_gateway3.core.gate.ble import ble_identity, reverse_mac
+from custom_components.xiaomi_gateway3.core.gate.lumi import zigbee_identity
+from custom_components.xiaomi_gateway3.core.gate.mesh import mesh_identity
+
+
+def _gw() -> XGateway:
+    # devices is a class-level registry, make sure tests don't bleed into each other
+    XGateway.devices.clear()
+    return XGateway("1.2.3.4")
+
+
+ZIGBEE_MAC = "00158d000abcdef0"
+
+
+def test_ble_identity_assembles_device_identity():
+    identity = ble_identity("blt.3.abc", 2038, "AA:BB:CC:DD:EE:FF")
+    assert identity == {
+        "model": 2038,
+        "did": "blt.3.abc",
+        "type": BLE,
+        "mac": "aa:bb:cc:dd:ee:ff",
+    }
+
+
+def test_mesh_identity_assembles_device_identity():
+    identity = mesh_identity("12345", 10441, "AA:BB:CC:DD:EE:FF")
+    assert identity == {
+        "model": 10441,
+        "did": "12345",
+        "type": MESH,
+        "mac": "aa:bb:cc:dd:ee:ff",
+    }
+
+
+def test_zigbee_identity_renames_and_normalizes():
+    identity = zigbee_identity(
+        "lumi.00158d000abcdef",
+        "lumi.sensor_ht",
+        ZIGBEE_MAC,
+        "0x1234",
+        30,
+        1,
+        "cloud7",
+    )
+    assert identity == {
+        "model": "lumi.sensor_ht",
+        "did": "lumi.00158d000abcdef",
+        "type": ZIGBEE,
+        "ieee": hex_to_ieee(ZIGBEE_MAC),
+        "nwk": "0x1234",
+        "fw_ver": 30,  # renamed from app_ver
+        "hw_ver": 1,  # renamed from hard_ver
+        "cloud_did": "cloud7",  # renamed from xiaomi_did
+    }
+
+
+def test_zigbee_identity_omits_missing_cloud_did():
+    identity = zigbee_identity(
+        "lumi.00158d000abcdef", "lumi.sensor_ht", ZIGBEE_MAC, "0x1234", 30, 1
+    )
+    assert "cloud_did" not in identity
+
+
+def test_ble_identity_lowercases_db_mac():
+    # ble_read_devices feeds reverse_mac(row[1]) into ble_identity
+    mac = reverse_mac("0102030405ff")
+    assert mac == "ff:05:04:03:02:01"
+    assert ble_identity("blt.3.row", 2038, mac)["mac"] == mac
+
+
+def test_init_device_maps_identity_onto_xdevice():
+    gw = _gw()
+    identity = zigbee_identity(
+        "lumi.00158d000abcdef", "lumi.sensor_ht", ZIGBEE_MAC, "0x1234", 30, 1, "cloud7"
+    )
+    device = gw.init_device(identity)
+
+    assert device.model == "lumi.sensor_ht"
+    assert device.did == "lumi.00158d000abcdef"
+    assert device.type == ZIGBEE
+    assert device.extra["ieee"] == hex_to_ieee(ZIGBEE_MAC)
+    assert device.extra["nwk"] == "0x1234"
+    assert device.extra["fw_ver"] == 30
+    assert device.extra["hw_ver"] == 1
+    assert device.extra["cloud_did"] == "cloud7"
+    # raw model must not leak into extra (only the YAML override lives there)
+    assert "model" not in device.extra
+    # registered in the gateway's device registry
+    assert gw.devices[device.did] is device
+
+
+def test_init_device_lowercases_mac():
+    gw = _gw()
+    device = gw.init_device(ble_identity("blt.3.mac", 2038, "AA:BB:CC:DD:EE:FF"))
+    assert device.extra["mac"] == "aa:bb:cc:dd:ee:ff"
+
+
+def test_init_device_supports_unknown_model():
+    # silabs discovered devices pass model=None until matched
+    gw = _gw()
+    device = gw.init_device(
+        {
+            "model": None,
+            "did": "lumi.none001",
+            "type": ZIGBEE,
+            "ieee": hex_to_ieee(ZIGBEE_MAC),
+            "nwk": "0x1234",
+        }
+    )
+    assert device.model is None
+    assert device.did == "lumi.none001"
+    assert "model" not in device.extra
+
+
+def test_init_device_group_without_mac():
+    gw = _gw()
+    device = gw.init_device(
+        {"model": "group.1", "did": "group." + "1" * 19, "type": "group"}
+    )
+    assert device.model == "group.1"
+    assert device.did == "group." + "1" * 19
+    assert device.type == "group"
+    assert "mac" not in device.extra
+
+
+def test_base_read_device_creates_gateway_from_identity():
+    gw = _gw()
+    identity = {
+        "model": "lumi.gateway.mgl03",
+        "did": "1234567",
+        "type": GATEWAY,
+        "mac": "AA:BB:CC:DD:EE:FF",
+        "fw_ver": "1.4.7_0160",
+        "mac2": "11:22:33:44:55:66",
+    }
+
+    asyncio.run(gw.base_read_device(identity))
+
+    assert gw.device.model == "lumi.gateway.mgl03"
+    assert gw.device.did == "1234567"
+    assert gw.device.type == GATEWAY
+    assert gw.device.extra["mac"] == "aa:bb:cc:dd:ee:ff"  # lowercased
+    assert gw.device.extra["mac2"] == "11:22:33:44:55:66"  # preserved
+    assert gw.device.extra["fw_ver"] == "1.4.7_0160"
+    assert "model" not in gw.device.extra
+    assert gw.devices["1234567"] is gw.device
+    assert gw in gw.device.gateways  # add_device wired it up
+
+
+def test_base_read_device_reuses_existing_device():
+    gw = _gw()
+    identity = {
+        "model": "lumi.gateway.mgl03",
+        "did": "7654321",
+        "type": GATEWAY,
+        "mac": "AA:BB:CC:DD:EE:FF",
+        "fw_ver": "1.4.7_0160",
+    }
+    asyncio.run(gw.base_read_device(identity))
+    first = gw.device
+    # a second read must not re-create the device (keeps existing converters/state)
+    asyncio.run(gw.base_read_device(identity))
+    assert gw.device is first
+
+
+def test_matter_identity_round_trips():
+    gw = _gw()
+    device = gw.init_device(
+        {
+            "model": "matter.lamp",
+            "did": "M." + "1" * 19,
+            "type": MATTER,
+            "fw_ver": 1,
+        }
+    )
+    assert device.model == "matter.lamp"
+    assert device.type == MATTER
+    assert device.uid == "1" * 19
+    assert device.extra["fw_ver"] == 1
