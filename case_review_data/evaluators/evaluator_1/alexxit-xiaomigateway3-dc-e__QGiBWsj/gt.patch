+class DeviceIdentity(TypedDict, total=False):
+    """Fields that make up a device's identity.
+
+    The model, did and type together with the assorted hardware addresses
+    and firmware versions used to be unpacked, renamed and re-passed as
+    parallel arguments and bare tuples across the adapter layer. They are
+    now carried into ``XGateway.init_device`` as this single value.
+    """
+
+    model: str | int | None  # raw model from the gateway DB/report (None if unknown)
+    # one of GATEWAY, ZIGBEE, BLE, MESH, GROUP, MATTER
+    type: str
+    did: str  # device ID ("ble." "lumi." "group." "M." "123")
+    mac: str  # for GATEWAY, BLE, MESH (lowercase hex with colons)
+    mac2: str  # lan mac for Xiaomi Multimode Gateway 2
+    ieee: str  # for ZIGBEE (lowercase hex with colons, EUI64)
+    nwk: str  # for ZIGBEE
+    fw_ver: int  # firmware version for GATEWAY and ZIGBEE
+    hw_ver: int  # hardware version for ZIGBEE
+    cloud_did: str  # for new ZIGBEE devices did is "lumi", but cloud_did is "123"
+
+
 class XDevice:
     configs: dict[str, dict] = {}  # key is device.uid
     restore: dict[str, dict] = {}  # key is device.cloud_did
