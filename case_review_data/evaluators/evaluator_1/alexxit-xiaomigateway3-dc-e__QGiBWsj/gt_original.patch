@@ -83,6 +83,61 @@ class XDeviceExtra(TypedDict, total=False):
     occupancy_timeout: list[float] | float  # occupancy timeout for motion
 
 
+class XDeviceIdentity:
+    """Cohesive identity of one device handled by a gateway adapter.
+
+    Every adapter (BLE, Lumi Zigbee, Mesh, Matter, Silabs, MiOT) reads its
+    own source (miio info, gateway databases, reports, unknown device
+    states), assembles these members once and passes them to
+    `XGateway.init_device` as a single object, so the identity data of a
+    device no longer travels through the interfaces as a group of separate
+    parameters. The members mirror the identity part of `XDeviceExtra`.
+    """
+
+    def __init__(
+        self,
+        model: str | int | None,
+        did: str,
+        dtype: str,
+        mac: str = None,
+        ieee: str = None,
+        nwk: str = None,
+        fw_ver: int = None,
+        hw_ver: int = None,
+        cloud_did: str = None,
+        mac2: str = None,
+    ):
+        self.model = model
+        self.did = did
+        self.dtype = dtype
+        self.mac = mac
+        self.ieee = ieee
+        self.nwk = nwk
+        self.fw_ver = fw_ver
+        self.hw_ver = hw_ver
+        self.cloud_did = cloud_did
+        self.mac2 = mac2
+
+    def as_extra(self) -> XDeviceExtra:
+        """Build the XDevice constructor argument from the identity members."""
+        extra: XDeviceExtra = {"did": self.did, "type": self.dtype}
+        if self.mac is not None:
+            extra["mac"] = self.mac.lower()  # aa:bb:cc:dd:ee:ff
+        if self.ieee is not None:
+            extra["ieee"] = self.ieee
+        if self.nwk is not None:
+            extra["nwk"] = self.nwk
+        if self.fw_ver is not None:
+            extra["fw_ver"] = self.fw_ver
+        if self.hw_ver is not None:
+            extra["hw_ver"] = self.hw_ver
+        if self.cloud_did is not None:
+            extra["cloud_did"] = self.cloud_did
+        if self.mac2 is not None:
+            extra["mac2"] = self.mac2
+        return extra
+
+
 class XDevice:
     configs: dict[str, dict] = {}  # key is device.uid
     restore: dict[str, dict] = {}  # key is device.cloud_did
