+		//! formats one zero-padded sequence file name (shared by the write-out paths)
+		static std::string buildFrameFilename(const std::string& base, const std::string fileEnding, unsigned int numCountDigits, unsigned int current) {
+			std::stringstream ss;
+			ss << base;
+#ifdef WIN32
+			for (unsigned int i = std::max(1u, (unsigned int)std::ceilf(std::log10f((float)current + 1))); i < numCountDigits; i++) ss << "0";
+#else
+			for (unsigned int i = std::max(1u, (unsigned int)ceilf(log10f((float)current + 1))); i < numCountDigits; i++) ss << "0";
+#endif
+			ss << current;
+			ss << fileEnding;
+			return ss.str();
+		}
