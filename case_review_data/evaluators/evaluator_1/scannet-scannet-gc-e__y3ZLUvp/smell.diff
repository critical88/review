+				if (f.m_depthSizeBytes != width*height) {
+					freeFrameDepth(f);
+					f.m_depthSizeBytes = width*height*sizeof(unsigned short);
+					f.m_depthCompressed = (unsigned char*)std::malloc(f.m_depthSizeBytes);
+				}
+				std::memcpy(f.m_depthCompressed, depth, f.m_depthSizeBytes);
