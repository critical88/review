+"""Structured host probe result.
+
+``xxh.get_host_info`` used to return a bare ``key=value`` mapping. This module
+introduces a :class:`HostInfo` value object so host-decision helpers can talk
+about named fields (``host_info.version``) while the legacy dictionary access
+(``host_info['xxh_version']``) still works during the migration.
+"""
+
+
+class HostInfo(dict):
+    """A host probe result that is both a mapping and an attribute container."""
+
+    def __getattr__(self, name):
+        key = 'xxh_' + name if ('xxh_' + name) in self else name
+        if key in self:
+            return self[key]
+        raise AttributeError(name)
+
+    @classmethod
+    def from_probe_output(cls, raw):
+        parsed = {}
+        for line in raw.replace('\r', '').split('\n'):
+            if line.strip() == '' or '=' not in line or '|' in line:
+                continue
+            key, value = line.split('=', 1)
+            if value[:1] == "'" and value[-1:] == "'":
+                value = value[1:-1]
+            parsed[key] = value
+        return cls(parsed)
