 //! Utilities for rows. A `Row` owns the underlying characters, the rendered
 //! string and the syntax highlighting information.
 
-use std::{iter::repeat_n, num::NonZeroUsize};
+use std::iter::{repeat_n, successors as scsr};
+use std::num::NonZeroUsize;
 
 use unicode_width::UnicodeWidthChar;
 
 use crate::ansi_escape::{RESET, WBG, push_colored};
 use crate::syntax::{Conf as SyntaxConf, HlType};
 
+/// The width of the line-number gutter, measured in number of digits of the
+/// largest line number. The gutter also uses two additional columns to draw
+/// the vertical bar, see [`GutterWidth::padding`].
+#[derive(Clone, Copy)]
+pub(crate) struct GutterWidth {
+    /// The number of digits of the largest line number.
+    n_digits: usize,
+}
+
+impl GutterWidth {
+    /// Return the gutter width corresponding to a document with `n_rows`
+    /// rows. The width is the number of digits of the last line number: this
+    /// is equal to the number of times we can divide this number by ten,
+    /// computed below using `successors`.
+    pub(crate) fn from_row_count(n_rows: usize) -> Self {
+        Self { n_digits: scsr(Some(n_rows), |u| Some(u / 10).filter(|u| *u > 0)).count() }
+    }
+
+    /// Return the total number of columns occupied by the gutter, including
+    /// the two columns used for the vertical bar and the space before it.
+    pub(crate) const fn padding(self) -> usize {
+        self.n_digits + 2
+    }
+}
