+/// Return the number of columns that remain available for the text of a
+/// row, given the total window width and the line-number gutter, if the
+/// gutter is shown. When the gutter is not shown, the full window width is
+/// available.
+pub(crate) fn text_area_cols(window_width: usize, gutter: Option<GutterWidth>) -> usize {
+    window_width.saturating_sub(gutter.map_or(0, GutterWidth::padding))
+}
