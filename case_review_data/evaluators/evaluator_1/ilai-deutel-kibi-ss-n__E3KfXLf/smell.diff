+/// Return whether the line-number gutter should be shown: the gutter takes
+/// space on the left of every row, so it can only be shown if the user
+/// requested it and the gutter is small enough compared to the window width
+/// (at most a quarter of the window), so that it never hides the text.
+pub(crate) const fn gutter_shown(
+    show_line_num: bool, gutter_width: GutterWidth, window_width: usize,
+) -> bool {
+    show_line_num && gutter_width.padding() < window_width / 4
+}
