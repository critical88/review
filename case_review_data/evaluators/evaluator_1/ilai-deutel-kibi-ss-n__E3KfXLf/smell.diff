+
+/// Format an entry of the line-number gutter: `val` (typically a line number
+/// or `~` for an empty row), right-aligned to the gutter width, followed by
+/// the space and the vertical bar that separate the gutter from the text.
+pub(crate) fn gutter_entry<T: Display>(gutter: GutterWidth, val: T) -> String {
+    format!("{:>1$} \u{2502}", val, gutter.padding() - 2)
