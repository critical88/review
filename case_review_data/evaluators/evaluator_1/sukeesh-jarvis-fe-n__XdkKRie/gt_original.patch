+    def records(self):
+        """The tasks in their stored order, read fresh from the storage."""
+        self.load()
+        return list(self.items)
+
+    def count(self):
+        """Number of tasks, read fresh from the storage."""
+        self.load()
+        return len(self.items)
+
+    def name(self, index):
+        """Name of the task at the one based position."""
+        self.load()
+        return self.items[index - 1]["name"]
+
+    def add_named(self, new_name):
+        """Append a new task with the given name."""
+        self.load()
+        self.items.append({"name": new_name})
+        self.save()
+
+    def replace_named(self, chosen_name, updated_name):
+        """Give every task called chosen_name the updated name."""
+        self.load()
+        self.items = [{"name": updated_name}
+                      if task["name"] == chosen_name else task
+                      for task in self.items]
+        self.save()
+
+    def set_priority(self, task_name, priority):
+        """Give every task called task_name the given priority."""
+        self.load()
+        self.items = [{"name": task_name, "priority": priority}
+                      if task["name"] == task_name else task
+                      for task in self.items]
+        self.save()
+
+    def remove_named(self, name):
+        """Drop every task called name."""
+        self.load()
+        self.items = [task for task in self.items if task["name"] != name]
+        self.save()
+
+    def ordered(self, strategy):
+        """The tasks sorted by name (strategy 1) or by priority."""
+        self.load()
+
+        def sort_by_priority(task):
+            try:
+                priority = task["priority"]
+                if priority == "High":
+                    return 3
+                elif priority == "Medium":
+                    return 2
+                else:
+                    return 1
+            except BaseException:
+                return 0
+
+        def sort_by_name(task):
+            return task["name"]
+
+        if strategy == 1:
+            return sorted(self.items, key=sort_by_name)
+        return sorted(self.items, key=sort_by_priority, reverse=True)
+
 
