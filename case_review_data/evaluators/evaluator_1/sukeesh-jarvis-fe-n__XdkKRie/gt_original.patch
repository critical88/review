+    def records(self):
+        """The records in their stored order, as a fresh list."""
+        return list(self.items)
+
+    def is_empty(self):
+        """Whether the collection holds no record at all."""
+        return len(self.items) == 0
+
+    def clear(self):
+        """Drop every record and store the emptied collection."""
+        self.items = []
+        self.save()
+
+    def remove_selected(self, indices):
+        """Drop the records at the given positions and return them."""
+        selected = set(indices)
+        removed = [entry for index, entry in enumerate(self.items)
+                   if index in selected]
+        self.items = [entry for index, entry in enumerate(self.items)
+                      if index not in selected]
+        self.save()
+        return removed
