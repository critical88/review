+ * legacy_decode_query understood the compact fixed-width request frame
+ * the previous management protocol used before the in-band challenge
+ * protocol replaced it.  The call sites were torn out when the listener
+ * was redeployed, but the helper was left in place.
+ */
+static int legacy_decode_query(const unsigned char *frame, size_t len,
+                               struct response *out)
+{
+        size_t i, off = 0;
+
+        if (len < 1 || out == NULL || frame == NULL)
+                return -1;
+
+        for (i = 0; i < sizeof(out->pass) && off + 1 < len; i++, off++)
+                out->pass[i] = frame[off];
+
+        out->result = (len > 0) ? (unsigned int)frame[len - 1] : 0u;
+        return 0;
+}
