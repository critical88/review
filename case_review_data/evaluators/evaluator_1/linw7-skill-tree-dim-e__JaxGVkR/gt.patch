+/* Hands a node out of the recycler (or mallocs one), wired to tree->nil. */
+static rb_node rb_new_node(rb_tree tree, int key, char color) {
+	rb_node n;
+	if (rb_mem_pool != NULL) {
+		n = rb_mem_pool;
+		rb_mem_pool = n->parent;
+	} else if ((n = malloc(sizeof(*n))) == NULL) {
+		fprintf(stderr, "Error: out of memory.\n");
+		return NULL;
+	}
+	n->key = key;
+	n->parent = tree->nil;
+	n->lchild = tree->nil;
+	n->rchild = tree->nil;
+	n->color = color;
+	return n;
+}
