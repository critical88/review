+/* Restores red-black properties after inserting a red `fresh`.
+ *
+ * The classic three-case walk: case 1 recolors and climbs while the parent
+ * and uncle are both red; case 2 rotates at the parent to fold a zig-zag
+ * into a zig-zig; case 3 rotates at the grandparent and recolors to settle
+ * the spine. */
+static void rb_insert_fixup(rb_tree tree, rb_node fresh) {
+	rb_node gp = fresh->parent->parent;
+	rb_node uncle = tree->nil;
+	if (fresh->parent != tree->nil && fresh->parent->parent != tree->nil) {
+		uncle = (gp->lchild == fresh->parent) ? gp->rchild : gp->lchild;
+	}
+	/* Case 1: recolor sprint -- chase red-on-red up the spine while the
+	 * uncle alongside is red too. */
+	while (fresh->parent->color == 'r' && uncle->color == 'r') {
+		gp->color = 'r';
+		uncle->color = 'b';
+		fresh->parent->color = 'b';
+		fresh = gp;
+		gp = fresh->parent->parent;
+		uncle = tree->nil;
+		if (fresh->parent != tree->nil && fresh->parent->parent != tree->nil) {
+			uncle = (gp->lchild == fresh->parent) ? gp->rchild : gp->lchild;
+		}
+	}
+	if (fresh->parent->color == 'b') {
+		if (fresh == tree->root) fresh->color = 'b';
+		return;
+	}
+	/* Case 2: if fresh hugs the same side as the uncle (a zig-zag),
+	 * rotate at the parent so the red pair lines up on one side. */
+	if ((fresh->parent->lchild == fresh) == (gp->lchild == uncle)) {
+		rb_node lift = fresh->parent;
+		rb_rotate(tree, lift, lift->rchild == fresh);
+		fresh = lift;
+	}
+	/* Case 3: rotate at the grandparent and recolor to push the red pair up. */
+	fresh->parent->color = 'b';
+	gp->color = 'r';
+	rb_rotate(tree, gp, gp->lchild == uncle);
+	tree->root->color = 'b';
+}
