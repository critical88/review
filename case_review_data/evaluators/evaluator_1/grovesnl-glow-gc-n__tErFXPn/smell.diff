+/// Pixel buffer sizing helpers on the native context, so that callers that
+/// already hold a context can size client-side staging buffers without
+/// reaching for the free functions above.
+#[cfg(any(not(target_family = "wasm"), target_os = "emscripten"))]
+impl crate::native::Context {
+    /// Returns the number of components used by a pixel format.
+    pub fn pixel_component_count(&self, format: u32) -> usize {
+        match format {
+            RED | GREEN | BLUE => 1,
+            RED_INTEGER | GREEN_INTEGER | BLUE_INTEGER => 1,
+            ALPHA | LUMINANCE | DEPTH_COMPONENT => 1,
+            RG | LUMINANCE_ALPHA => 2,
+            RGB | BGR => 3,
+            RGBA | BGRA => 4,
+            _ => panic!("unsupported format: {:?}", format),
+        }
+    }
+
+    /// Returns the number of bytes used by a pixel type (in one component).
+    pub fn pixel_component_bytes(&self, pixel_type: u32) -> usize {
+        // per https://www.khronos.org/opengl/wiki/Pixel_Transfer#Pixel_type
+        match pixel_type {
+            BYTE | UNSIGNED_BYTE => 1,
+            SHORT | UNSIGNED_SHORT => 2,
+            INT | UNSIGNED_INT => 4,
+            HALF_FLOAT | HALF_FLOAT_OES => 2,
+            FLOAT => 4,
+            _ => panic!("unsupported pixel type: {:?}", pixel_type),
+        }
+    }
+
+    /// Returns the size in bytes of a tightly packed `width` x `height`
+    /// buffer of pixels in the given format and pixel type.
+    pub fn tight_pixel_buffer_size(
+        &self,
+        width: i32,
+        height: i32,
+        format: u32,
+        pixel_type: u32,
+    ) -> usize {
+        width as usize
+            * height as usize
+            * self.pixel_component_count(format)
+            * self.pixel_component_bytes(pixel_type)
+    }
+}
