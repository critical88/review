index 81cf56f..f751af1 100644
--- a/site/content/chapter5/code/lib/vec.c
+++ b/site/content/chapter5/code/lib/vec.c
@@ -37,19 +37,6 @@ int get_vec_element(vec_ptr v, long index, data_t *dest) {
   return 1;
 }
 
-/*
- * Bounds-checked fetch kept from the first combine drafts, where the
- * kernels still walked the vector through checked reads. Every kernel
