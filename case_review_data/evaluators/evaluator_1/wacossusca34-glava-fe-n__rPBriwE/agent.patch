    a single shared implementation instead of duplicating it.
+     - rd_audio_bind: copy the active renderer's requests into the session
      - rd_audio_zero: clear the session buffers (used at instantiate time)
      - rd_audio_shift_write: roll the session window and append one chunk
      - rd_audio_shift_silence: roll the window and pad it with silence
      - rd_audio_read: drain the session for one frame (lock-copy-reset)  */
+void    rd_audio_bind         (struct audio_data* audio, struct glava_renderer* r);
 void    rd_audio_zero         (struct audio_data* audio);
 void    rd_audio_shift_write  (struct audio_data* audio, const float* l, const float* r);
