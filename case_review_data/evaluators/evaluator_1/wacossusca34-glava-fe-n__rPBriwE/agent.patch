    state that parameterizes it, so every consumer manipulates the session
    through the same rd_* surface instead of duplicating buffer traversal. */
 
+/* Pull the active renderer's requests into the session. The renderer owns the
+   request fields that parameterize the audio session, so binding them here
+   keeps the session aligned with whatever the renderer was configured for,
+   instead of every audio backend re-deriving the same mapping at init time. */
+void rd_audio_bind(struct audio_data* audio, struct glava_renderer* r) {
+    audio->rate         = (unsigned int) r->rate_request;
+    audio->sample_sz    = r->samplesize_request;
+    audio->audio_buf_sz = r->bufsize_request;
+    audio->channels     = r->mirror_input ? 1 : 2;
+    if (r->audio_source_request && strcmp(r->audio_source_request, "auto") != 0) {
+        audio->source = strdup(r->audio_source_request);
+    }
+}
