index 6ce3952..e7bb0ae 100644
--- a/glava/render.c
+++ b/glava/render.c
@@ -20,6 +20,7 @@
 #include "render.h"
 #include "xwin.h"
 #include "glsl_ext.h"
+#include "fifo.h"
 
 typeof(bind_types) bind_types = {
     [STDIN_TYPE_NONE]  = { .n = "NONE",  .i = STDIN_TYPE_NONE  },
@@ -93,6 +94,62 @@ static inline void register_wcb(struct gl_wcb* wcb) { wcbs[wcbs_idx++] = wcb; }
         register_wcb(&N);                       \
     } while (0)
 
+/* Audio session services.
+   The audio session created for the active renderer is shared between the
+   entry point (which drives the render loop) and the audio input backends
+   (which append to it from their streaming threads). Implementing these
+   operations here keeps the entire session lifecycle next to the renderer
+   state that parameterizes it, so every consumer manipulates the session
+   through the same rd_* surface instead of duplicating buffer traversal. */
+
+void rd_audio_zero(struct audio_data* audio) {
+    for (size_t t = 0; t < audio->audio_buf_sz; ++t) {
+        audio->audio_out_l[t] = 0.0F;
+        audio->audio_out_r[t] = 0.0F;
+    }
+}
+
+void rd_audio_shift_write(struct audio_data* audio, const float* l, const float* r) {
+    size_t fsz = audio->audio_buf_sz, ssz = audio->sample_sz;
+    size_t off = fsz - (ssz / 4);
+    float* bl = (float*) audio->audio_out_l;
+    float* br = (float*) audio->audio_out_r;
+    memmove(bl, &bl[ssz / 4], off * sizeof(float));
+    memmove(br, &br[ssz / 4], off * sizeof(float));
+    for (size_t n = 0; n < (ssz / 4); ++n) {
+        bl[off + n] = l[n];
+        br[off + n] = r[n];
+    }
+}
+
+void rd_audio_shift_silence(struct audio_data* audio) {
+    size_t fsz = audio->audio_buf_sz, ssz = audio->sample_sz;
+    size_t off = fsz - (ssz / 4);
+    float* bl = (float*) audio->audio_out_l;
+    float* br = (float*) audio->audio_out_r;
+    memmove(bl, &bl[ssz / 4], off * sizeof(float));
+    memmove(br, &br[ssz / 4], off * sizeof(float));
+    for (size_t q = 0; q < (ssz / 4); ++q) {
+        bl[off + q] = 0;
+        br[off + q] = 0;
+    }
+}
+
+bool rd_audio_read(struct audio_data* audio, float* lb, float* rb, size_t bsz) {
+    bool modified;
+    pthread_mutex_lock(&audio->mutex);
+    modified = audio->modified;
+    if (modified) {
+        /* create our own copies of the audio buffers, so the streaming
+           thread can continue to append to it */
+        memcpy(lb, (void*) audio->audio_out_l, bsz * sizeof(float));
+        memcpy(rb, (void*) audio->audio_out_r, bsz * sizeof(float));
+        audio->modified = false; /* set this flag to false until the next time we read */
+    }
+    pthread_mutex_unlock(&audio->mutex);
+    return modified;
+}
+
 /* GLSL bind source */
  
 struct gl_bind_src {
