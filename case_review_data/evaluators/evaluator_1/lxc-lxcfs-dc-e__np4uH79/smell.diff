+ * @hostswtotal:	The host's swap total, in kB.
+ * @swtotal_out:	Where to store the clamped swap total, in kB.
+ *
+ * In cgroups v1, the total amount of swap is always reported to be the lesser
+ * of the RAM+SWAP limit or the SWAP device size. This is because the kernel
+ * can swap as much as it wants and not only up to swtotal.
+ *
+ * When swappiness is 0, pretend we can't swap.
+ */
+static void apply_swap_policy(bool unified, uint64_t memlimit_kb,
+			      uint64_t swtotal, uint64_t swusage,
+			      uint64_t memswpriority, uint64_t hostswtotal,
+			      uint64_t *swtotal_out)
+{
+	if (!unified)
