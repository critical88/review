+	if (hostswtotal < swtotal)
+		swtotal = hostswtotal;
+
+	/* When swappiness is 0, pretend we can't swap. */
+	if (memswpriority == 0)
+		swtotal = swusage;
+
+	*swtotal_out = swtotal;
