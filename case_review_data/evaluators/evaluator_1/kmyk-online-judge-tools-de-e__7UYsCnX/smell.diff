+    def _load_legacy_v0(self, *, directory: pathlib.Path) -> List[str]:
+        """Import the history recorded in the old (pre-12) format.
+
+        Until 11.x, the history was recorded in a single JSON file named downloads.json, which lists the pairs of directories and URLs, and not in the current JSONL file. This method reads it for the given directory.
+        """
+        v0_path = self.path.parent / 'downloads.json'
+        if not v0_path.exists():
+            return []
+        logger.info('read history in the old format from: %s', str(v0_path))
+        found: Set[str] = set()
+        with open(v0_path) as fh:
+            records = json.load(fh)
+        for record in records:
+            if pathlib.Path(record['directory']) == directory:
+                found.add(record['url'])
+        return list(found)
