+def _render_tokens_legacy(tokens: List[_PrettyToken]) -> str:
+    """Render the tokens without colors, as the old (pre-12) pipeline did.
+
+    The old pipeline had no hints and no colors; it just made the whitespaces visible.
+    """
+    result = []
+    for _, value in tokens:
+        result.append(_replace_whitespace(value))
+    return ''.join(result)
+
+
+def make_pretty_diff_legacy(output_bytes: bytes, *, expected: str, compare_mode: CompareMode, limit: int) -> str:
+    """Render a diff of the outputs in the plain format of the old (pre-12) pipeline.
+
+    The old pipeline tokenized the outputs and rendered the tokens without colors, and then applied difflib.unified_diff to the rendered texts.
+    """
+    assert compare_mode != CompareMode.IGNORE_SPACES_AND_NEWLINES
+    rendered = _render_tokens_legacy(_tokenize_file_content_without_snipping(output_bytes))
+    expected_rendered = _render_tokens_legacy(_tokenize_file_content_without_snipping(expected.encode()))
