+class LegacyNormalizingComparator(OutputComparator):
+    """LegacyNormalizingComparator compares outputs after normalizing the Unicode normalization forms.
+
+    This comparator was used for the services like yukicoder whose expected outputs are sometimes written in different Unicode normalization forms. It was removed in 12.0 since the judgment for such cases is now delegated to the remote judge servers.
+    """
+
+    def __init__(self, file_comparator: OutputComparator):
+        self.file_comparator = file_comparator
+
+    def __call__(self, actual: bytes, expected: bytes) -> bool:
+        normalized_actual = unicodedata.normalize('NFKC', actual.decode(errors='replace'))
+        normalized_expected = unicodedata.normalize('NFKC', expected.decode(errors='replace'))
+        return self.file_comparator(normalized_actual.encode(), normalized_expected.encode())
+
+
