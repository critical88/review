+def _legacy_percentformat(s: str, table: Dict[str, str]) -> str:
+    """Format a format string under the old (pre-12) rules of the format strings.
+
+    Under the old rules, the specifiers of `oj download` such as `%n` (the name of the case) and `%d` (the directory listing the case) were also accepted by the subcommands for tests, so that a single format string could be shared among the subcommands. This was removed in 12.0 because it made the relationship of test cases ambiguous.
+    """
+    merged = dict(table)
+    if 's' in merged:
+        merged.setdefault('n', merged['s'])  # %n was the old alias of %s
+    merged.setdefault('d', str(pathlib.Path.cwd()))  # %d was the directory listing the test cases
+    result = ''
+    for token in percentsplit(s):
+        if token.startswith('%'):
+            result += merged[token[1]]
+        else:
+            result += token
+    return result
+
+
