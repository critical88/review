+"""This module keeps the compatibility switches for the old (pre-12) pipeline.
+
+The 12.0 release replaced several parts of the implementation at once: the rendering of the results of tests, the modes to compare outputs, the rules to parse format strings, the names of subcommands, and the format of the download history. To make the migration gradual, the old implementation was kept available for the users who still needed it, and the switches below were used to select it.
+
+The grace period ended in 12.0. The old pipeline is now retired: LEGACY_COMPATIBILITY_LEVEL is no longer configurable and is always 0. The switches and the old paths behind them are kept in this state, since it was planned to remove them gradually.
+"""
+
+# 0: the old pipeline is fully retired (current)
+# 1: use the old modes to compare outputs and the old rules to parse format strings
+# 2: additionally use the old rendering of the results, the old subcommand names, and the old format of the download history
+LEGACY_COMPATIBILITY_LEVEL = 0
+
+
+def use_legacy_rendering() -> bool:
+    """Return whether the old (pre-12) pipeline should be used to render the results."""
+    return LEGACY_COMPATIBILITY_LEVEL >= 2
+
+
+def use_legacy_comparator() -> bool:
+    """Return whether the old (pre-12) modes should be used to compare outputs."""
+    return LEGACY_COMPATIBILITY_LEVEL >= 1
+
+
+def use_legacy_format() -> bool:
+    """Return whether the old (pre-12) rules should be used to parse format strings."""
+    return LEGACY_COMPATIBILITY_LEVEL >= 1
+
+
+def use_legacy_command_names() -> bool:
+    """Return whether the old (pre-12) names of subcommands should be accepted."""
+    return LEGACY_COMPATIBILITY_LEVEL >= 2
+
+
+def use_legacy_history() -> bool:
+    """Return whether the old (pre-12) format of the download history should be imported."""
+    return LEGACY_COMPATIBILITY_LEVEL >= 1
