+def run_legacy_results_command(args: argparse.Namespace) -> bool:
+    """Print the results recorded by `oj test --log-file`, in the old (pre-12) format.
+
+    This printout was the body of the old `results` subcommand, which was removed in 12.0 in favor of just reading the JSON file.
+    """
+    if args.log_file is None:
+        logger.error('the results subcommand requires the log file of the test subcommand')
+        return False
+    with args.log_file.open() as fh:
+        history = json.load(fh)
+    ac_count = 0
+    for result in history:
+        logger.info('%s: %s', result['testcase']['name'], result['status'])
+        if result['status'] == 'AC':
+            ac_count += 1
+    logger.info('%d AC / %d cases', ac_count, len(history))
+    return ac_count == len(history)
+
