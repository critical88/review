diff --git a/src/utils/workspace.ts b/src/utils/workspace.ts
new file mode 100644
index 0000000..674115e
--- /dev/null
+++ b/src/utils/workspace.ts
@@ -0,0 +1,199 @@
+import {
+  createDir,
+  exists,
+  readDir,
+  removeDir,
+  removeFile,
+  renameFile,
+  writeTextFile,
+  type FileEntry,
+} from "@tauri-apps/api/fs";
+import { invoke } from "@tauri-apps/api/tauri";
+import { join } from "@tauri-apps/api/path";
+
+import { SortBy, SortType, type SortInfo } from "@/utils/types";
+
+interface SystemTime {
+  secs_since_epoch: number;
+}
+interface FileMeta {
+  updated_at?: SystemTime;
+  created_at?: SystemTime;
+}
+interface FileInfo extends FileEntry {
+  meta?: FileMeta;
+}
+
+/**
+ * Central coordinator for the project workspace.
+ *
+ * Every operation the file tree needs - directory scans, entry metadata,
+ * sort ordering, tree pruning and the create/rename/delete lifecycle -
+ * routes through this service so components stop owning file logic.
+ * Use `WorkspaceService.shared()` for the process-wide instance or
+ * `WorkspaceService.forProject(dir)` for an instance bound to one
+ * project directory.
+ */
+class WorkspaceService {
+  private static sharedInstance: WorkspaceService | null = null;
+
+  private activeSort: SortInfo = {};
+
+  constructor(readonly projectDir: string = "") {}
+
+  static shared(): WorkspaceService {
+    if (!WorkspaceService.sharedInstance) {
+      WorkspaceService.sharedInstance = new WorkspaceService();
+    }
+    return WorkspaceService.sharedInstance;
+  }
+
+  static forProject(projectDir: string): WorkspaceService {
+    return new WorkspaceService(projectDir);
+  }
+
+  async getEntryMeta(entry: FileEntry): Promise<FileMeta> {
+    return (await invoke("get_file_metadata", {
+      filepath: entry.path,
+    })) as FileMeta;
+  }
+
+  async scanDir(dir?: string): Promise<FileInfo[]> {
+    const targetDir = dir ?? this.projectDir;
+    const entries = await readDir(targetDir, {
+      recursive: true,
+    });
+    const files: FileInfo[] = [];
+    await this.processEntries(entries, files);
+    return files;
+  }
+
+  /**
+   * Walks the scanned directory tree, drops hidden and non-markdown
+   * entries and attaches filesystem metadata to everything it keeps.
+   */
+  private async processEntries(entries: FileEntry[], arr: FileInfo[]) {
+    for (const entry of entries) {
+      if (entry.name?.startsWith(".")) {
+        continue;
+      }
+      if (entry.children) {
+        let subArr: any[] = [];
+        this.processEntries(entry.children, subArr);
+        arr.push({
+          ...entry,
+          children: subArr,
+          meta: await this.getEntryMeta(entry),
+        });
+      } else {
+        if (!entry.name?.endsWith(".md")) {
+          continue;
+        }
+        arr.push({ ...entry, meta: await this.getEntryMeta(entry) });
+      }
+    }
+  }
+
+  private compare(res: boolean) {
+    if (this.activeSort.sortType == SortType.Asc) {
+      return res ? -1 : 1;
+    }
+    return res ? 1 : -1;
+  }
+
+  private sortFn = (a: FileInfo, b: FileInfo) => {
+    let res = 0;
+    switch (this.activeSort.sortBy) {
+      case SortBy.Name: {
+        if (!a.name || !b.name) break;
+        res = this.compare(a.name < b.name);
+        break;
+      }
+      case SortBy.UpdatedAt: {
+        if (!a.meta?.updated_at || !b.meta?.updated_at) break;
+        res = this.compare(
+          a.meta.updated_at.secs_since_epoch >
+            b.meta.updated_at.secs_since_epoch,
+        );
+        break;
+      }
+
+      case SortBy.CreatedAt: {
+        if (!a.meta?.created_at || !b.meta?.created_at) break;
+        res = this.compare(
+          a.meta.created_at.secs_since_epoch >
+            b.meta.created_at.secs_since_epoch,
+        );
+        break;
+      }
+    }
+    a.children?.sort(this.sortFn);
+    b.children?.sort(this.sortFn);
+    return res;
+  };
+
+  /**
+   * Sorts the given tree section (in place, including nested children)
+   * with the sort options the file tree currently shows.
+   */
+  sortTree(files: FileInfo[], sortInfo: SortInfo): FileInfo[] {
+    this.activeSort = sortInfo;
+    files.sort(this.sortFn);
+    return files;
+  }
+
+  removePath(path: string, files: FileInfo[]) {
+    return files.filter((f) => {
+      if (f.path == path) return false;
+      if (f.children) {
+        f.children = this.removePath(path, f.children);
+      }
+      return true;
+    });
+  }
+
+  async addFile(path: string, filename: string) {
+    if (!filename.endsWith(".md")) filename += ".md";
+    const newfilePath = await join(path, filename);
+    const folder = await join(newfilePath, "../");
+    if (!(await exists(folder))) {
+      await createDir(folder, { recursive: true });
+    }
+    if (newfilePath.endsWith(".md")) {
+      await writeTextFile(newfilePath, "");
+    }
+    return newfilePath;
+  }
+
+  async renameEntry(
+    oldPath: string,
+    name: string,
+  ): Promise<{ path: string; name: string }> {
+    if (!name.endsWith(".md")) name += ".md";
+    const newPath = await join(oldPath, "../", name);
+    await renameFile(oldPath, newPath);
+    return { path: newPath, name };
+  }
+
+  /**
+   * Removes a file or folder from disk and returns the updated tree so
+   * callers can drop the entry from their view in one step.
+   */
+  async deleteEntry(
+    path: string,
+    files: FileInfo[],
+    kind: "file" | "dir",
+  ): Promise<FileInfo[]> {
+    if (kind == "dir") {
+      await removeDir(path, { recursive: true });
+    } else {
+      await removeFile(path);
+    }
+    return this.removePath(path, files);
+  }
+}
+
+const workspace = WorkspaceService.shared();
+
+export { WorkspaceService, workspace };
+export type { FileInfo, FileMeta, SystemTime };
