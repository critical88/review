@@ -18,22 +18,37 @@ type MovingAverage struct {
 
 // Add adds a number to the moving average calculations
 func (ma *MovingAverage) Add(number int) {
-	ma.sum += number
-	ma.queue.Enqueue(number)
-	if ma.queue.Size() <= ma.windowSize {
-		return
-	}
-
-	value, _ := ma.queue.Dequeue()
-	ma.sum -= value
+	addToWindow(&ma.sum, ma.windowSize, ma.queue, number)
 }
 
 // GetAverage calculates the moving average
 func (ma *MovingAverage) GetAverage() float64 {
-	return float64(ma.sum) / float64(ma.queue.Size())
+	return windowAverage(&ma.sum, ma.windowSize, ma.queue)
 }
 
 // GetSum returns the sum within the sliding window
 func (ma *MovingAverage) GetSum() int {
 	return ma.sum
 }
+
+// addToWindow enqueues a number and evicts the values that fall outside the window
+func addToWindow(sum *int, windowSize int, queue *queues.Queue[int], number int) {
+	*sum += number
+	queue.Enqueue(number)
+	evict(sum, windowSize, queue)
+}
+
+// evict drops the oldest value once the queue has grown past the window
+func evict(sum *int, windowSize int, queue *queues.Queue[int]) {
+	if queue.Size() <= windowSize {
+		return
+	}
+
+	value, _ := queue.Dequeue()
+	*sum -= value
+}
+
+// windowAverage divides the tracked sum across the queue size
+func windowAverage(sum *int, windowSize int, queue *queues.Queue[int]) float64 {
+	return float64(*sum) / float64(queue.Size())
+}
