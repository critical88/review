+// isOpen determines whether the cell at a position can be entered
+func isOpen(world *GridWorld, i int, j int) bool {
+	if !world.IsValid(i, j) {
+		return false
+	}
+	return !world.Get(i, j).IsObstacle
+}
+
+// nodeAt fetches the node at a position, guarded by a bounds check
+func nodeAt(world *GridWorld, i int, j int) *GridNode {
+	if !world.IsValid(i, j) {
+		return nil
+	}
+	return world.Get(i, j)
+}
