+// validateDomainRecord checks a single domain record, given as its loose
+// fields, against the multi-provider configuration. providerName is the
+// domain-specific provider assignment, possibly empty.
+func validateDomainRecord(domainName string, subDomains []string, providerName string, config *settings.Settings) error {
+	if domainName == "" {
+		return errors.New("domain name should not be empty")
+	}
 
-		// Check if the provider is configured
-		if d.Provider != "" {
-			// Domain has specific provider - check if it's configured in providers
-			if _, exists := config.Providers[d.Provider]; !exists {
-				return fmt.Errorf("domain '%s' references provider '%s' which is not configured in providers section", d.DomainName, d.Provider)
-			}
-		} else if config.Provider == "" {
-			// No domain-specific provider and no global provider
-			return fmt.Errorf("domain '%s' has no provider specified and no global provider is configured", d.DomainName)
+	// Validate subdomains
+	for _, sd := range subDomains {
+		if sd == "" {
+			return errors.New("subdomain should not be empty")
 		}
-		// If domain doesn't specify provider but global provider exists, that's valid (mixed mode)
 	}
 
+	// Get the provider for this domain (either domain-specific or global fallback)
+	resolvedProvider := providerName
+	if resolvedProvider == "" {
+		resolvedProvider = config.Provider
+	}
+	if resolvedProvider == "" {
+		return fmt.Errorf("no provider configured for domain '%s'", domainName)
+	}
+
+	// Check if the provider is configured
+	if providerName != "" {
+		// Domain has specific provider - check if it's configured in providers
+		if _, exists := config.Providers[providerName]; !exists {
+			return fmt.Errorf("domain '%s' references provider '%s' which is not configured in providers section", domainName, providerName)
+		}
+	} else if config.Provider == "" {
+		// No domain-specific provider and no global provider
+		return fmt.Errorf("domain '%s' has no provider specified and no global provider is configured", domainName)
+	}
+	// If domain doesn't specify provider but global provider exists, that's valid (mixed mode)
+
 	return nil
 }
 
