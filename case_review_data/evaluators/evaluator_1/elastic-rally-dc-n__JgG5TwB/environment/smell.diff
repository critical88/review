+def store_cluster_environment_info(
+    metrics_store,
+    distribution_flavor,
+    distribution_version,
+    revision,
+    target_id,
+    target_platform,
+    target_auth_type,
+):
+    """
+    Publishes the target cluster's identity facts as cluster-scoped meta-info.
+
+    The exact same facts are also forwarded by the driver once track preparation
+    has completed (see ``PreparationComplete`` in ``esrally.driver.driver``), so
+    this helper's parameter list deliberately mirrors the values that travel
+    through that path: distribution flavor and version, build revision, the
+    cluster's id, the platform it runs on and the authentication type Rally
+    used to talk to it.
+
+    :param metrics_store: The metrics store that records cluster-scoped meta-info.
+    :param distribution_flavor: The target cluster's distribution flavor (e.g. ``default``, ``oss`` or ``serverless``).
+    :param distribution_version: The target cluster's version number.
+    :param revision: The target cluster's build revision.
+    :param target_id: Identifies the benchmark target (project ID for serverless, cluster ID for ECH, cluster name for on-prem) if known.
+    :param target_platform: The platform the target cluster runs on (one of ``serverless``, ``hosted`` or ``on-prem``).
+    :param target_auth_type: The authentication type Rally used to connect (``api_key`` or ``basic``) if recorded.
+    """
+    metrics_store.add_meta_info(metrics.MetaInfoScope.cluster, None, "source_revision", revision)
+    metrics_store.add_meta_info(metrics.MetaInfoScope.cluster, None, "distribution_version", distribution_version)
+    metrics_store.add_meta_info(metrics.MetaInfoScope.cluster, None, "distribution_flavor", distribution_flavor)
+    # Store target ID (project ID for serverless, cluster ID for ECH, cluster name for on-prem)
+    if target_id:
+        metrics_store.add_meta_info(metrics.MetaInfoScope.cluster, None, "target_id", target_id)
+    metrics_store.add_meta_info(metrics.MetaInfoScope.cluster, None, "target_platform", target_platform)
+    if target_auth_type:
+        metrics_store.add_meta_info(metrics.MetaInfoScope.cluster, None, "target_auth_type", target_auth_type)
+
+
