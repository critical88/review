+def remember_target_cluster(
+    driver_actor, cluster_details, distribution_flavor, distribution_version, revision, target_id, target_platform, target_auth_type
+):
+    """
+    Stores the identity facts of the cluster that we are benchmarking on the main driver actor.
+
+    ``Driver.prepare_benchmark`` derives these values while the benchmark candidate is
+    still reachable. This keeps the raw cluster info - needed by the actor's child
+    helpers - next to the resolved identity facts that are forwarded to race control
+    once track preparation has completed (see ``DriverActor._after_track_prepared``).
+    The parameter list matches the one used by the other paths that pass these facts
+    around (e.g. ``PreparationComplete``), so it stays easy to keep them in sync.
+
+    :param driver_actor: The main driver actor that remembers the target cluster's facts.
+    :param cluster_details: The raw cluster info response (may be empty if the REST API check was skipped).
+    :param distribution_flavor: The target cluster's distribution flavor (defaults to ``oss`` for unknown builds).
+    :param distribution_version: The target cluster's version number.
+    :param revision: The target cluster's build revision.
+    :param target_id: Identifies the benchmark target (project ID for serverless, cluster ID for ECH, cluster name for on-prem) if known.
+    :param target_platform: The platform the target cluster runs on (one of ``serverless``, ``hosted`` or ``on-prem``).
+    :param target_auth_type: The authentication type Rally used to connect (``api_key`` or ``basic``) if recorded.
+    """
+    driver_actor.cluster_details = cluster_details
+    driver_actor.distribution_flavor = distribution_flavor
+    driver_actor.distribution_version = distribution_version
+    driver_actor.revision = revision
+    driver_actor.target_id = target_id
+    driver_actor.target_platform = target_platform
+    driver_actor.target_auth_type = target_auth_type
+
+
