+    def record_target_cluster(
+        self, distribution_flavor, distribution_version, revision, target_id=None, target_platform=None, target_auth_type=None
+    ):
+        """
+        Records the identity facts of the cluster that this race has benchmarked.
+
+        The values arrive via the driver, once track preparation has completed. They are
+        passed through in the same shape in which they travel through the preparation
+        path (see ``esrally.driver.driver.DriverActor``), i.e. distribution flavor and
+        version, build revision, the cluster's id, the platform it runs on and the
+        authentication type that Rally used to talk to it.
+
+        :param distribution_flavor: The target cluster's distribution flavor.
+        :param distribution_version: The target cluster's version number.
+        :param revision: The target cluster's build revision.
+        :param target_id: Identifies the benchmark target if known. ``None`` keeps the current value.
+        :param target_platform: The platform the target cluster runs on. ``None`` keeps the current value.
+        :param target_auth_type: The authentication type Rally used to connect. ``None`` keeps the current value.
+        """
+        self.distribution_flavor = distribution_flavor
+        self.distribution_version = distribution_version
+        self.revision = revision
+        if target_id is not None:
+            self.target_id = target_id
+        if target_platform is not None:
+            self.target_platform = target_platform
+        if target_auth_type is not None:
+            self.target_auth_type = target_auth_type
+
     @property
     def track_name(self):
         return str(self.track)
