+class TargetCluster:
+    """
+    The identity of the cluster that a race benchmarks.
+
+    Bundles the resolved facts about the benchmark target so that they travel
+    through the preparation and telemetry paths as a single value rather than
+    a long, order-sensitive parameter list: its distribution flavor and
+    version, build revision, the identifier of the target itself (a project ID
+    for serverless, a cluster ID for hosted, a cluster name for on-prem), the
+    platform it runs on (``serverless``, ``hosted`` or ``on-prem``) and the
+    auth style Rally used to connect (``api_key`` or ``basic``).
+
+    ``Driver.prepare_benchmark`` and the ``ClusterEnvironmentInfo`` telemetry
+    device each derive one of these while the candidate is reachable; it is
+    then forwarded (driver -> race control -> ``Race``) and recorded as
+    metrics-store meta-info.
+    """
+
+    def __init__(self, distribution_flavor, distribution_version, revision, target_id=None, target_platform=None, target_auth_type=None):
+        self.distribution_flavor = distribution_flavor
+        self.distribution_version = distribution_version
+        self.revision = revision
+        self.target_id = target_id
+        self.target_platform = target_platform
+        self.target_auth_type = target_auth_type
+
+
