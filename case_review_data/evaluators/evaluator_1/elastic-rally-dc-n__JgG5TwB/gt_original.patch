+@dataclass
+class TargetCluster:
+    """
+    Identity facts of the cluster that a race benchmarks.
+
+    These facts always describe the same thing - the benchmark target - and they
+    travel together along the whole preparation path: the driver derives them
+    while the cluster is still reachable, telemetry devices record them as
+    cluster-level meta-info, and once track preparation has completed race
+    control attaches them to the race. They are therefore carried by this one,
+    cohesive object instead of being threaded through many parameter lists as
+    unrelated values. The ``oss`` defaults model a cluster whose build facts
+    could not be determined (e.g. because the REST API check was skipped).
+    """
+
+    distribution_flavor: Optional[str] = "oss"
+    distribution_version: Optional[str] = "oss"
+    revision: Optional[str] = "oss"
+    target_id: Optional[str] = None
+    target_platform: Optional[str] = None
+    target_auth_type: Optional[str] = None
+
+
