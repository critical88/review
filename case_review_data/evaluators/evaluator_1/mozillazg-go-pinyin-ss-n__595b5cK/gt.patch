diff --git a/render_policy.go b/render_policy.go
new file mode 100644
index 0000000..f1157b2
--- /dev/null
+++ b/render_policy.go
@@ -0,0 +1,72 @@
+package pinyin
+
+// toneKind describes how a syllable's tone (carried in the input as a
+// diacritic on a vowel) is represented in the rendered output.
+type toneKind int
+
+const (
+	// toneDiacritic keeps the tone as a diacritic on the vowel, e.g. ā.
+	toneDiacritic toneKind = iota
+	// toneNumeric renders the tone as a digit, e.g. a1.
+	toneNumeric
+	// toneNone drops the tone entirely, e.g. a.
+	toneNone
+)
+
+// renderPolicy captures how a single Style is transformed into its final
+// textual form. This is the single owner of all per-Style rendering decisions:
+// decodePhoneticSymbol (tone + tailTone), extractFinals (finals),
+// applyStyle (firstLetter) and SinglePinyin (initials) each consult the
+// policy returned by renderPolicyFor instead of re-deriving the Style mapping.
+//
+// To add a new rendering option (for example another numeric-tone variant),
+// add the Style constant and a single case to renderPolicyFor — nothing else.
+type renderPolicy struct {
+	// tone marks how a syllable's tone is rendered. Default zero value is
+	// toneDiacritic, matching the historical behaviour of unknown Styles.
+	tone toneKind
+	// tailTone moves a numeric tone mark to the end of the syllable, as used
+	// by Tone3 / FinalsTone3.
+	tailTone bool
+	// finals drops the initial consonant and keeps only the final(s), as
+	// used by the Finals family. Nasal-only syllables (ḿ ń ň ǹ) have no
+	// initial to drop, so the nasal character is preserved as-is.
+	finals bool
+	// firstLetter keeps only the first rune of the rendered syllable, as
+	// used by FirstLetter.
+	firstLetter bool
+	// initials replaces each syllable with just its initial consonant, as
+	// used by Initials.
+	initials bool
+}
+
+// renderPolicyFor returns the renderPolicy describing how the Style carried by
+// a should be rendered. Every per-Style rendering decision is made here.
+func renderPolicyFor(a Args) renderPolicy {
+	switch a.Style {
+	case Normal:
+		return renderPolicy{tone: toneNone}
+	case FirstLetter:
+		return renderPolicy{tone: toneNone, firstLetter: true}
+	case Finals:
+		return renderPolicy{tone: toneNone, finals: true}
+	case Tone:
+		return renderPolicy{tone: toneDiacritic}
+	case Tone2:
+		return renderPolicy{tone: toneNumeric}
+	case Tone3:
+		return renderPolicy{tone: toneNumeric, tailTone: true}
+	case FinalsTone:
+		return renderPolicy{tone: toneDiacritic, finals: true}
+	case FinalsTone2:
+		return renderPolicy{tone: toneNumeric, finals: true}
+	case FinalsTone3:
+		return renderPolicy{tone: toneNumeric, tailTone: true, finals: true}
+	case Initials:
+		return renderPolicy{tone: toneDiacritic, initials: true}
+	default:
+		// Unknown Styles behave like Tone: the diacritic is kept and no
+		// other transformation is applied.
+		return renderPolicy{tone: toneDiacritic}
+	}
+}
