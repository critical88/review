+/**
+ * Applies the interactive state of the original content onto its cloned
+ * counterpart in a single pass, the way the legacy flow did before the work was
+ * split out by element kind. Only the legacy print flow consults this entry
+ * point; the modern flow handles each element kind where it is loaded.
+ */
+export function applyClonedElementState(contentNode: Node, clonedContentNode: Node): void {
+    const sourceElement = contentNode as Element;
+    const targetElement = clonedContentNode as Element;
+
+    // Copy select states. Without this, the first select option is printed,
+    // regardless of selection state
+    const sourceSelects = sourceElement.querySelectorAll("select");
+    const targetSelects = targetElement.querySelectorAll("select");
+    for (let i = 0; i < sourceSelects.length; i++) {
+        targetSelects[i].value = sourceSelects[i].value;
+    }
+
+    // Copy text area states
+    const sourceTextAreas = sourceElement.querySelectorAll("textarea");
+    const targetTextAreas = targetElement.querySelectorAll("textarea");
+    for (let i = 0; i < sourceTextAreas.length; i++) {
+        targetTextAreas[i].value = sourceTextAreas[i].value;
+    }
+
+    // Copy input states. Clones do not carry over user-entered or toggled state
+    const sourceInputs = sourceElement.querySelectorAll("input");
+    const targetInputs = targetElement.querySelectorAll("input");
+    for (let i = 0; i < sourceInputs.length; i++) {
+        const sourceInput = sourceInputs[i];
+        const targetInput = targetInputs[i];
+        if (sourceInput.type === "checkbox" || sourceInput.type === "radio") {
+            targetInput.checked = sourceInput.checked;
+        } else {
+            targetInput.value = sourceInput.value;
+        }
+    }
+}
