-    const boundingRect = referenceElement.getBoundingClientRect();
-    const minimumWidth = readPixelLength(MINIMUM_PREVIEW_VIEWPORT.width) ?? 480;
-    const minimumHeight = readPixelLength(MINIMUM_PREVIEW_VIEWPORT.height) ?? 640;
