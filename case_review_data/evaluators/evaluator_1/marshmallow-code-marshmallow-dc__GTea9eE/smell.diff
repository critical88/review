diff --git a/src/marshmallow/nesting.py b/src/marshmallow/nesting.py
new file mode 100644
index 0000000..9b7eac8
--- /dev/null
+++ b/src/marshmallow/nesting.py
@@ -0,0 +1,82 @@
+"""Helpers for propagating schema field-selection selectors to nested schemas.
+
+The four selectors ``only``, ``exclude``, ``load_only`` and ``dump_only`` describe
+which fields a nested schema keeps and in which direction.  These helpers keep
+that propagation in one place; each selector is threaded separately through the
+helper signatures instead of inline inside the schema and field classes.
+
+.. warning::
+
+    This module is treated as private API.  Users should not need to use it
+    directly.
+"""
+
+from __future__ import annotations
+
+import typing
+
+from marshmallow import types
+
+
+def flatten_top_selectors(
+    only: types.StrSequenceOrSet | None,
+    exclude: types.StrSequenceOrSet,
+    set_factory: type,
+) -> tuple[typing.Any | None, typing.MutableSet[typing.Any]]:
+    """Strip dotted nested field names out of the top-level ``only``/``exclude`` selectors.
+
+    The ``only`` selector keeps the parent field name of every dotted entry
+    (``"nested.field"`` -> ``"nested"``).  The ``exclude`` selector drops any
+    dotted entry, because the parent field name is already excluded by the
+    nested schema's own handling.
+    """
+    flat_only = None
+    if only is not None:
+        flat_only = set_factory([field.split(".", 1)[0] for field in only])
+    flat_exclude = set_factory([field for field in exclude if "." not in field])
+    return flat_only, flat_exclude
+
+
+def prefixed_nested_selectors(
+    load_only: types.StrSequenceOrSet,
+    dump_only: types.StrSequenceOrSet,
+    name: str,
+) -> tuple[list[str], list[str]]:
+    """Resolve the ``load_only``/``dump_only`` selectors inherited from the root schema for the nested field named *name*.
+
+    ``"name.field"`` entries on the root become ``"field"`` on the nested schema;
+    entries that do not start with the field's prefix are dropped.
+    """
+    prefix = f"{name}."
+    nested_load_only = [
+        field.split(prefix, 1)[1] for field in load_only if field.startswith(prefix)
+    ]
+    nested_dump_only = [
+        field.split(prefix, 1)[1] for field in dump_only if field.startswith(prefix)
+    ]
+    return nested_load_only, nested_dump_only
+
+
+def build_nested_schema_kwargs(
+    many: bool | None,
+    only: types.StrSequenceOrSet | None,
+    exclude: types.StrSequenceOrSet,
+    name: str,
+    load_only: types.StrSequenceOrSet,
+    dump_only: types.StrSequenceOrSet,
+) -> dict[str, typing.Any]:
+    """Build the keyword arguments used to instantiate a nested schema class.
+
+    ``only`` and ``exclude`` pass through from the parent ``Nested`` field, while
+    ``load_only`` and ``dump_only`` are resolved from the root schema by prefix.
+    """
+    nested_load_only, nested_dump_only = prefixed_nested_selectors(
+        load_only, dump_only, name
+    )
+    return {
+        "many": bool(many),
+        "only": only,
+        "exclude": exclude,
+        "load_only": nested_load_only,
+        "dump_only": nested_dump_only,
+    }
