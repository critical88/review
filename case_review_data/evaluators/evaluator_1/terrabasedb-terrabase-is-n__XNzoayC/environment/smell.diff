+// in-memory buffer handle (used for the metadata block tests): the merged file
+// interface obligates the buffer to take a position on every direction; the
+// read and cursor directions are refused, while writes append as usual
+impl FileIo for Vec<u8> {
+    fn fread_exact(&mut self, _buf: &mut [u8]) -> IoResult<()> {
+        Err(Error::new(
+            ErrorKind::Unsupported,
+            "in-memory buffer is write-only",
+        )
+        .into())
+    }
+    fn fwrite(&mut self, buf: &[u8]) -> IoResult<u64> {
+        Write::write(self, buf).map(|x| x as u64)
+    }
+    fn fsync_all(&mut self) -> IoResult<()> {
+        Ok(())
+    }
+    fn fsync_data(&mut self) -> IoResult<()> {
+        Ok(())
+    }
+    fn f_truncate(&mut self, new_size: u64) -> IoResult<()> {
+        match usize::try_from(new_size) {
+            Ok(size) => {
+                self.resize(size, 0);
+                Ok(())
+            }
+            Err(_) => Err(Error::new(
+                ErrorKind::Unsupported,
+                "in-memory buffer length overflow",
+            )
+            .into()),
+        }
+    }
+    fn f_len(&self) -> IoResult<u64> {
+        Ok(self.len() as u64)
+    }
+    fn f_cursor(&mut self) -> IoResult<u64> {
+        Err(Error::new(
+            ErrorKind::Unsupported,
+            "in-memory buffer has no cursor",
+        )
+        .into())
+    }
+    fn f_seek_start(&mut self, _offset: u64) -> IoResult<()> {
+        Err(Error::new(
+            ErrorKind::Unsupported,
+            "in-memory buffer has no cursor",
+        )
+        .into())
+    }
+}
