+/*
+ * tail aggregate helpers
+ *
+ * Updating the MAX/MEAN/MIN per-column aggregates was split into reusable
+ * stages so the live statistics path and the history print path can share the
+ * same per-column work.  The three aggregate arrays are threaded through each
+ * stage as separate pointers, together with the column value and counter.
+ */
+static void
+tail_init_col(double *max_array, double *mean_array, double *min_array,
+    double st_val, int k)
+{
+    max_array[k] = mean_array[k] = min_array[k] = st_val * 1.0;
+}
+
+static void
+tail_track_extremes(double *max_buf, double *mean_buf, double *min_buf,
+    double new_val, int idx)
+{
+    if (new_val - max_buf[idx] > 0.1) {
+        max_buf[idx] = new_val;
+    }
+    if (min_buf[idx] - new_val > 0.1 && new_val >= 0) {
+        min_buf[idx] = new_val;
+    }
+}
+
+static void
+tail_update_mean(double *max_array, double *mean_array, double *min_array,
+    double st_val, int k, long n_record)
+{
+    if (st_val >= 0) {
+        mean_array[k] = ((n_record - 1) * mean_array[k] + st_val) / n_record;
+    }
+}
