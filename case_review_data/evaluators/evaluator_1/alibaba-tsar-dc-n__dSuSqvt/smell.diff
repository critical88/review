+/*
+ * pick the per-column aggregate array requested for tail printing
+ */
+static double *
+pick_tail_array(double *max_array, double *mean_array, double *min_array,
+    int tail_type)
+{
+    switch (tail_type) {
+        case TAIL_MAX:
+            return max_array;
+        case TAIL_MEAN:
+            return mean_array;
+        case TAIL_MIN:
+            return min_array;
+        default:
+            return NULL;
+    }
+}
