+/**
+ * Returns the month number carried by a month select.
+ * Unlike number inputs, a select yields plain strings, and an empty select yields
+ * no month at all. Both cases fall back to January.
+ */
+export function selectMonthNumberToUse(rawMonthValue: string | number | undefined): number {
+  const monthNumber = Number(rawMonthValue);
+
+  return Number.isNaN(monthNumber) ? 1 : monthNumber;
+}
