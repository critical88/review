+  /**
+   * Resizes an HWC tensor with bilinear interpolation.
+   */
+  resizeTensor(
+    imageTensor: NdArray<Uint8Array>,
+    newWidth: number,
+    newHeight: number,
+    proportional: boolean = false
+  ): NdArray<Uint8Array> {
+    return tensorResizeBilinear(
+      imageTensor,
+      newWidth,
+      newHeight,
+      proportional
+    );
+  }
+
+  /**
+   * Normalizes an HWC rgba tensor into a 1x3xHxW float tensor.
