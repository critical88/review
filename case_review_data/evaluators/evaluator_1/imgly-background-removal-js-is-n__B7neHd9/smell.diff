+export { SegmentationBackend, SegmentationSession };
+export type { ImageSource } from '../utils';
+
+import type { InferenceSession } from 'onnxruntime-node';
+import type { NdArray } from 'ndarray';
+import type { Config } from '../schema';
+import type { ImageSource } from '../utils';
+
+/**
+ * The single contract every segmentation backend has to provide.
+ *
+ * A backend owns the complete path from raw image bytes to a composed alpha
+ * mask: decoding and re-encoding images, the tensor math used to feed and
+ * post-process the model, access to the chunked resource bundle, and the
+ * onnx model runtime itself. Grouping these stages in one place keeps the
+ * switch to a different runtime (wasm, gpu, remote inference) to a single
+ * implementation.
+ */
+interface SegmentationBackend {
+  /**
+   * Decodes an arbitrary image source (path, url, blob, buffer) into an
+   * HWC rgba tensor.
+   */
+  decodeImage(source: ImageSource, config: Config): Promise<NdArray<Uint8Array>>;
+
+  /**
+   * Encodes an HWC rgba tensor into a Blob of the requested format.
+   */
+  encodeImage(
+    imageTensor: NdArray<Uint8Array>,
+    quality: number,
+    format: string
+  ): Promise<Blob>;
+
+  /**
+   * Resizes an HWC tensor with bilinear interpolation.
+   */
+  resizeTensor(
+    imageTensor: NdArray<Uint8Array>,
+    newWidth: number,
+    newHeight: number
+  ): NdArray<Uint8Array>;
+
+  /**
+   * Normalizes an HWC rgba tensor into a 1x3xHxW float tensor.
+   */
+  hwcToBchw(
+    imageTensor: NdArray<Uint8Array>,
+    mean?: number[],
+    std?: number[]
+  ): NdArray<Float32Array>;
+
+  /**
+   * Computes the largest size that fits into the given box without
+   * distorting the aspect ratio.
+   */
+  proportionalSize(
+    originalWidth: number,
+    originalHeight: number,
+    maxWidth: number,
+    maxHeight: number
+  ): [number, number];
+
+  /**
+   * Converts a float mask into its u8 representation.
+   */
+  float32ToUint8(
+    float32Array: NdArray<Float32Array>
+  ): NdArray<Uint8Array>;
+
+  /**
+   * Resolves a possibly relative url against a base url.
+   */
+  resolveUri(url: string, baseUrl: string): URL;
+
+  /**
+   * Loads any supported protocol into a fetch-like response.
+   */
+  fetchResponse(uri: URL, config: Config): Promise<Response>;
+
+  /**
+   * Assembles a chunked resource from the bundle behind config.publicPath.
+   */
+  fetchBlob(key: string, config: Config): Promise<Blob>;
+
+  /**
+   * Same as fetchBlob but yields an object url, used for wasm modules.
+   */
+  fetchResourceUrl(key: string, config: Config): Promise<string>;
+
+  /**
+   * Creates the onnx session for a model byte buffer.
+   */
+  createSession(
+    model: ArrayBuffer,
+    config: Config
+  ): Promise<SegmentationSession>;
+
+  /**
+   * Runs the session with the given feeds and collects the outputs.
+   */
+  runSession(
+    session: SegmentationSession,
+    inputs: [string, NdArray<Float32Array>][],
+    outputs: [string]
+  ): Promise<NdArray<Float32Array>[]>;
+}
+
+/**
+ * The session handle a backend creates and later runs. The Node backend runs
+ * in-process, so the handle is the onnxruntime session itself.
+ */
+type SegmentationSession = InferenceSession;
