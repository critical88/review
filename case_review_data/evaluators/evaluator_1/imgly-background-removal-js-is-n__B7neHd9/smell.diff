+export { CanvasSegmentationBackend };
+
+import { BaseSegmentationBackend } from './base';
+import type { SegmentationSession } from './types';
+
+import type { NdArray } from 'ndarray';
+import type { Config } from '../schema';
+import type { ImageSource } from '../utils';
+
+import { imageEncode } from '../codecs';
+import { imageSourceToImageData } from '../utils';
+import { createOnnxSession, runOnnxSession } from '../onnx';
+
+/**
+ * The browser segmentation backend: it decodes and encodes through the
+ * canvas APIs and runs models with onnxruntime-web.
+ */
+class CanvasSegmentationBackend extends BaseSegmentationBackend {
+  /**
+   * Decodes browser-supported image sources into an HWC rgba tensor.
+   */
+  async decodeImage(
+    source: ImageSource,
+    config: Config
+  ): Promise<NdArray<Uint8Array>> {
+    return await imageSourceToImageData(source, config);
+  }
+
+  /**
+   * Encodes an HWC rgba tensor into a Blob of the requested canvas format.
+   */
+  async encodeImage(
+    imageTensor: NdArray<Uint8Array>,
+    quality: number,
+    format: string
+  ): Promise<Blob> {
+    return await imageEncode(imageTensor, quality, format);
+  }
+
+  /**
+   * Creates the onnxruntime-web session for a model byte buffer.
+   */
+  async createSession(
+    model: ArrayBuffer,
+    config: Config
+  ): Promise<SegmentationSession> {
+    return await createOnnxSession(model, config);
+  }
+
+  /**
+   * Runs the onnxruntime-web session with the given feeds.
+   */
+  async runSession(
+    session: SegmentationSession,
+    inputs: [string, NdArray<Float32Array>][],
+    outputs: [string],
+    config: Config
+  ): Promise<NdArray<Float32Array>[]> {
+    return await runOnnxSession(session, inputs, outputs, config);
+  }
+}
