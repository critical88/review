@@ -0,0 +1,60 @@
+export { SharpSegmentationBackend };
+
+import { BaseSegmentationBackend } from './base';
+import type { SegmentationSession } from './types';
+
+import type { NdArray } from 'ndarray';
+import type { Config } from '../schema';
+import type { ImageSource } from '../utils';
+
+import { imageEncode } from '../codecs';
+import { imageSourceToImageData } from '../utils';
+import { createOnnxSession, runOnnxSession } from '../onnx';
+
+/**
+ * The Node.js segmentation backend: it decodes and encodes with sharp and
+ * runs models with onnxruntime-node.
+ */
+class SharpSegmentationBackend extends BaseSegmentationBackend {
+  /**
+   * Decodes sharp-supported image sources into an HWC rgba tensor.
+   */
+  async decodeImage(
+    source: ImageSource,
+    config: Config
+  ): Promise<NdArray<Uint8Array>> {
+    return await imageSourceToImageData(source, config);
+  }
+
+  /**
+   * Encodes an HWC rgba tensor into a Blob of the requested sharp format.
+   */
+  async encodeImage(
+    imageTensor: NdArray<Uint8Array>,
+    quality: number,
+    format: string
+  ): Promise<Blob> {
+    return await imageEncode(imageTensor, quality, format);
+  }
+
+  /**
+   * Creates the onnxruntime-node session for a model byte buffer.
+   */
+  async createSession(
+    model: ArrayBuffer,
+    config: Config
+  ): Promise<SegmentationSession> {
+    return await createOnnxSession(model, config);
+  }
+
+  /**
+   * Runs the onnxruntime-node session with the given feeds.
+   */
+  async runSession(
+    session: SegmentationSession,
+    inputs: [string, NdArray<Float32Array>][],
+    outputs: [string]
+  ): Promise<NdArray<Float32Array>[]> {
+    return await runOnnxSession(session, inputs, outputs);
+  }
+}
