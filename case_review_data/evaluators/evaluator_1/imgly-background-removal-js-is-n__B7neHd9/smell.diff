+export { BaseSegmentationBackend };
+
+import type { NdArray } from 'ndarray';
+import type { Config } from '../schema';
+import type { ImageSource } from '../utils';
+import type { SegmentationBackend, SegmentationSession } from './types';
+
+import {
+  tensorResizeBilinear,
+  tensorHWCtoBCHW,
+  calculateProportionalSize,
+  convertFloat32ToUint8
+} from '../utils';
+import { ensureAbsoluteURI } from '../url';
+import { loadFromURI, loadAsBlob, loadAsUrl } from '../resource';
+
+/**
+ * Backend plumbing that does not depend on the concrete codec or runtime.
+ *
+ * Tensor math and resource assembly go through the workspace helpers in
+ * `utils` and `resource`; the operations that genuinely differ per runtime
+ * (image codecs and onnx execution) stay abstract so each backend flavour
+ * only fills in the parts it can actually implement.
+ */
+abstract class BaseSegmentationBackend implements SegmentationBackend {
+  /**
+   * Resizes an HWC tensor with bilinear interpolation.
+   */
+  resizeTensor(
+    imageTensor: NdArray<Uint8Array>,
+    newWidth: number,
+    newHeight: number
+  ): NdArray<Uint8Array> {
+    return tensorResizeBilinear(imageTensor, newWidth, newHeight);
+  }
+
+  /**
+   * Normalizes an HWC rgba tensor into a 1x3xHxW float tensor.
+   */
+  hwcToBchw(
+    imageTensor: NdArray<Uint8Array>,
+    mean: number[] = [128, 128, 128],
+    std: number[] = [256, 256, 256]
+  ): NdArray<Float32Array> {
+    return tensorHWCtoBCHW(imageTensor, mean, std);
+  }
+
+  /**
+   * Computes the largest size that fits into the given box without
+   * distorting the aspect ratio.
+   */
+  proportionalSize(
+    originalWidth: number,
+    originalHeight: number,
+    maxWidth: number,
+    maxHeight: number
+  ): [number, number] {
+    return calculateProportionalSize(
+      originalWidth,
+      originalHeight,
+      maxWidth,
+      maxHeight
+    );
+  }
+
+  /**
+   * Converts a float mask into its u8 representation.
+   */
+  float32ToUint8(
+    float32Array: NdArray<Float32Array>
+  ): NdArray<Uint8Array> {
+    return convertFloat32ToUint8(float32Array);
+  }
+
+  /**
+   * Resolves a possibly relative url against a base url.
+   */
+  resolveUri(url: string, baseUrl: string): URL {
+    return ensureAbsoluteURI(url, baseUrl);
+  }
+
+  /**
+   * Loads any supported protocol into a fetch-like response.
+   */
+  async fetchResponse(uri: URL, _: Config): Promise<Response> {
+    return await loadFromURI(uri);
+  }
+
+  /**
+   * Assembles a chunked resource from the bundle behind config.publicPath.
+   */
+  async fetchBlob(key: string, config: Config): Promise<Blob> {
+    return await loadAsBlob(key, config);
+  }
+
+  /**
+   * Same as fetchBlob but yields an object url, used for wasm modules.
+   */
+  async fetchResourceUrl(key: string, config: Config): Promise<string> {
+    return await loadAsUrl(key, config);
+  }
+
+  /**
+   * Decodes an arbitrary image source into an HWC rgba tensor.
+   */
+  abstract decodeImage(
+    source: ImageSource,
+    config: Config
+  ): Promise<NdArray<Uint8Array>>;
+
+  /**
+   * Encodes an HWC rgba tensor into a Blob of the requested format.
+   */
+  abstract encodeImage(
+    imageTensor: NdArray<Uint8Array>,
+    quality: number,
+    format: string
+  ): Promise<Blob>;
+
+  /**
+   * Creates the onnx session for a model byte buffer.
+   */
+  abstract createSession(
+    model: ArrayBuffer,
+    config: Config
+  ): Promise<SegmentationSession>;
+
+  /**
+   * Runs the session with the given feeds and collects the outputs.
+   */
+  abstract runSession(
+    session: SegmentationSession,
+    inputs: [string, NdArray<Float32Array>][],
+    outputs: [string]
+  ): Promise<NdArray<Float32Array>[]>;
+}
