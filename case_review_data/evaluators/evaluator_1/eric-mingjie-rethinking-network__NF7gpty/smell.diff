+def test_densenet_small_cfg_layout(ns_densenet):
+    cfg = dense_cfg(growth=4, n=2, compression=2)
+    assert len(cfg) == 9
+    model = ns_densenet(depth=10, growthRate=4, compressionRate=2, cfg=cfg)
+    # dense-block slices
+    assert model.dense1[0].conv1.in_channels == cfg[0]
+    assert model.dense1[0].conv1.out_channels == 4
+    assert model.dense1[1].conv1.in_channels == cfg[1]
+    assert model.dense2[0].conv1.in_channels == cfg[3]
+    assert model.dense2[1].conv1.in_channels == cfg[4]
+    assert model.dense3[0].conv1.in_channels == cfg[6]
+    assert model.dense3[1].conv1.in_channels == cfg[7]
+    # transitions compress the running channel count
+    assert model.trans1.conv1.in_channels == cfg[2]
+    assert model.trans1.conv1.out_channels == 8
+    assert model.trans2.conv1.out_channels == 8
+    assert model.fc.in_features == cfg[-1]
+    assert model.bn.num_features == 16
+
