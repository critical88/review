+def test_vgg_l1_backward_populates_grads(l1_vgg):
+    model = l1_vgg.vgg(cfg=VGG_SMALL_CFG)
+    out = model(torch.randn(2, 3, 40, 40))
+    out.sum().backward()
+    conv_grads = [model.feature[0].weight.grad,
+                  model.classifier[0].weight.grad,
+                  model.classifier[3].weight.grad]
+    assert all(g is not None and g.abs().sum() > 0 for g in conv_grads)
