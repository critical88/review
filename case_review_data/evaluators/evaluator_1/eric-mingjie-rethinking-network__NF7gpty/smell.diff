+def test_slim_vgg_classifier_from_config_tail(im_slim_vgg):
+    model = im_slim_vgg.slimmingvgg(config=SLIM_CFG, num_classes=10)
+    config2 = [SLIM_CFG[-4], SLIM_CFG[-2], SLIM_CFG[-1]]
+    classes = list(model.classifier.children())
+    assert len(classes) == 7
+    assert classes[0].in_features == config2[0] * 7 * 7
+    assert classes[0].out_features == config2[1]
+    assert classes[3].in_features == config2[1]
+    assert classes[3].out_features == config2[2]
+    assert classes[6].in_features == config2[2]
+    assert classes[6].out_features == 10
