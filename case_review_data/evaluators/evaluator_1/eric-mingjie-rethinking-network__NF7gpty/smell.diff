+"""Behavioral tests for the small utility helpers shared by the pipelines."""
+import os
+
+import pytest
+import torch
+import torch.nn as nn
+
+from loader import load_flat
+
+
+@pytest.fixture(scope="module")
+def sf_utils():
+    return load_flat("sf_utils", "cifar/soft-filter-pruning/utils.py")
+
+
+@pytest.fixture(scope="module")
+def lt_wl_misc():
+    return load_flat("lt_wl_misc", "cifar/lottery-ticket/weight-level/utils/misc.py")
+
+
+def test_average_meter_tracks_running_average(sf_utils):
+    meter = sf_utils.AverageMeter()
+    meter.update(1.0, n=2)
+    meter.update(3.0, n=4)
+    assert meter.val == 3.0
+    assert meter.sum == pytest.approx(14.0)
+    assert meter.count == 6
+    assert meter.avg == pytest.approx(14.0 / 6)
+
+
+def test_average_meter_reset_returns_to_zero(sf_utils):
+    meter = sf_utils.AverageMeter()
+    meter.update(5.0, n=3)
+    meter.reset()
+    assert (meter.val, meter.avg, meter.sum, meter.count) == (0, 0, 0, 0)
+
+
+def test_recorder_meter_stores_per_epoch_history(sf_utils):
+    recorder = sf_utils.RecorderMeter(10)
+    assert recorder.current_epoch == 0
+    assert recorder.max_accuracy(False) == 0
+    recorder.update(0, 0.9, 0.5, 1.0, 0.60)
+    recorder.update(1, 0.7, 0.55, 0.8, 0.62)
+    assert recorder.current_epoch == 2
+    assert recorder.epoch_losses[0, 0] == pytest.approx(0.9)
+    assert recorder.epoch_losses[1, 1] == pytest.approx(0.8)
+    assert recorder.epoch_accuracy[1, 0] == pytest.approx(0.55)
+
+
+def test_recorder_meter_flags_new_best_accuracy(sf_utils):
+    recorder = sf_utils.RecorderMeter(10)
+    # update() compares a numpy max with a python float: compare its truth value
+    assert bool(recorder.update(0, 1.0, 0.4, 1.0, 0.50)) is True
+    assert bool(recorder.update(1, 1.0, 0.6, 1.0, 0.55)) is True
+    assert bool(recorder.update(2, 1.0, 0.75, 1.0, 0.40)) is False
+    assert recorder.max_accuracy(False) == pytest.approx(0.55)
+    assert recorder.max_accuracy(True) == pytest.approx(0.75)
+
+
+def test_convert_secs2time_splits_time_units(sf_utils):
+    assert sf_utils.convert_secs2time(0) == (0, 0, 0)
+    assert sf_utils.convert_secs2time(59) == (0, 0, 59)
+    assert sf_utils.convert_secs2time(60) == (0, 1, 0)
+    assert sf_utils.convert_secs2time(3661) == (1, 1, 1)
+    assert sf_utils.convert_secs2time(86399) == (23, 59, 59)
+
+
+def test_time_string_formats_utc_timestamp(sf_utils):
+    import re
+
+    stamp = sf_utils.time_string()
+    assert re.fullmatch(r"\[\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\]", stamp)
+
+
+def test_get_conv_zero_param_counts_zeroed_filters(lt_wl_misc):
+    model = nn.Sequential(
+        nn.Conv2d(3, 4, kernel_size=3, bias=False),
+        nn.Conv2d(4, 2, kernel_size=1, bias=False),
+    )
+    assert int(lt_wl_misc.get_conv_zero_param(model)) == 0
+    with torch.no_grad():
+        model[0].weight[1].zero_()
+    assert int(lt_wl_misc.get_conv_zero_param(model)) == 3 * 3 * 3
+
+
+def test_average_meter_in_lottery_utils(lt_wl_misc):
+    meter = lt_wl_misc.AverageMeter()
+    meter.update(2.0, n=1)
+    meter.update(4.0, n=3)
+    assert meter.avg == pytest.approx(14.0 / 4)
+    assert meter.val == 4.0
+
+
+def test_mkdir_p_is_idempotent(lt_wl_misc, tmp_path):
+    target = os.path.join(str(tmp_path), "logs", "run-1")
+    lt_wl_misc.mkdir_p(target)
+    lt_wl_misc.mkdir_p(target)
+    assert os.path.isdir(target)
