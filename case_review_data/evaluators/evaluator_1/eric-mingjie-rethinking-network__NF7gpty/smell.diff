+"""Behavioral tests for the model definitions of the pruning pipelines.
+
+Every assertion pins externally observable behavior of the networks:
+constructed module dimensions, state-dict layout, parameter counts,
+initialization conventions, and forward/backward output shapes.  The tests
+deliberately avoid asserting *how* a model is built internally, so any
+construction sequence that yields the same architecture remains valid.
+"""
+import pytest
+import torch
+import torch.nn as nn
+
+from loader import load_flat, load_ns_models
+
+# ---------------------------------------------------------------------------
+# Shared helpers and fixtures
+# ---------------------------------------------------------------------------
+
+VGG_SMALL_CFG = [8, 'M', 16, 'M', 32, 'M', 48, 'M', 64]
+RESNET_L1_CFG = [4, 6, 8, 10, 12, 14, 16, 18, 20]
+SLIM_CFG = [16, 'M', 32, 'M', 64, 'M', 128, 'M', 256, 96, 'M', 112, 64]
+IMRESNET_CFG = [8, 8, 8, 16, 16, 16, 16, 24, 24, 24, 24, 24, 24, 32, 32, 512]
+
+
+def count_params(model):
+    return sum(p.numel() for p in model.parameters())
+
+
+def check_bn_fill(model, value, value_1d=None):
+    """Check BN weight fills; BatchNorm1d defaults to ``value_1d``.
+
+    The pruning pipelines deliberately re-fill only their conv-side
+    BatchNorm2d layers in their weight-init helpers, so a BatchNorm1d in a
+    classifier head keeps torch's default weight of 1.0.
+    """
+    expected_1d = value if value_1d is None else value_1d
+    two_d = [m for m in model.modules() if isinstance(m, nn.BatchNorm2d)]
+    one_d = [m for m in model.modules() if isinstance(m, nn.BatchNorm1d)]
+    assert two_d or one_d, "no batch-norm layers found"
+    for m in two_d:
+        assert torch.all(m.weight == value), "BatchNorm2d weight fill mismatch"
+        assert torch.all(m.bias == 0)
+    for m in one_d:
+        assert torch.all(m.weight == expected_1d), "BatchNorm1d weight fill mismatch"
+        assert torch.all(m.bias == 0)
+
+
+def dense_cfg(growth, n, compression):
+    """cfg list consistent with the densenet channel bookkeeping."""
+    cfg, start = [], growth * 2
+    for _ in range(3):
+        cfg.extend([start + growth * i for i in range(n + 1)])
+        start = (start + growth * n) // compression
+    return cfg
+
