+    model = ns_densenet(depth=10, growthRate=4, compressionRate=2,
+                        cfg=dense_cfg(4, 2, 2))
+    keys = model.state_dict().keys()
+    assert "dense1.0.select.indexes" in keys
+    assert "trans1.select.indexes" in keys
+    assert "dense3.1.select.indexes" in keys
+    assert "select.indexes" in keys
+    for module in model.modules():
+        if module.__class__.__name__ == "channel_selection":
+            assert isinstance(module.indexes, nn.Parameter)
+            assert module.indexes.requires_grad
+            assert torch.all(module.indexes == 1)
