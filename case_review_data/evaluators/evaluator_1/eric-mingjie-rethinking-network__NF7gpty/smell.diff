+    assert model.layer2[1].downsample is None
+    assert model.layer3[1].downsample is None
+    # downsampling is the functional channel-completion shortcut
+    shortcut = model.layer2[0].downsample
+    assert callable(shortcut)
+    with torch.no_grad():
+        out = shortcut(torch.randn(1, 16, 8, 8))
+    assert out.shape == (1, 32, 4, 4)
+    assert model.layer3[0].downsample is not None
