+def test_imresnet_cfg_window_slices(im_resnet):
+    model = im_resnet.ResNet(im_resnet.BasicBlock, [3, 4, 6, 3],
+                             cfg=IMRESNET_CFG, num_classes=10)
+    assert model.layer1[0].conv1.out_channels == IMRESNET_CFG[0]
+    assert model.layer1[2].conv1.out_channels == IMRESNET_CFG[2]
+    assert model.layer2[0].conv1.out_channels == IMRESNET_CFG[3]
+    assert model.layer2[3].conv1.out_channels == IMRESNET_CFG[6]
+    assert model.layer3[0].conv1.out_channels == IMRESNET_CFG[7]
+    assert model.layer3[5].conv1.out_channels == IMRESNET_CFG[12]
+    assert model.layer4[0].conv1.out_channels == IMRESNET_CFG[13]
+    assert model.layer4[2].conv1.out_channels == IMRESNET_CFG[15]
+    # the width of the final stage dictates the classifier input
+    assert model.fc.in_features == IMRESNET_CFG[-1]
+
+
+def test_imresnet_stage_planes_and_shortcuts(im_resnet):
+    model = im_resnet.ResNet(im_resnet.BasicBlock, [3, 4, 6, 3],
+                             cfg=IMRESNET_CFG, num_classes=10)
+    assert model.layer1[0].downsample is None
+    shortcut = model.layer2[0].downsample
+    assert isinstance(shortcut, nn.Sequential)
+    assert shortcut[0].in_channels == 64
+    assert shortcut[0].out_channels == 128
+    assert shortcut[0].stride == (2, 2)
+    assert shortcut[0].bias is None
+    assert shortcut[1].num_features == 128
+    keys = model.state_dict().keys()
+    assert "layer2.0.downsample.0.weight" in keys
+    assert "layer4.0.downsample.0.weight" in keys
+    assert model.layer2[0].conv2.out_channels == 128
+    assert model.layer3[0].conv2.out_channels == 256
