+    assert model.fc.in_features == 456
+    assert model.bn.num_features == 456
+    assert model.select.indexes.numel() == 456
+    # channel bookkeeping threading through all stages
+    assert model.dense1[11].select.indexes.numel() == 156
+    assert model.dense2[0].select.indexes.numel() == 168
+    assert model.dense3[11].select.indexes.numel() == 444
