+def test_slim_vgg_feature_stack_layout(im_slim_vgg):
+    model = im_slim_vgg.slimmingvgg(config=SLIM_CFG, num_classes=10)
+    feature_modules = list(model.features.children())
+    assert len(feature_modules) == 23
+    assert feature_modules[0].out_channels == SLIM_CFG[0]
+    # the stack ends with a pool; the final conv sits three modules earlier
+    assert isinstance(feature_modules[-1], nn.MaxPool2d)
+    assert feature_modules[-4].out_channels == SLIM_CFG[-4]
+    pools = [m for m in model.features.modules() if isinstance(m, nn.MaxPool2d)]
+    assert len(pools) == 5
+    convs = [m for m in model.features.modules() if isinstance(m, nn.Conv2d)]
+    assert len(convs) == 6
+    assert all(m.bias is not None for m in convs)
