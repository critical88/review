+    assert convs and all(m.weight.std() > 0 for m in convs)
+    linear = [m for m in model.modules() if isinstance(m, nn.Linear)]
+    assert linear and all(m.bias.abs().sum() == 0 for m in linear)
+    assert all(m.weight.std() > 0 for m in linear)
