+++ b/tests/loader.py
@@ -0,0 +1,41 @@
+"""Import helpers for the repository's independent experiment pipelines.
+
+The repository is a collection of self-contained pruning experiments rather
+than an installable package.  Model definitions are therefore loaded directly
+from their files.  The network-slimming ``models`` directory uses relative
+imports, so it is imported as a package through ``sys.path``.
+"""
+import importlib
+import importlib.util
+import os
+import sys
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+_LOADED = {}
+
+
+def load_flat(name, rel_path):
+    """Import a standalone module from ``rel_path`` under a fresh name."""
+    key = ("flat", name)
+    if key not in _LOADED:
+        path = os.path.join(REPO_ROOT, rel_path)
+        spec = importlib.util.spec_from_file_location(name, path)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        spec.loader.exec_module(module)
+        _LOADED[key] = module
+    return _LOADED[key]
+
+
+def load_ns_models(rel_dir="cifar/network-slimming"):
+    """Import the network-slimming ``models`` package (relative imports)."""
+    key = ("pkg", rel_dir)
+    if key not in _LOADED:
+        pipeline_dir = os.path.join(REPO_ROOT, rel_dir)
+        sys.path.insert(0, pipeline_dir)
+        try:
+            _LOADED[key] = importlib.import_module("models")
+        finally:
+            sys.path.remove(pipeline_dir)
+    return _LOADED[key]
