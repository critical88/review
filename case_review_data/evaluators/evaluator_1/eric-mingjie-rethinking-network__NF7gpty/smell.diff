+def test_channel_selection_passes_all_channels(ns_channel_selection):
+    select = ns_channel_selection(4)
+    x = torch.randn(1, 4, 2, 2)
+    with torch.no_grad():
+        out = select(x)
+    assert out.shape == (1, 4, 2, 2)
+    assert "indexes" in select.state_dict()
+
+
+def test_channel_selection_drops_zeroed_channels(ns_channel_selection):
+    select = ns_channel_selection(4)
+    with torch.no_grad():
+        select.indexes[1] = 0
+    x = torch.randn(1, 4, 2, 2)
+    with torch.no_grad():
+        out = select(x)
+    assert out.shape == (1, 3, 2, 2)
+    assert torch.allclose(out, x[:, [0, 2, 3], :, :])
+
+
+def test_channel_selection_single_surviving_channel(ns_channel_selection):
+    select = ns_channel_selection(4)
+    with torch.no_grad():
+        select.indexes[:] = 0
+        select.indexes[2] = 1
+    x = torch.randn(1, 4, 2, 2)
+    with torch.no_grad():
+        out = select(x)
+    assert out.shape == (1, 1, 2, 2)
+    assert torch.allclose(out, x[:, 2:3, :, :])
+
