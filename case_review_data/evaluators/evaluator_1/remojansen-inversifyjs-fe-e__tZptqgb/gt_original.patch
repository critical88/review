 import type { BindingScope } from '@inversifyjs/core';
 
+import type { DigestPayload } from './binding_digest';
 import { BindingDigest } from './binding_digest';
 
+export interface SnapshotPayload {
+  readonly containerLabel: string;
+  readonly defaultScope: BindingScope;
+  readonly digests: readonly DigestPayload[];
+}
+
+export interface SnapshotDifference {
+  readonly kind: 'added' | 'qualification' | 'registration';
+  readonly serviceIdentifier: string;
+  readonly description: string;
+}
+
 export class ContainerSnapshot {
   public readonly containerLabel: string;
   public readonly defaultScope: BindingScope;
@@ -16,4 +29,110 @@ export class ContainerSnapshot {
     this.defaultScope = defaultScope;
     this.digests = [...digests];
   }
+
+  public renderAsText(): string {
+    const lines: string[] = [
+      `Container ${this.containerLabel} wiring report`,
+      `Default scope: ${this.defaultScope}`,
+    ];
+
+    for (const digest of this.digests) {
+      lines.push(digest.renderAsRow('  '));
+    }
+
+    lines.push(`Registered services: ${this.digests.length.toString()}`);
+
+    return lines.join('\n');
+  }
+
+  public scopeBreakdown(): Map<string, number> {
+    const breakdown: Map<string, number> = new Map<string, number>();
+
+    for (const digest of this.digests) {
+      const key: string = digest.registrationKey();
+      const count: number = breakdown.get(key) ?? 0;
+
+      breakdown.set(key, count + 1);
+    }
+
+    return breakdown;
+  }
+
+  public statefulRegistrationCount(): number {
+    let stateful: number = 0;
+
+    for (const digest of this.digests) {
+      if (digest.isStateful()) {
+        stateful += 1;
+      }
+    }
+
+    return stateful;
+  }
+
+  public qualifierUsage(): Map<string, number> {
+    const usage: Map<string, number> = new Map<string, number>();
+
+    for (const digest of this.digests) {
+      for (const qualifierKey of digest.qualifierKeys()) {
+        const count: number = usage.get(qualifierKey) ?? 0;
+
+        usage.set(qualifierKey, count + 1);
+      }
+    }
+
+    return usage;
+  }
+
+  public changesFrom(baseline: ContainerSnapshot): SnapshotDifference[] {
+    const baselineByIdentity: Map<string, BindingDigest> = new Map<
+      string,
+      BindingDigest
+    >();
+
+    for (const baselineDigest of baseline.digests) {
+      baselineByIdentity.set(baselineDigest.serviceIdentifier, baselineDigest);
+    }
+
+    const differences: SnapshotDifference[] = [];
+
+    for (const digest of this.digests) {
+      const previousDigest: BindingDigest | undefined = baselineByIdentity.get(
+        digest.serviceIdentifier,
+      );
+
+      if (previousDigest === undefined) {
+        differences.push({
+          description: digest.describeAddition(),
+          kind: 'added',
+          serviceIdentifier: digest.serviceIdentifier,
+        });
+
+        continue;
+      }
+
+      const changeDescription: string | undefined =
+        digest.changesFromRegistered(previousDigest);
+
+      if (changeDescription !== undefined) {
+        differences.push({
+          description: changeDescription,
+          kind: 'registration',
+          serviceIdentifier: digest.serviceIdentifier,
+        });
+      }
+    }
+
+    return differences;
+  }
+
+  public toJson(): SnapshotPayload {
+    return {
+      containerLabel: this.containerLabel,
+      defaultScope: this.defaultScope,
+      digests: this.digests.map((digest: BindingDigest) =>
+        digest.toJsonRecord(),
+      ),
+    };
+  }
 }
