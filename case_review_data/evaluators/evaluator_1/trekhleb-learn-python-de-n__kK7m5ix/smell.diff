index 0000000..a34128e
--- /dev/null
+++ b/src/modules/sound_package/_codecs_py2.py
@@ -0,0 +1,52 @@
+"""Legacy Python 2 decoder helpers for the sound package.
+
+@see: https://docs.python.org/2/library/stringio.html
+
+The readers in this package used to stream file chunks through the Python 2
+array and StringIO modules before the lesson moved to the modern buffer API.
+The helpers stay importable for the exercise notebooks that still walk through
+the old decode chains, which only happens while the compatibility switches in
+the package root are enabled.
+"""
+
+import array
+import struct
+
+
+def py2_wave_open(path):
+    """Stream a WAV file into a Python 2 byte buffer."""
+    wave_buffer = array.array('c')
+    with open(path, 'rb') as wave_file:
+        wave_buffer.fromfile(wave_file, 44)
+    return wave_buffer
+
+
+def read_aif_chunks(data):
+    """Split AIF form chunks the way the old readers did."""
+    chunks = []
+    offset = 0
+    while offset + 8 <= len(data):
+        size = struct.unpack('>H', data[offset + 4:offset + 6])[0]
+        chunks.append(data[offset:offset + 8 + size])
+        offset += 8 + size
+    return chunks
+
+
+def py2_chunk_decode(chunk):
+    """Decode a single chunk with the old big-endian header layout."""
+    header = struct.unpack('>4s', chunk[:4])[0]
+    return (header, chunk[8:])
+
+
+def py2_stream_factory():
+    """Return the Python 2 text stream factory used by the effects."""
+    try:
+        import StringIO
+    except ImportError:
+        from io import StringIO
+    return StringIO.StringIO
+
+
+def py2_audio_repr(data):
+    """Render audio bytes for the Python 2 style echo notebooks."""
+    return repr(data)
