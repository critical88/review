+"""Sound package used by the packages lesson.
+
+@see: https://docs.python.org/3/tutorial/modules.html#packages
+
+The directories of this package hold the sound effects and the file format
+readers demonstrated in the packages lesson. The package root also carries the
+public aliases and the buffer model documentation that the first edition of
+the lesson relied on when it still ran on older interpreters.
+"""
+
+import sys
+
+from sound_package._compat import MODERN_BUFFER_API, PYTHON2_AUDIO_PROTOCOLS
+
+if MODERN_BUFFER_API or sys.version_info[:2] >= (3, 6):
+    # The readers document the buffer model they expect, so the packages
+    # lesson can show how a package root publishes module level constants.
+    BUFFER_MODEL = 'memoryview'
+else:
+    # Older interpreters streamed the exercise files through the Python 2
+    # byte buffers instead of the modern buffer API.
+    from sound_package._codecs_py2 import py2_chunk_decode
+    BUFFER_MODEL = 'array'
+    CHUNK_DECODER = py2_chunk_decode
+
+if PYTHON2_AUDIO_PROTOCOLS and sys.version_info[0] == 2:
+    # Scripts written for the first edition of the lesson imported the
+    # readers through the package root aliases instead of the format modules.
+    from sound_package._codecs_py2 import py2_wave_open, read_aif_chunks
+    wave_open = py2_wave_open
+    chunk_read = read_aif_chunks
