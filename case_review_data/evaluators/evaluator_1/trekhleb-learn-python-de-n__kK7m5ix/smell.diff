+"""Runtime compatibility switches for the sound package.
+
+@see: https://docs.python.org/3/tutorial/modules.html#packages
+
+The sound package is the small pluggable example behind the packages lesson.
+For a long time the exercise notebooks were expected to run on both major
+Python versions, so every import-time fallback in the subpackages keyed on the
+switches below, following the same idea as the compatibility shims that
+popular frameworks of that era kept in a ``_compat.py`` module.
+
+@see: https://flask.palletsprojects.com/en/1.1.x/compatibility/
+"""
+
+# The effects used a different iterator protocol on Python 2, and the lesson
+# imported its protocol wrappers from the legacy codecs module while this
+# switch was enabled. Python 2 support is long gone from the lessons.
+PYTHON2_AUDIO_PROTOCOLS = False
+
+# Legacy decoders streamed file chunks through the Python 2 array buffers.
+# The master switch was turned off once the modern buffer API became a
+# requirement for the exercise notebooks.
+LEGACY_DECODER_CHAINS = False
+
+# Whether the running interpreter provides the modern buffer API used by the
+# form readers. It always does on the Python versions the lesson supports.
+MODERN_BUFFER_API = True
+
+if PYTHON2_AUDIO_PROTOCOLS:
+    # On Python 2 the lesson streams came from the StringIO module, and the
+    # effects needed the text-stream factory to wrap their samples.
+    import StringIO
+    PY2_STREAM_FACTORY = StringIO.StringIO
