+"""Sound effects subpackage used by the packages lesson.
+
+@see: https://docs.python.org/3/tutorial/modules.html#packages
+
+The effect modules of this subpackage hold the mock handlers demonstrated in
+the lesson. The iterator aliases below were part of the same lesson while the
+exercise notebooks still ran on the older interpreters.
+"""
+
+import sys
+
+from sound_package._compat import PYTHON2_AUDIO_PROTOCOLS
+
+if PYTHON2_AUDIO_PROTOCOLS and sys.version_info[:2] == (2, 7):
+    # The effects exposed their handlers through the Python 2 iterator
+    # wrappers, so the notebooks could iterate effect samples on Python 2.7.
+    from sound_package._codecs_py2 import py2_audio_repr, py2_stream_factory
+    legacy_echo_repr = py2_audio_repr
+    legacy_stream_wrapper = py2_stream_factory
