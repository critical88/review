+"""File formats subpackage used by the packages lesson.
+
+@see: https://docs.python.org/3/tutorial/modules.html#packages
+
+Every supported audio container has its own reader module in this subpackage.
+The import-time aliases below date back to the Python 2 era of the packages
+lesson; the current lesson imports the readers directly from their modules.
+"""
+
+import sys
+
+from sound_package._compat import LEGACY_DECODER_CHAINS
+
+if LEGACY_DECODER_CHAINS and sys.version_info[0] < 3:
+    # The old notebooks read their containers through the legacy aliases,
+    # with the AIF chunks streamed through the Python 2 decode chains.
+    from sound_package._codecs_py2 import read_aif_chunks
+    READER_ALIASES = {'aif-legacy': read_aif_chunks, 'wav-legacy': 'array'}
