diff --git a/src/drivers/utils/max-item-size.ts b/src/drivers/utils/max-item-size.ts
new file mode 100644
index 0000000..d802587
--- /dev/null
+++ b/src/drivers/utils/max-item-size.ts
@@ -0,0 +1,45 @@
+import { createError } from "./index.ts";
+
+/**
+ * Size input for a `maxItemSize` check: an already-measured number, or a thunk
+ * that defers an expensive measurement (the byte-length of a payload) so the
+ * common "no limit configured" write resolves nothing.
+ */
+type ItemSize = number | (() => number);
+
+function resolveSize(size: ItemSize): number {
+  return typeof size === "function" ? size() : size;
+}
+
+/**
+ * Whether a write exceeds the configured `maxItemSize` limit and must be refused.
+ *
+ * A `maxItemSize` of `undefined` means "no limit configured"; every other value
+ * (including `0`) is treated as a real ceiling. `size` is only resolved when a
+ * limit is configured, so drivers that measure size expensively stay free in the
+ * common no-limit case.
+ *
+ * This is the single owner of the "is this value too large?" decision shared by
+ * every driver that accepts `maxItemSize`; {@link assertItemSize} builds on it.
+ */
+export function exceedsItemSize(maxItemSize: number | undefined, size: ItemSize): boolean {
+  return maxItemSize !== undefined && resolveSize(size) > maxItemSize;
+}
+
+/**
+ * Throw a tailored error when `maxItemSize` would be exceeded, otherwise return.
+ *
+ * Drivers keep their store-specific wording via `message` (built only on the
+ * rejection path, and given the offending `size`); the over-limit decision
+ * itself comes from {@link exceedsItemSize}.
+ */
+export function assertItemSize(
+  driver: string,
+  maxItemSize: number | undefined,
+  size: ItemSize,
+  message: (size: number) => string,
+): void {
+  if (exceedsItemSize(maxItemSize, size)) {
+    throw createError(driver, message(resolveSize(size)));
+  }
+}
