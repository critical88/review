diff --git a/src/drivers/utils/index.ts b/src/drivers/utils/index.ts
index 9f098c2..81f2354 100644
--- a/src/drivers/utils/index.ts
+++ b/src/drivers/utils/index.ts
@@ -6,6 +6,57 @@ export type DriverFactory<OptionsT, InstanceT = never> = (
   opts: OptionsT,
 ) => Driver<OptionsT, InstanceT>;
 
+/**
+ * Options shared by drivers that can limit the size of stored values.
+ */
+export interface ItemSizeOptions {
+  /**
+   * Maximum size (in bytes) of a value passed to a write operation.
+   *
+   * `undefined` (the default) disables the limit. Drivers that only accept
+   * throwaway items (caches) silently drop larger values; drivers that treat
+   * writes as committed storage reject them with an error.
+   */
+  maxItemSize?: number;
+}
+
+/**
+ * Number of bytes `value` occupies when stored.
+ *
+ * This is the enforcement unit all drivers share: changing how limits are
+ * measured happens here, once, for every driver.
+ */
+export function measureItemSize(value: string): number {
+  return new TextEncoder().encode(value).length;
+}
+
+/**
+ * Whether `value` crosses the configured `maxItemSize` limit.
+ */
+export function exceedsItemSize(maxItemSize: number | undefined, value: string): boolean {
+  return maxItemSize !== undefined && measureItemSize(value) > maxItemSize;
+}
+
+/**
+ * Reject a write that crosses the configured `maxItemSize` limit.
+ *
+ * Throws the shared, driver-annotated error so callers always see the same
+ * contract violation regardless of which driver is mounted.
+ */
+export function assertItemSize(
+  driver: string,
+  key: string,
+  value: string,
+  maxItemSize: number | undefined,
+): void {
+  if (exceedsItemSize(maxItemSize, value)) {
+    throw createError(
+      driver,
+      `Value for "${key}" is ${measureItemSize(value)} bytes, exceeding maxItemSize (${maxItemSize}).`,
+    );
+  }
+}
+
 export interface ErrorOptions {
   cause?: unknown;
 }
