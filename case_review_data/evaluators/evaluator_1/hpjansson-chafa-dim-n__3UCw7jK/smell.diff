+                    {
+                        if (candidate_tags & selector->tags)
+                        {
+                            is_selected = selector->additive ? TRUE : FALSE;
+                            auto_exclude_tags &= ~((guint) selector->tags);
+                        }
+                    }
+                    else
+                    {
