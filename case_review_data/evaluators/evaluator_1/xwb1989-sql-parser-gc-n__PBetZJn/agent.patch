+package sqlparser
+
+import (
+	"bytes"
+
+	"github.com/xwb1989/sqlparser/dependency/querypb"
+)
+
+// This file owns bound-query construction: materializing a parsed query
+// template into its final, executable form by substituting supplied bind
+// variables. The owner works purely at the byte level — it walks the
+// template's precomputed bind locations and copies literal text plus
+// encoded values into an output buffer — so it carries its own bind
+// namespace and encoders rather than borrowing state from a render buffer.
+// Resolve and encode rules are dispatched through the shared codec in
+// bind_value.go.
+
+// boundQueryBuilder assembles a parsed query's text and bind values into a
+// fully substituted statement.
+type boundQueryBuilder struct {
+	out      *bytes.Buffer
+	bindVars map[string]*querypb.BindVariable
+	extras   map[string]Encodable
+}
+
+// newBoundQueryBuilder binds a destination buffer to the bind-variable
+// namespace and custom encoders a bound statement substitutes against.
+func newBoundQueryBuilder(out *bytes.Buffer, bindVars map[string]*querypb.BindVariable, extras map[string]Encodable) *boundQueryBuilder {
+	return &boundQueryBuilder{out: out, bindVars: bindVars, extras: extras}
+}
+
+// build walks pq's precomputed bind locations, copying the literal text
+// between them and substituting each bind reference with either a custom
+// encoder (from extras) or a resolved value from the namespace.
+func (b *boundQueryBuilder) build(pq *ParsedQuery) ([]byte, error) {
+	current := 0
+	for _, loc := range pq.bindLocations {
+		b.out.WriteString(pq.Query[current:loc.offset])
+		name := pq.Query[loc.offset : loc.offset+loc.length]
+		if encodable, ok := b.extras[name[1:]]; ok {
+			encodable.EncodeSQL(b.out)
+		} else {
+			supplied, _, err := resolveBindVar(name, b.bindVars)
+			if err != nil {
+				return nil, err
+			}
+			encodeBindValue(b.out, supplied)
+		}
+		current = loc.offset + loc.length
+	}
+	b.out.WriteString(pq.Query[current:])
+	return b.out.Bytes(), nil
+}
