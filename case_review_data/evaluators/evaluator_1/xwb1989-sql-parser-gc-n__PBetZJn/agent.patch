+package sqlparser
+
+import (
+	"bytes"
+	"fmt"
+
+	"github.com/xwb1989/sqlparser/dependency/querypb"
+	"github.com/xwb1989/sqlparser/dependency/sqltypes"
+)
+
+// This file holds the single, shared implementations for resolving a bind
+// variable reference against a namespace and for encoding one bind variable
+// value into an output buffer. bound-query construction, redaction and the
+// public helpers below all dispatch through these functions instead of each
+// owning a private copy of the lookup or encoding rules.
+
+// resolveBindVar looks up name (a ":name" or "::name" reference) in bindVars,
+// applying the single/list validation that bound-query construction and the
+// fetch helper both expect.
+func resolveBindVar(name string, bindVars map[string]*querypb.BindVariable) (val *querypb.BindVariable, isList bool, err error) {
+	name = name[1:]
+	if name[0] == ':' {
+		name = name[1:]
+		isList = true
+	}
+	supplied, ok := bindVars[name]
+	if !ok {
+		return nil, false, fmt.Errorf("missing bind var %s", name)
+	}
+
+	if isList {
+		if supplied.Type != querypb.Type_TUPLE {
+			return nil, false, fmt.Errorf("unexpected list arg type (%v) for key %s", supplied.Type, name)
+		}
+		if len(supplied.Values) == 0 {
+			return nil, false, fmt.Errorf("empty list supplied for %s", name)
+		}
+		return supplied, true, nil
+	}
+
+	if supplied.Type == querypb.Type_TUPLE {
+		return nil, false, fmt.Errorf("unexpected arg type (TUPLE) for non-list key %s", name)
+	}
+
+	return supplied, false, nil
+}
+
+// encodeBindValue writes one bind variable value into out, expanding tuple
+// values into a parenthesized list. Used by bound-query construction and the
+// encode helper.
+func encodeBindValue(out *bytes.Buffer, value *querypb.BindVariable) {
+	if value.Type != querypb.Type_TUPLE {
+		// Since we already check for TUPLE, we don't expect an error.
+		v, _ := sqltypes.BindVariableToValue(value)
+		v.EncodeSQL(out)
+		return
+	}
+
+	// It's a TUPLE.
+	out.WriteByte('(')
+	for i, bv := range value.Values {
+		if i != 0 {
+			out.WriteString(", ")
+		}
+		sqltypes.ProtoToValue(bv).EncodeSQL(out)
+	}
+	out.WriteByte(')')
+}
+
+// EncodeValue encodes one bind variable value into the query.
+func EncodeValue(buf *bytes.Buffer, value *querypb.BindVariable) {
+	encodeBindValue(buf, value)
+}
+
+// FetchBindVar resolves the bind variable by fetching it from bindVariables.
+func FetchBindVar(name string, bindVariables map[string]*querypb.BindVariable) (val *querypb.BindVariable, isList bool, err error) {
+	return resolveBindVar(name, bindVariables)
+}
