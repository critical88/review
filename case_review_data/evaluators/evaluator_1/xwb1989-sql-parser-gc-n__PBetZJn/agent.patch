+
+func newImpossibleQueryBuilder(buf *TrackedBuffer) *impossibleQueryBuilder {
+	return &impossibleQueryBuilder{buf: buf}
+}
+
+// build rewrites node so every select yields no rows. For a Select it emits
+// "select <cols> from <from> where 1 != 1" plus any group by; for a Union it
+// preserves the shape through the recursive branches; anything else is
+// formatted as-is.
+func (q *impossibleQueryBuilder) build(node SQLNode) {
+	switch node := node.(type) {
+	case *Select:
+		q.buf.Myprintf("select %v from %v where 1 != 1", node.SelectExprs, node.From)
+		if node.GroupBy != nil {
+			node.GroupBy.Format(q.buf)
+		}
+	case *Union:
+		q.buf.Myprintf("%v %s %v", node.Left, node.Type, node.Right)
+	default:
+		node.Format(q.buf)
+	}
