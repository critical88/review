+// This file owns redaction: rendering a statement with its literal values
+// replaced by generated bind variables, framed by any surrounding margin
+// comments, for safe logging. The owner carries the bind-variable namespace
+// it populates while normalizing and the prefix used to name those variables,
+// then writes the redacted statement into a render buffer it is handed. It
+// shares neither the namespace nor the prefix with the buffer; the buffer is
+// only an output sink.
+
+// redactor renders a statement into buf with literal values scrubbed into
+// generated bind variables named with redactPrefix.
+type redactor struct {
+	buf          *TrackedBuffer
+	bindVars     map[string]*querypb.BindVariable
+	redactPrefix string
+}
+
+func newRedactor(buf *TrackedBuffer, bindVars map[string]*querypb.BindVariable, redactPrefix string) *redactor {
+	return &redactor{buf: buf, bindVars: bindVars, redactPrefix: redactPrefix}
+}
+
+// render normalizes stmt into bindVars under redactPrefix, then writes the
+// leading comments, the (now redacted) statement, and the trailing comments.
+func (r *redactor) render(leading, trailing string, stmt Statement) {
+	Normalize(stmt, r.bindVars, r.redactPrefix)
+	r.buf.WriteString(leading)
+	r.buf.WriteNode(stmt)
+	r.buf.WriteString(trailing)
+}
