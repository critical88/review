+// parseRequest converts the HTTP request into the internal request type,
+// stripping the prefix both paths were served under and normalizing them.
+func (h *Handler) parseRequest(r *http.Request) (*request, error) {
+	prefix := h.user.handler.Prefix
+
+	ctx := &request{
+		method: r.Method,
+	}
+
+	if destination := r.Header.Get("Destination"); destination != "" {
+		u, err := url.Parse(destination)
+		if err != nil {
+			return nil, errors.New("invalid destination header")
+		}
+
+		// RFC 4918, section 10.3, has Destination as an absolute URI, which is
+		// what clients send in practice. Only the path is relevant here, and
+		// taking it unconditionally keeps the host out of the matched value.
+		destination = u.Path
+
+		if prefix != "" {
+			destination = strings.TrimPrefix(u.Path, prefix)
+			if len(destination) >= len(u.Path) {
+				return nil, errors.New("invalid url prefix")
+			}
+		}
+
+		ctx.destination = h.cleanRequestPath(destination)
+	}
+
+	reqPath := r.URL.Path
+
+	if prefix != "" {
+		reqPath = strings.TrimPrefix(r.URL.Path, prefix)
+		if len(reqPath) >= len(r.URL.Path) {
+			return nil, errors.New("invalid url prefix")
+		}
+	}
+
+	ctx.path = h.cleanRequestPath(reqPath)
+
+	return ctx, nil
+}
+
+// cleanRequestPath resolves dot segments so that the permission checks see the
+// same path that the backing file system will ultimately open. The file systems
+// in golang.org/x/net/webdav apply path.Clean before joining the backing
+// directory, so without this the two layers disagree on which file a request
+// names and a rule can be bypassed with e.g. "/public/../secret/file.txt".
+func (h *Handler) cleanRequestPath(p string) string {
+	if !strings.HasPrefix(p, "/") {
+		p = "/" + p
+	}
+
+	cleaned := path.Clean(p)
+
+	// path.Clean drops the trailing slash, but rules are prefix matches and are
+	// commonly written with one, such as "/c/". Dropping it would stop a request
+	// for the collection itself from matching the rule that names it.
+	if cleaned != "/" && h.isCollectionRequestPath(p) {
+		cleaned += "/"
+	}
+
+	return cleaned
+}
+
+// isCollectionRequestPath reports whether p names a collection rather than a
+// resource within it. Besides an explicit trailing slash, a trailing "." or
+// ".." segment also resolves to the collection itself.
+func (h *Handler) isCollectionRequestPath(p string) bool {
+	return strings.HasSuffix(p, "/") || strings.HasSuffix(p, "/.") || strings.HasSuffix(p, "/..")
+}
+
+// authorizeRequest checks if the user has permission to access a
+// directory/file. COPY and MOVE resolve the destination first, so a rule that
+// denies the destination refuses the request even when the source is allowed;
+// if no rule matches, the global permissions decide.
+func (h *Handler) authorizeRequest(user *handlerUser, req *request, fileExists func(string) bool) bool {
+	// For COPY and MOVE requests, we first check the permissions for the destination
+	// path. As soon as a rule matches and does not allow the operation at the destination,
+	// we fail immediately. If no rule matches, we check the global permissions.
+	if req.method == "COPY" || req.method == "MOVE" {
+		if !user.UserPermissions.allowedAt(req.destination, func(perms Permissions) bool {
+			return perms.AllowedDestination(req, fileExists)
+		}) {
+			return false
+		}
+	}
+
+	return user.UserPermissions.allowedAt(req.path, func(perms Permissions) bool {
+		return perms.Allowed(req, fileExists)
+	})
+}
+
+// authorizeSubtree reports whether the request is permitted on name and every
+// descendant of it. MOVE and DELETE act on a whole subtree in one call, so
+// every descendant needs authorizing here; COPY and PROPFIND instead reach
+// descendants through the filtered listings of the per-user file system.
+//
+// It reads the unwrapped file system directly: the filtered view omits the
+// very entries this has to refuse on.
+func (h *Handler) authorizeSubtree(ctx context.Context, user *handlerUser, req *request, name string, fileExists func(string) bool) (bool, error) {
+	info, err := user.fs.fs.Stat(ctx, name)
+	if err != nil {
+		if os.IsNotExist(err) {
+			// Nothing to walk; the request fails later on its own terms.
+			return true, nil
+		}
+
+		return false, err
+	}
+
+	if !info.IsDir() {
+		return true, nil
+	}
+
+	file, err := user.fs.fs.OpenFile(ctx, name, os.O_RDONLY, 0)
+	if err != nil {
+		return false, err
+	}
+
+	entries, err := file.Readdir(-1)
+	err = errors.Join(err, file.Close())
+	if err != nil {
+		return false, err
+	}
+
+	for _, entry := range entries {
+		child := path.Join(name, entry.Name())
+
+		if !user.fs.perms.allowedAt(child, func(p Permissions) bool {
+			return p.Allowed(req, fileExists)
+		}) {
+			return false, nil
+		}
+
+		if entry.IsDir() {
+			ok, err := h.authorizeSubtree(ctx, user, req, child, fileExists)
+			if !ok || err != nil {
+				return ok, err
+			}
+		}
+	}
+
+	return true, nil
+}
