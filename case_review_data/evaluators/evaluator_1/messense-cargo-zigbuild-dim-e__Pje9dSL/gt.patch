+                    let output = Command::new("xcrun")
+                        .args(["--sdk", "macosx", "--show-sdk-path"])
+                        .output()
+                        .ok()?;
+                    if output.status.success() {
+                        let stdout = String::from_utf8(output.stdout).ok()?;
+                        let stdout = stdout.trim();
+                        if !stdout.is_empty() {
+                            return Some(stdout.into());
+                        }
                     }
+                    None
                 }
+            })
+            .clone()
+    }
+
+    #[cfg(not(target_os = "macos"))]
