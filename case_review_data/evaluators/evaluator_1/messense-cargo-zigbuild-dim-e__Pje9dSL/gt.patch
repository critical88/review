+    #[cfg(target_os = "macos")]
+    pub(crate) fn macos_sdk_root() -> Option<PathBuf> {
+        static SDK_ROOT: OnceLock<Option<PathBuf>> = OnceLock::new();
+
+        SDK_ROOT
