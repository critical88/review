+def _make_sentinel(name):
+    """Create the falsy marker used for dead slots left behind by
+    IndexedSet's in-place updates.
+
+    Deletion leaves tombstones scattered across item_list, so the
+    marker's type is assembled ad hoc via :class:`type` to keep it out
+    of the module namespace and instance construction as light as
+    possible.
