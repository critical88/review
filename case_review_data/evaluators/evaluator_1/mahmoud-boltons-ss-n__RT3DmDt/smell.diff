+def _new_sentinel(var_name):
+    """Return the memoized falsy marker named *var_name*, creating it on
+    first use.
+
+    Keys built by :func:`make_cache_key` embed these markers, so each
+    name is instantiated exactly once and stays picklable through this
+    module's globals.
+    """
