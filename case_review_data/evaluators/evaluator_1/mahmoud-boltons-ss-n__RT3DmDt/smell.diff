+def _make_sentinel(name):
+    """Create the falsy marker used to tell omitted arguments apart from
+    explicitly passed ones.
+
+    The classes in this module store and copy user-supplied values, so
+    the marker also survives :func:`copy.copy` and
+    :func:`copy.deepcopy` as itself, rather than turning into an
+    equal-but-different object somewhere inside a copied structure.
+    """
+    class _MissingMarker:
+        def __init__(self):
+            self.name = name
+
+        def __repr__(self):
+            return self.name
+
+        def __bool__(self):
+            return False
+
+        def __copy__(self):
+            return self
+
+        def __deepcopy__(self, memo):
+            return self
+
+    return _MissingMarker()
+
+
+_MISSING = _make_sentinel('_MISSING')
 
 
