+def _make_sentinel(name='_UNSET', var_name=None):
+    """Create the falsy marker for parameters the caller left unset.
+
+    BufferedSocket needs to tell an omitted *timeout* or *maxsize*
+    apart from an explicit ``None``, so those parameters default to
+    this marker. *var_name* mirrors the global the marker will be
+    stored under, when it differs from *name*.
+    """
+    if var_name is None:
+        var_name = name
+
+    class _UnsetMarker:
+        __slots__ = ('name', 'var_name')
+
+        def __init__(self):
+            self.name = name
+            self.var_name = var_name
+
+        def __repr__(self):
+            return self.var_name
+
+        def __bool__(self):
+            return False
+
+    return _UnsetMarker()
+
+
