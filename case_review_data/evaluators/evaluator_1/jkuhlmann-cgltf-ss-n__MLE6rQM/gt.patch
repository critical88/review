+ * reference points past the end of its array: an out-of-range index is reported
+ * as CGLTF_ERROR_JSON, otherwise the staged value is replaced with
+ * &(base)[index] (index being the stored value minus one). Change that rule
+ * here, once, instead of in each call site. `required` selects whether a NULL
+ * reference is itself an error (required == 1) or is left untouched (required
+ * == 0).
+ */
+#define CGLTF_FIXUP_POINTER(ref_, base_, count_, required_) \
+	do { \
+		if (!(ref_)) \
+		{ \
+			if (required_) { return CGLTF_ERROR_JSON; } \
+		} \
+		else \
+		{ \
+			if ((cgltf_size)(ref_) > (count_)) { return CGLTF_ERROR_JSON; } \
+			(ref_) = &(base_)[(cgltf_size)(ref_) - 1]; \
+		} \
+	} while (0)
