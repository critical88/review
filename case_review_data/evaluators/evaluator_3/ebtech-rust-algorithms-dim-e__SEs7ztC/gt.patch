+/// Pollard's rho: assuming `n` is an odd composite >= 3, returns a nontrivial
+/// divisor `d` with 1 < d < n. The walk follows f(x) = x*x + a, trying
+/// a = 1, 2, ... in turn, with tortoise/hare cycle detection; a cycle is
+/// revealed by gcd(tortoise - hare, n). Modular products go through [`mod_mul`]
+/// and the gcd through [`num::fast_gcd`], so this shares the same leaves as
+/// [`is_prime`] rather than spelling the arithmetic out again.
+fn pollard_rho(n: i64) -> i64 {
+    for a in 1..n {
+        let mut tortoise = 2;
+        let mut hare = 2;
+        loop {
+            // tortoise takes one step along f, hare takes two.
+            tortoise = (mod_mul(tortoise, tortoise, n) + a) % n;
+            hare = (mod_mul(hare, hare, n) + a) % n;
+            hare = (mod_mul(hare, hare, n) + a) % n;
+            let div = num::fast_gcd(tortoise - hare, n);
+            if div == n {
+                // Hit a cycle for this polynomial without exposing a factor;
+                // restart with the next value of a.
+                break;
+            } else if div > 1 {
+                return div;
+            }
+        }
+    }
+    panic!("No divisor found!");
+}
