diff --git a/pkg/config/aqua_own.go b/pkg/config/aqua_own.go
new file mode 100644
index 00000000..ce1fdaac
--- /dev/null
+++ b/pkg/config/aqua_own.go
@@ -0,0 +1,18 @@
+package config
+
+// IsAquaOwnPackage reports whether pkg is one of aqua's own packages and so is
+// kept in aqua's internal package directory instead of the regular package
+// directory that holds the packages aqua manages for users.
+//
+// aqua's own packages are aqua itself (aquaproj/aqua) and its proxy companion
+// (aquaproj/aqua-proxy), distributed as a GitHub release or GitHub content
+// asset. This is the single source of truth for that decision: Package.PkgPath,
+// which decides where aqua's own packages live, uses it, and every other flow
+// that needs to know whether a package is aqua's own should call this instead
+// of re-checking the repository owner and name.
+func (p *Package) IsAquaOwnPackage() bool {
+	pkgInfo := p.PackageInfo
+	return pkgInfo.RepoOwner == repoOwnerAquaproj &&
+		(pkgInfo.RepoName == pkgNameAqua || pkgInfo.RepoName == pkgNameAquaProxy) &&
+		(pkgInfo.Type == PkgInfoTypeGitHubRelease || pkgInfo.Type == PkgInfoTypeGitHubContent)
+}
diff --git a/pkg/config/aqua_own_test.go b/pkg/config/aqua_own_test.go
new file mode 100644
index 00000000..50ca39f3
--- /dev/null
+++ b/pkg/config/aqua_own_test.go
@@ -0,0 +1,181 @@
+package config_test
+
+import (
+	"testing"
+
+	"github.com/aquaproj/aqua/v2/pkg/config"
+	"github.com/aquaproj/aqua/v2/pkg/config/aqua"
+	"github.com/aquaproj/aqua/v2/pkg/config/registry"
+	"github.com/aquaproj/aqua/v2/pkg/runtime"
+)
+
+// TestPackage_IsAquaOwnPackage locks in (*Package).IsAquaOwnPackage as the
+// single decision for which packages count as aqua's own. aqua (aquaproj/aqua)
+// and its proxy companion (aquaproj/aqua-proxy), distributed as a GitHub
+// release or content asset, are aqua's own; everything else — including other
+// aquaproj repositories and other distribution types — is not.
+func TestPackage_IsAquaOwnPackage(t *testing.T) { //nolint:funlen
+	t.Parallel()
+	owner := repoOwnerAquaproj
+	data := []struct {
+		title string
+		exp   bool
+		pkg   *config.Package
+	}{
+		{
+			title: "aqua github_release",
+			exp:   true,
+			pkg: &config.Package{
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubRelease,
+					RepoOwner: owner,
+					RepoName:  "aqua",
+				},
+			},
+		},
+		{
+			title: "aqua-proxy github_release",
+			exp:   true,
+			pkg: &config.Package{
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubRelease,
+					RepoOwner: owner,
+					RepoName:  "aqua-proxy",
+				},
+			},
+		},
+		{
+			title: "aqua github_content",
+			exp:   true,
+			pkg: &config.Package{
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubContent,
+					RepoOwner: owner,
+					RepoName:  "aqua",
+				},
+			},
+		},
+		{
+			title: "aqua-installer github_content is not aqua's own",
+			exp:   false,
+			pkg: &config.Package{
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubContent,
+					RepoOwner: owner,
+					RepoName:  "aqua-installer",
+				},
+			},
+		},
+		{
+			title: "aqua github_archive is not aqua's own (wrong type)",
+			exp:   false,
+			pkg: &config.Package{
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubArchive,
+					RepoOwner: owner,
+					RepoName:  "aqua",
+				},
+			},
+		},
+		{
+			title: "non-aquaproj owner is not aqua's own",
+			exp:   false,
+			pkg: &config.Package{
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubRelease,
+					RepoOwner: "suzuki-shunsuke",
+					RepoName:  "aqua",
+				},
+			},
+		},
+	}
+	for _, d := range data {
+		t.Run(d.title, func(t *testing.T) {
+			t.Parallel()
+			if got := d.pkg.IsAquaOwnPackage(); got != d.exp {
+				t.Fatalf("wanted %v, got %v", d.exp, got)
+			}
+		})
+	}
+}
+
+// TestPackage_AbsPkgPath_aquaOwn locks in Package.AbsPkgPath as the single
+// source for where aqua's own packages live: aqua and aqua-proxy are kept in
+// the internal package directory, while other packages (even other
+// aquaproj repositories) go in the regular package directory.
+func TestPackage_AbsPkgPath_aquaOwn(t *testing.T) { //nolint:funlen
+	t.Parallel()
+	rootDir := "/tmp/aqua"
+	rt := &runtime.Runtime{GOOS: "linux", GOARCH: archAmd64}
+	data := []struct {
+		title string
+		exp   string
+		pkg   *config.Package
+	}{
+		{
+			title: "aqua github_release lives in the internal package directory",
+			exp:   "/tmp/aqua/internal/pkgs/github_release/github.com/aquaproj/aqua/v1.6.1/aqua_linux_amd64.tar.gz",
+			pkg: &config.Package{
+				Package: &aqua.Package{Version: "v1.6.1"},
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubRelease,
+					RepoOwner: repoOwnerAquaproj,
+					RepoName:  "aqua",
+					Asset:     "aqua_{{.OS}}_{{.Arch}}.tar.gz",
+					Format:    "tar.gz",
+				},
+			},
+		},
+		{
+			title: "aqua-proxy github_release lives in the internal package directory",
+			exp:   "/tmp/aqua/internal/pkgs/github_release/github.com/aquaproj/aqua-proxy/v1.2.13/aqua-proxy_linux_amd64.tar.gz",
+			pkg: &config.Package{
+				Package: &aqua.Package{Version: "v1.2.13"},
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubRelease,
+					RepoOwner: repoOwnerAquaproj,
+					RepoName:  "aqua-proxy",
+					Asset:     "aqua-proxy_{{.OS}}_{{.Arch}}.tar.gz",
+				},
+			},
+		},
+		{
+			title: "aqua github_content lives in the internal package directory",
+			exp:   "/tmp/aqua/internal/pkgs/github_content/github.com/aquaproj/aqua/v1.6.1/aqua",
+			pkg: &config.Package{
+				Package: &aqua.Package{Version: "v1.6.1"},
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubContent,
+					RepoOwner: repoOwnerAquaproj,
+					RepoName:  "aqua",
+					Path:      "aqua",
+				},
+			},
+		},
+		{
+			title: "aqua-installer github_content lives in the regular package directory",
+			exp:   "/tmp/aqua/pkgs/github_content/github.com/aquaproj/aqua-installer/v0.2.0/aqua-installer",
+			pkg: &config.Package{
+				Package: &aqua.Package{Version: "v0.2.0"},
+				PackageInfo: &registry.PackageInfo{
+					Type:      pkgTypeGitHubContent,
+					RepoOwner: repoOwnerAquaproj,
+					RepoName:  "aqua-installer",
+					Path:      "aqua-installer",
+				},
+			},
+		},
+	}
+	for _, d := range data {
+		t.Run(d.title, func(t *testing.T) {
+			t.Parallel()
+			got, err := d.pkg.AbsPkgPath(rootDir, rt)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got != d.exp {
+				t.Fatalf("wanted %v, got %v", d.exp, got)
+			}
+		})
+	}
+}
