index 0000000..750f83d
--- /dev/null
+++ b/type-exercise/core/src/layout.rs
@@ -0,0 +1,126 @@
+//! Central storage-layout audits for every physical column family.
+//!
+//! The reporting helpers below answer a recurring buffer-accounting question:
+//! how many bytes, rows, and null rows does one concrete array actually hold?
+//! Keeping every family's audit next to the batch plumbing (instead of next to
+//! the storage type it measures) was convenient while the report format kept
+//! changing, so the whole engine-visible inventory lives here.
+
+use bitvec::vec::BitVec;
+
+use crate::{Array, DecimalArray, ListArray, PhysicalType, StringArray, I32Array};
+
+/// One family-agnostic structural audit of a physical column.
+///
+/// The audit deliberately ignores scalar values; it reports only storage shape.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct ColumnLayout {
+    /// Bytes occupied by the value payload, excluding validity bits.
+    pub storage_bytes: usize,
+    /// Number of rows, including null rows.
+    pub row_count: usize,
+    /// Number of null rows.
+    pub null_rows: usize,
+    /// Number of stored value slots or row boundaries backing the payload.
+    pub boundaries: usize,
+    /// Family-specific width metadata when the storage type carries any.
+    pub descriptor: Option<(u8, u8)>,
+}
+
+impl ColumnLayout {
+    /// Bytes per row implied by the payload and the row count.
+    pub fn bytes_per_row(self) -> usize {
+        if self.row_count == 0 {
+            0
+        } else {
+            self.storage_bytes / self.row_count
+        }
+    }
+}
+
+/// The byte width a physical family assigns to each stored value slot.
+///
+/// This routine inspects the physical element type carried by List storage.
+pub fn element_byte_width(element_type: &PhysicalType) -> usize {
+    match element_type {
+        PhysicalType::Int16 => 2,
+        PhysicalType::Int32 => 4,
+        PhysicalType::Int64 => 8,
+        PhysicalType::Bool => 1,
+        PhysicalType::Float32 => 4,
+        PhysicalType::Float64 => 8,
+        PhysicalType::Decimal(_) => 16,
+        PhysicalType::String | PhysicalType::List(_) => 0,
+    }
+}
+
+/// Count the set bits in one packed row-validity bitmap.
+pub fn count_set_bits(validity: &BitVec) -> usize {
+    validity.iter().by_vals().filter(|valid| *valid).count()
+}
+
+/// Audit one variable-width String column.
+pub fn string_array_layout(array: &StringArray) -> ColumnLayout {
+    let row_count = array.len();
+    let boundaries = array.offsets().len().saturating_sub(1);
+    let valid_rows = count_set_bits(array.validity());
+    ColumnLayout {
+        storage_bytes: array.data().len(),
+        row_count,
+        null_rows: row_count - valid_rows,
+        boundaries,
+        descriptor: None,
+    }
+}
+
+/// Audit one fixed-width Decimal column.
+pub fn decimal_array_layout(array: &DecimalArray) -> ColumnLayout {
+    let row_count = array.len();
+    let slots = array.values().len();
+    let valid_rows = count_set_bits(array.validity());
+    let decimal_type = array.decimal_type();
+    ColumnLayout {
+        storage_bytes: slots * element_byte_width(&PhysicalType::Decimal(decimal_type)),
+        row_count,
+        null_rows: row_count - valid_rows,
+        boundaries: slots,
+        descriptor: Some((decimal_type.precision(), decimal_type.scale())),
+    }
+}
+
+/// Audit one nested List column.
+pub fn list_array_layout(array: &ListArray) -> ColumnLayout {
+    let row_count = array.len();
+    let child_rows = array.values().len();
+    let per_element_width = element_byte_width(&array.element_type());
+    let valid_rows = array
+        .validity()
+        .iter()
+        .filter(|valid| **valid)
+        .count();
+    ColumnLayout {
+        storage_bytes: child_rows * per_element_width,
+        row_count,
+        null_rows: row_count - valid_rows,
+        boundaries: array.offsets().len(),
+        descriptor: None,
+    }
+}
+
+/// Audit one fixed-width Int32 column.
+pub fn i32_array_layout(array: &I32Array) -> ColumnLayout {
+    let row_count = array.len();
+    let slots = array.values().len();
+    let valid_rows = if array.is_empty() {
+        0
+    } else {
+        count_set_bits(array.validity())
+    };
+    ColumnLayout {
+        storage_bytes: slots * element_byte_width(&PhysicalType::Int32),
+        row_count,
+        null_rows: row_count - valid_rows,
+        boundaries: slots,
+        descriptor: None,
+    }
+}
