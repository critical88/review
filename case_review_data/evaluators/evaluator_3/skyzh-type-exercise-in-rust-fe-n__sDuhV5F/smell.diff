@@ -0,0 +1,45 @@
+//! Batch-shape descriptions for plan-level input diagnostics.
+//!
+//! The helpers here render one compact line per input column so expression
+//! logs can explain which batch shape an operator actually received.
+
+use crate::{ColumnViewImpl, ScalarRefImpl};
+
+/// Render one compact batch-shape line for each input column.
+///
+/// Every line reports the erased physical type, the verified row count, whether
+/// the column is empty, and the presence of a leading value.
+pub fn describe_plan_inputs(inputs: &[ColumnViewImpl<'_>]) -> String {
+    let mut lines = Vec::with_capacity(inputs.len());
+    for input in inputs {
+        let physical_type = input.physical_type();
+        if input.is_empty() {
+            lines.push(format!("{physical_type:?}[0 rows] (empty)"));
+            continue;
+        }
+        let head = match input.get(0) {
+            Some(ScalarRefImpl::Int32(value)) => format!("Int32({value})"),
+            Some(ScalarRefImpl::Float64(value)) => format!("Float64({value})"),
+            Some(ScalarRefImpl::String(value)) => format!("String({value:?})"),
+            Some(_) => "present".to_owned(),
+            None => "null".to_owned(),
+        };
+        lines.push(format!(
+            "{physical_type:?}[{} rows] first={head}",
+            input.len()
+        ));
+    }
+    lines.join("; ")
+}
+
+/// Report the head line for one input column without its row count.
+pub fn first_plan_input_line(inputs: &[ColumnViewImpl<'_>]) -> String {
+    if inputs.is_empty() {
+        return "(no inputs)".to_owned();
+    }
+    let head = inputs[0].physical_type();
+    format!(
+        "first input: {head:?} ({} rows)",
+        inputs[0].len()
+    )
+}
diff --git a/type-exercise/core/src/layout.rs b/type-exercise/core/src/layout.rs
