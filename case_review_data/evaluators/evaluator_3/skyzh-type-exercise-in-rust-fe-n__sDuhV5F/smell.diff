+/// Render the declared logical signature that produced one bound expression.
+///
+/// Planning errors quote this line so operators can tell which concrete
+/// physical kernel was selected for which declared logical inputs.
+pub fn describe_declared_inputs(bound: &BoundExpression) -> String {
+    let inputs = bound
+        .input_types()
+        .iter()
+        .map(|input| format!("{input:?}"))
+        .collect::<Vec<_>>();
+    format!(
+        "{}({}) -> {:?} ({:?})",
+        bound.physical_name(),
+        inputs.join(", "),
+        bound.output_type(),
+        bound.output_physical_type()
+    )
+}
