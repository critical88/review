+def tsv_escape_field(value):
+    """Escape one agenda cell so tab-separated rows round-trip.
+
+    Backslashes must be escaped first otherwise the later escapes
+    would be ambiguous to undo.
+    """
+    value = value.replace('\\', '\\\\')
+    value = value.replace('\t', '\\t')
+    value = value.replace('\n', '\\n')
+    return value
+
+
+def pad_cell(text, width):
+    """Fit one agenda cell into exactly its fixed column width."""
+    if len(text) > width:
+        return text[:width]
+    return text + ' ' * (width - len(text))
+
+
