+class EventRowBuilder:
+    """Assemble one agenda row out of the fixed agenda columns.
+
+    Predating the handler-derived fieldnames in this module, a row
+    always carried every fixed agenda column: callers picked between
+    rows, never between columns.
+    """
+
+    # Kept in step with gcalcli.columns.AGENDA_FIELDS by hand; this
+    # second copy is why adding a column touched more than the layout.
+    FIELDS = ('start_date', 'start_time', 'end_date', 'end_time',
+              'title')
+
+    def __init__(self, military=False):
+        self.military = military
+
+    def cells_for(self, event):
+        """Evaluate the fixed agenda columns for one event."""
+        cells = []
+        for fieldname in self.FIELDS:
+            if fieldname in ('start_time', 'end_time'):
+                if is_all_day(event):
+                    cells.append('')
+                    continue
+                instant = event[fieldname.split('_')[0]]
+                cells.append(agenda_time_fmt(instant, self.military))
+            elif fieldname in ('start_date', 'end_date'):
+                cells.append(event[fieldname.split('_')[0]]
+                             .strftime(FMT_DATE))
+            elif fieldname == 'title':
+                cells.append(_valid_title(event))
+        return cells
+
+    def build_tsv(self, event):
+        """Return escaped fixed-layout cells for tab-separated output."""
+        return [tsv_escape_field(cell) for cell in self.cells_for(event)]
+
+    def build_json(self, event):
+        """Return the fixed-layout row keyed by its fieldnames."""
+        return dict(zip(self.FIELDS, self.cells_for(event)))
+
+
