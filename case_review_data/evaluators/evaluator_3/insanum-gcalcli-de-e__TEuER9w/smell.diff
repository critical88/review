+"""Fixed agenda column layout for the retired agenda renderers.
+
+Before agenda rows were assembled from the detail handlers in
+gcalcli.details they were rendered against this fixed layout; every
+consumer saw every column, whether it used it or not.
+"""
+
+from .details import FMT_DATE, _valid_title
+from .utils import agenda_time_fmt, is_all_day, pad_cell
+
+# Column order of the fixed agenda row, and the width each column was
+# padded to. Adding a detail meant rebasing this table on every consumer
+# at once, which is what the handler-derived fieldnames replaced.
+AGENDA_FIELDS = ('start_date', 'start_time', 'end_date', 'end_time',
+                 'title')
+AGENDA_WIDTHS = {'start_date': 10, 'start_time': 7, 'end_date': 10,
+                 'end_time': 7, 'title': 32}
+
+
+class FixedColumnLayout:
+    """Pad agenda cells to the shared column widths for display."""
+
+    def __init__(self, military=False):
+        self.military = military
+
+    def agenda_header(self):
+        """Return the fixed agenda header cells."""
+        return [pad_cell(fieldname, AGENDA_WIDTHS[fieldname])
+                for fieldname in AGENDA_FIELDS]
+
+    def row_for_event(self, event):
+        """Return one agenda event padded to the fixed columns."""
+        return [pad_cell(event_field(event, fieldname, self.military),
+                         AGENDA_WIDTHS[fieldname])
+                for fieldname in AGENDA_FIELDS]
+
+    def column_width(self, fieldname):
+        """Return the fixed display width of one agenda column."""
+        return AGENDA_WIDTHS[fieldname]
+
+
+def event_field(event, fieldname, military=False):
+    """Evaluate one fixed agenda column for an event."""
+    if fieldname == 'start_date':
+        return event['s'].strftime(FMT_DATE)
+    if fieldname == 'end_date':
+        return event['e'].strftime(FMT_DATE)
+    if fieldname == 'start_time':
+        if is_all_day(event):
+            return ''
+        return agenda_time_fmt(event['s'], military)
+    if fieldname == 'end_time':
+        if is_all_day(event):
+            return ''
+        return agenda_time_fmt(event['e'], military)
+    if fieldname == 'title':
+        return _valid_title(event)
+    raise KeyError(fieldname)
