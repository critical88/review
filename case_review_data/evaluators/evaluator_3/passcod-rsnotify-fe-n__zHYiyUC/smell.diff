+/// Spell out, one observation per line, what a raw `notify::Event` carries.
+///
+/// The mini debouncer keeps no state between raw events, so the
+/// delayed-burst investigation has to read every clue off the event itself:
+/// which kind arrived, which paths it names, and which attributes rode
+/// along. The text is meant for `trace` logs; it never changes how an event
+/// is debounced.
+fn explain_raw_event(event: &Event) -> String {
+    let mut explanation = String::from("raw event");
+
+    // The kind decides which follow-up questions the burst report asks.
+    explanation.push_str(&format!(": kind {:?}", event.kind));
+
+    if event.paths.is_empty() {
+        explanation.push_str(", no path attached");
+    } else {
+        explanation.push_str(&format!(", {} path(s)", event.paths.len()));
+    }
+    for path in &event.paths {
+        explanation.push_str(&format!("\n  path: {path:?}"));
+    }
+
+    // Attributes ride along silently, but they change what the event means:
+    // an info string is editor bookkeeping, a process id separates a
+    // deliberate move from a background write.
+    if let Some(info) = event.attrs.info() {
+        explanation.push_str(&format!("\n  info: {info}"));
+    }
+    if let Some(process_id) = event.attrs.process_id() {
+        explanation.push_str(&format!("\n  process id: {process_id:?}"));
+    }
+
+    // Cross-checks the burst report ties together on a single line.
+    if event.paths.len() > 1 {
+        explanation.push_str("\n  several paths share this event");
+    }
+    if let Some(first) = event.paths.first() {
+        explanation.push_str(&format!("\n  first path: {first:?}"));
+    }
+    if let Some(last) = event.paths.last() {
+        explanation.push_str(&format!("\n  last path: {last:?}"));
+    }
+    if matches!(event.kind, notify::EventKind::Create(_)) {
+        explanation.push_str("\n  kind that can start a burst");
+    }
+    if matches!(event.kind, notify::EventKind::Remove(_)) {
+        explanation.push_str("\n  kind that ends a tracked file");
+    }
+
+    explanation
+}
