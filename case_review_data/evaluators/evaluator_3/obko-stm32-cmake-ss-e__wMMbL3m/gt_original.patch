diff --git a/examples/common/appfw.c b/examples/common/appfw.c
new file mode 100644
index 0000000..1317e08
--- /dev/null
+++ b/examples/common/appfw.c
@@ -0,0 +1,38 @@
+#include "appfw.h"
+
+/* Boot progress marker, read back over the debug probe by bring-up tooling. */
+volatile unsigned int appfw_boot_stage;
+
+static unsigned int appfw_append(char *banner, unsigned int position, const char *part)
+{
+    unsigned int index = 0u;
+
+    while (part[index] != '\0')
+    {
+        banner[position++] = part[index++];
+    }
+
+    return position;
+}
+
+const char *appfw_signature(const struct appfw_image *image)
+{
+    static char appfw_banner[64];
+    unsigned int position = 0u;
+
+    position = appfw_append(appfw_banner, position, image->name);
+    position = appfw_append(appfw_banner, position, " @ ");
+    position = appfw_append(appfw_banner, position, image->board);
+    position = appfw_append(appfw_banner, position, " rev");
+    position = appfw_append(appfw_banner, position, image->revision);
+    appfw_banner[position] = '\0';
+
+    return appfw_banner;
+}
+
+unsigned int appfw_boot_report(unsigned int stage)
+{
+    appfw_boot_stage = stage;
+
+    return APPFW_PROTOCOL_REVISION;
+}
diff --git a/examples/common/appfw.cmake b/examples/common/appfw.cmake
new file mode 100644
index 0000000..f670c53
--- /dev/null
+++ b/examples/common/appfw.cmake
@@ -0,0 +1,20 @@
+# Shared "appfw" firmware self-report implementation used by every bundled
+# example: "appfw.h" declares the interface, "appfw.c" implements it once.
+#
+# appfw.c is compiled into each example target with that target's own device
+# flags (families differ in -mcpu/-mfpu/-mfloat-abi, so a single prebuilt
+# object library cannot be shared across them).
+#
+# Usage, once per example project:
+#   include(${CMAKE_CURRENT_SOURCE_DIR}/../common/appfw.cmake)
+#   appfw_link(<example-target>)
+
+# Captured at include time: CMAKE_CURRENT_LIST_DIR inside the function below
+# would otherwise resolve to the including project's directory at call time.
+set(APPFW_COMMON_DIR "${CMAKE_CURRENT_LIST_DIR}" CACHE INTERNAL
+    "Directory of the shared appfw example module")
+
+function(appfw_link TARGET)
+    target_sources(${TARGET} PRIVATE "${APPFW_COMMON_DIR}/appfw.c")
+    target_include_directories(${TARGET} PRIVATE "${APPFW_COMMON_DIR}")
+endfunction()
diff --git a/examples/common/appfw.h b/examples/common/appfw.h
new file mode 100644
index 0000000..68a6029
--- /dev/null
+++ b/examples/common/appfw.h
@@ -0,0 +1,52 @@
+#ifndef STM32_CMAKE_EXAMPLES_COMMON_APPFW_H_
+#define STM32_CMAKE_EXAMPLES_COMMON_APPFW_H_
+
+/*
+ * Application firmware self-report ("appfw"), bundle protocol revision 2.
+ *
+ * Every example shipped in this repository is flashed and exercised by the
+ * same bring-up tools, so they all report themselves the same way:
+ *
+ *   appfw_boot_stage     bring-up progress marker, read back over the debug
+ *                        probe (APPFW_STAGE_BOOT, then APPFW_STAGE_READY);
+ *   appfw_signature()    "<image> @ <board> rev<r>" banner of this image;
+ *   appfw_boot_report()  advances the marker and returns the bundle protocol
+ *                        revision this image understands.
+ *
+ * Every example owns only the identity of its own image (struct appfw_image);
+ * the stages, the banner layout and the protocol revision live here, so a
+ * protocol change is a single edit again.
+ */
+#define APPFW_PROTOCOL_REVISION 2u
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum
+{
+    APPFW_STAGE_BOOT  = 1,
+    APPFW_STAGE_READY = 2
+};
+
+/* Identity of one example image. */
+struct appfw_image
+{
+    const char *name;
+    const char *board;
+    const char *revision;
+};
+
+extern volatile unsigned int appfw_boot_stage;
+
+/* "<image> @ <board> rev<r>" for the given image. */
+const char *appfw_signature(const struct appfw_image *image);
+
+/* Record boot progress and return the bundle protocol revision. */
+unsigned int appfw_boot_report(unsigned int stage);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* STM32_CMAKE_EXAMPLES_COMMON_APPFW_H_ */
