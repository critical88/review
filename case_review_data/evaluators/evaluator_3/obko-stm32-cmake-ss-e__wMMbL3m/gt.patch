diff --git a/examples/common/appfw.c b/examples/common/appfw.c
new file mode 100644
index 0000000..8803668
--- /dev/null
+++ b/examples/common/appfw.c
@@ -0,0 +1,43 @@
+#include "appfw.h"
+
+volatile unsigned int appfw_boot_stage;
+
+/* Append the bytes of <part> into <banner> at <position> and return the new
+ * position. Mirrors the per-example render loops this module replaces. */
+static unsigned int appfw_append(char *banner, unsigned int position,
+                                 const char *part)
+{
+    unsigned int index = 0u;
+
+    while (part[index] != '\0')
+    {
+        banner[position++] = part[index++];
+    }
+
+    return position;
+}
+
+const char *appfw_render_banner(const char *image, const char *target,
+                                const char *revision)
+{
+    static char appfw_banner[APPFW_BANNER_SIZE];
+    unsigned int position = 0u;
+
+    /* Layout is fixed by the protocol: image, separator, target, separator,
+     * revision. Change it here once and every example follows. */
+    position = appfw_append(appfw_banner, position, image);
+    position = appfw_append(appfw_banner, position, " @ ");
+    position = appfw_append(appfw_banner, position, target);
+    position = appfw_append(appfw_banner, position, " rev");
+    position = appfw_append(appfw_banner, position, revision);
+    appfw_banner[position] = '\0';
+
+    return appfw_banner;
+}
+
+unsigned int appfw_boot_report(unsigned int stage)
+{
+    appfw_boot_stage = stage;
+
+    return APPFW_PROTOCOL_REVISION;
+}
diff --git a/examples/common/appfw.h b/examples/common/appfw.h
new file mode 100644
index 0000000..9bc6769
--- /dev/null
+++ b/examples/common/appfw.h
@@ -0,0 +1,54 @@
+#ifndef APPFW_H
+#define APPFW_H
+
+/*
+ * Application firmware self-report ("appfw"), bundle protocol revision 2.
+ *
+ * Single owner of the bring-up self-report contract shared by every example in
+ * this repository: each example is flashed, halted, queried over the debug
+ * probe and stepped to its idle loop by the same bring-up tools, so they all
+ * report themselves the same way. This module owns that contract.
+ *
+ *   appfw_boot_stage        bring-up progress marker, written by
+ *                           appfw_boot_report() and read back from RAM over the
+ *                           debug probe (APPFW_STAGE_BOOT, then
+ *                           APPFW_STAGE_READY);
+ *   appfw_boot_report()     records <stage> in appfw_boot_stage and returns the
+ *                           bundle protocol revision this image understands;
+ *   appfw_render_banner()   "<image> @ <target> rev<r>" banner of this image.
+ *
+ * The stage numbers, the banner layout and the protocol revision live HERE, so
+ * a protocol change is made in one place and every example follows. Each
+ * example owns only its own per-image strings (image name, target, revision),
+ * which it forwards to appfw_render_banner() from its appfw_signature().
+ */
+
+#define APPFW_PROTOCOL_REVISION 2u
+#define APPFW_STAGE_BOOT        1u
+#define APPFW_STAGE_READY       2u
+
+/* Scratch buffer for the rendered banner; sized for the longest banner any
+ * example emits, including the terminating NUL. */
+#define APPFW_BANNER_SIZE       64u
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Bring-up progress marker; read back from RAM over the debug probe. */
+extern volatile unsigned int appfw_boot_stage;
+
+/* Record <stage> in appfw_boot_stage and return the bundle protocol revision
+ * the image speaks. */
+unsigned int appfw_boot_report(unsigned int stage);
+
+/* Render "<image> @ <target> rev<r>" into a shared scratch buffer and return
+ * it. Stable across calls: the same content is produced every time. */
+const char *appfw_render_banner(const char *image, const char *target,
+                                const char *revision);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* APPFW_H */
