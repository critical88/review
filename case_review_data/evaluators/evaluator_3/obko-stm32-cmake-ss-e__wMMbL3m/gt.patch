+          )
+      endif()
+      message(FATAL_ERROR "\nFailed to rebase in: '/workspace/repo/.stm32-fetch/stm32-hal-f2-src'."
+                          "\nOutput from the attempted rebase follows:"
+                          "\n${rebase_output}"
+                          "\n\nYou will have to resolve the conflicts manually")
+    endif()
