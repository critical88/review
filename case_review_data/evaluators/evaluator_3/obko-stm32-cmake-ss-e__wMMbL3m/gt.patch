+            --git-dir=.git 
+            submodule update --recursive --init 
+    WORKING_DIRECTORY "/workspace/repo/.stm32-fetch/stm32-cmsis-c0-src"
+    COMMAND_ERROR_IS_FATAL ANY
+  )
+endif()
