@@ -0,0 +1,86 @@
+"""Tests for certipy.lib.files saving behaviour."""
+
+import base64
+import os
+
+import pytest
+
+from certipy.lib.errors import handle_error, translate_error_code
+from certipy.lib.files import try_to_save_file
+
+
+def test_save_bytes_creates_file(tmp_path):
+    target = str(tmp_path / "out.pem")
+    assert try_to_save_file(b"data", target) == target
+    assert (tmp_path / "out.pem").read_bytes() == b"data"
+
+
+def test_save_string_creates_file(tmp_path):
+    target = str(tmp_path / "out.txt")
+    assert try_to_save_file("text", target) == target
+    assert (tmp_path / "out.txt").read_text() == "text"
+
+
+def test_save_sanitizes_colons_in_filename(tmp_path):
+    target = str(tmp_path / "out:put.pem")
+    returned = try_to_save_file(b"data", target)
+    assert returned == str(tmp_path / "out_put.pem")
+    assert (tmp_path / "out_put.pem").read_bytes() == b"data"
+
+
+def test_save_overwrites_when_user_confirms(tmp_path, monkeypatch):
+    target = tmp_path / "existing.pem"
+    target.write_bytes(b"old")
+    monkeypatch.setattr("builtins.input", lambda prompt: "y")
+    assert try_to_save_file(b"new", str(target)) == str(target)
+    assert target.read_bytes() == b"new"
+
+
+def test_save_uses_unique_filename_when_user_declines(tmp_path, monkeypatch):
+    target = tmp_path / "existing.pem"
+    target.write_bytes(b"old")
+    monkeypatch.setattr("builtins.input", lambda prompt: "n")
+    returned = try_to_save_file(b"new", str(target))
+    assert returned != str(target)
+    assert os.path.basename(returned).startswith("existing_")
+    assert os.path.basename(returned).endswith(".pem")
+    with open(returned, "rb") as f:
+        assert f.read() == b"new"
+    assert target.read_bytes() == b"old"
+
+
+def test_save_failure_aborts_when_requested(tmp_path):
+    target = str(tmp_path / "missing-dir" / "out.pem")
+    with pytest.raises(OSError):
+        try_to_save_file(b"data", target, abort_on_fail=True)
+
+
+def test_save_failure_falls_back_to_stdout(tmp_path, capsys):
+    target = str(tmp_path / "missing-dir" / "out.pem")
+    returned = try_to_save_file(b"data", target)
+    assert returned == "stdout"
+    captured = capsys.readouterr()
+    assert base64.b64decode(captured.out.strip()) == b"data"
+
+
+def test_save_failure_falls_back_to_stdout_for_text(tmp_path, capsys):
+    target = str(tmp_path / "missing-dir" / "out.txt")
+    assert try_to_save_file("text", target) == "stdout"
+    captured = capsys.readouterr()
+    assert captured.out.strip() == "text"
+
+
+def test_translate_error_code_known_and_unknown():
+    assert translate_error_code(0x80090311).startswith("code: 0x80090311 - ")
+    assert translate_error_code(0xDEADBEEF) == "unknown error code: 0xdeadbeef"
+
+
+def test_translate_error_code_masks_sign_extension():
+    signed = 0x80090311 - 2**32
+    assert str(signed) not in translate_error_code(signed)
+    assert translate_error_code(signed) == translate_error_code(0x80090311)
+
+
+def test_handle_error_does_not_exit():
+    assert handle_error() is None
+    assert handle_error(is_warning=True) is None
diff --git a/tests/test_find_data.py b/tests/test_find_data.py
new file mode 100644
index 0000000..161e74e
--- /dev/null
+++ b/tests/test_find_data.py
@@ -0,0 +1,252 @@
+"""Tests for certipy.commands.find data processing."""
+
+import struct
+
+import pytest
+
+from certipy.commands.find import Find
+from certipy.lib.constants import (
+    CertificateNameFlag,
+    EnrollmentFlag,
+    PrivateKeyFlag,
+)
+from conftest import FakeEntry
+
+ONE_YEAR_FILETIME = struct.pack("<q", -315360000000000)
+ONE_WEEK_FILETIME = struct.pack("<q", -6048000000000)
+
+EKU_CLIENT_AUTH = b"1.3.6.1.5.5.7.3.2"
+EKU_SERVER_AUTH = b"1.3.6.1.5.5.7.3.1"
+EKU_REQUEST_AGENT = b"1.3.6.1.4.1.311.20.2.1"
+
+
+def _finder():
+    # No target required: only pure data-processing methods are exercised
+    return Find(None)
+
+
+def _template(**raw):
+    return FakeEntry(raw, raw)
+
+
+def test_enabled_flag_reflects_certificate_authorities():
+    finder = _finder()
+    enabled = _template(cas=["CORP-CA"])
+    disabled = _template(cas=None)
+    finder._process_template_properties([enabled, disabled])
+    assert enabled.get("enabled") is True
+    assert disabled.get("enabled") is False
+
+
+def test_validity_and_renewal_periods_are_converted():
+    finder = _finder()
+    template = _template(
+        pKIExpirationPeriod=ONE_YEAR_FILETIME,
+        pKIOverlapPeriod=ONE_WEEK_FILETIME,
+    )
+    finder._process_template_properties([template])
+    assert template.get("validity_period") == "1 year"
+    assert template.get("renewal_period") == "1 week"
+
+
+def test_missing_validity_periods_default_to_zero():
+    finder = _finder()
+    template = _template()
+    finder._process_template_properties([template])
+    assert template.get("validity_period") == 0
+    assert template.get("renewal_period") == 0
+
+
+def test_flag_attributes_are_listed():
+    finder = _finder()
+    template = _template(
+        **{
+            "msPKI-Certificate-Name-Flag": str(CertificateNameFlag.ENROLLEE_SUPPLIES_SUBJECT.value),
+            "msPKI-Enrollment-Flag": str(EnrollmentFlag.PEND_ALL_REQUESTS.value),
+            "msPKI-Private-Key-Flag": str(PrivateKeyFlag.REQUIRE_PRIVATE_KEY_ARCHIVAL.value),
+            "msPKI-RA-Signature": "2",
+            "msPKI-Template-Schema-Version": "3",
+        }
+    )
+    finder._process_template_properties([template])
+    assert CertificateNameFlag.ENROLLEE_SUPPLIES_SUBJECT in template.get(
+        "certificate_name_flag"
+    )
+    assert EnrollmentFlag.PEND_ALL_REQUESTS in template.get("enrollment_flag")
+    assert PrivateKeyFlag.REQUIRE_PRIVATE_KEY_ARCHIVAL in template.get(
+        "private_key_flag"
+    )
+    assert template.get("authorized_signatures_required") == 2
+    assert template.get("schema_version") == 3
+
+
+def test_flag_defaults_when_attributes_missing():
+    finder = _finder()
+    template = _template()
+    finder._process_template_properties([template])
+    assert template.get("certificate_name_flag") == []
+    assert template.get("enrollment_flag") == []
+    assert template.get("private_key_flag") == []
+    assert template.get("authorized_signatures_required") == 0
+    assert template.get("schema_version") == 1
+
+
+def test_capabilities_derived_from_eku():
+    finder = _finder()
+    template = _template(
+        **{
+            "msPKI-RA-Application-Policies": [EKU_CLIENT_AUTH],
+            "pKIExtendedKeyUsage": [EKU_CLIENT_AUTH],
+        }
+    )
+    finder._process_template_properties([template])
+    assert template.get("extended_key_usage") == ["Client Authentication"]
+    assert template.get("application_policies") == ["Client Authentication"]
+    assert template.get("client_authentication") is True
+    assert template.get("any_purpose") is False
+    assert template.get("enrollment_agent") is False
+
+
+def test_capabilities_with_empty_eku_means_any_purpose():
+    finder = _finder()
+    template = _template(
+        **{
+            "msPKI-RA-Application-Policies": None,
+            "pKIExtendedKeyUsage": None,
+        }
+    )
+    finder._process_template_properties([template])
+    assert template.get("extended_key_usage") == []
+    assert template.get("application_policies") == []
+    assert template.get("any_purpose") is True
+    assert template.get("client_authentication") is True
+    assert template.get("server_authentication") is True
+    assert template.get("enrollment_agent") is True
+
+
+def test_enrollee_supplies_subject_from_certificate_name_flag():
+    finder = _finder()
+    template = _template(
+        **{
+            "msPKI-Certificate-Name-Flag": str(CertificateNameFlag.ENROLLEE_SUPPLIES_SUBJECT.value),
+            "msPKI-Enrollment-Flag": "0",
+            "msPKI-Private-Key-Flag": "0",
+            "msPKI-RA-Application-Policies": None,
+            "pKIExtendedKeyUsage": [EKU_CLIENT_AUTH],
+        }
+    )
+    finder._process_template_properties([template])
+    assert template.get("enrollee_supplies_subject") is True
+    assert template.get("requires_manager_approval") is False
+    assert template.get("requires_key_archival") is False
+
+
+def test_enrollment_agent_and_server_authentication_capabilities():
+    finder = _finder()
+    agent = _template(pKIExtendedKeyUsage=[EKU_REQUEST_AGENT])
+    server = _template(pKIExtendedKeyUsage=[EKU_SERVER_AUTH])
+    finder._process_template_properties([agent, server])
+    assert agent.get("enrollment_agent") is True
+    assert agent.get("server_authentication") is False
+    assert server.get("enrollment_agent") is False
+    assert server.get("server_authentication") is True
+
+
+def test_flatten_template_data():
+    finder = _finder()
+    entry = {
+        "Template Name": "User",
+        "Enabled": False,
+        "Certificate Authorities": ["CA1", "CA2"],
+        "Valid Extensions": {"EKU": "Client Authentication"},
+        "Pending": None,
+        "Permissions": {
+            "Enrollment Permissions": {"Enrollment Rights": ["u1", "u2"]},
+            "Object Control Permissions": {
+                "Write Owner Principals": ["o1"],
+                "Write Dacl Principals": ["d1", "d2"],
+            },
+        },
+    }
+    flattened = finder._flatten_template_data(entry)
+    assert flattened["Template Name"] == "User"
+    assert flattened["Enabled"] == "False"
+    assert flattened["Certificate Authorities"] == "CA1\nCA2"
+    assert flattened["Pending"] == ""
+    assert flattened["Valid Extensions"] == "EKU: Client Authentication"
+    assert flattened["Enrollment Permissions"] == "u1\nu2"
+    assert flattened["Write Owner Principals"] == "o1"
+    assert flattened["Write Dacl Principals"] == "d1\nd2"
+
+
+def test_flatten_ca_data():
+    finder = _finder()
+    entry = {
+        "CA Name": "CORP-CA",
+        "Web Enrollment": {
+            "http": {"enabled": True},
+            "https": {"enabled": False, "channel_binding": True},
+        },
+        "Permissions": {
+            "Owner": "CORP\\Administrator",
+            "Access Rights": {
+                "Manage CA": ["adm"],
+                "Manage Certificates": ["c1", "c2"],
+            },
+        },
+        "[!] Vulnerabilities": {"ESC1": "dangerous template"},
+        "Config": {"flag": "value"},
+        "Templates": ["User", "Machine"],
+        "Notes": None,
+    }
+    flattened = finder._flatten_ca_data(entry)
+    assert flattened["CA Name"] == "CORP-CA"
+    assert flattened["Web Enrollment HTTP"] == "Enabled"
+    assert flattened["Web Enrollment HTTPS"] == "Disabled"
+    assert flattened["Channel Binding"] == "Enabled"
+    assert flattened["Owner"] == "CORP\\Administrator"
+    assert flattened["Manage CA Principals"] == "adm"
+    assert flattened["Manage Certificates Principals"] == "c1\nc2"
+    assert flattened["[!] Vulnerabilities"] == "ESC1: dangerous template"
+    assert flattened["Config"] == "flag: value"
+    assert flattened["Templates"] == "User\nMachine"
+    assert flattened["Notes"] == ""
+
+
+def test_flatten_ca_data_unknown_channel_binding():
+    finder = _finder()
+    flattened = finder._flatten_ca_data(
+        {"Web Enrollment": {"https": {"enabled": True, "channel_binding": None}}}
+    )
+    assert flattened["Channel Binding"] == "Unknown"
+    assert flattened["Web Enrollment HTTPS"] == "Enabled"
+
+
+def test_template_csv_output():
+    finder = _finder()
+    output = {
+        "Certificate Templates": {
+            0: {
+                "Template Name": "User",
+                "Display Name": "User",
+                "Enabled": True,
+                "Certificate Authorities": ["CA1"],
+                "Extended Key Usage": ["Client Authentication"],
+                "[!] Vulnerabilities": {"ESC1": "ESC1"},
+                "Validity Period": "1 year",
+            }
+        }
+    }
+    csv_data = finder.get_template_output_for_csv(output)
+    lines = csv_data.splitlines()
+    assert lines[0].startswith('"Template Name";"Display Name"')
+    assert len(lines) == 2
+    assert "User" in lines[1]
+    assert "ESC1: ESC1" in lines[1]
+
+
+def test_template_csv_output_without_data():
+    finder = _finder()
+    csv_data = finder.get_template_output_for_csv({"Certificate Templates": []})
+    # Only the header row is emitted
+    assert len(csv_data.splitlines()) == 1  # only the header row
diff --git a/tests/test_forge.py b/tests/test_forge.py
new file mode 100644
index 0000000..2609ae2
--- /dev/null
+++ b/tests/test_forge.py
@@ -0,0 +1,215 @@
+"""Tests for the certificate forging logic in certipy.commands.forge."""
+
+import pytest
+from cryptography import x509
+from cryptography.hazmat.primitives import hashes
+from cryptography.x509.oid import ExtensionOID
+
+from certipy.lib.certificate import (
+    NTDS_CA_SECURITY_EXT,
+    PRINCIPAL_NAME,
+    SAN_URL_PREFIX,
+    cert_to_der,
+    create_pfx,
+    der_to_cert,
+    get_identities_from_certificate,
+    get_object_sid_from_certificate,
+    get_object_sid_from_certificate_san_url,
+    get_object_sid_from_certificate_sid_extension,
+    load_pfx,
+)
+from certipy.commands.forge import Forge
+
+
+def test_forge_self_signed_ca_with_default_subject(tmp_path):
+    out = str(tmp_path / "ca.pfx")
+    Forge(out=out, pfx_password="secret").create_self_signed_ca()
+    key, cert = load_pfx((tmp_path / "ca.pfx").read_bytes(), b"secret")
+    assert cert is not None and key is not None
+    assert (
+        cert.subject.get_attributes_for_oid(x509.NameOID.COMMON_NAME)[0].value
+        == "Certipy CA"
+    )
+
+
+def test_forge_self_signed_ca_with_custom_subject_and_out(tmp_path):
+    out = str(tmp_path / "custom-name")
+    Forge(subject="CN=Corp Root", out=out).create_self_signed_ca()
+    assert (tmp_path / "custom-name.pfx").exists()
+    _, cert = load_pfx((tmp_path / "custom-name.pfx").read_bytes(), None)
+    assert (
+        cert.subject.get_attributes_for_oid(x509.NameOID.COMMON_NAME)[0].value
+        == "Corp Root"
+    )
+
+
+def test_serial_number_from_hex_string():
+    assert Forge(serial="dead:beef").get_serial_number() == 0xdeadbeef
+    assert Forge(serial="ff").get_serial_number() == 0xFF
+
+    implicit = Forge()
+    serial = implicit.get_serial_number()
+    assert serial > 0
+
+
+def test_get_crl_distribution_points():
+    assert Forge().get_crl() is None
+    extension = Forge(crl="http://crl.corp.local/ca.crl").get_crl()
+    assert isinstance(extension, x509.CRLDistributionPoints)
+    uri = (
+        extension[0]
+        .full_name[0]
+        .value
+    )
+    assert uri == "http://crl.corp.local/ca.crl"
+
+    overridden = Forge(crl="http://first/x.crl").get_crl("http://second/y.crl")
+    assert overridden[0].full_name[0].value == "http://second/y.crl"
+
+
+def test_get_allowed_hash_algorithm_rules():
+    forge = Forge()
+    assert isinstance(forge.get_allowed_hash_algorithm(None), hashes.SHA256)
+
+    sha256 = hashes.SHA256()
+    assert forge.get_allowed_hash_algorithm(sha256) is sha256
+
+    # SHA-1 is rejected for security reasons and downgraded to SHA-256
+    assert isinstance(forge.get_allowed_hash_algorithm(hashes.SHA1()), hashes.SHA256)
+
+
+def test_create_sid_extension_contents():
+    assert Forge().create_sid_extension() is None
+
+    extension = Forge(sid="S-1-5-21-1-2-3-42").create_sid_extension()
+    assert isinstance(extension, x509.UnrecognizedExtension)
+    assert extension.oid == NTDS_CA_SECURITY_EXT
+    assert b"S-1-5-21-1-2-3-42" in extension.value
+
+
+def test_determine_output_filename():
+    assert (
+        Forge(out="explicit.pfx").determine_output_filename("UPN", "user@corp.local")
+        == "explicit.pfx"
+    )
+    assert (
+        Forge().determine_output_filename("UPN", "administrator@corp.local")
+        == "administrator_forged.pfx"
+    )
+    assert (
+        Forge().determine_output_filename("DNS Host Name", "host.corp.local")
+        == "host_forged.pfx"
+    )
+    # Unusable identity values fall back to a timestamped name
+    fallback = Forge().determine_output_filename("Email", "someone@corp.local")
+    assert fallback.endswith("_forged.pfx")
+
+
+def test_build_new_certificate_contents(rsa_key, sha256_ca):
+    forge = Forge(
+        upn="administrator@corp.local",
+        dns="dc01.corp.local",
+        sid="S-1-5-21-1-2-3-999",
+        subject="CN=Certipy Forged",
+        serial="dead:beef",
+        crl="http://crl.corp.local/ca.crl",
+        validity_period=30,
+        pfx_password="forged",
+    )
+    _, pfx = forge.build_new_certificate(
+        rsa_key, rsa_key.public_key(), sha256_ca
+    )
+    key, cert = load_pfx(pfx, b"forged")
+    assert key is not None and cert is not None
+
+    # Subject, issuer, serial and validity
+    assert (
+        cert.subject.get_attributes_for_oid(x509.NameOID.COMMON_NAME)[0].value
+        == "Certipy Forged"
+    )
+    assert cert.issuer == sha256_ca.subject
+    assert cert.serial_number == 0xdeadbeef
+    assert (
+        cert.not_valid_after_utc - cert.not_valid_before_utc
+    ).days >= 30
+    cert.verify_directly_issued_by(sha256_ca)
+
+    # Alternative names: UPN, DNS and SID URL
+    san = cert.extensions.get_extension_for_class(x509.SubjectAlternativeName).value
+    assert x509.DNSName("dc01.corp.local") in san
+    assert san.get_values_for_type(x509.OtherName)[0].type_id == PRINCIPAL_NAME
+    assert x509.UniformResourceIdentifier(
+        f"{SAN_URL_PREFIX}S-1-5-21-1-2-3-999"
+    ) in san
+
+    # Extractable identities and SIDs through the shared helpers
+    identities = get_identities_from_certificate(cert)
+    assert ("UPN", "administrator@corp.local") in identities
+    assert ("DNS Host Name", "dc01.corp.local") in identities
+    assert get_object_sid_from_certificate_san_url(cert) == "S-1-5-21-1-2-3-999"
+    assert get_object_sid_from_certificate_sid_extension(cert) == "S-1-5-21-1-2-3-999"
+    assert get_object_sid_from_certificate(cert) == "S-1-5-21-1-2-3-999"
+
+    # Distribution point and key identifiers
+    crl_points = cert.extensions.get_extension_for_class(x509.CRLDistributionPoints)
+    assert crl_points.value[0].full_name[0].value == "http://crl.corp.local/ca.crl"
+    assert (
+        cert.extensions.get_extension_for_oid(
+            ExtensionOID.AUTHORITY_KEY_IDENTIFIER
+        ).critical
+        is False
+    )
+    assert cert.extensions.get_extension_for_oid(
+        ExtensionOID.SUBJECT_KEY_IDENTIFIER
+    ).value is not None
+
+
+def test_build_new_certificate_ends_in_loadable_pfx(rsa_key, sha256_ca):
+    forge = Forge(upn="user@corp.local")
+    _, pfx = forge.build_new_certificate(rsa_key, rsa_key.public_key(), sha256_ca)
+    key, cert = load_pfx(pfx, None)
+    assert cert is not None
+    assert key.key_size == 2048
+
+
+def test_build_from_template_reuses_template_values(tmp_path, rsa_key, sha256_ca, sid_cert_der):
+    template_path = tmp_path / "template.pfx"
+    template_path.write_bytes(create_pfx(rsa_key, der_to_cert(sid_cert_der), None))
+
+    forge = Forge(template=str(template_path))
+    _, pfx = forge.build_from_template(rsa_key, rsa_key.public_key(), sha256_ca)
+    _, cert = load_pfx(pfx, None)
+
+    template_cert = der_to_cert(sid_cert_der)
+    # Subject and serial number are inherited from the template
+    assert cert.subject == template_cert.subject
+    assert cert.serial_number == template_cert.serial_number
+    assert cert.issuer == sha256_ca.subject
+    cert.verify_directly_issued_by(sha256_ca)
+    # SAN and the SID extension are dropped when no new identities are given
+    with pytest.raises(x509.ExtensionNotFound):
+        cert.extensions.get_extension_for_oid(ExtensionOID.SUBJECT_ALTERNATIVE_NAME)
+    with pytest.raises(x509.ExtensionNotFound):
+        cert.extensions.get_extension_for_oid(NTDS_CA_SECURITY_EXT)
+
+
+def test_build_from_template_requires_template(rsa_key, sha256_ca):
+    forge = Forge()
+    with pytest.raises(ValueError):
+        forge.build_from_template(rsa_key, rsa_key.public_key(), sha256_ca)
+
+
+def test_load_ca_certificate_and_key_requires_pfx_password(tmp_path, pfx_bytes):
+    ca_pfx = tmp_path / "ca.pfx"
+    ca_pfx.write_bytes(pfx_bytes)
+
+    forge = Forge(ca_pfx=str(ca_pfx), ca_password="certipy-test")
+    ca_key, ca_cert = forge.load_ca_certificate_and_key()
+    assert ca_cert is not None
+    assert ca_key.key_size == 2048
+
+    with pytest.raises(ValueError):
+        Forge().load_ca_certificate_and_key()
+
+    with pytest.raises(FileNotFoundError):
+        Forge(ca_pfx=str(tmp_path / "missing.pfx")).load_ca_certificate_and_key()
diff --git a/tests/test_formatting.py b/tests/test_formatting.py
new file mode 100644
index 0000000..03216e2
--- /dev/null
+++ b/tests/test_formatting.py
@@ -0,0 +1,94 @@
+"""Tests for certipy.lib.formatting output helpers."""
+
+import datetime
+
+import pytest
+
+from certipy.lib.formatting import REMAP, pretty_print, to_pascal_case
+
+
+def _pretty_print_lines(data):
+    """Run pretty_print against a capturing print function and return lines."""
+    lines = []
+
+    def capture(text):
+        lines.append(str(text).rstrip())
+
+    pretty_print(data, print_func=capture)
+    while lines and lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def test_to_pascal_case_single_word():
+    assert to_pascal_case("enabled") == "Enabled"
+
+
+def test_to_pascal_case_multiple_words():
+    assert to_pascal_case("client_authentication") == "ClientAuthentication"
+
+
+def test_pretty_print_scalars_and_remap():
+    lines = _pretty_print_lines(
+        {"enabled": True, "http": "https://ca.corp.local/certsrv"}
+    )
+    assert lines[0].startswith("Enabled")
+    assert ": True" in lines[0]
+    assert any(line.startswith("HTTP") for line in lines)
+    assert "https://ca.corp.local/certsrv" in lines[1]
+
+
+def test_pretty_print_nested_dictionary():
+    lines = _pretty_print_lines({"parent": {"child": 1}})
+    assert lines[0] == "parent"
+    assert lines[1].lstrip().startswith("child")
+    assert ": 1" in lines[1]
+
+
+def test_pretty_print_list_of_scalars():
+    lines = _pretty_print_lines({"templates": ["User", "Machine"]})
+    assert lines[0].startswith("templates")
+    assert "User" in lines[0]
+    assert "Machine" in " ".join(lines)
+
+
+def test_pretty_print_empty_list():
+    lines = _pretty_print_lines({"templates": []})
+    assert len(lines) == 1
+    assert lines[0].startswith("templates")
+    assert lines[0].endswith(":")
+
+
+def test_pretty_print_list_of_dictionaries():
+    data = {"cas": [{"name": "CA1"}, {"name": "CA2"}]}
+    lines = _pretty_print_lines(data)
+    assert lines[0] == "cas"
+    assert any("name" in line for line in lines[1:])
+
+
+def test_pretty_print_tuple_of_items():
+    lines = _pretty_print_lines({"entries": ({"name": "CA1"}, "extra")})
+    assert lines[0] == "entries"
+    assert any("name" in line for line in lines[1:])
+    assert any("extra" in line for line in lines[1:])
+
+
+def test_pretty_print_datetime_value():
+    stamp = datetime.datetime(2024, 1, 2, 3, 4, 5)
+    lines = _pretty_print_lines({"expires": stamp})
+    assert "2024-01-02T03:04:05" in lines[0]
+
+
+def test_pretty_print_none_values_are_skipped():
+    assert _pretty_print_lines({"missing": None}) == []
+
+
+def test_pretty_print_unsupported_type_raises():
+    with pytest.raises(TypeError):
+        pretty_print({"weird": object()})
+
+
+def test_remap_contains_channel_binding_and_web_keys():
+    assert REMAP["channel_binding"] == "Channel Binding (EPA)"
+    assert REMAP["http"] == "HTTP"
+    assert REMAP["https"] == "HTTPS"
diff --git a/tests/test_ntlm.py b/tests/test_ntlm.py
new file mode 100644
index 0000000..b44b7e7
--- /dev/null
+++ b/tests/test_ntlm.py
@@ -0,0 +1,115 @@
+"""Tests for NTLMv2 response computation in certipy.lib.ntlm."""
+
+import struct
+
+import pytest
+from impacket.ntlm import (
+    AV_PAIRS,
+    NTLMSSP_AV_CHANNEL_BINDINGS,
+    NTLMSSP_AV_DNS_HOSTNAME,
+    NTLMSSP_AV_TARGET_NAME,
+    NTLMSSP_AV_TIME,
+    NTLMSSP_NEGOTIATE_KEY_EXCH,
+    NTLMSSP_NEGOTIATE_NTLM,
+    NTLMSSP_NEGOTIATE_TARGET_INFO,
+    NTOWFv2,
+    hmac_md5,
+)
+
+from certipy.lib.ntlm import compute_response, ntlm_negotiate
+
+SERVER_CHALLENGE = b"S" * 8
+CLIENT_CHALLENGE = b"C" * 8
+HOSTNAME = "dc01.corp.local".encode("utf-16le")
+
+
+def _av_pair(attr, value):
+    return struct.pack("<HH", attr, len(value)) + value
+
+
+def _target_info():
+    # Minimal NTLMSSP AV_PAIRS blob advertising only a DNS hostname
+    return _av_pair(NTLMSSP_AV_DNS_HOSTNAME, HOSTNAME) + struct.pack("<HH", 0, 0)
+
+
+def _compute(**overrides):
+    args = dict(
+        server_challenge=SERVER_CHALLENGE,
+        client_challenge=CLIENT_CHALLENGE,
+        target_info=_target_info(),
+        domain="corp",
+        user="user",
+        password="pass",
+    )
+    args.update(overrides)
+    return compute_response(**args)
+
+
+def _av_pairs_of(nt_response):
+    # NT proof is 16 bytes; the temp blob follows: 8-byte header,
+    # 8-byte timestamp, 8-byte client challenge, 4-byte reserved
+    temp = nt_response[16:]
+    assert temp[:8] == b"\x01\x01" + b"\x00" * 6
+    assert temp[16:24] == CLIENT_CHALLENGE
+    assert temp[24:28] == b"\x00" * 4
+    return AV_PAIRS(temp[28:])
+
+
+def test_compute_response_nt_proof_is_verifiable():
+    nt_response, lm_response, session_base_key, hostname = _compute()
+    response_key = NTOWFv2("user", "pass", "corp")
+
+    # NT response = NT proof over the server challenge plus the temp blob
+    assert nt_response[:16] == hmac_md5(response_key, SERVER_CHALLENGE + nt_response[16:])
+    # LM response = HMAC over challenge and client challenge
+    assert lm_response == (
+        hmac_md5(response_key, SERVER_CHALLENGE + CLIENT_CHALLENGE) + CLIENT_CHALLENGE
+    )
+    # Session base key = HMAC over the NT proof
+    assert session_base_key == hmac_md5(response_key, nt_response[:16])
+    assert hostname == HOSTNAME
+
+
+def test_compute_response_populates_av_pairs():
+    nt_response, _, _, _ = _compute()
+    av_pairs = _av_pairs_of(nt_response)
+    assert av_pairs[NTLMSSP_AV_DNS_HOSTNAME] == (len(HOSTNAME), HOSTNAME)
+    # A timestamp is added when the server did not include one
+    assert av_pairs[NTLMSSP_AV_TIME] is not None
+
+
+def test_compute_response_sets_spn_target_name():
+    nt_response, _, _, _ = _compute(service="ldap")
+    av_pairs = _av_pairs_of(nt_response)
+    spn = "ldap/".encode("utf-16le") + HOSTNAME
+    assert av_pairs[NTLMSSP_AV_TARGET_NAME] == (len(spn), spn)
+
+
+def test_compute_response_includes_channel_binding_data():
+    without_cb, _, _, _ = _compute()
+    with_cb, _, _, _ = _compute(channel_binding_data=b"\x11" * 16)
+    assert with_cb != without_cb
+    av_pairs = _av_pairs_of(with_cb)
+    assert av_pairs[NTLMSSP_AV_CHANNEL_BINDINGS] == (16, b"\x11" * 16)
+    assert _av_pairs_of(without_cb)[NTLMSSP_AV_CHANNEL_BINDINGS] is None
+
+
+def test_compute_response_without_dns_hostname_raises():
+    with pytest.raises(ValueError):
+        _compute(target_info=struct.pack("<HH", 0, 0))
+
+
+def test_compute_response_anonymous_yields_empty_responses():
+    nt_response, lm_response, _, _ = _compute(user="", password="")
+    assert nt_response == b""
+    assert lm_response == b""
+
+
+def test_ntlm_negotiate_flags():
+    auth = ntlm_negotiate()
+    assert auth["flags"] & NTLMSSP_NEGOTIATE_NTLM
+    assert auth["flags"] & NTLMSSP_NEGOTIATE_TARGET_INFO
+    assert not auth["flags"] & NTLMSSP_NEGOTIATE_KEY_EXCH
+
+    signing = ntlm_negotiate(signing_required=True)
+    assert signing["flags"] & NTLMSSP_NEGOTIATE_KEY_EXCH
