+"""Tests for core certificate helpers in certipy.lib.certificate."""
+
+import hashlib
+import struct
+
+import pytest
+from asn1crypto import csr as asn1csr
+from cryptography import x509
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import padding
+from cryptography.hazmat.primitives.asymmetric import ed25519
+from cryptography.x509.oid import NameOID
+
+from certipy.lib.certificate import (
+    NTDS_CA_SECURITY_EXT,
+    PRINCIPAL_NAME,
+    SAN_URL_PREFIX,
+    cert_id_to_parts,
+    cert_to_der,
+    cert_to_pem,
+    create_csr,
+    create_pfx,
+    csr_to_der,
+    der_to_cert,
+    der_to_key,
+    dn_to_components,
+    get_identities_from_certificate,
+    get_object_sid_from_certificate,
+    get_object_sid_from_certificate_san_url,
+    get_object_sid_from_certificate_sid_extension,
+    get_subject_from_str,
+    hash_digest,
+    key_to_pem,
+    load_pfx,
+    pem_to_cert,
+    pem_to_key,
+    private_key_to_ms_blob,
+    rsa_pkcs1v15_sign,
+)
+
+
+def _csr_attribute_oids(csr):
+    """Return the OIDs of all CRI attributes carried by a CSR."""
+    request = asn1csr.CertificationRequest.load(csr_to_der(csr))
+    return [str(attr["type"]) for attr in request["certification_request_info"]["attributes"]]
+
+
+def test_dn_to_components_parses_multivalue_dn():
+    assert dn_to_components("CN=username,DC=domain,DC=local") == [
+        ("CN", "username"),
+        ("DC", "domain"),
+        ("DC", "local"),
+    ]
+
+
+def test_dn_to_components_uppercases_attribute_names():
+    assert dn_to_components("cn=host,dc=corp")[0][0] == "CN"
+
+
+def test_dn_to_components_handles_escaped_commas():
+    components = dn_to_components("CN=Doe\\, John,DC=corp")
+    assert len(components) == 2
+    assert components[0] == ("CN", "Doe\\, John")
+    assert components[1] == ("DC", "corp")
+
+
+def test_get_subject_from_str_builds_x509_name():
+    name = get_subject_from_str("CN=Certipy Test,DC=corp,DC=local")
+    assert isinstance(name, x509.Name)
+    assert name.get_attributes_for_oid(NameOID.COMMON_NAME)[0].value == "Certipy Test"
+
+
+def test_hash_digest_matches_hashlib():
+    assert hash_digest(b"certipy", hashes.SHA256) == hashlib.sha256(b"certipy").digest()
+    assert hash_digest(b"certipy", hashes.MD5) == hashlib.md5(b"certipy").digest()
+
+
+def test_rsa_pkcs1v15_sign_verifies(rsa_key):
+    signature = rsa_pkcs1v15_sign(b"payload", rsa_key, hashes.SHA256)
+    rsa_key.public_key().verify(
+        signature, b"payload", padding.PKCS1v15(), hashes.SHA256()
+    )
+
+
+def test_rsa_pkcs1v15_sign_rejects_key_of_wrong_type():
+    key = ed25519.Ed25519PrivateKey.generate()
+    with pytest.raises(TypeError):
+        rsa_pkcs1v15_sign(b"payload", key)
+
+
+def test_create_csr_default_subject_from_username(rsa_key):
+    csr, returned_key = create_csr(
+        username="certipyuser",
+        alt_dns=None,
+        alt_upn=None,
+        alt_sid=None,
+        subject=None,
+        key_size=2048,
+        application_policies=None,
+        smime=None,
+        key=rsa_key,
+    )
+    assert returned_key is rsa_key
+    assert csr.is_signature_valid
+    assert (
+        csr.subject.get_attributes_for_oid(NameOID.COMMON_NAME)[0].value
+        == "Certipyuser"
+    )
+
+
+def test_create_csr_rejects_empty_username_without_subject():
+    with pytest.raises(ValueError):
+        create_csr(
+            username="",
+            alt_dns=None,
+            alt_upn=None,
+            alt_sid=None,
+            subject=None,
+            key_size=2048,
+            application_policies=None,
+            smime=None,
+        )
+
+
+def test_create_csr_with_explicit_subject(rsa_key):
+    csr, _ = create_csr(
+        username="ignored",
+        alt_dns=None,
+        alt_upn=None,
+        alt_sid=None,
+        subject="CN=Certipy Subject,DC=corp,DC=local",
+        key_size=2048,
+        application_policies=None,
+        smime=None,
+        key=rsa_key,
+    )
+    assert (
+        csr.subject.get_attributes_for_oid(NameOID.COMMON_NAME)[0].value
+        == "Certipy Subject"
+    )
+
+
+def test_create_csr_generates_key_when_not_provided():
+    csr, key = create_csr(
+        username="keygen",
+        alt_dns=None,
+        alt_upn=None,
+        alt_sid=None,
+        subject=None,
+        key_size=2048,
+        application_policies=None,
+        smime=None,
+    )
+    assert key is not None
+    assert key.key_size == 2048
+    assert csr.is_signature_valid
+
+
+def test_create_csr_with_san_entries(rsa_key):
+    csr, _ = create_csr(
+        username="sans",
+        alt_dns=b"host.corp.local",
+        alt_upn=b"user@corp.local",
+        alt_sid=None,
+        subject=None,
+        key_size=2048,
+        application_policies=None,
+        smime=None,
+        key=rsa_key,
+    )
+    san = csr.extensions.get_extension_for_class(x509.SubjectAlternativeName).value
+    assert x509.DNSName("host.corp.local") in san
+    upn = san.get_values_for_type(x509.OtherName)[0]
+    assert upn.type_id == PRINCIPAL_NAME
+
+
+def test_create_csr_with_sid_entries(rsa_key):
+    csr, _ = create_csr(
+        username="sids",
+        alt_dns=None,
+        alt_upn=None,
+        alt_sid=b"S-1-5-21-1-2-3-4",
+        subject=None,
+        key_size=2048,
+        application_policies=None,
+        smime=None,
+        key=rsa_key,
+    )
+    extension_oids = {ext.oid.dotted_string for ext in csr.extensions}
+    # The SID is carried both as a SAN URL and in the NTDS security extension
+    assert NTDS_CA_SECURITY_EXT.dotted_string in extension_oids
+
+    request = asn1csr.CertificationRequest.load(csr_to_der(csr))
+    extension_request_count = _csr_attribute_oids(csr).count("1.2.840.113549.1.9.14")
+    assert extension_request_count == 2
+
+    san_values = []
+    for attr in request["certification_request_info"]["attributes"]:
+        if str(attr["type"]) != "1.2.840.113549.1.9.14":
+            continue
+        for values in attr["values"]:
+            for extension in values:
+                if extension["extn_id"].dotted == "2.5.29.17":
+                    san_values = extension["extn_value"].parsed
+    uris = [
+        g.chosen.native
+        for g in san_values
+        if g.name == "uniform_resource_identifier"
+    ]
+    assert uris == [f"{SAN_URL_PREFIX}S-1-5-21-1-2-3-4"]
+
+
+def test_create_csr_with_application_policies(rsa_key):
+    csr, _ = create_csr(
+        username="policies",
+        alt_dns=None,
+        alt_upn=None,
+        alt_sid=None,
+        subject=None,
+        key_size=2048,
+        application_policies=["1.3.6.1.5.5.7.3.2"],
+        smime=None,
+        key=rsa_key,
+    )
+    extension_oids = {ext.oid.dotted_string for ext in csr.extensions}
+    assert "1.3.6.1.4.1.311.21.10" in extension_oids
+
+
+def test_create_csr_with_smime(rsa_key):
+    csr, _ = create_csr(
+        username="smimeuser",
+        alt_dns=None,
+        alt_upn=None,
+        alt_sid=None,
+        subject=None,
+        key_size=2048,
+        application_policies=None,
+        smime="3des",
+        key=rsa_key,
+    )
+    extension_oids = {ext.oid.dotted_string for ext in csr.extensions}
+    assert "1.2.840.113549.1.9.15" in extension_oids
+
+
+def test_create_csr_renewal_attribute(rsa_key, sha256_ca):
+    csr, _ = create_csr(
+        username="renewal",
+        alt_dns=None,
+        alt_upn=None,
+        alt_sid=None,
+        subject=None,
+        key_size=2048,
+        application_policies=None,
+        smime=None,
+        key=rsa_key,
+        renewal_cert=sha256_ca,
+    )
+    assert "1.3.6.1.4.1.311.13.1" in _csr_attribute_oids(csr)
+
+
+def test_pem_der_certificate_roundtrip(sha256_ca):
+    der = cert_to_der(sha256_ca)
+    assert der_to_cert(der) == pem_to_cert(cert_to_pem(sha256_ca))
+    assert der_to_cert(der) == sha256_ca
+
+
+def test_pem_der_private_key_roundtrip(rsa_key):
+    der = rsa_key.private_bytes(
+        serialization.Encoding.DER,
+        serialization.PrivateFormat.PKCS8,
+        serialization.NoEncryption(),
+    )
+    restored = der_to_key(der)
+    assert restored.public_key().public_numbers() == rsa_key.public_key().public_numbers()
+
+
+def test_key_to_pem_loadable(rsa_key):
+    restored = pem_to_key(key_to_pem(rsa_key))
+    assert restored.key_size == rsa_key.key_size
+
+
+def test_private_key_to_ms_blob_header(rsa_key):
+    blob = private_key_to_ms_blob(rsa_key)
+    assert blob[:8] == struct.pack("<bbHI", 7, 2, 0, 41984)
+    assert blob[8:12] == b"RSA2"
+    assert struct.unpack("<I", blob[12:16])[0] == rsa_key.key_size
+
+
+def test_create_pfx_and_load_pfx_roundtrip(pfx_bytes, rsa_key, sha256_ca):
+    key, cert = load_pfx(pfx_bytes, b"certipy-test")
+    assert cert is not None and key is not None
+    assert cert.subject == sha256_ca.subject
+    assert key.key_size == rsa_key.key_size
+
+
+def test_create_pfx_unprotected_container_loads_without_password(rsa_key, sha256_ca):
+    pfx = create_pfx(rsa_key, sha256_ca, None)
+    key, cert = load_pfx(pfx, None)
+    assert cert is not None
+    assert key is not None
+
+
+def test_load_pfx_with_wrong_password_raises(pfx_bytes):
+    with pytest.raises(Exception):
+        load_pfx(pfx_bytes, b"wrong-password")
+
+
+def test_get_identities_from_certificate(sid_cert_der):
+    cert = der_to_cert(sid_cert_der)
+    identities = get_identities_from_certificate(cert)
+    assert identities == [("UPN", "user@corp.local")]
+
+
+def test_get_object_sid_from_certificate_san_url(sid_cert_der):
+    cert = der_to_cert(sid_cert_der)
+    assert get_object_sid_from_certificate_san_url(cert) == "S-1-5-21-1-2-3-4"
+
+
+def test_get_object_sid_from_certificate_sid_extension(sid_cert_der):
+    cert = der_to_cert(sid_cert_der)
+    assert get_object_sid_from_certificate_sid_extension(cert) == "S-1-5-21-1-2-3-999"
+
+
+def test_get_object_sid_prefers_security_extension(sid_cert_der):
+    cert = der_to_cert(sid_cert_der)
+    assert get_object_sid_from_certificate(cert) == "S-1-5-21-1-2-3-999"
+
+
+def test_get_object_sid_returns_none_without_extensions(rsa_key, sha256_ca):
+    # sha256_ca has basic constraints only: no SAN and no SID extension
+    assert get_object_sid_from_certificate(sha256_ca) is None
+    assert get_identities_from_certificate(sha256_ca) == []
+    assert get_object_sid_from_certificate_san_url(sha256_ca) is None
+    assert get_object_sid_from_certificate_sid_extension(sha256_ca) is None
+
+
+def test_cert_id_to_parts_upn_and_dns():
+    username, domain = cert_id_to_parts([("UPN", "user@corp.local")])
+    assert username == "user"
+    assert domain == "corp.local"
+
+    username, domain = cert_id_to_parts([("DNS Host Name", "host.corp.local")])
+    assert username == "host$"
+    assert domain == "corp.local"
+
+
+def test_cert_id_to_parts_filters_unrelated_identity_types():
+    assert cert_id_to_parts([("Email", "user@corp.local")]) == ("", "")
+    assert cert_id_to_parts([]) == (None, None)
+
+
+def test_cert_id_to_parts_merges_multiple_identities():
+    username, domain = cert_id_to_parts(
+        [("UPN", "user@corp.local"), ("DNS Host Name", "web.corp.local")]
+    )
+    assert username == "user_web$"
+    assert domain == "corp.local_corp.local"
diff --git a/tests/test_channel_binding.py b/tests/test_channel_binding.py
