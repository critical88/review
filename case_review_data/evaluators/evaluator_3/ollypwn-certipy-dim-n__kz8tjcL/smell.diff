index 0000000..894e828
--- /dev/null
+++ b/tests/test_channel_binding.py
@@ -0,0 +1,106 @@
+"""Tests for RFC 5929 channel binding computation."""
+
+import hashlib
+
+import pytest
+
+from certipy.lib.channel_binding import (
+    get_channel_binding_data,
+    get_channel_binding_data_from_response,
+    get_channel_binding_data_from_ssl_socket,
+)
+
+
+def _expected_binding(der, algorithm="sha256"):
+    """Independently compute the RFC 5929 tls-server-end-point binding."""
+    cert_hash = hashlib.new(algorithm, der).digest()
+    application_data_raw = b"tls-server-end-point:" + cert_hash
+    application_data = len(application_data_raw).to_bytes(4, "little")
+    structure = b"\x00" * 8 + b"\x00" * 8 + application_data + application_data_raw
+    return hashlib.md5(structure).digest()
+
+
+def test_binding_matches_rfc5929_reference(sha256_ca_der):
+    assert get_channel_binding_data(sha256_ca_der) == _expected_binding(
+        sha256_ca_der, "sha256"
+    )
+
+
+def test_binding_is_deterministic(sha256_ca_der):
+    first = get_channel_binding_data(sha256_ca_der)
+    second = get_channel_binding_data(sha256_ca_der)
+    assert first == second
+    assert len(first) == 16
+
+
+def test_binding_uses_sha256_for_sha1_certificates(sha256_ca_der, monkeypatch):
+    # RFC 5929: MD5/SHA-1 signature algorithms must be hashed with SHA-256.
+    # The installed OpenSSL refuses to sign with SHA-1, so the certificate
+    # interface is stubbed out for this specific rule.
+    from cryptography.hazmat.primitives import hashes as _hashes
+
+    class Sha1SignedCertificate:
+        signature_hash_algorithm = _hashes.SHA1()
+
+    import certipy.lib.channel_binding as module
+
+    monkeypatch.setattr(
+        "certipy.lib.channel_binding.x509.load_der_x509_certificate",
+        lambda der: Sha1SignedCertificate(),
+    )
+    binding = get_channel_binding_data(sha256_ca_der)
+    assert binding == _expected_binding(sha256_ca_der, "sha256")
+    # A plain SHA-1 hash must NOT have been used
+    assert binding != _expected_binding(sha256_ca_der, "sha1")
+
+
+def test_binding_depends_on_certificate_bytes(sha256_ca_der, sid_cert_der):
+    sha256_binding = get_channel_binding_data(sha256_ca_der)
+    sid_binding = get_channel_binding_data(sid_cert_der)
+    assert sha256_binding != sid_binding
+
+
+def test_binding_from_response(fake_response_factory, sha256_ca_der):
+    response = fake_response_factory(sha256_ca_der)
+    assert get_channel_binding_data_from_response(response) == get_channel_binding_data(
+        sha256_ca_der
+    )
+
+
+def test_binding_from_response_missing_network_stream():
+    class EmptyResponse:
+        extensions = {}
+
+    with pytest.raises(ValueError):
+        get_channel_binding_data_from_response(EmptyResponse())
+
+
+def test_binding_from_response_missing_ssl_object(fake_response_factory):
+    class NoSslStream:
+        def get_extra_info(self, name):
+            return None
+
+    class Response:
+        extensions = {"network_stream": NoSslStream()}
+
+    with pytest.raises(ValueError):
+        get_channel_binding_data_from_response(Response())
+
+
+def test_binding_from_response_missing_peer_certificate(fake_response_factory):
+    response = fake_response_factory(None)
+    with pytest.raises(ValueError):
+        get_channel_binding_data_from_response(response)
+
+
+def test_binding_from_ssl_socket(fake_ssl_socket_factory, sha256_ca_der):
+    sock = fake_ssl_socket_factory(sha256_ca_der)
+    assert get_channel_binding_data_from_ssl_socket(sock) == get_channel_binding_data(
+        sha256_ca_der
+    )
+
+
+def test_binding_from_ssl_socket_missing_certificate(fake_ssl_socket_factory):
+    sock = fake_ssl_socket_factory(None)
+    with pytest.raises(ValueError):
+        get_channel_binding_data_from_ssl_socket(sock)
