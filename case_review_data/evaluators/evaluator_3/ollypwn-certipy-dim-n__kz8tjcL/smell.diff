new file mode 100644
index 0000000..8aaa87e
--- /dev/null
+++ b/tests/test_time.py
@@ -0,0 +1,77 @@
+"""Tests for certipy.lib.time FILETIME and span conversions."""
+
+import struct
+
+import pytest
+
+from certipy.lib.time import (
+    filetime_to_span,
+    filetime_to_str,
+    span_to_filetime,
+    span_to_str,
+)
+
+
+def test_filetime_to_span_one_year():
+    # 1 year expressed in 100-nanosecond intervals, negative per validity convention
+    assert filetime_to_span(struct.pack("<q", -315360000000000)) == 31536000
+
+
+def test_filetime_to_span_roundtrip_with_span_to_filetime():
+    span = 3600
+    filetime = span_to_filetime(span)
+    assert filetime_to_span(filetime) == span
+
+
+def test_filetime_to_span_accepts_negative_values_absolutely():
+    value = struct.pack("<q", -864000000000)
+    assert filetime_to_span(value) == 86400
+
+
+def test_filetime_to_span_invalid_length_raises():
+    with pytest.raises(struct.error):
+        filetime_to_span(b"\x01\x02\x03")
+
+
+def test_span_to_filetime_negative_span_raises():
+    with pytest.raises(ValueError):
+        span_to_filetime(-1)
+
+
+def test_span_to_filetime_epoch_values():
+    assert span_to_filetime(0) == struct.pack("<q", 0)
+    packed = span_to_filetime(604800)
+    assert struct.unpack("<q", packed)[0] == -6048000000000
+
+
+def test_span_to_str_units():
+    assert span_to_str(31536000) == "1 year"
+    assert span_to_str(63072000) == "2 years"
+    assert span_to_str(2592000) == "1 month"
+    assert span_to_str(604800) == "1 week"
+    assert span_to_str(86400) == "1 day"
+    assert span_to_str(3600) == "1 hour"
+
+
+def test_span_to_str_pluralisation():
+    assert span_to_str(1209600) == "2 weeks"
+    assert span_to_str(7200) == "2 hours"
+
+
+def test_span_to_str_non_divisible_falls_back_to_seconds():
+    assert span_to_str(7) == "7 seconds"
+    assert span_to_str(3601) == "3601 seconds"
+
+
+def test_span_to_str_non_positive_returns_empty():
+    assert span_to_str(0) == ""
+    assert span_to_str(-5) == ""
+
+
+def test_filetime_to_str_combined_conversion():
+    assert filetime_to_str(struct.pack("<q", -6048000000000)) == "1 week"
+
+
+def test_filetime_to_str_invalid_payload_returns_error_message():
+    result = filetime_to_str(b"short")
+    assert "Invalid FILETIME format" in result
