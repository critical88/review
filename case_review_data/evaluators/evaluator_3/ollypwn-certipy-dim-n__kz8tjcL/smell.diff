+"""
+Shared test fixtures for the Certipy offline test suite.
+
+The fixtures build local cryptographic material (RSA keys, self-signed
+certificates, PFX containers) so that certificate handling, enrollment
+request construction, forging, and reporting code paths can be exercised
+without contacting a live Active Directory environment.
+"""
+
+import datetime
+
+import pytest
+from cryptography import x509
+from cryptography.hazmat.primitives import hashes
+from cryptography.x509.oid import NameOID
+from pyasn1.codec.der import encoder
+from pyasn1.type.char import UTF8String
+
+from certipy.lib.certificate import (
+    NTDS_CA_SECURITY_EXT,
+    PRINCIPAL_NAME,
+    SAN_URL_PREFIX,
+    cert_to_der,
+    create_pfx,
+    generate_rsa_key,
+)
+
+
+class FakeEntry:
+    """
+    Minimal stand-in for LDAPEntry used by the reporting code paths.
+
+    Values and raw attribute values are kept in separate dictionaries so the
+    code under test can rely on the same get/set contract that LDAP-backed
+    entries expose.
+    """
+
+    def __init__(self, values=None, raw=None):
+        self._values = dict(values or {})
+        self._raw = dict(raw or {})
+
+    def get(self, key, default=None):
+        return self._values.get(key, default)
+
+    def set(self, key, value):
+        self._values[key] = value
+        if key not in self._raw:
+            self._raw[key] = value
+
+    def get_raw(self, key, default=None):
+        return self._raw.get(key, default)
+
+
+def _build_self_signed(key, hash_algorithm, common_name="Certipy Test CA"):
+    subject = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, common_name)])
+    builder = (
+        x509.CertificateBuilder()
+        .subject_name(subject)
+        .issuer_name(subject)
+        .public_key(key.public_key())
+        .serial_number(0x0A0B0C)
+        .not_valid_before(
+            datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=1)
+        )
+        .not_valid_after(
+            datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=365)
+        )
+        .add_extension(x509.BasicConstraints(ca=True, path_length=None), True)
+    )
+    return builder.sign(key, hash_algorithm())
+
+
+@pytest.fixture(scope="session")
+def rsa_key():
+    return generate_rsa_key(2048)
+
+
+@pytest.fixture(scope="session")
+def sha256_ca(rsa_key):
+    return _build_self_signed(rsa_key, hashes.SHA256)
+
+
+@pytest.fixture(scope="session")
+def sha256_ca_der(sha256_ca):
+    return cert_to_der(sha256_ca)
+
+
+@pytest.fixture(scope="session")
+def sid_cert_der(rsa_key, sha256_ca):
+    """DER bytes of an end-entity certificate with UPN, SAN-URL SID and SID extension."""
+    sid = "S-1-5-21-1-2-3-4"
+    builder = (
+        x509.CertificateBuilder()
+        .subject_name(
+            x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, "Certipy Test Service")])
+        )
+        .issuer_name(sha256_ca.subject)
+        .public_key(rsa_key.public_key())
+        .serial_number(1)
+        .not_valid_before(
+            datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=1)
+        )
+        .not_valid_after(
+            datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=30)
+        )
+        .add_extension(
+            x509.SubjectAlternativeName(
+                [
+                    # Encode the UPN exactly the way the forging code does so
+                    # that identity extraction sees a UTF8String payload.
+                    x509.OtherName(
+                        PRINCIPAL_NAME, encoder.encode(UTF8String("user@corp.local"))
+                    ),
+                    x509.UniformResourceIdentifier(f"{SAN_URL_PREFIX}{sid}"),
+                ]
+            ),
+            False,
+        )
+        .add_extension(
+            x509.UnrecognizedExtension(
+                NTDS_CA_SECURITY_EXT, b"\x00\x01S-1-5-21-1-2-3-999"
+            ),
+            False,
+        )
+    )
+    cert = builder.sign(rsa_key, hashes.SHA256())
+    return cert_to_der(cert)
+
+
+@pytest.fixture(scope="session")
+def pfx_bytes(rsa_key, sha256_ca):
+    return create_pfx(rsa_key, sha256_ca, "certipy-test")
+
+
+@pytest.fixture
+def fake_response_factory():
+    class FakeNetworkStream:
+        def __init__(self, ssl_object):
+            self._ssl_object = ssl_object
+
+        def get_extra_info(self, name):
+            if name == "ssl_object":
+                return self._ssl_object
+            return None
+
+    class FakeSslObject:
+        def __init__(self, der):
