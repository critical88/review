+"""Tests for the cert command entry point and its file helpers."""
+
+import argparse
+
+import pytest
+
+from certipy.commands.cert import (
+    entry,
+    load_certificate_file,
+    parse_certificate,
+    parse_key,
+    write_output,
+)
+from certipy.lib.certificate import (
+    cert_to_der,
+    cert_to_pem,
+    der_to_cert,
+    key_to_pem,
+    load_pfx,
+    pem_to_cert,
+)
+
+
+def _options(**overrides):
+    options = {
+        "pfx": None,
+        "password": None,
+        "cert": None,
+        "key": None,
+        "export": None,
+        "export_password": None,
+        "nocert": False,
+        "nokey": False,
+        "out": None,
+    }
+    options.update(overrides)
+    return argparse.Namespace(**options)
+
+
+def test_load_certificate_file_reads_bytes(tmp_path, sha256_ca):
+    path = tmp_path / "ca.pem"
+    path.write_bytes(cert_to_pem(sha256_ca))
+    assert load_certificate_file(str(path)) == cert_to_pem(sha256_ca)
+
+
+def test_load_certificate_file_missing_raises(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        load_certificate_file(str(tmp_path / "missing.pem"))
+
+
+def test_parse_certificate_accepts_pem_and_der(sha256_ca):
+    pem = parse_certificate(cert_to_pem(sha256_ca))
+    der = parse_certificate(cert_to_der(sha256_ca))
+    assert pem == sha256_ca
+    assert der == sha256_ca
+
+
+def test_parse_certificate_rejects_garbage():
+    with pytest.raises(ValueError):
+        parse_certificate(b"not a certificate")
+
+
+def test_parse_key_accepts_pem_and_der(rsa_key, sha256_ca):
+    pem = parse_key(key_to_pem(rsa_key))
+    assert pem.key_size == rsa_key.key_size
+
+
+def test_parse_key_rejects_garbage():
+    with pytest.raises(ValueError):
+        parse_key(b"not a key")
+
+
+def test_write_output_to_stdout(capsys):
+    write_output("text", None)
+    assert capsys.readouterr().out.strip() == "text"
+
+
+def test_write_output_to_file(tmp_path):
+    target = tmp_path / "out.pem"
+    write_output(b"data", str(target))
+    assert target.read_bytes() == b"data"
+
+
+def test_entry_without_inputs_does_nothing(tmp_path):
+    out = tmp_path / "out.pem"
+    entry(_options(out=str(out)))
+    assert not out.exists()
+
+
+def test_entry_converts_pfx_to_pem(tmp_path, pfx_bytes, sha256_ca):
+    pfx_path = tmp_path / "auth.pfx"
+    pfx_path.write_bytes(pfx_bytes)
+    out = tmp_path / "out.pem"
+    entry(
+        _options(
+            pfx=str(pfx_path),
+            password="certipy-test",
+            out=str(out),
+        )
+    )
+    content = out.read_text()
+    assert "BEGIN CERTIFICATE" in content
+    assert "BEGIN PRIVATE KEY" in content
+    assert pem_to_cert(content.encode()) == sha256_ca
+
+
+def test_entry_exports_certificate_and_key_as_pfx(tmp_path, pfx_bytes):
+    pfx_path = tmp_path / "auth.pfx"
+    pfx_path.write_bytes(pfx_bytes)
+    out = tmp_path / "re-exported.pfx"
+    entry(
+        _options(
+            pfx=str(pfx_path),
+            password="certipy-test",
+            export=True,
+            export_password=None,
+            out=str(out),
+        )
+    )
+    key, cert = load_pfx(out.read_bytes(), None)
+    assert cert is not None and key is not None
+
+
+def test_entry_converts_der_certificate_to_pem(tmp_path, sha256_ca):
+    cert_path = tmp_path / "ca.der"
+    cert_path.write_bytes(cert_to_der(sha256_ca))
+    out = tmp_path / "out.pem"
+    entry(_options(cert=str(cert_path), out=str(out)))
+    content = out.read_text()
+    assert "BEGIN CERTIFICATE" in content
+    assert "BEGIN PRIVATE KEY" not in content
+
+
+def test_entry_converts_pem_key_to_pem_output(tmp_path, rsa_key):
+    key_path = tmp_path / "key.pem"
+    key_path.write_bytes(key_to_pem(rsa_key))
+    out = tmp_path / "out.pem"
+    entry(_options(key=str(key_path), out=str(out)))
+    content = out.read_text()
+    assert "BEGIN PRIVATE KEY" in content
+    assert "BEGIN CERTIFICATE" not in content
+
+
+def test_entry_reports_missing_file_without_raising(tmp_path):
+    out = tmp_path / "out.pem"
+    entry(_options(cert=str(tmp_path / "missing.der"), out=str(out)))
+    assert not out.exists()
diff --git a/tests/test_certificate_cmc.py b/tests/test_certificate_cmc.py
new file mode 100644
index 0000000..a87d768
--- /dev/null
+++ b/tests/test_certificate_cmc.py
@@ -0,0 +1,131 @@
+"""Tests for CMC/CMS request builders in certipy.lib.certificate."""
+
+import struct
+
+import pytest
+from asn1crypto import cms as asn1cms
+from asn1crypto import x509 as asn1x509
+
+from certipy.lib.certificate import (
+    SAN_URL_PREFIX,
+    create_csr,
+    create_csr_attributes,
+    create_key_archival,
+    create_on_behalf_of,
+    create_renewal,
+    cert_to_der,
+    private_key_to_ms_blob,
+)
+
+
+def _csr(username="cmcuser", **overrides):
+    return create_csr(
+        username=username,
+        alt_dns=None,
+        alt_upn=None,
+        alt_sid=None,
+        subject=None,
+        key_size=2048,
+        application_policies=None,
+        smime=None,
+        **overrides,
+    )
+
+
+def test_create_csr_attributes_template_only():
+    assert create_csr_attributes("User") == ["CertificateTemplate:User"]
+
+
+def test_create_csr_attributes_with_san_entries():
+    attributes = create_csr_attributes(
+        "Machine",
+        alt_dns=b"host.corp.local",
+        alt_upn=b"user@corp.local",
+        alt_sid=b"S-1-5-21-1-2-3-4",
+    )
+    assert attributes[0] == "CertificateTemplate:Machine"
+    assert attributes[1] == (
+        "SAN:dns=host.corp.local&upn=user@corp.local"
+        f"&url={SAN_URL_PREFIX}S-1-5-21-1-2-3-4"
+    )
+
+
+def test_create_csr_attributes_with_san_strings_and_policies():
+    attributes = create_csr_attributes(
+        "User",
+        alt_dns="host.corp.local",
+        alt_upn="user@corp.local",
+        application_policies=["1.3.6.1.5.5.7.3.2", "1.3.6.1.5.5.7.3.1"],
+    )
+    assert attributes[1] == "SAN:dns=host.corp.local&upn=user@corp.local"
+    assert attributes[2] == (
+        "ApplicationPolicies:1.3.6.1.5.5.7.3.2&1.3.6.1.5.5.7.3.1"
+    )
+
+
+def test_create_renewal_builds_cmc_wrapped_cms(rsa_key, sha256_ca):
+    request = b"enrollment request"
+    cmc_bytes = create_renewal(request, sha256_ca, rsa_key)
+
+    cmc = asn1cms.ContentInfo.load(cmc_bytes)
+    assert cmc["content_type"].native == "signed_data"
+
+    signed_data = cmc["content"]
+    assert signed_data["encap_content_info"]["content"].native == request
+
+    # The renewed certificate travels with the request
+    embedded = signed_data["certificates"][0].chosen
+    assert embedded["tbs_certificate"]["serial_number"].native == sha256_ca.serial_number
+
+    signer_info = signed_data["signer_infos"][0]
+    assert signer_info["digest_algorithm"]["algorithm"].native == "sha256"
+    # Renewal certificate hash attribute and message digest must be present
+    attribute_types = [str(attr["type"]) for attr in signer_info["signed_attrs"]]
+    assert "1.3.6.1.4.1.311.13.1" in attribute_types
+    assert "1.2.840.113549.1.9.4" in attribute_types
+
+
+def test_create_on_behalf_of_adds_requester(rsa_key, sha256_ca):
+    request = b"enrollment request"
+    cmc_bytes = create_on_behalf_of(request, "corp\\helpdesk", sha256_ca, rsa_key)
+
+    cmc = asn1cms.ContentInfo.load(cmc_bytes)
+    assert cmc["content_type"].native == "signed_data"
+
+    signer_info = cmc["content"]["signer_infos"][0]
+    attribute_types = [str(attr["type"]) for attr in signer_info["signed_attrs"]]
+    assert "1.3.6.1.4.1.311.21.10" in attribute_types
+    assert "1.3.6.1.4.1.311.13.2.1" in attribute_types
+    assert "1.2.840.113549.1.9.4" in attribute_types
+
+    # The requester name is carried as a BMPString inside the request
+    assert "corp\\helpdesk".encode("utf-16-be") in cmc_bytes
+
+
+def test_create_key_archival_wraps_csr_and_envelope(rsa_key, sha256_ca):
+    csr, _ = _csr("archival")
+    cmc_bytes = create_key_archival(csr, rsa_key, sha256_ca)
+
+    cmc = asn1cms.ContentInfo.load(cmc_bytes)
+    assert cmc["content_type"].native == "signed_data"
+
+    signed_data = cmc["content"]
+    # The PKI payload is carried as raw bytes inside the CMS wrapper
+    content = signed_data["encap_content_info"]["content"]
+    payload = content.native if isinstance(content.native, bytes) else content.parsed.dump()
+    assert isinstance(payload, bytes) and len(payload) > 0
+
+    signer_info = signed_data["signer_infos"][0]
+    unsigned_attrs = [
+        str(attr["type"]) for attr in (signer_info["unsigned_attrs"] or [])
+    ]
+    # The encrypted key envelope is attached for the CA to decrypt
+    assert "1.3.6.1.4.1.311.21.13" in unsigned_attrs
+
+
+def test_private_key_ms_blob_is_recoverable(rsa_key):
+    blob = private_key_to_ms_blob(rsa_key)
+    # The blob stores public modulus length and the primes in little-endian
+    bitlen = struct.unpack("<I", blob[12:16])[0]
+    assert bitlen == rsa_key.key_size
+    assert b"RSA2" == blob[8:12]
