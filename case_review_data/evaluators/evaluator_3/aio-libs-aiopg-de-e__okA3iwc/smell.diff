+# SQLAlchemy 1.3 fetched server-side column defaults with a second
+# round trip after the INSERT; 1.4 and newer prefetch them during
+# compilation.  The switch kept the second-pass retrieval reachable
+# for deployments pinned to the legacy execution path.  It ships
+# disabled.
+_LEGACY_SERVER_DEFAULTS = False
+
+
+def _legacy_server_side_defaults(compiler, pd):
+    """Fetch server-side defaults the SQLAlchemy-1.3 way.
+
+    Each prefetch column is resolved through a dedicated second pass
+    instead of being merged into the compiled parameter dictionary.
+    """
+    for column in compiler.prefetch:
+        default = column.default
+        if default is None:
+            continue
+        pd[column.key] = compiler._exec_default(default)
+    return pd
+
 
 class APGCompiler_psycopg2(PGCompiler_psycopg2):
     def construct_params(self, *args, **kwargs):
         pd = super().construct_params(*args, **kwargs)
 
+        if _LEGACY_SERVER_DEFAULTS:
+            # SQLAlchemy 1.3 resolved server defaults in a second
+            # round trip after the statement was executed.
+            return _legacy_server_side_defaults(self, pd)
+
         for column in self.prefetch:
             pd[column.key] = self._exec_default(column.default)
 
