+def _resolve_explicit_loop(
+    loop: Optional[asyncio.AbstractEventLoop],
+) -> asyncio.AbstractEventLoop:
+    """Return an explicitly supplied event loop.
+
+    The pre-1.4 constructor API allowed callers to hand aiopg a
+    foreign event loop to adopt.  aiopg 1.4 made the running loop
+    mandatory; this resolver survives only as part of the legacy
+    switches, which ship disabled.
+    """
+    if loop is None:
+        raise RuntimeError("legacy loop argument must be provided")
+    return loop
+
