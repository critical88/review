+    def test_capabilities_introspection_matches_declared_families(self):
+        # A driver calls capabilities()/supports() on a constructed resource.
+        fake = Mock()
+        for cls, expected in EXPECTED_CAPABILITIES.items():
+            inst = cls(fake)
+            self.assertEqual(
+                tuple(inst.capabilities()),
+                expected,
+                f"{cls.__name__}.capabilities() mismatch",
+            )
+            for family in RESOURCE_CAPABILITY_FAMILIES:
+                self.assertEqual(
+                    inst.supports(family),
+                    family in expected,
+                    f"{cls.__name__}.supports({family.__name__}) mismatch",
+                )
