diff --git a/leptonai/api/v2/tests/test_resource_capabilities.py b/leptonai/api/v2/tests/test_resource_capabilities.py
new file mode 100644
index 0000000..99facca
--- /dev/null
+++ b/leptonai/api/v2/tests/test_resource_capabilities.py
@@ -0,0 +1,206 @@
+"""Capability declaration contracts for the workspace resource APIs.
+
+A single generic driver (the resource dashboard) walks every workspace
+resource uniformly, so the shared operation families (health, runtime,
+lifecycle, model catalog) are exposed as opt-in capability contracts: a
+resource API declares a family by inheriting it, a driver renders a control
+for exactly the declared families via :meth:`capabilities` /
+``isinstance``.
+
+These tests pin that each participant declares *only* the families it can
+meaningfully support. That is the regression the opt-in contract fixes:
+previously every resource blanket-inherited every family (configuration
+resources returned empty readiness maps, empty replica lists, ``None``
+stops, ...), so the dashboard rendered the same controls for a secret and a
+deployment alike.
+"""
+
+import unittest
+from unittest.mock import Mock
+
+from leptonai.api.v2.dedicated_node_groups import DedicatedNodeGroupAPI
+from leptonai.api.v2.deployment import DeploymentAPI
+from leptonai.api.v2.devpod import DevPodAPI
+from leptonai.api.v2.endpoint import EndpointAPI
+from leptonai.api.v2.finetune import FineTuneAPI
+from leptonai.api.v2.ingress import IngressAPI
+from leptonai.api.v2.job import JobAPI
+from leptonai.api.v2.pod import PodAPI
+from leptonai.api.v2.raycluster import RayClusterAPI
+from leptonai.api.v2.resource_contracts import (
+    RESOURCE_CAPABILITY_FAMILIES,
+    ResourceHealthAPI,
+    ResourceLifecycleAPI,
+    ResourceModelCatalogAPI,
+    ResourceRuntimeAPI,
+)
+from leptonai.api.v2.secret import SecretAPI
+from leptonai.api.v2.template import TemplateAPI
+
+
+# The capability families each resource API is expected to opt into. A
+# resource lists a family here iff it implements that family's operations in a
+# meaningful way for its resource kind; configuration resources opt into none.
+EXPECTED_CAPABILITIES = {
+    DeploymentAPI: (
+        ResourceHealthAPI,
+        ResourceRuntimeAPI,
+        ResourceLifecycleAPI,
+    ),
+    EndpointAPI: (ResourceRuntimeAPI, ResourceLifecycleAPI),
+    JobAPI: (ResourceRuntimeAPI,),
+    FineTuneAPI: (ResourceModelCatalogAPI,),
+    DevPodAPI: (ResourceLifecycleAPI,),
+    PodAPI: (ResourceHealthAPI, ResourceLifecycleAPI),
+    SecretAPI: (),
+    IngressAPI: (),
+    TemplateAPI: (),
+    RayClusterAPI: (),
+    DedicatedNodeGroupAPI: (),
+}
+
+# The operational capability surface a driver renders controls for. These are
+# distinct from a resource's own CRUD/management methods; a configuration
+# resource must not expose any of them.
+OPERATIONAL_CAPABILITY_METHODS = (
+    "get_readiness",
+    "get_termination",
+    "get_replicas",
+    "get_log",
+    "get_events",
+    "stop",
+    "restart",
+    "list_supported_models",
+    "list_trainers",
+)
+
+
+class TestResourceCapabilityDeclarations(unittest.TestCase):
+    def test_base_profiles_do_not_blanket_inherit_capability_families(self):
+        # The profiles must not blanket-inherit any family; otherwise every
+        # resource would again appear to support every family and the dashboard
+        # would render the same controls for every resource type.
+        from leptonai.api.v2.resource_contracts import (
+            ConfigurationResourceAPI,
+            WorkloadResourceAPI,
+            WorkspaceResourceAPI,
+        )
+
+        for profile in (
+            WorkspaceResourceAPI,
+            WorkloadResourceAPI,
+            ConfigurationResourceAPI,
+        ):
+            for family in RESOURCE_CAPABILITY_FAMILIES:
+                self.assertFalse(
+                    issubclass(profile, family),
+                    f"{profile.__name__} blanket-inherits {family.__name__};"
+                    " capability families are opt-in per resource",
+                )
+
+    def test_each_resource_declares_only_its_meaningful_families(self):
+        for cls, expected in EXPECTED_CAPABILITIES.items():
+            declared = tuple(
+                family
+                for family in RESOURCE_CAPABILITY_FAMILIES
+                if issubclass(cls, family)
+            )
+            self.assertEqual(
+                declared,
+                expected,
+                f"{cls.__name__} declares {declared}, expected {expected}",
+            )
+
+    def test_no_resource_declares_every_capability_family(self):
+        # The old total-contract bug: every resource looked like it supported
+        # all four families. Guard against the contract becoming total again.
+        all_families = set(RESOURCE_CAPABILITY_FAMILIES)
+        for cls in EXPECTED_CAPABILITIES:
+            declared = {
+                family
+                for family in RESOURCE_CAPABILITY_FAMILIES
+                if issubclass(cls, family)
+            }
+            self.assertLess(
+                len(declared),
+                len(all_families),
+                f"{cls.__name__} declares every capability family; the contract"
+                " is opt-in, not total",
+            )
