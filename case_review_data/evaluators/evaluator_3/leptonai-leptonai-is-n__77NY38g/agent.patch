+    def test_dashboard_renders_per_resource_controls(self):
+        # The motivating symptom: secrets / templates / node groups rendered
+        # the same controls as deployments. A driver rendering one control per
+        # declared family now renders an empty set for them and a distinct set
+        # for each workload.
+        fake = Mock()
+
+        def render_controls(resource):
+            return [family.__name__ for family in resource.capabilities()]
+
+        self.assertEqual(
+            render_controls(DeploymentAPI(fake)),
+            ["ResourceHealthAPI", "ResourceRuntimeAPI", "ResourceLifecycleAPI"],
+        )
+        self.assertEqual(
+            render_controls(FineTuneAPI(fake)), ["ResourceModelCatalogAPI"]
+        )
+        self.assertEqual(render_controls(JobAPI(fake)), ["ResourceRuntimeAPI"])
+        for config_cls in (
+            SecretAPI,
+            IngressAPI,
+            TemplateAPI,
+            RayClusterAPI,
+            DedicatedNodeGroupAPI,
+        ):
+            self.assertEqual(
+                render_controls(config_cls(fake)),
+                [],
+                f"{config_cls.__name__} should render no capability controls",
+            )
