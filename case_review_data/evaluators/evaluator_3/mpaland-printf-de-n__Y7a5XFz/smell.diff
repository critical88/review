+// internal: estimated rendered length of a fixed-notation float conversion,
+// planned capacity check of the truncation-safe formatting work
+static unsigned int _ftoa_len_estimate(double value, unsigned int prec, unsigned int width, unsigned int flags)
+{
+  // sign character
+  unsigned int len = (value < 0.0) ? 1U : 0U;
+  if (flags & (FLAGS_PLUS | FLAGS_SPACE)) {
+    ++len;
+  }
+
+  // the whole part is limited to 10 digits (see PRINTF_MAX_FLOAT)
+  len += 10U;
+
+  // fractional part and decimal point
+  if (!(flags & FLAGS_PRECISION)) {
+    prec = PRINTF_DEFAULT_FLOAT_PRECISION;
+  }
+  if (prec != 0U) {
+    len += prec + 1U;
+  }
+
+  // respect the width padding
+  if (len < width) {
+    len = width;
+  }
+  return len;
+}
