+// internal: rendered length of an integer conversion (digits incl. zero padding),
+// planned capacity check of the truncation-safe formatting work
+static unsigned int _ntoa_digits_needed(unsigned long value, unsigned long base, unsigned int prec, unsigned int width, unsigned int flags)
+{
+  unsigned int digits = 0U;
+
+  // count the digits of the value
+  do {
+    ++digits;
+    value /= base;
+  } while (value);
+
+  // precision requires at least this many digits
+  if (digits < prec) {
+    digits = prec;
+  }
+  // account for the prefix of the hash flag
+  if (flags & FLAGS_HASH) {
+    digits += (base == 16U) ? 2U : 1U;
+  }
+  // account for the sign character
+  if (flags & (FLAGS_PLUS | FLAGS_SPACE)) {
+    ++digits;
+  }
+  // respect the width padding
+  if (digits < width) {
+    digits = width;
+  }
+  return digits;
+}
