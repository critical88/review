new file mode 100644
index 0000000..1bd06f6
--- /dev/null
+++ b/modiscript/debug.py
@@ -0,0 +1,26 @@
+class DebugReporter:
+    """Writes command-line debug reports for a run.
+
+    Deciding *when* (only in debug mode and only for file-backed programs) and
+    *where* (beside the analyzed source) these reports are written is a
+    diagnostic concern; it is kept out of the front end. ``record_lexemes``
+    dumps the lexeme stream and ``record_parse_tree`` dumps the parsed AST.
+    """
+
+    def __init__(self, value, value_type="filename", debug=False):
+        self.debug = debug
+        self._dump_ready = value_type == "filename"
+        self._trace_stem = value.split('.', 1)[0] if value_type == "filename" else ''
+
+    def record_lexemes(self, lex_out):
+        if not (self.debug and self._dump_ready):
+            return
+        with open(self._trace_stem + '.txt', 'w') as f:
+            print(*lex_out, sep='\n', file=f)
+
+    def record_parse_tree(self, parse_out):
+        if not (self.debug and self._dump_ready):
+            return
+        import ast
+        with open(self._trace_stem + '.py', 'w') as f:
+            print(ast.dump(parse_out), file=f)
