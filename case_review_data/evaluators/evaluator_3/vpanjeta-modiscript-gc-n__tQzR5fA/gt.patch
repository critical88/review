diff --git a/modiscript/program.py b/modiscript/program.py
new file mode 100644
index 0000000..81b4fda
--- /dev/null
+++ b/modiscript/program.py
@@ -0,0 +1,30 @@
+from .utils import LEX, ErrorHandler, STARTING_TROUBLE, CONGRESS_RULE
+
+
+class ProgramEnvelope:
+    """The required packaging of every Modi program.
+
+    A program must open with ``mitrooon`` and close with ``acche din aa gaye``.
+    Verifying (and stripping) that envelope is a packaging concern, not a
+    token-grammar one, so it lives here instead of in the front end.
+    """
+
+    opening = 'mitrooon'
+    closing = 'acche din aa gaye'.split()
+
+    @staticmethod
+    def is_var(lex, value):
+        return lex['lex'] == LEX['var'] and lex['value'] == value
+
+    def expect_opening(self, lexeme):
+        if not self.is_var(lexeme, self.opening):
+            raise ErrorHandler(STARTING_TROUBLE)
+
+    def expect_closing(self, lexemes):
+        ending = list(self.closing)
+        try:
+            while ending:
+                if not self.is_var(lexemes.pop(), ending.pop()):
+                    raise ErrorHandler(CONGRESS_RULE)
+        except IndexError:
+            raise ErrorHandler(CONGRESS_RULE)
