+    def _error_detail(self, json: Any) -> str:
+        """Suffix appended to error messages raised for an API response.
+
+        Built from the response's optional ``message`` and ``detail``
+        fields. Endpoint methods inject this into the specific exception
+        they raise (for example ``GlossaryNotFoundException``) before
+        falling back to ``_raise_for_status()``, which applies the same
+        rule to its own messages. Centralized here so it can be changed in
+        one place.
+        """
+        detail = ""
+        if json is not None and isinstance(json, dict) and "message" in json:
+            detail += ", message: " + json["message"]
+        if json is not None and isinstance(json, dict) and "detail" in json:
+            detail += ", detail: " + json["detail"]
+        return detail
+
     def _raise_for_status(
         self,
         status_code: int,
         content: Union[str, requests.Response],
         json: Any,
     ):
-        message = ""
