+/* The screen row, i.e. the way a line is laid out in the viewport of the
+ * active window (taking line wrapping into account), containing `pos`.
+ * The range covers the bytes displayed in that row and, if the underlying
+ * line continues below, the ones of its remaining screen rows.
+ */
+static Filerange vis_text_object_screenline(Vis *vis, Text *txt, size_t pos) {
+	Filerange range = text_range_empty();
+	if (!vis || !vis->win)
+		return range;
+
+	View *view = &vis->win->view;
+	/* the position must be within the displayed area */
+	if (pos < view->start || pos > view->end)
+		return range;
+
+	size_t start = view->start;
+	int row = 0;
+	for (Line *l = view->topline; l && row < view->height; l = l->next, row++) {
+		size_t next = start + l->len;
+		if (pos < next) {
+			range.start = start;
+			range.end   = next;
+			/* the same line might be wrapped over several screen rows:
+			 * extend over the remaining rows showing its content */
+			while (range.end < view->end && l->next && l->next != view->bottomline &&
+			       l->next->lineno == l->lineno) {
+				range.end += l->next->len;
+				l = l->next;
+			}
+			return range;
+		}
+		start = next;
+	}
+	return range;
+}
