+/***
+ * Scroll position information of the window's viewport.
+ *
+ * Describes which part of the underlying file is currently being
+ * displayed by this window.
+ * @function scrollinfo
+ * @tfield int topline file line number (1 based) displayed in the first screen row
+ * @tfield int lastline file line number (1 based) displayed in the last screen row in use
+ * @tfield int lines number of screen rows currently displaying content
+ * @tfield int height number of rows available in the viewport
+ * @tfield int row zero based screen row the primary cursor is on, or -1
+ * @tfield int percent portion of the file located before the primary cursor, in percent
+ */
+static int window_scrollinfo(lua_State *L) {
+	Win *win = obj_ref_check(L, 1, VIS_LUA_TYPE_WINDOW);
+
+	View *view = &win->view;
+	Line *topline = view->topline;
+	Line *lastline = view->lastline;
+
+	/* number of screen rows actually displaying content */
+	int used = 0;
+	for (Line *l = view->topline; l && l != view->lastline; l = l->next)
+		used++;
+	used++;
+
+	/* the screen row the primary cursor is displayed on */
+	Selection *sel = view->selection;
+	int row = 0, cursor_row = -1;
+	for (Line *l = view->topline; l && l != view->bottomline; l = l->next, row++) {
+		if (sel && l == sel->line) {
+			cursor_row = row;
+			break;
+		}
+	}
+
+	size_t size = text_size(view->text);
+	size_t pos = sel ? sel->pos : view->start;
+	if (pos > size)
+		pos = size;
+	size_t percent = 0;
+	if (size > 0)
+		percent = (size_t)(((double)pos/(double)size)*100 + 1);
+
+	lua_createtable(L, 0, 6);
+	lua_pushinteger(L, topline->lineno);
+	lua_setfield(L, -2, "topline");
+	lua_pushinteger(L, lastline->lineno);
+	lua_setfield(L, -2, "lastline");
+	lua_pushinteger(L, used);
+	lua_setfield(L, -2, "lines");
+	lua_pushinteger(L, view->height);
+	lua_setfield(L, -2, "height");
+	lua_pushinteger(L, cursor_row);
+	lua_setfield(L, -2, "row");
+	lua_pushinteger(L, percent);
+	lua_setfield(L, -2, "percent");
+	return 1;
+}
