+/* Compose the scroll position indicator shown in the right part of a
+ * window's status bar. Reports which portion of the file is being
+ * displayed: "Top" when the first line of the file is shown, "Bot" when
+ * the last one is, "All" if the whole file is visible and the percentage
+ * of the file located before the primary cursor otherwise.
+ */
+VIS_INTERNAL void
+ui_window_indicator(Win *win, char *buf, size_t len)
+{
+	if (!buf || len == 0)
+		return;
+
+	View *view = &win->view;
+	Line *topline = view->topline;
+	if (!topline) {
+		snprintf(buf, len, "All");
+		return;
+	}
+
+	/* number of screen rows actually displaying content */
+	int used = 0;
+	for (Line *l = view->topline; l && l != view->lastline; l = l->next)
+		used++;
+	used++;
+
+	/* screen row on which the primary cursor is displayed */
+	Selection *sel = view->selection;
+	int row = 0, cursor_row = -1;
+	for (Line *l = view->topline; l && l != view->bottomline; l = l->next, row++) {
+		if (sel && l == sel->line) {
+			cursor_row = row;
+			break;
+		}
+	}
+
+	/* everything from the first to the last line of the file is visible */
+	if (topline->lineno == 1 && !view->lastline->next)
+		snprintf(buf, len, "All");
+	else if (cursor_row == 0 && topline->lineno == 1)
+		snprintf(buf, len, "Top");
+	else if (!view->lastline->next)
+		snprintf(buf, len, "Bot");
+	else {
+		size_t size = text_size(view->text);
+		size_t pos = sel ? sel->pos : view->start;
+		if (pos > size)
+			pos = size;
+		size_t percent = 0;
+		if (size > 0)
+			percent = (size_t)(((double)pos/(double)size)*100 + 1);
+		snprintf(buf, len, "%zu%%", percent);
+	}
+}
+
+/* Draw a scrollbar on the rightmost column of the window. The thumb
+ * covers the part of the file which is currently displayed, a wider
+ * glyph marks the row the primary cursor is on.
+ */
+static void ui_window_scrollbar(Win *win) {
+	Ui *ui = &win->vis->ui;
+	View *view = &win->view;
+	/* nothing to indicate before the view layout was set up */
+	if (!view->topline || !view->bottomline)
+		return;
+
+	int height = view->height;
+	/* the scrollbar overlays the last column of the text area */
+	int x = win->x + win->width - 1;
+	int y = win->y;
+
+	/* number of screen rows actually displaying content, the scrollbar
+	 * does not extend into the unused region below the file */
+	int used = 0;
+	for (Line *l = view->topline; l && l != view->lastline; l = l->next)
+		used++;
+	used++;
+	int track = MIN(height, used);
+
+	/* the screen row on which the primary cursor is displayed */
+	Selection *sel = view->selection;
+	int cursor_row = -1, row = 0;
+	for (Line *l = view->topline; l && l != view->bottomline; l = l->next, row++) {
+		if (sel && l == sel->line) {
+			cursor_row = row;
+			break;
+		}
+	}
+
+	/* portion of the file covered by the viewport */
+	size_t size = view->text ? text_size(view->text) : 0;
+	size_t start = view->start, end = view->end;
+	int thumb_top = 0, thumb_bot = 0;
+	if (size > 0 && start < end) {
+		thumb_top = (int)(((uint64_t)start * (uint64_t)height) / size);
+		thumb_bot = (int)((((uint64_t)end * (uint64_t)height) + size - 1) / size);
+		if (thumb_bot <= thumb_top)
+			thumb_bot = thumb_top + 1;
+	}
+
+	for (int i = 0; i < track; i++) {
+		const char *glyph = "│";
+		u16 style = UI_STYLE_SEPARATOR;
+		if (i >= thumb_top && i < thumb_bot) {
+			glyph = "┃";
+			style = UI_STYLE_STATUS;
+		}
+		if (i == cursor_row) {
+			glyph = "▐";
+			style = UI_STYLE_STATUS_FOCUSED;
+		}
+		ui_draw_string(ui, x, y + i, glyph, style);
+	}
+}
+
 static void ui_window_draw(Win *win) {
 	Ui *ui = &win->vis->ui;
 	View *view = &win->view;
@@ -409,6 +523,8 @@ static void ui_window_draw(Win *win) {
 		cells  += ui->width;
 		styles += ui->width;
 	}
+
+	ui_window_scrollbar(win);
 }
 
