diff --git a/pkg/nodeops/labels.go b/pkg/nodeops/labels.go
new file mode 100644
index 0000000..1a88cbf
--- /dev/null
+++ b/pkg/nodeops/labels.go
@@ -0,0 +1,92 @@
+package nodeops
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	log "github.com/sirupsen/logrus"
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/kubernetes"
+)
+
+// AddNodeAnnotations patches the given node object annotations onto the node
+// identified by nodeID.
+func AddNodeAnnotations(client *kubernetes.Clientset, nodeID string, annotations map[string]string) error {
+	node, err := client.CoreV1().Nodes().Get(context.TODO(), nodeID, metav1.GetOptions{})
+	if err != nil {
+		log.Errorf("Error retrieving node object via k8s API: %s", err)
+		return err
+	}
+	for k, v := range annotations {
+		node.Annotations[k] = v
+		log.Infof("Adding node %s annotation: %s=%s", node.GetName(), k, v)
+	}
+
+	bytes, err := json.Marshal(node)
+	if err != nil {
+		log.Errorf("Error marshalling node object into JSON: %v", err)
+		return err
+	}
+
+	_, err = client.CoreV1().Nodes().Patch(context.TODO(), node.GetName(), types.StrategicMergePatchType, bytes, metav1.PatchOptions{})
+	if err != nil {
+		var annotationsErr string
+		for k, v := range annotations {
+			annotationsErr += fmt.Sprintf("%s=%s ", k, v)
+		}
+		log.Errorf("Error adding node annotations %s via k8s API: %v", annotationsErr, err)
+		return err
+	}
+	return nil
+}
+
+// DeleteNodeAnnotation removes the annotation key from the node identified by
+// nodeID.
+func DeleteNodeAnnotation(client *kubernetes.Clientset, nodeID, key string) error {
+	log.Infof("Deleting node %s annotation %s", nodeID, key)
+
+	// JSON Patch takes as path input a JSON Pointer, defined in RFC6901
+	// So we replace all instances of "/" with "~1" as per:
+	// https://tools.ietf.org/html/rfc6901#section-3
+	patch := []byte(fmt.Sprintf("[{\"op\":\"remove\",\"path\":\"/metadata/annotations/%s\"}]", strings.ReplaceAll(key, "/", "~1")))
+	_, err := client.CoreV1().Nodes().Patch(context.TODO(), nodeID, types.JSONPatchType, patch, metav1.PatchOptions{})
+	if err != nil {
+		log.Errorf("Error deleting node annotation %s via k8s API: %v", key, err)
+		return err
+	}
+	return nil
+}
+
+func updateNodeLabels(client *kubernetes.Clientset, node *v1.Node, labels []string) {
+	labelsMap := make(map[string]string)
+	for _, label := range labels {
+		k := strings.Split(label, "=")[0]
+		v := strings.Split(label, "=")[1]
+		labelsMap[k] = v
+		log.Infof("Updating node %s label: %s=%s", node.GetName(), k, v)
+	}
+
+	bytes, err := json.Marshal(map[string]interface{}{
+		"metadata": map[string]interface{}{
+			"labels": labelsMap,
+		},
+	})
+	if err != nil {
+		log.Fatalf("Error marshalling node object into JSON: %v", err)
+	}
+
+	_, err = client.CoreV1().Nodes().Patch(context.TODO(), node.GetName(), types.StrategicMergePatchType, bytes, metav1.PatchOptions{})
+	if err != nil {
+		var labelsErr string
+		for _, label := range labels {
+			k := strings.Split(label, "=")[0]
+			v := strings.Split(label, "=")[1]
+			labelsErr += fmt.Sprintf("%s=%s ", k, v)
+		}
+		log.Errorf("Error updating node labels %s via k8s API: %v", labelsErr, err)
+	}
+}
diff --git a/pkg/nodeops/nodeops.go b/pkg/nodeops/nodeops.go
new file mode 100644
index 0000000..0822ace
--- /dev/null
+++ b/pkg/nodeops/nodeops.go
@@ -0,0 +1,110 @@
+// Package nodeops implements the node lifecycle operations performed during
+// a kured reboot cycle: draining a node, uncordoning it again, and reporting
+// on both steps. The operations are exercised by the main control loop of
+// the kured command, but live in their own package so they can be reasoned
+// about (and reused) independently of the command line flags that the kured
+// command wires them up with; every setting a step needs is therefore passed
+// in explicitly by the caller.
+package nodeops
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/containrrr/shoutrrr"
+	log "github.com/sirupsen/logrus"
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/client-go/kubernetes"
+	kubectldrain "k8s.io/kubectl/pkg/drain"
+)
+
+// Drain cordons and drains a node. preRebootNodeLabels are applied to the
+// node before cordoning, notifications go to notifyURL using
+// messageTemplateDrain, and the drain runs with drainDelay, drainGracePeriod,
+// drainPodSelector, skipWaitForDeleteTimeoutSeconds and drainTimeout.
+func Drain(client *kubernetes.Clientset, node *v1.Node, preRebootNodeLabels []string,
+	drainDelay time.Duration, drainGracePeriod int, drainPodSelector string,
+	skipWaitForDeleteTimeoutSeconds int, drainTimeout time.Duration,
+	notifyURL string, messageTemplateDrain string) error {
+	nodename := node.GetName()
+
+	if preRebootNodeLabels != nil {
+		updateNodeLabels(client, node, preRebootNodeLabels)
+	}
+
+	if drainDelay > 0 {
+		log.Infof("Delaying drain for %v", drainDelay)
+		time.Sleep(drainDelay)
+	}
+
+	log.Infof("Draining node %s", nodename)
+
+	if notifyURL != "" {
+		if err := shoutrrr.Send(notifyURL, fmt.Sprintf(messageTemplateDrain, nodename)); err != nil {
+			log.Warnf("Error notifying: %v", err)
+		}
+	}
+
+	drainer := &kubectldrain.Helper{
+		Client:                          client,
+		Ctx:                             context.Background(),
+		GracePeriodSeconds:              drainGracePeriod,
+		PodSelector:                     drainPodSelector,
+		SkipWaitForDeleteTimeoutSeconds: skipWaitForDeleteTimeoutSeconds,
+		Force:                           true,
+		DeleteEmptyDirData:              true,
+		IgnoreAllDaemonSets:             true,
+		ErrOut:                          os.Stderr,
+		Out:                             os.Stdout,
+		Timeout:                         drainTimeout,
+	}
+
+	if err := kubectldrain.RunCordonOrUncordon(drainer, node, true); err != nil {
+		log.Errorf("Error cordonning %s: %v", nodename, err)
+		return err
+	}
+
+	if err := kubectldrain.RunNodeDrain(drainer, nodename); err != nil {
+		log.Errorf("Error draining %s: %v", nodename, err)
+		return err
+	}
+	return nil
+}
+
+// Uncordon uncordons a node and reapplies postRebootNodeLabels once the node
+// is schedulable again.
+func Uncordon(client *kubernetes.Clientset, node *v1.Node, postRebootNodeLabels []string) error {
+	nodename := node.GetName()
+	log.Infof("Uncordoning node %s", nodename)
+	drainer := &kubectldrain.Helper{
+		Client: client,
+		ErrOut: os.Stderr,
+		Out:    os.Stdout,
+		Ctx:    context.Background(),
+	}
+	if err := kubectldrain.RunCordonOrUncordon(drainer, node, false); err != nil {
+		log.Fatalf("Error uncordonning %s: %v", nodename, err)
+		return err
+	} else if postRebootNodeLabels != nil {
+		updateNodeLabels(client, node, postRebootNodeLabels)
+	}
+	return nil
+}
+
+// UncordonAfterReboot uncordons a node that has come back from a reboot,
+// restores its postRebootNodeLabels and reports the successful uncordon of
+// nodeID to notifyURL using messageTemplateUncordon.
+func UncordonAfterReboot(client *kubernetes.Clientset, node *v1.Node, nodeID string,
+	postRebootNodeLabels []string, notifyURL string, messageTemplateUncordon string) error {
+	if err := Uncordon(client, node, postRebootNodeLabels); err != nil {
+		return err
+	}
+	if notifyURL != "" {
+		if err := shoutrrr.Send(notifyURL, fmt.Sprintf(messageTemplateUncordon, nodeID)); err != nil {
+			log.Warnf("Error notifying: %v", err)
+		}
+	}
+	return nil
+}
