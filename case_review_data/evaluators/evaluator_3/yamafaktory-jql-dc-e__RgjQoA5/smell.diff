+/// Builds a tape in place over `json` and evaluates `tokens` against it. The
+/// tape builder writes only the bytes it unescapes a string into, so
+/// escape-free input — the caller has checked for a backslash — is left intact
+/// for the reads a decline and a taped outcome make against it.
+fn tape_in_place(
+    buffers: &mut Buffers,
+    tokens: &[Token],
+    json: &mut [u8],
+) -> Result<Outcome, JqlRunnerError> {
+    let tape = match simd_json::to_tape_with_buffers(json, buffers) {
+        Ok(tape) => tape,
+        Err(_) => return Ok(declined(buffers, json)),
+    };
+
+    taped_outcome(eval(tokens, tape.as_value()), json)
+}
+
+/// Builds a tape over a scratch `copy` of `json` — the tape builder unescapes
+/// strings into the copy — and evaluates `tokens` against it. The pristine
+/// `json`, not the copy a failed build may have partly unescaped, is what a
+/// decline is read against.
+fn tape_escaped(
+    buffers: &mut Buffers,
+    tokens: &[Token],
+    json: &[u8],
+    copy: &mut [u8],
+) -> Result<Outcome, JqlRunnerError> {
+    let tape = match simd_json::to_tape_with_buffers(copy, buffers) {
+        Ok(tape) => tape,
+        Err(_) => return Ok(declined(buffers, json)),
+    };
+
+    taped_outcome(eval(tokens, tape.as_value()), json)
+}
+
+/// Turns a tape build failure into a declined outcome, reading the document
+/// boundaries out of the stage-1 scan it already paid for.
+///
+/// The failure itself says nothing usable about why — a second document
+/// reports the same internal tape error as some malformed input — so
+/// [`document_starts`] is what decides whether the scan describes a clean
+/// sequence of documents.
+fn declined(buffers: &Buffers, json: &[u8]) -> Outcome {
+    Outcome {
+        value: None,
+        document_starts: document_starts(buffers.structural_indexes(), json),
+    }
+}
+
+/// Wraps the result a taped evaluation came back with, reporting a fallback
+/// when the numbers it carries could have been parsed differently by
+/// serde_json.
+fn taped_outcome(
+    outcome: Result<Value, JqlRunnerError>,
+    json: &[u8],
+) -> Result<Outcome, JqlRunnerError> {
+    if outcome_may_diverge(&outcome, json) {
+        return Ok(Outcome::fallback());
+    }
+
+    outcome.map(|value| Outcome {
+        value: Some(value),
+        document_starts: None,
+    })
+}
+
 /// Whether the numbers `outcome` carries could have been parsed differently by
 /// serde_json, which means the tape must be given up for it.
 ///
