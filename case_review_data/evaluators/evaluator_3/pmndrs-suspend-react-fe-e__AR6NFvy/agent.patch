 /**
  * The registry of live cache entries. Consumers may hold several registries,
- * the exported suspense API uses a single shared one.
+ * the exported suspense API uses a single shared one. The registry owns its
+ * entries collection, so lookup, removal and clearing live here rather than
+ * with the code that wires the public operations together.
  */
 export class CacheRegistry {
   public readonly entries: CacheEntry[] = []
@@ -43,4 +47,25 @@ export class CacheRegistry {
   register(entry: CacheEntry) {
     this.entries.push(entry)
   }
+
+  /** Find the live entry whose keys match, using each entry's equality function. */
+  find(keys: any[]): CacheEntry | undefined {
+    return this.entries.find((entry) => shallowEqualArrays(keys, entry.keys, entry.equal))
+  }
+
+  /** Remove a single entry from the registry by reference. */
+  remove(entry: CacheEntry) {
+    const index = this.entries.indexOf(entry)
+    if (index !== -1) this.entries.splice(index, 1)
+  }
+
+  /** Drop every entry, or only the entry matching `keys` when given. */
+  clear(keys?: any[]) {
+    if (keys === undefined || keys.length === 0) {
+      this.entries.splice(0, this.entries.length)
+    } else {
+      const entry = this.find(keys)
+      if (entry) this.remove(entry)
+    }
+  }
 }
