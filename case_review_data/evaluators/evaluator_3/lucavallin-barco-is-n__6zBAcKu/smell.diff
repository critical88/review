diff --git a/include/runtime.h b/include/runtime.h
new file mode 100644
index 0000000..d258693
--- /dev/null
+++ b/include/runtime.h
@@ -0,0 +1,100 @@
+#ifndef RUNTIME_H
+#define RUNTIME_H
+
+#include <errno.h>
+#include <seccomp.h>
+#include <sys/types.h>
+
+/* Consolidated runtime settings: cgroups limits. */
+#define CGROUPS_MEMORY_MAX "1G"
+#define CGROUPS_CPU_WEIGHT "256"
+#define CGROUPS_PIDS_MAX "64"
+#define CGROUPS_CGROUP_PROCS "cgroup.procs"
+enum { CGROUPS_CONTROL_FIELD_SIZE = 256 };
+
+/* Consolidated runtime settings: container stack. */
+enum { CONTAINER_STACK_SIZE = (1024 * 1024) };
+
+/* Consolidated runtime settings: seccomp policy. */
+#define SEC_SCMP_FAIL SCMP_ACT_ERRNO(EPERM)
+
+/* Consolidated runtime settings: user namespace mappings. */
+enum {
+  USER_NAMESPACE_UID_PARENT_RANGE_START = 0,
+  USER_NAMESPACE_UID_CHILD_RANGE_START = 10000,
+  USER_NAMESPACE_UID_CHILD_RANGE_SIZE = 2000,
+};
+
+/*
+ * The runtime configuration record.
+ *
+ * This is the single configuration record carried through every phase of
+ * the runtime lifecycle. Each subsystem reads (and, where applicable,
+ * updates) the fields it cares about; no subsystem needs more than a
+ * slice of the record.
+ */
+typedef struct {
+  // uid and gid of the user in the container
+  uid_t uid;
+  // socket end used by the container process
+  int fd;
+  // socket end used by the parent process (barco)
+  int parent_fd;
+  // pid of the container process
+  pid_t pid;
+  // hostname assigned to the container and to its cgroup directory
+  char *hostname;
+  // command to run in the container and its argument
+  char *cmd;
+  char *arg;
+  // directory to mount as root in the container
+  char *mnt;
+  // top of the stack reserved for the container process
+  char *stack_top;
+} runtime_config;
+
+/*
+ * The runtime lifecycle interface.
+ *
+ * Every barco subsystem exposes the complete lifecycle below. A subsystem
+ * that has nothing to do in a phase implements it as a default no-op that
+ * returns 0, so the runtime can drive all of them uniformly.
+ */
+typedef struct {
+  // Creates the container process (parent side).
+  int (*spawn)(runtime_config *config);
+  // Configures the runtime for the container from the parent side.
+  int (*configure)(runtime_config *config);
+  // Applies the namespace-local settings from inside the container.
+  int (*activate)(runtime_config *config);
+  // Runs the container workload (inside the container).
+  int (*run)(runtime_config *config);
+  // Waits for the container process to exit (parent side).
+  int (*join)(runtime_config *config);
+  // Stops the container process (parent side).
+  int (*stop)(runtime_config *config);
+  // Releases the runtime resources for the container (parent side).
+  int (*release)(runtime_config *config);
+} runtime_ops;
+
+/* The runtime lifecycle interface implemented by every subsystem. */
+extern const runtime_ops container_interface;
+extern const runtime_ops cgroups_interface;
+extern const runtime_ops mount_interface;
+extern const runtime_ops user_interface;
+extern const runtime_ops sec_interface;
+
+/*
+ * Drives a runtime lifecycle phase across every registered subsystem,
+ * stopping at the first failure.
+ * Returns 0 on success and the failing phase result otherwise.
+ */
+int runtime_spawn(runtime_config *config);
+int runtime_configure(runtime_config *config);
+int runtime_activate(runtime_config *config);
+int runtime_run(runtime_config *config);
+int runtime_join(runtime_config *config);
+int runtime_stop(runtime_config *config);
+int runtime_release(runtime_config *config);
+
+#endif
