diff --git a/src/runtime.c b/src/runtime.c
new file mode 100644
index 0000000..17700cb
--- /dev/null
+++ b/src/runtime.c
@@ -0,0 +1,123 @@
+#include "runtime.h"
+#include "log.h"
+#include <stddef.h>
+
+/*
+ * The registered runtime interfaces, in the order the lifecycle phases of
+ * the runtime must be driven across subsystems.
+ */
+static const runtime_ops *const runtime_registry[] = {
+    &container_interface, &cgroups_interface, &mount_interface,
+    &user_interface,      &sec_interface,     NULL};
+
+// Drives the spawn phase across every registered interface, stopping at
+// the first failure.
+int runtime_spawn(runtime_config *config) {
+  int result = 0;
+
+  log_debug("spawning runtime interfaces...");
+  for (const runtime_ops *const *interface = runtime_registry; *interface;
+       interface++) {
+    if ((result = (*interface)->spawn(config))) {
+      return result;
+    }
+  }
+
+  return result;
+}
+
+// Drives the configure phase across every registered interface, stopping
+// at the first failure.
+int runtime_configure(runtime_config *config) {
+  int result = 0;
+
+  log_debug("configuring runtime interfaces...");
+  for (const runtime_ops *const *interface = runtime_registry; *interface;
+       interface++) {
+    if ((result = (*interface)->configure(config))) {
+      return result;
+    }
+  }
+
+  return result;
+}
+
+// Drives the activate phase across every registered interface, stopping
+// at the first failure.
+int runtime_activate(runtime_config *config) {
+  int result = 0;
+
+  log_debug("activating runtime interfaces...");
+  for (const runtime_ops *const *interface = runtime_registry; *interface;
+       interface++) {
+    if ((result = (*interface)->activate(config))) {
+      return result;
+    }
+  }
+
+  return result;
+}
+
