diff --git a/sorl/thumbnail/keys.py b/sorl/thumbnail/keys.py
new file mode 100644
index 0000000..f187b19
--- /dev/null
+++ b/sorl/thumbnail/keys.py
@@ -0,0 +1,77 @@
+"""
+Single owner of thumbnail cache key construction.
+
+Every identity that lives in the thumbnail cache -- a source image, a
+thumbnail file, and the metadata rows that link them -- is addressed by a key
+built from the same two pieces of knowledge:
+
+* a stable ``md5`` digest of the identifying parts, and
+* a namespaced composite key laid out as ``<prefix>||<identity>||<key>``.
+
+These used to be spelled out, slightly differently, at each call site. Changing
+the cache namespace (for example bumping ``THUMBNAIL_KEY_PREFIX`` so old
+metadata rows are no longer reused) therefore meant hunting the same logic
+through ``images``, ``base`` and every kvstore. It now lives here, so the next
+change to the key layout is made in one place.
+"""
+
+import hashlib
+
+from django.utils.encoding import force_str
+
+from sorl.thumbnail.conf import settings
+
+# Separator between the parts of every cache key, from the inputs fed to the
+# digest up to the composite key-value-store keys. Defined once so the layout
+# can be changed without touching each call site.
+KEY_SEPARATOR = '||'
+
+
+def digest(*parts):
+    """
+    Return a stable md5 hexdigest for ``parts``.
+
+    This is the identity function for anything stored in the thumbnail cache.
+    Both ``ImageFile.key`` and the thumbnail destination filename derive their
+    key from a digest of their identifying parts, so identical inputs always
+    map to the same key -- which is exactly why the namespace must not be
+    spliced in here and there but threaded through this single call.
+
+    ``usedforsecurity=False`` keeps this FIPS-compliant; the digest is only ever
+    used for cache addressing, never for security.
+    """
+    salt = KEY_SEPARATOR.join(force_str(arg) for arg in parts)
+    return hashlib.md5(salt.encode(), usedforsecurity=False).hexdigest()
+
+
+def kvstore_key(identity, key):
+    """
+    Build the composite key under which a thumbnail's metadata row is stored
+    in the key-value store: ``<THUMBNAIL_KEY_PREFIX>||<identity>||<key>``.
+
+    ``identity`` is the row kind (``'image'`` or ``'thumbnails'``) and ``key``
+    is the digest produced by :func:`digest`. The prefix is the cache
+    namespace: bumping ``THUMBNAIL_KEY_PREFIX`` is how an installation retires
+    every old metadata row at once, so the prefix is applied here -- the single
+    owner of the layout -- instead of being re-spliced at every call site.
+    """
+    return KEY_SEPARATOR.join(
+        [settings.THUMBNAIL_KEY_PREFIX, identity, force_str(key)]
+    )
+
+
+def kvstore_prefix(identity=None):
+    """
+    Return the shared prefix of every composite key.
+
+    With ``identity`` this yields ``<prefix>||<identity>||`` (used by
+    ``_find_keys`` to enumerate all rows of one kind); without it, the bare
+    ``<prefix>||`` namespace prefix (used by ``clear`` to wipe everything
+    belonging to this installation). Either way only ever matches sorl's own
+    composite keys, never raw keys of other applications that happen to share
+    the prefix string.
+    """
+    parts = [settings.THUMBNAIL_KEY_PREFIX]
+    if identity is not None:
+        parts.append(identity)
+    return KEY_SEPARATOR.join(parts) + KEY_SEPARATOR
