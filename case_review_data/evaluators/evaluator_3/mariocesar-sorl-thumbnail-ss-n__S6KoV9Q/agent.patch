diff --git a/tests/thumbnail_tests/test_keys.py b/tests/thumbnail_tests/test_keys.py
new file mode 100644
index 0000000..cad30cd
--- /dev/null
+++ b/tests/thumbnail_tests/test_keys.py
@@ -0,0 +1,80 @@
+import hashlib
+import unittest
+
+from django.test import SimpleTestCase, override_settings
+
+from sorl.thumbnail.conf import settings
+from sorl.thumbnail.images import ImageFile
+from sorl.thumbnail.keys import digest, kvstore_key, kvstore_prefix
+
+
+class DigestTest(SimpleTestCase):
+    def test_is_md5_of_separ_joined_parts(self):
+        # The digest must stay byte-identical: ``ImageFile.key`` output is a
+        # stability contract (see CHANGES.rst, #805) and thumbnail filenames
+        # are pinned by test_nonascii. Changing the algorithm here would
+        # obsolete every cached thumbnail.
+        salt = '||'.join(['some.jpg', '100x100', '{"quality": 95}'])
+        self.assertEqual(
+            digest('some.jpg', '100x100', '{"quality": 95}'),
+            hashlib.md5(salt.encode(), usedforsecurity=False).hexdigest(),
+        )
+
+    def test_identical_inputs_map_to_same_key(self):
+        self.assertEqual(digest('a', 'b'), digest('a', 'b'))
+
+    def test_part_order_and_values_matter(self):
+        self.assertNotEqual(digest('a', 'b'), digest('b', 'a'))
+        self.assertNotEqual(digest('a', 'b'), digest('a', 'c'))
+
+    def test_image_file_key_routes_through_digest(self):
+        # ``ImageFile.key`` is no longer an inlined copy of the digest; it must
+        # delegate to the shared owner with exactly its own identifying parts.
+        im = ImageFile('some.jpg')
+        self.assertEqual(
+            im.key,
+            digest(im.name, im.serialize_storage(use_backend_name=True)),
+        )
+
+
+class KVStoreKeyTest(SimpleTestCase):
+    def test_kvstore_key_layout(self):
+        self.assertEqual(
+            kvstore_key('image', 'abc'),
+            'sorl-thumbnail||image||abc',
+        )
+
+    def test_kvstore_prefix_layout(self):
+        self.assertEqual(kvstore_prefix(), 'sorl-thumbnail||')
+        self.assertEqual(kvstore_prefix('thumbnails'), 'sorl-thumbnail||thumbnails||')
+
+
+class NamespaceBumpTest(SimpleTestCase):
+    """Changing THUMBNAIL_KEY_PREFIX is a single-settings cache namespace bump.
+
+    Every composite key and every scan prefix must derive from the live
+    setting so that bumping it retires all old metadata rows in one go. This
+    is the scenario the consolidation exists to make trivial.
+    """
+
+    def test_default_keys_use_default_prefix(self):
+        self.assertTrue(kvstore_key('image', 'abc').startswith('sorl-thumbnail||'))
+        self.assertTrue(kvstore_prefix().startswith('sorl-thumbnail||'))
+
+    @override_settings(THUMBNAIL_KEY_PREFIX='fresh-namespace')
+    def test_bump_rekeys_everything(self):
+        self.assertEqual(kvstore_key('image', 'abc'), 'fresh-namespace||image||abc')
+        self.assertEqual(kvstore_prefix(), 'fresh-namespace||')
+        self.assertEqual(kvstore_prefix('thumbnails'), 'fresh-namespace||thumbnails||')
+
+        # No key built under the retired namespace survives the bump, so old
+        # metadata rows are never matched again.
+        default_key = 'sorl-thumbnail||image||abc'
+        self.assertNotEqual(kvstore_key('image', 'abc'), default_key)
+        self.assertFalse(kvstore_prefix().startswith(default_key.split('||')[0] + '||'))
+        # The setting really is the single source.
+        self.assertEqual(settings.THUMBNAIL_KEY_PREFIX, 'fresh-namespace')
+
+
+if __name__ == '__main__':
+    unittest.main()
