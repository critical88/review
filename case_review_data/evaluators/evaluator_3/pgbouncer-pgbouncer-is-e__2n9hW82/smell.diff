+
+/*
+ * Connection operations.
+ *
+ * Every kind of connection that PgBouncer manages on a PgSocket describes
+ * itself with a ConnOps table, in the same way an SBuf picks its SBufIO
+ * transport.  A kind registers its table when the socket is constructed
+ * (see construct_client()/construct_server() in objects.c), and the shared
+ * machinery - the stream buffer (sbuf.c) and the packet reassembly state
+ * machine (proto.c) - reaches the connection through the registered table
+ * instead of asking which side of the pool it belongs to.
+ *
+ * The table covers the full lifetime of a connection, so the same interface
+ * can also describe kinds that PgBouncer opens itself, such as the
+ * cancel-only connections to peering PgBouncers.  A kind that never
+ * exercises a capability simply leaves the slot NULL; a new kind does not
+ * have to invent stubs, and adding a capability later does not have to
+ * touch any of the call sites.
+ */
+
+/* fwd def */
+typedef struct ConnOps ConnOps;
+
+struct ConnOps {
+	/*
+	 * Stream entry point.  Everything that happens on the socket is
+	 * reported here by SBuf (SBUF_EV_*).
+	 */
+	bool (*sbuf_event)(SBuf *sbuf, SBufEvent evtype, struct MBuf *data);
+
+	/*
+	 * Deliver a packet that was fully buffered by the packet callback
+	 * state machine (sbuf.c SBUF_EV_PKT_CALLBACK handling in proto.c).
+	 */
+	bool (*handle_complete_packet)(PgSocket *sk, PktHdr *pkt);
+
+	/*
+	 * Tear the connection down from shared code that cannot tell which
+	 * kind of connection it is holding.
+	 */
+	void (*disconnect)(PgSocket *sk, const char *reason);
+
+	/*
+	 * An outgoing connection was established (SBUF_EV_CONNECT_OK on a
+	 * client-side socket requestor).  Accepted sockets never see this.
+	 */
+	bool (*connected)(PgSocket *sk);
+
+	/*
+	 * An outgoing connection could not be established
+	 * (SBUF_EV_CONNECT_FAILED).  Accepted sockets never see this.
+	 */
+	void (*connect_failed)(PgSocket *sk);
+
+	/*
+	 * TLS handshake finished (SBUF_EV_TLS_READY).
+	 */
+	bool (*tls_ready)(PgSocket *sk);
+
+	/*
+	 * The server answered our SSLRequest with a single character
+	 * while we wait for it (server-side of the SSL negotiation).
+	 */
+	bool (*sslchar)(PgSocket *sk, struct MBuf *data);
+
+	/*
+	 * Login phase protocol packet (startup exchange, authentication).
+	 */
+	bool (*login_packet)(PgSocket *sk, PktHdr *pkt);
+
+	/*
+	 * Work phase protocol packet (everything after login).
+	 */
+	bool (*work_packet)(PgSocket *sk, PktHdr *pkt);
+
+	/*
+	 * Answer an AuthenticationRequest (or the authentication-time
+	 * exchange) that arrives while logging in.
+	 */
+	bool (*authreq)(PgSocket *sk, PktHdr *pkt);
+
+	/*
+	 * Complete the login on our side of the connection.
+	 */
+	bool (*finish_login)(PgSocket *sk);
+
+	/*
+	 * Pick the pool a startup packet asks for.
+	 */
+	bool (*startup_pool)(PgSocket *sk, const char *dbname, const char *username);
+
+	/*
+	 * A cancellation request arrived for this bouncer to honor.
+	 */
+	void (*cancel_request)(PgSocket *req);
+};
