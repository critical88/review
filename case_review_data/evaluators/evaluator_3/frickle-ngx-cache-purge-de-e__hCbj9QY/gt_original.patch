-static ngx_int_t
-ngx_http_cache_purge_pattern_unlink(ngx_http_cache_t *c)
-{
-    ngx_http_file_cache_t  *cache;
-
-    cache = c->file_cache;
-
-    /*
-     * remove the pattern-matched entry from disk and from the
-     * shared memory accounting.
-     */
-
-    ngx_shmtx_lock(&cache->shpool->mutex);
-
-    if (!c->node->exists) {
-        ngx_shmtx_unlock(&cache->shpool->mutex);
-        return NGX_DECLINED;
-    }
-
-    cache->sh->size -= c->node->fs_size;
-
-    c->node->exists = 0;
-#  if (nginx_version >= 8001) \
-       || ((nginx_version < 8000) && (nginx_version >= 7060))
-    c->node->updating = 0;
-#  endif
-
-    ngx_shmtx_unlock(&cache->shpool->mutex);
-
-    if (ngx_delete_file(c->file.name.data) == NGX_FILE_ERROR) {
-        /* entry in error log is enough, don't notice client */
-        ngx_log_error(NGX_LOG_CRIT, c->file.log, ngx_errno,
-                      ngx_delete_file_n " \"%s\" failed", c->file.name.data);
-
-        return NGX_ERROR;
-    }
-
-    return NGX_OK;
-}
