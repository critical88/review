diff --git a/t/servroot/conf/nginx.conf b/t/servroot/conf/nginx.conf
new file mode 100644
index 0000000..a57b6b5
--- /dev/null
+++ b/t/servroot/conf/nginx.conf
@@ -0,0 +1,80 @@
+worker_processes  1;
+daemon on;
+master_process off;
+error_log /workspace/repo/t/servroot/logs/error.log debug;
+pid       /workspace/repo/t/servroot/logs/nginx.pid;
+env MOCKEAGAIN_VERBOSE;
+env MOCKEAGAIN;
+env MOCKEAGAIN_WRITE_TIMEOUT_PATTERN;
+env LD_PRELOAD;
+env LD_LIBRARY_PATH;
+env DYLD_INSERT_LIBRARIES;
+env DYLD_FORCE_FLAT_NAMESPACE;
+#env LUA_PATH;
+#env LUA_CPATH;
+
+
+
+http {
+    access_log /workspace/repo/t/servroot/logs/access.log; client_body_temp_path /workspace/repo/t/servroot/client_body_temp;  fastcgi_temp_path /workspace/repo/t/servroot/fastcgi_temp; scgi_temp_path /workspace/repo/t/servroot/scgi_temp; uwsgi_temp_path /workspace/repo/t/servroot/uwsgi_temp;
+    #access_log off;
+
+    default_type text/plain;
+    keepalive_timeout  68000ms;
+
+    proxy_cache_path  /tmp/ngx_cache_purge_cache keys_zone=test_cache:10m;
+    proxy_temp_path   /tmp/ngx_cache_purge_temp 1 2;
+
+    server {
+        listen          1984;
+        #placeholder
+        server_name     'localhost';
+        
+        client_max_body_size 30M;
+        #client_body_buffer_size 4k;
+
+        # Begin preamble config...
+
+        # End preamble config...
+
+        # Begin test case config...
+    fastcgi_cache_purge  on;
+    proxy_cache_purge    on;
+    set $cache           test_cache;
+
+    location /proxy {
+        proxy_pass         $scheme://127.0.0.1:$server_port/etc/passwd;
+        proxy_cache        $cache;
+        proxy_cache_key    $uri$is_args$args;
+        proxy_cache_valid  3m;
+        add_header         X-Cache-Status $upstream_cache_status;
+
+        if ($uri)          { }
+    }
+
+    location = /etc/passwd {
+        root               /;
+    }
+
+        # End test case config.
+
+        location / {
+            root /workspace/repo/t/servroot/html;
+            index index.html index.htm;
+        }
+    }
+}
+
+
+
+#timer_resolution 100ms;
+
+events {
+    accept_mutex off;
+
+    worker_connections  128;
+}
+env ASAN_OPTIONS;
+env MOCKNOEAGAIN_VERBOSE;
+env MOCKNOEAGAIN;
+user root;
