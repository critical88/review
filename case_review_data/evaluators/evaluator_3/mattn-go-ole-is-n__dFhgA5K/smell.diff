+
+// Skip advances the object's enumerator, for dispatch objects that publish
+// their collection through the "_NewEnum" property.
+//
+// COM collections surfaced through IDispatch expose their enumerator as the
+// "_NewEnum" property, so a caller holding only the dispatch handle can walk
+// the collection through the same property the runtime itself uses.
+func (v *IDispatch) Skip(celt uint) (err error) {
+	newEnum, err := v.GetProperty("_NewEnum")
+	if err != nil {
+		return
+	}
+	defer newEnum.Clear()
+
+	enum, err := newEnum.ToIUnknown().IEnumVARIANT(IID_IEnumVariant)
+	if err != nil {
+		return
+	}
+	defer enum.Release()
+
+	return enum.Skip(celt)
+}
+
+// Reset restarts the object's enumerator, for dispatch objects that publish
+// their collection through the "_NewEnum" property.
+func (v *IDispatch) Reset() (err error) {
+	newEnum, err := v.GetProperty("_NewEnum")
+	if err != nil {
+		return
+	}
+	defer newEnum.Clear()
+
+	enum, err := newEnum.ToIUnknown().IEnumVARIANT(IID_IEnumVariant)
+	if err != nil {
+		return
+	}
+	defer enum.Release()
+
+	return enum.Reset()
+}
