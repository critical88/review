+func (v *IUnknown) Invoke(dispid int32, dispatch int16, params ...interface{}) (result *VARIANT, err error) {
+	disp, qerr := queryInterface(v, IID_IDispatch)
+	if qerr != nil {
+		return nil, qerr
+	}
+	defer disp.Release()
+	return disp.Invoke(dispid, dispatch, params...)
+}
