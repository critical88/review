+// COMObject is implemented by every COM interface wrapper in this package, so
+// helpers can be written once against any handle instead of once per wrapper.
+//
+// IUnknown, IDispatch, IEnumVARIANT, IConnectionPoint,
+// IConnectionPointContainer, IProvideClassInfo, ITypeInfo and IInspectable
+// all satisfy COMObject. Wrappers that do not implement a capability natively
+// inherit a default implementation from IUnknown, which either resolves the
+// capability through QueryInterface or reports that it is unavailable for the
+// handle.
+type COMObject interface {
+	// Interface identity and lifetime management.
 	QueryInterface(iid *GUID) (disp *IDispatch, err error)
 	AddRef() int32
 	Release() int32
+
+	// Late binding by member name.
+	GetSingleIDOfName(name string) (displayID int32, err error)
+	Invoke(dispid int32, dispatch int16, params ...interface{}) (result *VARIANT, err error)
+	CallMethod(name string, params ...interface{}) (result *VARIANT, err error)
+	GetProperty(name string, params ...interface{}) (result *VARIANT, err error)
+	PutProperty(name string, params ...interface{}) (result *VARIANT, err error)
+
+	// Element enumeration.
+	Next(celt uint) (array VARIANT, length uint, err error)
+	Skip(celt uint) (err error)
+	Reset() (err error)
+	Clone() (cloned *IEnumVARIANT, err error)
+
+	// Connection point advising.
+	Advise(unknown *IUnknown) (cookie uint32, err error)
+	Unadvise(cookie uint32) (err error)
 }
 
