+/******************************************************************************
+ * Built-in hook tables and seam resolution
+ *
+ * The engine never calls a host hook blindly. Each seam is resolved through
+ * the helpers below, which fall back to these built-in tables whenever the
+ * host did not register that capability. That is what lets a participant
+ * supply only the seams it can meaningfully support: every capability it
+ * leaves NULL is served by the matching built-in default.
+ */
+
+static const Fiche_Storage_Hooks builtin_storage = {
+    generate_slug,
+    create_directory,
+    save_to_file
+};
+
+static const Fiche_Audit_Hooks builtin_audit = {
+    print_status,
+    print_error,
+    print_separator,
+    log_entry
+};
+
+static const Fiche_Identity_Hooks builtin_identity = {
+    set_domain_name,
+    perform_user_change
+};
+
+static const Fiche_Admission_Hooks builtin_admission = {
+    default_admit_connection
+};
+
+
+static const Fiche_Storage_Hooks *service_storage(const Fiche_Service *s) {
+    return (s->ops && s->ops->storage) ? s->ops->storage : &builtin_storage;
+}
+
+static const Fiche_Audit_Hooks *service_audit(const Fiche_Service *s) {
+    return (s->ops && s->ops->audit) ? s->ops->audit : &builtin_audit;
+}
+
+static const Fiche_Identity_Hooks *service_identity(const Fiche_Service *s) {
+    return (s->ops && s->ops->identity) ? s->ops->identity : &builtin_identity;
+}
+
+static const Fiche_Admission_Hooks *service_admission(const Fiche_Service *s) {
+    return (s->ops && s->ops->admission) ? s->ops->admission : &builtin_admission;
+}
+
+
 /******************************************************************************
  * Public fiche functions
  */
