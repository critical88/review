++/*
++ * Wait until one of the requested interests is reported for the given
++ * descriptor.  Every method whose resource is a kernel descriptor uses
++ * this helper to implement its readiness hooks.
++ *
++ * Returns 1 when the descriptor is ready, 0 when max_msec milliseconds
++ * elapsed, and -1 on error.  A negative timeout blocks until the
++ * descriptor is ready.
++ */
++int
++bio_poll_descriptor(int fd, short interest, long max_msec)
++{
++	struct pollfd pfd;
++	int ret;
++
++	if (fd < 0)
++		return (-1);
++
++	pfd.fd = fd;
++	pfd.events = interest;
++	pfd.revents = 0;
++
++	if (max_msec < 0) {
++		/* Block until the descriptor is ready. */
++		max_msec = -1;
++	} else if (max_msec > INT_MAX) {
++		max_msec = INT_MAX;
++	}
++
++	do {
++		ret = poll(&pfd, 1, (int)max_msec);
++	} while (ret < 0 && errno == EINTR);
++
++	if (ret < 0)
++		return (-1);
++	if (pfd.revents & POLLNVAL)
++		return (-1);
++	if (pfd.revents & (interest | POLLERR | POLLHUP))
++		return (1);
++	return (0);
++}
