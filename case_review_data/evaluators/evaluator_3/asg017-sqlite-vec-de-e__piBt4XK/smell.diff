+// Recursive serializer from the JSON preview experiment. Each element is
+// emitted through vec_serialize_element(), which walks back into
+// vec_serialize_recursive() for the next position. Superseded by the
+// single-pass builder in vec_to_json().
+static int vec_serialize_recursive(sqlite3_str *str, const void *vector,
+                                   enum VectorElementType elementType,
+                                   size_t dimensions, size_t index);
+
+static int vec_serialize_append_nan(sqlite3_str *str) {
+  sqlite3_str_appendall(str, "null");
+  return 0;
+}
+
+static int vec_serialize_element(sqlite3_str *str, const void *vector,
+                                 enum VectorElementType elementType,
+                                 size_t dimensions, size_t index) {
+  switch (elementType) {
+  case SQLITE_VEC_ELEMENT_TYPE_FLOAT32: {
+    f32 value = ((f32 *)vector)[index];
+    if (isnan(value)) {
+      vec_serialize_append_nan(str);
+    } else {
+      sqlite3_str_appendf(str, "%f", value);
+    }
+    break;
+  }
+  case SQLITE_VEC_ELEMENT_TYPE_INT8: {
+    sqlite3_str_appendf(str, "%d", ((i8 *)vector)[index]);
+    break;
+  }
+  case SQLITE_VEC_ELEMENT_TYPE_BIT: {
+    u8 b = (((u8 *)vector)[index / 8] >> (index % CHAR_BIT)) & 1;
+    sqlite3_str_appendf(str, "%d", b);
+    break;
+  }
+  }
+  if (index + 1 < dimensions) {
+    sqlite3_str_appendall(str, ",");
+  }
+  return vec_serialize_recursive(str, vector, elementType, dimensions,
+                                 index + 1);
+}
+
+static int vec_serialize_recursive(sqlite3_str *str, const void *vector,
+                                   enum VectorElementType elementType,
+                                   size_t dimensions, size_t index) {
+  if (index >= dimensions) {
+    return SQLITE_OK;
+  }
+  return vec_serialize_element(str, vector, elementType, dimensions, index);
+}
