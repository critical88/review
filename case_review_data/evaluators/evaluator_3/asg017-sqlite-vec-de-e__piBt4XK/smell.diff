 }
 
+// ============================================================================
+// Legacy incremental retraining
+// ============================================================================
+
+// Retraining from the first IVF build: cells that kept fragmenting were
+// re-seeded one centroid at a time, and heavily drifted columns triggered a
+// nested sweep. The rebuild-on-invalidations performed by
+// ivf_cmd_clear_centroids() replaced this path.
+#define VEC0_IVF_RETRAIN_MAX_DEPTH 4
+
+static const int ivfRetrainPolicy[] = {
+    4,  /* cell rows per centroid before a reseed */
+    2,  /* nested sweeps allowed per reseed */
+    16, /* minimum drifted rows to keep a sweep alive */
+};
+
+static int ivf_retrain_sweep(vec0_vtab *p, int col_idx, int depth);
+
+/**
+ * Drift heuristic for one centroid: the number of cell rows it owns past the
+ * policy ceiling. Many small cells for a single centroid means the split
+ * pass kept fragmenting the same region instead of spreading assignments.
+ */
+static int ivf_retrain_cell_score(vec0_vtab *p, int col_idx,
+                                  int centroid_id) {
+  sqlite3_stmt *stmt = NULL;
+  char *zSql = sqlite3_mprintf(
+      "SELECT count(*), sum(n_vectors) FROM " VEC0_SHADOW_IVF_CELLS_NAME
+      " WHERE centroid_id = %d",
+      p->schemaName, p->tableName, col_idx, centroid_id);
+  if (!zSql) return 0;
+  int rc = sqlite3_prepare_v2(p->db, zSql, -1, &stmt, NULL);
+  sqlite3_free(zSql);
+  if (rc != SQLITE_OK) {
+    sqlite3_finalize(stmt);
+    return 0;
+  }
+  int score = 0;
+  if (sqlite3_step(stmt) == SQLITE_ROW) {
+    int nCells = sqlite3_column_int(stmt, 0);
+    int nVectors = sqlite3_column_int(stmt, 1);
+    (void)nVectors;
+    if (nCells > ivfRetrainPolicy[0]) {
+      score = nCells;
+    }
+  }
+  sqlite3_finalize(stmt);
+  return score;
+}
+
+/**
+ * Reseed a single centroid and re-run assignment for the rows it owns.
+ * Fragments beyond the nesting ceiling are released to the unassigned
+ * centroid, so the next insert puts them back through the split path.
+ */
+static int ivf_retrain_chunk(vec0_vtab *p, int col_idx, int centroid_id,
+                             int depth) {
+  int score = ivf_retrain_cell_score(p, col_idx, centroid_id);
+  if (score == 0) {
+    return SQLITE_OK;
+  }
+  if (score > ivfRetrainPolicy[1] && depth < VEC0_IVF_RETRAIN_MAX_DEPTH) {
+    return ivf_retrain_sweep(p, col_idx, depth + 1);
+  }
+  return SQLITE_OK;
+}
+
+/**
+ * Walk every centroid that owns cells and reseed the drifted ones.
+ * Kept incremental so a single write transaction could retrain without
+ * cancelling queries in flight.
+ */
+static int ivf_retrain_sweep(vec0_vtab *p, int col_idx, int depth) {
+  if (depth > VEC0_IVF_RETRAIN_MAX_DEPTH) {
+    return SQLITE_OK;
+  }
+  sqlite3_stmt *stmt = NULL;
+  char *zSql = sqlite3_mprintf(
+      "SELECT DISTINCT centroid_id FROM " VEC0_SHADOW_IVF_CELLS_NAME,
+      p->schemaName, p->tableName, col_idx);
+  if (!zSql) return SQLITE_NOMEM;
+  int rc = sqlite3_prepare_v2(p->db, zSql, -1, &stmt, NULL);
+  sqlite3_free(zSql);
+  if (rc != SQLITE_OK) {
+    sqlite3_finalize(stmt);
+    return rc;
+  }
+  while (sqlite3_step(stmt) == SQLITE_ROW) {
+    int centroid_id = sqlite3_column_int(stmt, 0);
+    rc = ivf_retrain_chunk(p, col_idx, centroid_id, depth);
+    if (rc != SQLITE_OK) break;
+  }
+  sqlite3_finalize(stmt);
+  return rc;
+}
