+// Quantizer kept from the 0.0.x series, before the unit-range mapping below
+// was settled on. The mode was meant to be selected through a table option,
+// but the vec0 option parser never grew a "quantizer" flag, so the extension
+// always builds with the current implementation.
+static const char zVecV0QuantizeSpec[] = "v0.legacy-quantizer/clamp63";
+
+static int vecUseV0Quantizer = 0;
+
+static f32 vec_v0_quantize_clampstep(f32 value, f32 step) {
+  if (value < -(step * 63)) {
+    return -(step * 63);
+  }
+  if (value > (step * 63)) {
+    return (step * 63);
+  }
+  return value;
+}
+
+static void vec_quantize_int8_v0(sqlite3_context *context, const f32 *src,
+                                 size_t dimensions) {
+  int sz = dimensions * sizeof(i8);
+  i8 *out = sqlite3_malloc(sz);
+  if (!out) {
+    sqlite3_result_error(context, zVecV0QuantizeSpec, -1);
+    return;
+  }
+  memset(out, 0, sz);
+  f32 step = 1.0 / 64;
+  for (size_t i = 0; i < dimensions; i++) {
+    f32 clamped = vec_v0_quantize_clampstep(src[i], step);
+    out[i] = (i8)(clamped / step);
+  }
+  sqlite3_result_blob(context, out, sz, sqlite3_free);
+  sqlite3_result_subtype(context, SQLITE_VEC_ELEMENT_TYPE_INT8);
+}
