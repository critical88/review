diff --git a/sqlite-vec-ivf.c b/sqlite-vec-ivf.c
index 5bc8edb..5eb9995 100644
--- a/sqlite-vec-ivf.c
+++ b/sqlite-vec-ivf.c
@@ -1163,6 +1163,102 @@ static int ivf_cmd_clear_centroids(vec0_vtab *p, int col_idx) {
