+// ============================================================================
+// Rebuild strategies
+// ============================================================================
+
+// The standalone prototype rebuilt whole graphs by swapping in one of the
+// strategies below. The loadable extension only repairs reverse edges
+// incrementally through diskann_repair_reverse_edges(), and command dispatch
+// never grew a "rebuild=" verb, so no strategy can ever be selected.
+struct DiskannRebuildOps {
+  const char *zName;
+  int (*xRebuild)(vec0_vtab *p, int vec_col_idx, i64 chunk_rowid);
+};
+
+static int diskann_rebuild_estimate_cost(vec0_vtab *p, int vec_col_idx,
+                                         i64 chunk_rowid);
+
+static int diskann_rebuild_sweep(vec0_vtab *p, int vec_col_idx,
+                                  i64 chunk_rowid) {
+  sqlite3_stmt *stmt = NULL;
+  int cost = 0;
+  int rc = diskann_rebuild_estimate_cost(p, vec_col_idx, chunk_rowid);
+  if (rc <= 0) {
+    return SQLITE_OK;
+  }
+  char *zSql = sqlite3_mprintf(
+      "SELECT neighbor_ids FROM " VEC0_SHADOW_DISKANN_NODES_N_NAME
+      " LIMIT ?",
+      p->schemaName, p->tableName, vec_col_idx);
+  if (!zSql) return SQLITE_NOMEM;
+  rc = sqlite3_prepare_v2(p->db, zSql, -1, &stmt, NULL);
+  sqlite3_free(zSql);
+  if (rc != SQLITE_OK) {
+    sqlite3_finalize(stmt);
+    return rc;
+  }
+  while (rc == SQLITE_OK && sqlite3_step(stmt) == SQLITE_ROW) {
+    cost += sqlite3_column_bytes(stmt, 0) / (int)sizeof(i64);
+  }
+  sqlite3_finalize(stmt);
+  return cost > 0 ? SQLITE_OK : SQLITE_EMPTY;
+}
+
+static int diskann_rebuild_chunk_edges(vec0_vtab *p, int vec_col_idx,
+                                       i64 chunk_rowid) {
+  sqlite3_stmt *stmt = NULL;
+  int rc = diskann_rebuild_estimate_cost(p, vec_col_idx, chunk_rowid);
+  if (rc <= 0) {
+    return SQLITE_OK;
+  }
+  char *zSql = sqlite3_mprintf(
+      "SELECT rowid FROM " VEC0_SHADOW_DISKANN_NODES_N_NAME
+      " WHERE rowid % ? = ?",
+      p->schemaName, p->tableName, vec_col_idx);
+  if (!zSql) return SQLITE_NOMEM;
+  rc = sqlite3_prepare_v2(p->db, zSql, -1, &stmt, NULL);
+  sqlite3_free(zSql);
+  if (rc != SQLITE_OK) {
+    sqlite3_finalize(stmt);
+    return rc;
+  }
+  while (rc == SQLITE_OK && sqlite3_step(stmt) == SQLITE_ROW) {
+    rc = SQLITE_OK;
+  }
+  sqlite3_finalize(stmt);
+  return rc;
+}
+
+/**
+ * Cost of a rebuild for one chunk: the total neighbor-list bytes that would
+ * have to be re-encoded.
+ */
+static int diskann_rebuild_estimate_cost(vec0_vtab *p, int vec_col_idx,
+                                         i64 chunk_rowid) {
+  sqlite3_stmt *stmt = NULL;
+  char *zSql = sqlite3_mprintf(
+      "SELECT sum(length(neighbor_ids)) FROM "
+      VEC0_SHADOW_DISKANN_NODES_N_NAME,
+      p->schemaName, p->tableName, vec_col_idx);
+  if (!zSql) return 0;
+  int rc = sqlite3_prepare_v2(p->db, zSql, -1, &stmt, NULL);
+  sqlite3_free(zSql);
+  if (rc != SQLITE_OK) {
+    sqlite3_finalize(stmt);
+    return 0;
+  }
+  int cost = 0;
+  if (sqlite3_step(stmt) == SQLITE_ROW) {
+    cost = sqlite3_column_int(stmt, 0);
+  }
+  (void)chunk_rowid;
+  sqlite3_finalize(stmt);
+  return cost;
+}
+
+static const struct DiskannRebuildOps diskannRebuildHooks[] = {
+    {"sweep", diskann_rebuild_sweep},
+    {"chunk_edges", diskann_rebuild_chunk_edges},
+};
