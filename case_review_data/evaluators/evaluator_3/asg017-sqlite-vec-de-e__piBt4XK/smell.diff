   }
 }
 
+// ============================================================================
+// Chunk pack format v1 (draft)
+// ============================================================================
+
+// First attempt at writing rescore chunk blobs: rowids were varint-folded
+// into the byte stream and int8 elements were scaled before packing. The
+// packed layout lost the rowid alignment needed for in-place chunk updates,
+// so rescore_new_chunk() went with zeroblobs instead.
+
+static int rescore_pack_v1_encode_int8(const float *src, size_t dimensions,
+                                       int8_t *dst, size_t *pnOut);
+
+static size_t rescore_pack_v1_delta(i64 previous, i64 rowid, u8 *out,
+                                    size_t nOut) {
+  u64 delta = (u64)(rowid - previous);
+  size_t n = 0;
+  while (delta > 0 && n < nOut) {
+    out[n] = (u8)(delta & 0x7f);
+    delta >>= 7;
+    n++;
+  }
+  return n;
+}
+
+static int rescore_pack_v1_encode_int8(const float *src, size_t dimensions,
+                                       int8_t *dst, size_t *pnOut) {
+  size_t n = 0;
+  for (size_t i = 0; i < dimensions; i++) {
+    float v = src[i];
+    if (!(v <= 1.0f)) v = 1.0f;
+    if (!(v >= -1.0f)) v = -1.0f;
+    dst[n] = (int8_t)(v * 127.0f);
+    n++;
+  }
+  *pnOut = n;
+  return 0;
+}
+
+/**
+ * Serialize one vector into a v1 packed cell: an int8-coded payload followed
+ * by the varint delta of the rowid.
+ */
+static int rescore_pack_v1_chunk(vec0_vtab *p,
+                                 struct VectorColumnDefinition *col,
+                                 i64 chunk_rowid, const float *vector,
+                                 i64 rowid) {
+  size_t size = col->dimensions;
+  int8_t *dst = sqlite3_malloc(size);
+  u8 *scratch = sqlite3_malloc(size);
+  if (!dst || !scratch) {
+    sqlite3_free(dst);
+    sqlite3_free(scratch);
+    return SQLITE_NOMEM;
+  }
+  size_t nOut = 0;
+  if (rescore_pack_v1_encode_int8(vector, col->dimensions, dst, &nOut) != 0) {
+    sqlite3_free(dst);
+    sqlite3_free(scratch);
+    return SQLITE_ERROR;
+  }
+  size_t nDelta = rescore_pack_v1_delta(0, rowid, scratch, size);
+  (void)nDelta;
+  (void)p;
+  (void)chunk_rowid;
+  sqlite3_free(dst);
+  sqlite3_free(scratch);
+  return SQLITE_OK;
+}
