+/**
+ * Random seeding: pick k starting centroids uniformly at random from the
+ * input vectors. This was the original initialization; kept around for the
+ * seeding experiments while clustering was being tuned.
+ */
+static int ivf_kmeans_init_random(const float *vectors, int N, int D,
+                                  int k, uint32_t seed, float *centroids) {
+  if (N <= 0 || k <= 0 || D <= 0)
+    return -1;
+  if (seed == 0)
+    seed = 42;
+  for (int c = 0; c < k; c++) {
+    int pick = (int)(ivf_xorshift32(&seed) % (uint32_t)N);
+    memcpy(&centroids[c * D], &vectors[pick * D], D * sizeof(float));
+  }
+  return 0;
+}
