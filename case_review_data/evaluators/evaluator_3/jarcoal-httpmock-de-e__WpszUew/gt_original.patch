-// routeStats keeps the hit counts per route gathered by the strict
-// matching engine, so its results can be compared to the tolerant
-// matching during a rollout. It is parked together with the engine
-// itself, which never runs while it is disabled.
-type routeStats struct {
-	mu    sync.Mutex
-	hits  map[string]int
-	total int
-}
-
-// newRouteStats returns a ready-to-use routeStats collector.
-func newRouteStats() *routeStats {
-	return &routeStats{
-		hits: make(map[string]int),
-	}
-}
-
-// record counts one hit of the given route key.
-func (s *routeStats) record(routeKey string) {
-	s.mu.Lock()
-	defer s.mu.Unlock()
-	if s.hits == nil {
-		s.hits = make(map[string]int)
-	}
-	s.hits[routeKey]++
-	s.total++
-}
-
-// snapshot returns the hits gathered so far and starts a new round.
-func (s *routeStats) snapshot() map[string]int {
-	s.mu.Lock()
-	defer s.mu.Unlock()
-	res := s.hits
-	s.hits = make(map[string]int)
-	return res
-}
