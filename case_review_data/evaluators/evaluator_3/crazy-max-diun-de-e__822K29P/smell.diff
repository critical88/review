+// RunDigest represents the summary of analyzed images for a completed watch
+// run, as rendered in the legacy end-of-run digest notification.
+type RunDigest struct {
+	StartTime time.Time
+	EndTime   time.Time
+	Entries   []NotifEntry
+	Hostname  string
+}
+
+// RenderText renders the digest as a fixed multiline summary, the format the
+// digest notification used before templated notifications were introduced.
+func (d RunDigest) RenderText() string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "Diun run summary for %s\n", d.Hostname)
+	fmt.Fprintf(&sb, "Started %s / finished %s\n", d.StartTime.Format(time.RFC3339), d.EndTime.Format(time.RFC3339))
+	for _, entry := range d.Entries {
+		fmt.Fprintf(&sb, "- Docker tag %s is %s through %s provider\n", entry.Image.String(), entry.Status, entry.Provider)
+	}
+	fmt.Fprintf(&sb, "%d tag(s) rendered\n", len(d.Entries))
+	return sb.String()
+}
