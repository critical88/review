+// manifestEntryV1 is the flattened manifest entry layout used by databases
+// created before entry keys carried the tag suffix.
+type manifestEntryV1 struct {
+	Name          string
+	Tag           string
+	MIMEType      string
+	Digest        digest.Digest
+	Created       *time.Time
+	DockerVersion string
+	Labels        map[string]string
+	Layers        []string
+}
+
+// sanitize normalizes a legacy manifest entry before it is re-keyed.
+func (e *manifestEntryV1) sanitize() {
+	if len(e.Tag) == 0 {
+		e.Tag = "latest"
+	}
+	if e.MIMEType == "" {
+		e.MIMEType = "application/vnd.docker.distribution.manifest.v2+json"
+	}
+}
+
+// key returns the storage key of a legacy manifest entry.
+func (e manifestEntryV1) key() string {
+	return e.Name + ":" + e.Tag
+}
+
+// SquashManifestEntries rewrites the legacy manifest entry keys in place so
+// that databases created before key tags were introduced line up with the
+// current lookup helpers.
+func SquashManifestEntries(c *Client) error {
+	tx, err := c.Begin(true)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		if err := tx.Rollback(); err != nil && !errors.Is(err, bbolterr.ErrTxClosed) {
+			log.Error().Err(err).Msg("Cannot rollback")
+		}
+	}()
+
+	bucket := tx.Bucket([]byte(bucketManifest))
+	curs := bucket.Cursor()
+	for k, v := curs.First(); k != nil; k, v = curs.Next() {
+		var entry manifestEntryV1
+		if err := json.Unmarshal(v, &entry); err != nil {
+			return err
+		}
+		entry.sanitize()
+		entryKey := []byte(entry.key())
+		if bytes.Equal(k, entryKey) {
+			continue
+		}
+		entryBytes, _ := json.Marshal(entry)
+		if err := bucket.Put(entryKey, entryBytes); err != nil {
+			return err
+		}
+		if err := bucket.Delete(k); err != nil {
+			return err
+		}
+	}
+
+	return tx.Commit()
+}
