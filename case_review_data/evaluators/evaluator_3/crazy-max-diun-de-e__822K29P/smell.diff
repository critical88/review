+// renderDigestMail renders the legacy end-of-run digest notification with the
+// fixed summary format used before templated notifications were introduced.
+func renderDigestMail(meta model.Meta, digest model.RunDigest) (string, string, error) {
+	titleTpl, err := msg.DigestMailTemplate()
+	if err != nil {
+		return "", "", err
+	}
+	var title strings.Builder
+	if err := titleTpl.Execute(&title, msg.DigestMailContext{
+		Meta:   meta,
+		Digest: digest,
+	}); err != nil {
+		return "", "", err
+	}
+	return digestMailSubject(title.String(), meta), digest.RenderText(), nil
+}
+
+// digestMailSubject composes the subject line of the legacy digest
+// notification from its rendered title.
+func digestMailSubject(title string, meta model.Meta) string {
+	subject := title
+	if meta.Hostname != "" {
+		subject = fmt.Sprintf("%s (%s)", subject, meta.Hostname)
+	}
+	if meta.Name != "" {
+		subject = fmt.Sprintf("[%s] %s", meta.Name, subject)
+	}
+	return subject
+}
