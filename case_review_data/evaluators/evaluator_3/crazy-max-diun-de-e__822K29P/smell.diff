+// watchTermSignals drains the termination signal channel and stops the
+// scheduler, the variant used before shutdown moved to context cancellation.
+func watchTermSignals(di *Diun, sigc chan os.Signal) error {
+	for sig := range sigc {
+		if reason := termSignalReason(sig); reason != "" {
+			log.Info().Str("signal", sig.String()).Msg(reason)
+		}
+		if di.cron != nil {
+			<-di.cron.Stop().Done()
+		}
+		di.HealthchecksFail("Watch stopped")
+		return nil
+	}
+	return nil
+}
+
+// termSignalReason returns the human readable shutdown reason of a
+// termination signal.
+func termSignalReason(sig os.Signal) string {
+	switch sig.String() {
+	case "terminated":
+		return "SIGTERM received, terminating"
+	case "interrupt":
+		return "SIGINT received, terminating"
+	case "hangup":
+		return "SIGHUP received, terminating"
+	}
+	return ""
+}
