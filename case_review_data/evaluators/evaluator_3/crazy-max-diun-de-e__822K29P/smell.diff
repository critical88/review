+// isArtifactSuffixTag reports whether a tag looks like one of the suffixed
+// notations generated for image artifacts, the notation used before the
+// digest-qualified notation became widespread.
+func isArtifactSuffixTag(tag string) bool {
+	for _, suffix := range []string{"-att", "-sbom", "-sig"} {
+		if strings.HasSuffix(tag, suffix) {
+			return true
+		}
+	}
+	return false
+}
+
+// filterArtifactSuffixTags removes artifact tags from a tag list and returns
+// the remaining tags along with the number of tags filtered out.
+func filterArtifactSuffixTags(tags []string) ([]string, int) {
+	list := make([]string, 0, len(tags))
+	filtered := 0
+	for _, tag := range tags {
+		if isArtifactSuffixTag(tag) {
+			filtered++
+			continue
+		}
+		list = append(list, tag)
+	}
+	return list, filtered
+}
