+// kcpRecv drains the reassembly queue of the embedded KCP state machine
+// into 'buffer'. This is the session-level read datapath: readable fragments
+// are merged in sequence, buffered segments are promoted to the receive
+// queue, and the tell-probe is armed when the window opens up again.
+//
+// It returns the number of bytes read, -1 when there is no readable data,
+// and -2 if len(buffer) is smaller than the readable message size.
+func (s *UDPSession) kcpRecv(buffer []byte) (n int) {
+	peeksize := s.kcp.PeekSize()
+	if peeksize < 0 {
+		return -1
+	}
+
+	if peeksize > len(buffer) {
+		return -2
+	}
+
+	var fast_recover bool
+	if s.kcp.rcv_queue.Len() >= int(s.kcp.rcv_wnd) {
+		fast_recover = true
+	}
+
+	// merge fragment
+	for {
+		seg, ok := s.kcp.rcv_queue.Pop()
+		if !ok {
+			break
+		}
+
+		copy(buffer, seg.data)
+		buffer = buffer[len(seg.data):]
+		n += len(seg.data)
+		s.kcp.recycleSegment(&seg)
+		if seg.frg == 0 {
+			s.kcp.debugLog(IKCP_LOG_RECV, "stream", s.kcp.stream, "conv", s.kcp.conv, "sn", seg.sn, "ts", seg.ts, "datalen", n)
+			break
+		}
+	}
+
+	// move available data from rcv_buf -> rcv_queue
+	for s.kcp.rcv_buf.Len() > 0 {
+		seg := heap.Pop(s.kcp.rcv_buf).(segment)
+		if seg.sn == s.kcp.rcv_nxt && s.kcp.rcv_queue.Len() < int(s.kcp.rcv_wnd) {
+			s.kcp.rcv_queue.Push(seg)
+			s.kcp.rcv_nxt++
+		} else {
+			// push back segment
+			heap.Push(s.kcp.rcv_buf, seg)
+			break
+		}
+	}
+
+	// fast recover
+	if s.kcp.rcv_queue.Len() < int(s.kcp.rcv_wnd) && fast_recover {
+		// ready to send back IKCP_CMD_WINS in ikcp_flush
+		// tell remote my window size
+		s.kcp.probe |= IKCP_ASK_TELL
+	}
+	return
+}
