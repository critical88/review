+// kcpSend appends an application buffer to the send queue of the embedded KCP
+// state machine. This is the session-level write datapath: in streaming mode
+// the tail segment of the queue is grown in place, otherwise 'buffer' is
+// sliced into segments sized by the KCP maximum segment size.
+//
+// It returns 0 on success, -1 for an empty buffer, and -2 when the buffer
+// would require more than 255 segments.
+func (s *UDPSession) kcpSend(buffer []byte) int {
+	var count int
+	if len(buffer) == 0 {
+		return -1
+	}
+
+	s.kcp.debugLog(IKCP_LOG_SEND, "stream", s.kcp.stream, "conv", s.kcp.conv, "datalen", len(buffer))
+
+	// append to previous segment in streaming mode (if possible)
+	if s.kcp.stream != 0 {
+		if n := s.kcp.snd_queue.Len(); n > 0 {
+			for seg := range s.kcp.snd_queue.ForEachReverse {
+				if len(seg.data) < int(s.kcp.mss) {
+					capacity := int(s.kcp.mss) - len(seg.data)
+					extend := min(len(buffer), capacity)
+
+					// grow slice, the underlying cap is guaranteed to
+					// be larger than kcp.mss
+					oldlen := len(seg.data)
+					seg.data = seg.data[:oldlen+extend]
+					copy(seg.data[oldlen:], buffer)
+					buffer = buffer[extend:]
+				}
+				break
+			}
+		}
+
+		if len(buffer) == 0 {
+			return 0
+		}
+	}
+
+	if len(buffer) <= int(s.kcp.mss) {
+		count = 1
+	} else {
+		count = (len(buffer) + int(s.kcp.mss) - 1) / int(s.kcp.mss)
+	}
+
+	if count > 255 {
+		return -2
+	}
+
+	if count == 0 {
+		count = 1
+	}
+
+	for i := 0; i < count; i++ {
+		var size int
+		size = min(len(buffer), int(s.kcp.mss))
+		seg := s.kcp.newSegment(size)
+		copy(seg.data, buffer[:size])
+		if s.kcp.stream == 0 { // message mode
+			seg.frg = uint8(count - i - 1)
+		} else { // stream mode
+			seg.frg = 0
+		}
+
+		s.kcp.snd_queue.Push(seg)
+		buffer = buffer[size:]
+	}
+	return 0
+}
