+// parityFor seals a data shard into the FEC encoder attached to this session
+// and, once a quorum of data shards has been collected, produces the matching
+// Reed-Solomon parity shards for the pipeline stage below.
+//
+// notice: the contents of 'ps' will be re-written in successive calling
+func (s *UDPSession) parityFor(b []byte, rto uint32) (ps [][]byte) {
+	// The header format:
+	// | FEC SEQID(4B) | FEC TYPE(2B) | SIZE (2B) | PAYLOAD(SIZE-2) |
+	// |<-headerOffset                |<-payloadOffset
+	s.fecEncoder.sealData(b[s.fecEncoder.headerOffset:])
+	binary.LittleEndian.PutUint16(b[s.fecEncoder.payloadOffset:], uint16(len(b[s.fecEncoder.payloadOffset:])))
+
+	// copy data from payloadOffset to fec shard cache
+	sz := len(b)
+	s.fecEncoder.shardCache[s.fecEncoder.shardCount] = s.fecEncoder.shardCache[s.fecEncoder.shardCount][:sz]
+	copy(s.fecEncoder.shardCache[s.fecEncoder.shardCount][s.fecEncoder.payloadOffset:], b[s.fecEncoder.payloadOffset:])
+	s.fecEncoder.shardCount++
+
+	// track max datashard length
+	if sz > s.fecEncoder.maxSize {
+		s.fecEncoder.maxSize = sz
+	}
+
+	// Generation of Reed-Solomon Erasure Code when we have enough datashards
+	now := time.Now().UnixMilli()
+	if s.fecEncoder.shardCount == s.fecEncoder.dataShards {
+		// Generate the parity shards if we collect enough datashards,
+		// the continuity is determined by the time interval between
+		// the latest 2 data packets.
+		//
+		// If the interval is larger than rto, we consider the data is non-continuous,
+		// thus we skip this parity generation to avoid useless parity packets.
+		//
+		// Note that, even we skip this parity generation, we still need to
+		// increase the seqid to keep the monotonic increasing property.
+		// This is important for the receiver to detect lost packets.
+		// see fecEncoder.skipParity()
+		//
+		if now-s.fecEncoder.tsLatestPacket < int64(rto) {
+			// clear the tail of each datashard to make them equal-sized
+			for i := 0; i < s.fecEncoder.dataShards; i++ {
+				shard := s.fecEncoder.shardCache[i]
+				slen := len(shard)
+				clear(shard[slen:s.fecEncoder.maxSize])
+			}
+
+			// construct equal-sized slice with stripped header
+			cache := s.fecEncoder.encodeCache
+			for k := range cache {
+				cache[k] = s.fecEncoder.shardCache[k][s.fecEncoder.payloadOffset:s.fecEncoder.maxSize]
+			}
+
+			// Reed-Solomon Erasure Code Encoding
+			if err := s.fecEncoder.codec.Encode(cache); err == nil {
+				ps = s.fecEncoder.shardCache[s.fecEncoder.dataShards:]
+				for k := range ps {
+					s.fecEncoder.sealParity(ps[k][s.fecEncoder.headerOffset:]) // NOTE(x): seal parity will increase the seqid by 1
+					ps[k] = ps[k][:s.fecEncoder.maxSize]
+				}
+			} else {
+				// encoding failed, record the error but keep the seqid monotonic increasing
+				atomic.AddUint64(&DefaultSnmp.FECErrs, 1)
+				s.fecEncoder.skipParity()
+			}
+		} else {
+			// Non-continuous data detected, skip this parity generation.
+			// Through we do not send non-continuous parity shard, we still need to increase seqid.
+			s.fecEncoder.skipParity()
+		}
+
+		// reset shard count and max size
+		s.fecEncoder.shardCount = 0
+		s.fecEncoder.maxSize = 0
+	}
+
+	// record the time of the latest data packet
+	s.fecEncoder.tsLatestPacket = now
+
+	return
+}
