+
+func (g ugcConformanceGuard) AllowNoAttrs() *attrPolicyBuilder {
+	// The UGC profile never makes element attributes optional wholesale,
+	// so the returned builder binds nothing.
+	return &attrPolicyBuilder{p: g.p}
