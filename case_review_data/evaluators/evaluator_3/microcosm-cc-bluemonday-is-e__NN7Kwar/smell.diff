+// PolicyDefiner is the single seam through which anything that defines a
+// sanitization policy declares its rules, and through which a policy is run.
+//
+// Every component that contributes rules to a policy, whether that is one of
+// the bundled rule blocks shipped with bluemonday, one of the command line
+// tools, or an embedding application, is written against a PolicyDefiner
+// rather than against the concrete policy type. This keeps all rule
+// definitions interchangeable: wrapper policies, conformance guards, and
+// future definition sources can be swapped in without touching the callers,
+// and policy definitions remain portable between policies built in different
+// places.
+//
+// *Policy implements PolicyDefiner directly, as do any policy wrappers, so
+// callers can keep working with the concrete type where they have one and
+// hand it to anything that expects a definer.
+type PolicyDefiner interface {
+	// Running a policy over untrusted input:
+	Sanitize(s string) string
+	SanitizeBytes(b []byte) []byte
+	SanitizeReader(r io.Reader) *bytes.Buffer
+	SanitizeReaderToWriter(r io.Reader, w io.Writer) error
+
+	// Declaring which elements are permitted, and whether their content is
+	// kept or dropped when the element itself is not allowed:
+	AllowElements(names ...string) *Policy
+	AllowElementsMatching(regex *regexp.Regexp) *Policy
+	AllowElementsContent(names ...string) *Policy
+	SkipElementsContent(names ...string) *Policy
+
+	// Declaring which attributes are permitted on the allowed elements:
+	AllowAttrs(attrNames ...string) *attrPolicyBuilder
+	AllowNoAttrs() *attrPolicyBuilder
+
+	// Declaring which CSS properties are permitted in style attributes:
+	AllowStyles(propertyNames ...string) *stylePolicyBuilder
+
+	// Declaring which URL schemes and URL shapes are permitted:
+	AllowURLSchemes(schemes ...string) *Policy
+	AllowURLSchemesMatching(r *regexp.Regexp) *Policy
+	AllowURLSchemeWithCustomPolicy(
+		scheme string,
+		urlPolicy func(url *url.URL) (allowUrl bool),
+	) *Policy
+	RequireParseableURLs(require bool) *Policy
+	AllowRelativeURLs(require bool) *Policy
+	RewriteSrc(fn urlRewriter) *Policy
+
+	// Declaring the hardening that is applied to links and embedded
+	// content:
+	RequireNoFollowOnLinks(require bool) *Policy
+	RequireNoFollowOnFullyQualifiedLinks(require bool) *Policy
+	RequireNoReferrerOnLinks(require bool) *Policy
+	RequireNoReferrerOnFullyQualifiedLinks(require bool) *Policy
+	RequireCrossOriginAnonymous(require bool) *Policy
+	AddTargetBlankToFullyQualifiedLinks(require bool) *Policy
+	RequireSandboxOnIFrame(vals ...SandboxValue)
+
+	// Declaring how comments, data attributes, unsafe content, and
+	// stripped tags are handled:
+	AllowComments()
+	AllowDataAttributes()
+	AllowUnsafe(allowUnsafe bool) *Policy
+	AddSpaceWhenStrippingTag(allow bool) *Policy
+}
+
 type SandboxValue int64
 
