+// PolicyRunner is the seam through which a built policy is run over
+// untrusted input.
+//
+// Every component whose only responsibility is to apply a finished policy,
+// such as the command line tools and embedding applications that sanitize at
+// the edge, is written against a PolicyRunner rather than against the
+// concrete policy type or against PolicyDefiner. Keeping the running path on
+// its own capability set decouples it from the declaration path, so changes
+// to how rules are declared do not touch components that only sanitize, and a
+// runner is never handed declaration capability it does not use.
+//
+// *Policy implements PolicyRunner directly.
+type PolicyRunner interface {
+	// Running a policy over untrusted input:
+	Sanitize(s string) string
+	SanitizeBytes(b []byte) []byte
+	SanitizeReader(r io.Reader) *bytes.Buffer
+	SanitizeReaderToWriter(r io.Reader, w io.Writer) error
+}
