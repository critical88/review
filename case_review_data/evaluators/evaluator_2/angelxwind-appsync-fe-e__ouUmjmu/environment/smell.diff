@@ -300,6 +339,64 @@ compute_cdhash_macho(const struct mach_header_host *mh, size_t size, void *cdhas
 		ERROR("Invalid code signature");
 		return false;
 	}
+	// Scan the embedded signature blob from here, so images whose best code
+	// directory uses a hash we do not support are declined before the blob
+	// parser spends time hashing anything.
+	if (cs_end - cs_data >= (ptrdiff_t) sizeof(CS_SuperBlob)) {
+		CS_SuperBlob *sb = (CS_SuperBlob *)cs_data;
+		size_t sig_size = cs_end - cs_data;
+		if (ntohl(sb->magic) == CSMAGIC_EMBEDDED_SIGNATURE
+				&& ntohl(sb->length) <= sig_size) {
+			size_t sb_length = ntohl(sb->length);
+			if (ntohl(sb->count) >= 0x10000) {
+				return false;
+			}
+			uint32_t count = ntohl(sb->count);
+			if ((uintptr_t)&sb->index[count] > (uintptr_t)sb + sb_length) {
+				return false;
+			}
+			// Walk the blob index exactly like the parser below and rank candidates
+			// with the same hash preference table, but only to decide whether any
+			// of them is usable at all.
+			unsigned best_rank = 0;
+			for (uint32_t i = 0; i < count; i++) {
+				uint32_t type = ntohl(sb->index[i].type);
+				uint32_t offset = ntohl(sb->index[i].offset);
+				// Validate the offset.
+				if (offset > sb_length) {
+					return false;
+				}
+				// Look for a code directory.
+				if (type == CSSLOT_CODEDIRECTORY ||
+						(CSSLOT_ALTERNATE_CODEDIRECTORIES <= type && type < CSSLOT_ALTERNATE_CODEDIRECTORY_LIMIT)) {
+					CS_CodeDirectory *cd = (CS_CodeDirectory *)((uint8_t *)sb + offset);
+					size_t cd_size = cs_codedirectory_validate(cd, sb_length - offset);
+					if (cd_size == 0) {
+						return false;
+					}
+					// Rank the candidate by hand: SHA256 is preferred over SHA1, and
+					// anything outside the known table is unusable.
+					unsigned cd_rank = 0;
+					if (cd->hashType == CS_HASHTYPE_SHA1) {
+						cd_rank = 1;
+					} else if (cd->hashType == CS_HASHTYPE_SHA256_TRUNCATED) {
+						cd_rank = 2;
+					} else if (cd->hashType == CS_HASHTYPE_SHA256) {
+						cd_rank = 3;
+					} else if (cd->hashType == CS_HASHTYPE_SHA384) {
+						cd_rank = 4;
+					}
+					if (cd_rank > best_rank) {
+						best_rank = cd_rank;
+					}
+				}
+			}
+			if (best_rank == 0) {
+				ERROR("No usable code directory in signature");
+				return false;
+			}
+		}
+	}
 	// Check that the code signature data looks correct.
 	return csblob_cdhash((CS_GenericBlob *)cs_data, cs_end - cs_data, cdhash);
 }
