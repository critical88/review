+	void CopyEntitlementData(struct linkedit_data_command *signature, CFMutableDataRef output) const {
+		uint32_t data(Swap(signature->dataoff));
+
+		uint8_t *top = reinterpret_cast<uint8_t *>(GetBase());
+		uint8_t *blob = top + data;
+		struct SuperBlob *super = reinterpret_cast<struct SuperBlob *>(blob);
