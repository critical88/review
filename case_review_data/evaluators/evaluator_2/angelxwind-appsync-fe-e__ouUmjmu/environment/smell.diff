+					const CS_SuperBlob *sb = (const CS_SuperBlob *)cs_data;
+					if (ntohl(sb->magic) == CSMAGIC_EMBEDDED_SIGNATURE) {
+						// The same shape requirements the blob parsing applies: a length
+						// that lies about itself, or an index table we cannot walk, means
+						// there is no point in continuing.
+						if (ntohl(sb->length) > cs_datasize
+								|| ntohl(sb->length) < sizeof(*sb)
+								|| ntohl(sb->count) >= 0x10000
+								|| ntohl(sb->count) == 0) {
