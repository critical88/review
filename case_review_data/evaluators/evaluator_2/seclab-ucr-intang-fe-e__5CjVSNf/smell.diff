diff --git a/src/memcache.c b/src/memcache.c
index 8d3b7b7..1f15fe1 100644
--- a/src/memcache.c
+++ b/src/memcache.c
@@ -932,3 +932,108 @@ void load_historical_result_from_redis() {
     log_debug("%d records loaded.", count);
 }
 
+
+
+/****************************************/
+/* Per-connection activity ledger       */
+/****************************************/
+
+struct ledger_ht_node
+{
+    struct conn_ledger *node;
+    struct ledger_ht_node *next;
+};
+
+static struct conn_ledger* ledger_list = NULL;
+static unsigned int ledger_list_len = 0;
+static struct ledger_ht_node* ledger_hashtbl[HASH_TABLE_SIZE];
+
+
+// Create an empty ledger entry for the connection,
+// and insert it into the linked list and the hash table.
+static struct conn_ledger* create_ledger_entry(struct fourtuple *f)
+{
+    unsigned int hash = make_hash(f);
+
+    struct conn_ledger *lg = (struct conn_ledger*)malloc(sizeof(struct conn_ledger));
+    memset(lg, 0, sizeof(struct conn_ledger));
+    lg->fourtp = *f;
+    lg->ts = time(NULL);
+    lg->prev = NULL;
+    lg->next = ledger_list;
+    if (ledger_list) {
+        ledger_list->prev = lg;
+    }
+    ledger_list = lg;
+    ledger_list_len++;
+
+    struct ledger_ht_node *hn = (struct ledger_ht_node*)malloc(sizeof(struct ledger_ht_node));
+    hn->node = lg;
+    hn->next = ledger_hashtbl[hash % HASH_TABLE_SIZE];
+    ledger_hashtbl[hash % HASH_TABLE_SIZE] = hn;
+
+    return lg;
+}
+
+// Retrieve the ledger entry of a connection. NULL if it doesn't exist.
+struct conn_ledger *ledger_ref(struct fourtuple *f)
+{
+    struct ledger_ht_node *hn;
+    unsigned int hash = make_hash(f);
+    for (hn = ledger_hashtbl[hash % HASH_TABLE_SIZE];
+            hn != NULL && hn->node != NULL; hn = hn->next) {
+        struct conn_ledger *lg = hn->node;
+        if (lg->fourtp.saddr == f->saddr &&
+                lg->fourtp.sport == f->sport &&
+                lg->fourtp.daddr == f->daddr &&
+                lg->fourtp.dport == f->dport)
+            return lg;
+    }
+    return NULL;
+}
+
+// Retrieve the ledger entry of a connection,
+// create an empty one if it doesn't exist yet.
+struct conn_ledger *ledger_open(struct fourtuple *f)
+{
+    struct conn_ledger *lg = ledger_ref(f);
+    if (lg)
+        return lg;
+
+    if (ledger_list_len > MAX_CACHE_SIZE) {
+        printf("Warning! Per-connection activity ledger is full! Enlarge the cache.\n");
+        return NULL;
+    }
+
+    lg = create_ledger_entry(f);
+
+    // debug
+    //conn_ledger_cache_summary();
+
+    return lg;
+}
+
+// The strategy dispatched for the current cycle. -1 if unknown.
+int ledger_sid(struct conn_ledger *ledger)
+{
+    return ledger ? ledger->sid : -1;
+}
+
+// The evidence collected for the current cycle.
+unsigned short ledger_events(struct conn_ledger *ledger)
+{
+    return ledger ? ledger->events : 0;
+}
+
+// The server-side TTL estimate for the insertion packets of this cycle.
+unsigned char ledger_ttl_hint(struct conn_ledger *ledger)
+{
+    return ledger ? ledger->ttl_hint : 0;
+}
+
+// Display summary of the per-connection activity ledger
+void conn_ledger_cache_summary()
+{
+    printf("Ledger list size: %d\n", ledger_list_len);
+    printf("Ledger list max size: %d\n", MAX_CACHE_SIZE);
+}
diff --git a/src/memcache.h b/src/memcache.h
index 39d8c45..fc1f4a2 100644
--- a/src/memcache.h
+++ b/src/memcache.h
@@ -2,6 +2,10 @@
 #ifndef __MEMCACHE_H__
 #define __MEMCACHE_H__
 
+#include <time.h>
+
+#include "protocol.h"
+
 
 struct fourtuple;
 
@@ -32,11 +36,61 @@ int save_ttl_to_redis();
 void save_historical_result_to_redis();
 void load_historical_result_from_redis();
 
+
+/*
+ * Per-connection activity ledger.
+ *
+ * While the per-connection cache above only remembers which strategy was
+ * dispatched, the ledger records what has actually been observed for a
+ * connection during its current treatment cycle: the strategy that was
+ * dispatched, how often a strategy has been tried, which activity and
+ * censor-attack evidence was seen, which discrepancies were applied, and the
+ * TTL hint used by insertion packets. It is the connection-facing half of the
+ * cache TODO: over time we want to know, per connection and per host, which
+ * discrepancies are applicable and which treatments actually work.
+ *
+ * The ledger is keyed by the connection 4-tuple. The record and its rules
+ * belong to this module (the in-memory cache); other modules should consult
+ * it through the accessors below instead of reaching into the record.
+ */
+
+/* Event evidence bits for conn_ledger.events */
+#define LEDGER_EV_SEEN      (1 << 0)    /* flow observed */
+#define LEDGER_EV_REQ       (1 << 1)    /* outgoing request observed */
+#define LEDGER_EV_RESP      (1 << 2)    /* server response observed */
+#define LEDGER_EV_TYPE1RST  (1 << 3)    /* type-1 reset attack evidence */
+#define LEDGER_EV_TYPE2RST  (1 << 4)    /* type-2 reset attack evidence */
+#define LEDGER_EV_VERIFIED  (1 << 5)    /* cycle closed by an evaluation */
+#define LEDGER_EV_INJECTED  (1 << 6)    /* insertion packets were sent */
+
+struct conn_ledger
+{
+    struct fourtuple fourtp;                    /* connection identity, the ledger's key */
+    int sid;                                    /* strategy dispatched for this cycle */
+    unsigned char attempts;                      /* count of dispatched strategies */
+    unsigned char verdict;                       /* 0 unknown, 1 succeeded, 2 no response, 3 reset attack */
+    unsigned short events;                       /* LEDGER_EV_* evidence */
+    unsigned char discreps;                      /* INS_DISC_* discrepancies applied to this flow */
+    unsigned int last_mark;                      /* last sequence number / txn id / evidence value */
+    unsigned char ttl_hint;                      /* server-side TTL estimate for insertion packets */
+    time_t ts;
+    struct conn_ledger *prev;
+    struct conn_ledger *next;
+};
+
+struct conn_ledger *ledger_ref(struct fourtuple *f);
+struct conn_ledger *ledger_open(struct fourtuple *f);
+
+int ledger_sid(struct conn_ledger *ledger);
+unsigned short ledger_events(struct conn_ledger *ledger);
+unsigned char ledger_ttl_hint(struct conn_ledger *ledger);
+
 // debug
 void conn_info_cache_summary();
 void conn_info_cache_dump();
 void host_info_cache_summary();
 void host_info_cache_dump();
+void conn_ledger_cache_summary();
 
 #endif
 
