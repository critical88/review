diff --git a/src/memcache.c b/src/memcache.c
index 1f15fe1..2018bab 100644
--- a/src/memcache.c
+++ b/src/memcache.c
@@ -1031,6 +1031,53 @@ unsigned char ledger_ttl_hint(struct conn_ledger *ledger)
     return ledger ? ledger->ttl_hint : 0;
 }
 
+// Record a type-1 reset attack observed during the current cycle.
+void ledger_mark_type1rst(struct conn_ledger *ledger)
+{
+    if (!ledger) return;
+    ledger->events |= LEDGER_EV_TYPE1RST;
+}
+
+// Record a type-2 reset attack observed during the current cycle.
+// mark is the evidence value (e.g. the RST TTL) to remember alongside it.
+void ledger_mark_type2rst(struct conn_ledger *ledger, unsigned int mark)
+{
+    if (!ledger) return;
+    ledger->events |= LEDGER_EV_TYPE2RST;
+    ledger->last_mark = mark;
+}
+
+/*
+ * Close the current treatment cycle for a connection. Classify a verdict from
+ * the evidence collected over the cycle, adapt the insertion-packet TTL hint,
+ * mark the cycle verified, and summarize. The ledger owns these rules over its
+ * own record; callers that drive the evaluation (e.g. the cache timer) should
+ * invoke this instead of reaching into the fields directly.
+ */
+void ledger_close_cycle(struct conn_ledger *ledger)
+{
+    if (!ledger) return;
+
+    unsigned short ev = ledger->events;
+    if (ev & (LEDGER_EV_TYPE1RST | LEDGER_EV_TYPE2RST)) {
+        ledger->verdict = 3;
+        if (ledger->ttl_hint < 255)
+            ledger->ttl_hint++;
+    }
+    else if (ev & LEDGER_EV_RESP) {
+        ledger->verdict = 1;
+    }
+    else {
+        ledger->verdict = 2;
+        if (ledger->ttl_hint > 3)
+            ledger->ttl_hint--;
+    }
+    ledger->events |= LEDGER_EV_VERIFIED;
+    log_info("[LEDGER] Cycle closed. %u_%hu_%u_%hu verdict=%d events=%04x ttl_hint=%u.",
+            ledger->fourtp.saddr, ledger->fourtp.sport, ledger->fourtp.daddr, ledger->fourtp.dport,
+            ledger->verdict, ledger->events, ledger->ttl_hint);
+}
+
 // Display summary of the per-connection activity ledger
 void conn_ledger_cache_summary()
 {
diff --git a/src/memcache.h b/src/memcache.h
index fc1f4a2..422bb8e 100644
--- a/src/memcache.h
+++ b/src/memcache.h
@@ -85,6 +85,18 @@ int ledger_sid(struct conn_ledger *ledger);
 unsigned short ledger_events(struct conn_ledger *ledger);
 unsigned char ledger_ttl_hint(struct conn_ledger *ledger);
 
+/* Record censor reset-attack evidence observed during the current cycle. */
+void ledger_mark_type1rst(struct conn_ledger *ledger);
+void ledger_mark_type2rst(struct conn_ledger *ledger, unsigned int mark);
+
+/*
+ * Close the current treatment cycle: classify a verdict from the evidence
+ * collected, adapt the TTL hint accordingly, mark the cycle verified, and
+ * summarize the outcome. This is the ledger's own rule over its record, so it
+ * lives here rather than in the caller that drives the evaluation.
+ */
+void ledger_close_cycle(struct conn_ledger *ledger);
+
 // debug
 void conn_info_cache_summary();
 void conn_info_cache_dump();
