diff --git a/src/memcache.c b/src/memcache.c
index 1f15fe1..ee4f96b 100644
--- a/src/memcache.c
+++ b/src/memcache.c
@@ -1037,3 +1037,145 @@ void conn_ledger_cache_summary()
     printf("Ledger list size: %d\n", ledger_list_len);
     printf("Ledger list max size: %d\n", MAX_CACHE_SIZE);
 }
+
+
+/*
+ * The ledger's rules.
+ *
+ * These functions define how the activity ledger is maintained. Callers hand
+ * over the raw observation (strategy id, sequence number, attack evidence,
+ * confirmed TTL, discrepancy flags) and the ledger decides how it is recorded,
+ * classified and summarized.
+ */
+
+// A strategy has been dispatched to the connection: start a new cycle.
+void ledger_provision(struct conn_ledger *ledger, int sid, unsigned char host_ttl)
+{
+    if (!ledger)
+        return;
+    ledger->sid = sid;
+    ledger->attempts++;
+    ledger->ttl_hint = host_ttl;
+    ledger->events = LEDGER_EV_SEEN;
+    if (ledger->attempts >= 3) {
+        // this connection has already consumed several strategies.
+        log_info("[LEDGER] Strategy %d has been tried %d times for %u_%hu_%u_%hu.",
+                sid, ledger->attempts, ledger->fourtp.saddr, ledger->fourtp.sport,
+                ledger->fourtp.daddr, ledger->fourtp.dport);
+    }
+}
+
+// An outgoing request triggered the strategy of this cycle.
+void ledger_note_request(struct conn_ledger *ledger, unsigned int mark)
+{
+    if (!ledger)
+        return;
+    ledger->events |= LEDGER_EV_REQ;
+    ledger->last_mark = mark;
+}
+
+// A server response was seen during this cycle.
+void ledger_note_result(struct conn_ledger *ledger, unsigned int mark)
+{
+    if (!ledger)
+        return;
+    ledger->events |= LEDGER_EV_RESP;
+    ledger->last_mark = mark;
+}
+
+// The connection is alive. On the first response of the cycle, adopt the
+// server-side initial TTL as the hint for the insertion packets.
+void ledger_note_response(struct conn_ledger *ledger, unsigned char observed_ttl)
+{
+    if (!ledger)
+        return;
+    ledger->events |= LEDGER_EV_RESP;
+    if (ledger->ttl_hint == 0) {
+        ledger->ttl_hint = observed_ttl;
+    }
+}
+
+// Evidence that a type-1 reset attack hit this cycle.
+void ledger_note_reset_type1(struct conn_ledger *ledger)
+{
+    if (!ledger)
+        return;
+    ledger->events |= LEDGER_EV_TYPE1RST;
+}
+
+// Evidence that a type-2 (TTL-based) reset attack hit this cycle.
+void ledger_note_reset_type2(struct conn_ledger *ledger, unsigned char attack_ttl)
+{
+    if (!ledger)
+        return;
+    ledger->events |= LEDGER_EV_TYPE2RST;
+    ledger->last_mark = attack_ttl;
+}
+
+// Close the treatment cycle: classify it from the collected evidence,
+// adapt the TTL hint, and summarize.
+void ledger_close_cycle(struct conn_ledger *ledger)
+{
+    if (!ledger)
+        return;
+    unsigned short ev = ledger->events;
+    if (ev & (LEDGER_EV_TYPE1RST | LEDGER_EV_TYPE2RST)) {
+        ledger->verdict = 3;
+        if (ledger->ttl_hint < 255)
+            ledger->ttl_hint++;
+    }
+    else if (ev & LEDGER_EV_RESP) {
+        ledger->verdict = 1;
+    }
+    else {
+        ledger->verdict = 2;
+        if (ledger->ttl_hint > 3)
+            ledger->ttl_hint--;
+    }
+    ledger->events |= LEDGER_EV_VERIFIED;
+    log_info("[LEDGER] Cycle closed. %u_%hu_%u_%hu verdict=%d events=%04x ttl_hint=%u.",
+            ledger->fourtp.saddr, ledger->fourtp.sport, ledger->fourtp.daddr, ledger->fourtp.dport,
+            ledger->verdict, ledger->events, ledger->ttl_hint);
+}
+
+// The insertion packets sent to this connection applied these discrepancies.
+void ledger_note_discrepancy(struct conn_ledger *ledger, unsigned int flags)
+{
+    if (!ledger)
+        return;
+    ledger->events |= LEDGER_EV_INJECTED;
+    ledger->discreps |= (unsigned char)(flags & 0xFF);
+}
+
+// A probing response confirmed the server-side TTL of this connection.
+void ledger_refine_ttl_hint(struct conn_ledger *ledger, unsigned char ttl)
+{
+    if (!ledger)
+        return;
+    if (ledger->ttl_hint == 0 || ttl < ledger->ttl_hint) {
+        ledger->ttl_hint = ttl;
+    }
+}
+
+// A strategy fired a treatment on this connection by itself.
+void ledger_note_dispatch(struct conn_ledger *ledger, unsigned int mark)
+{
+    if (!ledger)
+        return;
+    ledger->events |= LEDGER_EV_INJECTED;
+    ledger->last_mark = mark;
+}
+
+// A strategy re-sent a treatment on a connection whose server response
+// has already been seen.
+void ledger_note_retransmission(struct conn_ledger *ledger, unsigned int mark)
+{
+    if (!ledger)
+        return;
+    if (ledger->events & LEDGER_EV_RESP) {
+        log_debug("[LEDGER] Junk data resent to %u_%hu after a response was seen.",
+                ledger->fourtp.saddr, ledger->fourtp.sport, ledger->fourtp.daddr, ledger->fourtp.dport);
+    }
+    ledger->events |= LEDGER_EV_INJECTED;
+    ledger->last_mark = mark;
+}
