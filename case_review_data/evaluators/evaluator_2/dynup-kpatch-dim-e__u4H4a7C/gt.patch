+/*
+ * Look for the patched object's static-local variable corresponding to
+ * sym, also checking the parent function's section for a .part. sibling
+ * that may have kept the reference when gcc numbers the mangled suffixes
+ * arbitrarily.
+ */
+static struct symbol *kpatch_find_static_twin(struct section *relasec,
+					       struct symbol *sym)
+{
+	struct section *relasec2 = relasec;
+	struct symbol *res = NULL;
+
+	if (!relasec2->twin && relasec2->base->sym) {
+		/*
+		 * The static twin might have been in a .part. symbol in the
+		 * original object that got removed in the patched object.
+		 */
+		struct symbol *parent = NULL;
+
+		parent = kpatch_get_correlated_parent(relasec2->base->sym);
+		if (parent)
+			relasec2 = parent->sec->rela;
+
+	}
+
+	if (relasec2->twin) {
+		res = kpatch_find_uncorrelated_rela(relasec2->twin, sym);
+		if (!res && relasec2->twin->base->sym)
+			/* reference may have moved to child functions' sections */
+			res = kpatch_find_static_twin_in_children(relasec2->twin->base->sym,
+								   sym);
+	}
+
+	return res;
+}
