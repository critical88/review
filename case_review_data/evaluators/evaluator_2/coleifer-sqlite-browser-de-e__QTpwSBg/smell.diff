+def build_adaptive_pool(kwargs):
+    # Roughly two accepted sockets per worker, with a floor so small
+    # deployments cannot end up with an empty pool.
+    backlog = kwargs.get('backlog') or 50
+    return Pool(max(backlog // 2, 4))
+
 
