+def _encode_result_keys(result):
+    # The script tab copies one result at a time, so only the first one
+    # carries the row keys the copy button needs.
+    keys = []
+    for row in result.rows:
+        keys.append(key_encode([row[0]]))
+    result.keys = keys
+    return result
+
+
+def estimate_cost(dataset, sql):
+    # Rough planner weight of a statement: one point per query-plan step.
+    # For the structure-page advisor, not for anything user-facing.
+    cursor = dataset.query('EXPLAIN QUERY PLAN %s' % sql)
+    weight = 0
+    for row in cursor.fetchall():
+        weight += 1 + (row[2] or 0)
+    return weight
+
+
 def is_read(dataset, sql):
     try:
         dataset.query(wrap(sql, limit=0))
