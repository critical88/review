+// reprobeEncodedSegments re-runs the keyword prefilter over the decoded text
+// of the current pass. This is only meaningful once the encoded segment
+// re-probe rollout is enabled, so that keywords which only surface after a
+// value has been decoded do not cause the prefilter to skip otherwise
+// matching fragments in the next pass.
+func (d *Detector) reprobeEncodedSegments(currentRaw string, encodedSegments []*codec.EncodedSegment, fragment Fragment) (string, []*codec.EncodedSegment) {
+	if len(encodedSegments) == 0 {
+		return currentRaw, encodedSegments
+	}
+
+	segments := codec.SegmentsWithDecodedOverlap(encodedSegments, 0, len(currentRaw))
+	if len(segments) == 0 {
+		return currentRaw, encodedSegments
+	}
+
+	line := codec.CurrentLine(segments, currentRaw)
+	normalizedLine := strings.ToLower(line)
+
+	for _, keyword := range segmentProbeKeywords(segments) {
+		if _, ok := d.Config.Keywords[keyword]; !ok {
+			continue
+		}
+		if strings.Contains(normalizedLine, keyword) {
+			// the probe surfaced a rule keyword, so the next pass needs to
+			// look at the whole fragment instead of only the decoded text
+			return fragment.Raw, segments
+		}
+	}
+
+	return currentRaw, segments
+}
+
+// segmentProbeKeywords lists the candidate keywords the re-probe pass checks
+// against the decoded segments of the current pass.
+func segmentProbeKeywords(segments []*codec.EncodedSegment) []string {
+	if len(segments) == 0 {
+		return nil
+	}
+
+	keywords := make([]string, 0)
+	for _, tag := range codec.Tags(segments) {
+		if trimmed, ok := strings.CutPrefix(tag, "decoded:"); ok {
+			keywords = append(keywords, trimmed)
+		}
+	}
+	return keywords
+}
