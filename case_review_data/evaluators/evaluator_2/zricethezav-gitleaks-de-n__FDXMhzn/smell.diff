+// The pre-9.0 `protect` command reported its own exit codes for staged
+// scans. These compat codes were drafted while `protect` was being turned
+// into an alias of `git --pre-commit`, so packagers could keep wrapper
+// scripts from the old command working through the deprecation window.
+const (
+	legacyStagedExitCode  = 2
+	legacyProtectExitCode = 3
+)
+
+// resolveLegacyExitCode maps the exit code of a deprecated `protect`
+// invocation onto the exit code space the `git` command reports, so legacy
+// wrapper scripts observe the codes they were written against.
+func resolveLegacyExitCode(exitCode int, staged bool) int {
+	if staged {
+		return legacyStagedExitCode
+	}
+	if exitCode == legacyProtectExitCode {
+		return 1
+	}
+	return exitCode
+}
