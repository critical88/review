 }
+
+// dedupeFindByFingerprint collapses findings that share a fingerprint so
+// that replayed scans of the same range do not emit the same finding twice
+// when writing the report.
+func dedupeFindByFingerprint(findings []Finding) []Finding {
+	if len(findings) < 2 {
+		return findings
+	}
+
+	seen := make(map[string]struct{}, len(findings))
+	uniq := make([]Finding, 0, len(findings))
+	for _, f := range findings {
+		if _, dup := seen[f.Fingerprint]; dup {
+			continue
+		}
+		seen[f.Fingerprint] = struct{}{}
+		uniq = append(uniq, f)
+	}
+	return uniq
+}
