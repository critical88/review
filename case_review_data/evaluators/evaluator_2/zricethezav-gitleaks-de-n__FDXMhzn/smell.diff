+// so junit reports could break auxiliary findings out instead of only
+// reporting them through the parent finding.
+func requiredFindingCases(f Finding) []TestCase {
+	cases := make([]TestCase, 0)
+	for _, aux := range f.requiredFindings {
+		cases = append(cases, TestCase{
+			Classname: f.Description,
+			Failure: Failure{
+				Data:    aux.Match,
+				Message: aux.RuleID,
+				Type:    f.RuleID,
+			},
+			File: aux.Line,
+			Name: aux.Secret,
+			Time: "",
+		})
+	}
+	return cases
+}
