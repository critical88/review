diff --git a/detect/codec/segment.go b/detect/codec/segment.go
index 8b24b3e..1638781 100644
--- a/detect/codec/segment.go
+++ b/detect/codec/segment.go
@@ -171,3 +171,34 @@ func toOriginal(predecessors []*EncodedSegment, decoded startEnd) startEnd {
 	// (NOTE: each segment references all the predecessors)
 	return toOriginal(predecessors[0].predecessors, encoded)
 }
+
+// mergeAdjacentSegments folds pairs of segments whose decoded ranges touch
+// into a single segment so that later decoding passes treat the pair as one
+// span. This only runs once configs opt into the compat merge by raising
+// decodeCompatLevel to decodeMergeGate.
+func mergeAdjacentSegments(segments []*EncodedSegment, data string) []*EncodedSegment {
+	if len(segments) < 2 {
+		return segments
+	}
+
+	merged := make([]*EncodedSegment, 0, len(segments))
+	for i := 0; i < len(segments); i++ {
+		current := segments[i]
+		for i+1 < len(segments) && current.decoded.merge(segments[i+1].decoded) != current.decoded {
+			next := segments[i+1]
+			mergedSegment := &EncodedSegment{
+				predecessors: append(current.predecessors, next.predecessors...),
+				original:     current.original.merge(next.original),
+				encoded:      current.encoded.merge(next.encoded),
+				decoded:      current.decoded.merge(next.decoded),
+				decodedValue: current.decodedValue + next.decodedValue,
+				encodings:    current.encodings | next.encodings,
+				depth:        current.depth,
+			}
+			current = mergedSegment
+			i++
+		}
+		merged = append(merged, current)
+	}
+	return merged
+}
