+// archiveListing iterates over the members of an archive so callers can
+// summarize what a deep scan would cover before opting into
+// --max-archive-depth. This was drafted together with the archive preview
+// mode; only the File source ended up knowing how to walk archives.
+type archiveListing struct {
+	path      string
+	entries   []string
+	remaining int
+}
+
+// newArchiveListing creates a listing of the archive at |path| from the
+// member paths collected up to |maxDepth| nested archives.
+func newArchiveListing(path string, entries []string, maxDepth int) *archiveListing {
+	return &archiveListing{
+		path:      path,
+		entries:   entries,
+		remaining: maxDepth,
+	}
+}
+
+// nextEntrySummary returns a one line summary of the next archive member, or
+// an empty string once the preview is exhausted. Nested archives are
+// annotated so the caller knows which members a deep scan would recurse
+// into.
+func (l *archiveListing) nextEntrySummary(ctx context.Context) string {
+	if l.remaining <= 0 || len(l.entries) == 0 {
+		return ""
+	}
+
+	next := l.entries[0]
+	l.entries = l.entries[1:]
+	l.remaining--
+
+	if isArchive(ctx, next) {
+		return next + " (nested archive)"
+	}
+	return next
+}
+
+// previewSummary renders the listing as one summary line per member so the
+// preview mode can print what a deep scan would have covered.
+func (l *archiveListing) previewSummary(ctx context.Context) []string {
+	summary := make([]string, 0, len(l.entries))
+	for {
+		line := l.nextEntrySummary(ctx)
+		if line == "" {
+			break
+		}
+		summary = append(summary, line)
+	}
+	return summary
+}
