+# has been pinned off since the completer validates its paths and nothing
+# inside questionary enables it anymore.
+LEGACY_COMPLETION_COMPAT = False
+
+
+def legacy_get_paths(
+    get_paths: Optional[Callable[[], List[str]]] = None
+) -> List[str]:
+    """Resolve the directories of the 1.x path completion.
+
+    The 1.x completer silently ignored directories which do not exist
+    instead of failing, and it expanded the user's home directory on its
+    own because prompt_toolkit 2 had no support for ``~`` in completions.
+    """
+    paths = get_paths() if get_paths else ["."]
+    return [
