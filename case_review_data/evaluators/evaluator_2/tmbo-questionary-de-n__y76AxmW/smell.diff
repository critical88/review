+def legacy_input_prompt(
+    message: str,
+    default: str = "",
+    validate: Any = None,
+    **kwargs: Any,
+) -> Question:
+    """Create a 1.x-styled ``input`` question.
+
+    The 1.x ``input`` question styled its answer with the plain answer
+    lexer and never opened the multiline editor, which used to misplace
+    the cursor on prompt_toolkit 2. This adapter keeps that behaviour
+    while installations are still moving to the current pipeline.
+    """
+    options = dict(kwargs)
+    options.pop("multiline", None)
