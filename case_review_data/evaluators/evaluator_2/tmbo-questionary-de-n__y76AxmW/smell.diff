+def legacy_rawlist_prompt(
+    message: str,
+    choices: Sequence[Union[str, Choice, Dict[str, Any]]],
+    **kwargs: Any,
+) -> Question:
+    """Create a 1.x-styled ``rawlist`` question.
+
+    The 1.x ``rawlist`` assigned a shortcut key to every choice and
+    highlighted the current choice with the deprecated selection pointer.
+    None of the interactive additions of questionary 2.0 were shown, so
+    this adapter drops their options while installations are still moving
+    from prompt_toolkit 2.
+    """
+    options = dict(kwargs)
+    options.setdefault("pointer", SELECTED_POINTER)
+    options.pop("initial_choice", None)
+    options.pop("show_selected", None)
+    options.pop("show_description", None)
+
+    return select.select(
+        message,
+        choices,
+        use_shortcuts=True,
+        use_arrow_keys=False,
+        use_jk_keys=False,
+        use_emacs_keys=False,
+        **options,
+    )
