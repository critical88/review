diff --git a/src/entry.c b/src/entry.c
index fc16eae..c40fb9c 100644
--- a/src/entry.c
+++ b/src/entry.c
@@ -28,6 +28,65 @@ static void rounded_rectangle(cairo_t *cr, uint32_t width, uint32_t height, uint
 	cairo_close_path(cr);
 }
 
+static const struct text_theme *window_default_theme(
+		const struct entry *entry,
+		struct text_theme *root_theme)
+{
+	/*
+	 * Themes with no explicit fallback of their own fall back to the
+	 * general window level values.
+	 */
+	*root_theme = (struct text_theme) {
+		.foreground_color = entry->foreground_color,
+		.background_color = (struct color) { .a = 0 },
+		.padding = (struct directional) {0},
+		.background_corner_radius = 0
+	};
+	return root_theme;
+}
+
+struct text_theme entry_resolve_theme(
+		const struct entry *entry,
+		const struct text_theme *theme,
+		const struct text_theme *fallback)
+{
+	struct text_theme root_theme;
+	if (fallback == NULL) {
+		fallback = window_default_theme(entry, &root_theme);
+	}
+
+	struct text_theme resolved = *theme;
+	if (!resolved.foreground_specified) {
+		resolved.foreground_color = fallback->foreground_color;
+	}
+	if (!resolved.background_specified) {
+		resolved.background_color = fallback->background_color;
+	}
+	if (!resolved.padding_specified) {
+		resolved.padding = fallback->padding;
+	}
+	if (!resolved.radius_specified) {
+		resolved.background_corner_radius = fallback->background_corner_radius;
+	}
+	return resolved;
+}
+
+struct cursor_theme entry_resolve_cursor_theme(const struct entry *entry)
+{
+	struct cursor_theme resolved = entry->cursor_theme;
+	if (!resolved.color_specified) {
+		struct text_theme input_theme = entry_resolve_theme(
+				entry,
+				&entry->input_theme,
+				NULL);
+		resolved.color = input_theme.foreground_color;
+	}
+	if (!resolved.text_color_specified) {
+		resolved.text_color = entry->background_color;
+	}
+	return resolved;
+}
+
 void entry_init(struct entry *entry, uint8_t *restrict buffer, uint32_t width, uint32_t height, uint32_t fractional_scale_numerator)
 {
 	double scale = fractional_scale_numerator / 120.;
