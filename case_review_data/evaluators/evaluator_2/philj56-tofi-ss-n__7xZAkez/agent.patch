diff --git a/test/theme.c b/test/theme.c
new file mode 100644
index 0000000..8dd8d93
--- /dev/null
+++ b/test/theme.c
@@ -0,0 +1,187 @@
+#include <locale.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include "entry.h"
+#include "theme.h"
+#include "tap.h"
+
+static void check(bool cond, const char *msg)
+{
+	if (cond) {
+		tap_ok("%s", msg);
+	} else {
+		tap_not_ok("%s", msg);
+	}
+}
+
+static bool color_eq(struct color a, struct color b)
+{
+	return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a;
+}
+
+static bool padding_eq(struct directional a, struct directional b)
+{
+	return a.top == b.top && a.right == b.right
+		&& a.bottom == b.bottom && a.left == b.left;
+}
+
+static bool text_theme_eq(struct text_theme a, struct text_theme b)
+{
+	return color_eq(a.foreground_color, b.foreground_color)
+		&& color_eq(a.background_color, b.background_color)
+		&& padding_eq(a.padding, b.padding)
+		&& a.background_corner_radius == b.background_corner_radius;
+}
+
+int main(void)
+{
+	setlocale(LC_ALL, "");
+	tap_version(14);
+
+	struct entry entry = {0};
+	entry.foreground_color = (struct color){1.0f, 1.0f, 1.0f, 1.0f};
+	entry.background_color = (struct color){0.1f, 0.1f, 0.1f, 1.0f};
+
+	/* The window-wide defaults an unset value should inherit. */
+	struct text_theme root = {
+		.foreground_color = entry.foreground_color,
+		.background_color = (struct color){.a = 0},
+		.padding = (struct directional){0},
+		.background_corner_radius = 0,
+	};
+
+	/*
+	 * An entirely-unspecified element theme inherits every field from
+	 * the window-wide defaults, and its "specified" flags stay unset.
+	 */
+	entry.prompt_theme = (struct text_theme){0};
+	struct text_theme prompt = theme_resolve_element(&entry, THEME_PROMPT);
+	check(text_theme_eq(prompt, root),
+			"Unspecified prompt inherits window-wide defaults");
+	check(prompt.foreground_specified == false,
+			"Resolver leaves unspecified foreground flag unset");
+
+	/* A fully-specified theme is passed through unchanged. */
+	entry.input_theme = (struct text_theme){
+		.foreground_color = {0.5f, 0.5f, 0.5f, 1.0f},
+		.background_color = {0.2f, 0.2f, 0.2f, 1.0f},
+		.padding = {1, 2, 3, 4},
+		.background_corner_radius = 7,
+		.foreground_specified = true,
+		.background_specified = true,
+		.padding_specified = true,
+		.radius_specified = true,
+	};
+	struct text_theme input = theme_resolve_element(&entry, THEME_INPUT);
+	check(text_theme_eq(input, entry.input_theme),
+			"Fully-specified input theme is preserved");
+
+	/*
+	 * A partially-specified theme keeps its specified values and
+	 * inherits the rest from the window-wide defaults.
+	 */
+	entry.placeholder_theme = (struct text_theme){0};
+	entry.placeholder_theme.foreground_color =
+		(struct color){0.9f, 0.9f, 0.9f, 0.5f};
+	entry.placeholder_theme.foreground_specified = true;
+	struct text_theme placeholder =
+		theme_resolve_element(&entry, THEME_PLACEHOLDER);
+	check(color_eq(placeholder.foreground_color,
+			entry.placeholder_theme.foreground_color),
+			"Placeholder keeps its specified foreground");
+	check(color_eq(placeholder.background_color, root.background_color),
+			"Placeholder background inherits transparent window default");
+	check(padding_eq(placeholder.padding, root.padding),
+			"Placeholder padding inherits zero window default");
+	check(placeholder.background_corner_radius == 0,
+			"Placeholder radius inherits zero window default");
+
+	/*
+	 * The odd-row subtlety: alternate result rows inherit from the
+	 * default-result theme first, then from the window-wide defaults.
+	 * Here the default result specifies only a background, so an
+	 * otherwise-unspecified alternate row picks up that background
+	 * rather than the window's transparent one, while its foreground
+	 * still falls through to the window text colour.
+	 */
+	entry.default_result_theme = (struct text_theme){0};
+	entry.default_result_theme.background_color =
+		(struct color){0.3f, 0.4f, 0.5f, 1.0f};
+	entry.default_result_theme.background_specified = true;
+	struct text_theme def =
+		theme_resolve_element(&entry, THEME_DEFAULT_RESULT);
+	check(color_eq(def.background_color,
+			entry.default_result_theme.background_color),
+			"Default result keeps its specified background");
+	check(color_eq(def.foreground_color, root.foreground_color),
+			"Default result foreground inherits window default");
+
+	entry.alternate_result_theme = (struct text_theme){0};
+	struct text_theme alternate =
+		theme_resolve_element(&entry, THEME_ALTERNATE_RESULT);
+	check(color_eq(alternate.background_color,
+			entry.default_result_theme.background_color),
+			"Alternate row inherits default-result background, not window default");
+	check(color_eq(alternate.foreground_color, root.foreground_color),
+			"Alternate row foreground falls through to window default");
+
+	/* A value the alternate row specifies itself is kept. */
+	entry.alternate_result_theme.foreground_color =
+		(struct color){0.8f, 0.6f, 0.4f, 1.0f};
+	entry.alternate_result_theme.foreground_specified = true;
+	struct text_theme alternate_spec =
+		theme_resolve_element(&entry, THEME_ALTERNATE_RESULT);
+	check(color_eq(alternate_spec.foreground_color,
+			entry.alternate_result_theme.foreground_color),
+			"Alternate row keeps its specified foreground");
+	check(color_eq(alternate_spec.background_color,
+			entry.default_result_theme.background_color),
+			"Alternate row still inherits default-result background");
+
+	/* An unspecified selection theme inherits the window-wide defaults. */
+	entry.selection_theme = (struct text_theme){0};
+	struct text_theme selection =
+		theme_resolve_element(&entry, THEME_SELECTION);
+	check(text_theme_eq(selection, root),
+			"Unspecified selection inherits window-wide defaults");
+
+	/*
+	 * Cursor subtleties.  With no input foreground specified, the
+	 * cursor colour falls back to the window text colour, and the
+	 * highlighted-text colour falls back to the window background.
+	 * Metrics and visibility pass through unchanged.
+	 */
+	entry.input_theme = (struct text_theme){0};
+	entry.cursor_theme = (struct cursor_theme){0};
+	entry.cursor_theme.show = true;
+	entry.cursor_theme.style = CURSOR_STYLE_BLOCK;
+	struct cursor_theme cur = theme_resolve_cursor(&entry);
+	check(color_eq(cur.color, entry.foreground_color),
+			"Cursor colour falls back to window foreground when input unspecified");
+	check(color_eq(cur.text_color, entry.background_color),
+			"Cursor text colour falls back to window background");
+	check(cur.show == true, "Cursor visibility passes through");
+	check(cur.style == CURSOR_STYLE_BLOCK, "Cursor style passes through");
+
+	/* Once the input specifies a foreground, the cursor uses that. */
+	entry.input_theme.foreground_color =
+		(struct color){0.7f, 0.7f, 0.7f, 1.0f};
+	entry.input_theme.foreground_specified = true;
+	struct cursor_theme cur_input = theme_resolve_cursor(&entry);
+	check(color_eq(cur_input.color, entry.input_theme.foreground_color),
+			"Cursor colour falls back to input foreground when specified");
+
+	/* An explicitly-specified cursor colour and text colour are kept. */
+	entry.cursor_theme.color = (struct color){0.1f, 0.2f, 0.3f, 1.0f};
+	entry.cursor_theme.color_specified = true;
+	entry.cursor_theme.text_color = (struct color){0.9f, 0.8f, 0.7f, 1.0f};
+	entry.cursor_theme.text_color_specified = true;
+	struct cursor_theme cur_spec = theme_resolve_cursor(&entry);
+	check(color_eq(cur_spec.color, entry.cursor_theme.color),
+			"Explicitly-specified cursor colour is preserved");
+	check(color_eq(cur_spec.text_color, entry.cursor_theme.text_color),
+			"Explicitly-specified cursor text colour is preserved");
+
+	tap_plan();
+	return EXIT_SUCCESS;
+}
