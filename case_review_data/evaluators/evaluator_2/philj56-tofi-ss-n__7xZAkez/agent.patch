new file mode 100644
index 0000000..e38c4f1
--- /dev/null
+++ b/src/theme.c
@@ -0,0 +1,94 @@
+#include "theme.h"
+
+/*
+ * The window-wide fallback theme: the entry's text colour for the
+ * foreground, a fully transparent background, and no padding or corner
+ * radius.  Anything an element leaves unset inherits from here (or, for
+ * alternate result rows, from the default-result theme resolved against
+ * this).
+ */
+static struct text_theme theme_root(const struct entry *entry)
+{
+	struct text_theme root = {
+		.foreground_color = entry->foreground_color,
+		.background_color = (struct color) { .a = 0 },
+		.padding = (struct directional) {0},
+		.background_corner_radius = 0,
+	};
+	return root;
+}
+
+/*
+ * Return a copy of `theme` in which any field the user left unset has been
+ * filled in from `fallback`.  This is the single decision for how an unset
+ * theme value inherits; every element routes through here.
+ */
+static struct text_theme theme_resolve(const struct text_theme *theme,
+                                       const struct text_theme *fallback)
+{
+	struct text_theme resolved = *theme;
+	if (!resolved.foreground_specified) {
+		resolved.foreground_color = fallback->foreground_color;
+	}
+	if (!resolved.background_specified) {
+		resolved.background_color = fallback->background_color;
+	}
+	if (!resolved.padding_specified) {
+		resolved.padding = fallback->padding;
+	}
+	if (!resolved.radius_specified) {
+		resolved.background_corner_radius = fallback->background_corner_radius;
+	}
+	return resolved;
+}
+
+struct text_theme theme_resolve_element(const struct entry *entry,
+                                        enum theme_element element)
+{
+	struct text_theme root = theme_root(entry);
+	switch (element) {
+	case THEME_PROMPT:
+		return theme_resolve(&entry->prompt_theme, &root);
+	case THEME_INPUT:
+		return theme_resolve(&entry->input_theme, &root);
+	case THEME_PLACEHOLDER:
+		return theme_resolve(&entry->placeholder_theme, &root);
+	case THEME_DEFAULT_RESULT:
+		return theme_resolve(&entry->default_result_theme, &root);
+	case THEME_ALTERNATE_RESULT: {
+		/*
+		 * Odd rows inherit from the default-result theme first, so
+		 * resolve that against the window defaults and use it as the
+		 * fallback for the alternate theme.
+		 */
+		struct text_theme default_result =
+			theme_resolve(&entry->default_result_theme, &root);
+		return theme_resolve(&entry->alternate_result_theme, &default_result);
+	}
+	case THEME_SELECTION:
+		return theme_resolve(&entry->selection_theme, &root);
+	}
+	/* Unreachable; keep the compiler happy without a default label. */
+	return root;
+}
+
+struct cursor_theme theme_resolve_cursor(const struct entry *entry)
+{
+	struct cursor_theme resolved = entry->cursor_theme;
+	if (!resolved.color_specified) {
+		/*
+		 * The cursor colour falls back to the input's foreground, or
+		 * the window text colour when the input hasn't specified one.
+		 */
+		if (entry->input_theme.foreground_specified) {
+			resolved.color = entry->input_theme.foreground_color;
+		} else {
+			resolved.color = entry->foreground_color;
+		}
+	}
+	if (!resolved.text_color_specified) {
+		/* Highlighted text falls back to the window background. */
+		resolved.text_color = entry->background_color;
+	}
+	return resolved;
+}
diff --git a/src/theme.h b/src/theme.h
new file mode 100644
index 0000000..878b911
--- /dev/null
+++ b/src/theme.h
@@ -0,0 +1,54 @@
+#ifndef THEME_H
+#define THEME_H
+
+#include "entry.h"
+
+/*
+ * The single owner of tofi's theme-inheritance policy.
+ *
+ * Each themable element -- the prompt, the input line, the placeholder, the
+ * result rows (with an alternate look for odd-indexed rows), the selected
+ * row and the cursor -- may leave any of its colour, background, padding and
+ * corner-radius unset.  These functions are the one place that decides what
+ * such an unset value inherits:
+ *
+ *   - foreground, background, padding and corner-radius fall back to the
+ *     window-wide defaults: the entry's text colour, a transparent
+ *     background, zero padding and no corner radius;
+ *   - odd (alternate) result rows additionally inherit from the
+ *     default-result theme before reaching the window-wide defaults;
+ *   - the cursor colour falls back to the input's foreground, or the
+ *     window text colour when that is unset, and the colour of the text
+ *     highlighted by a block cursor falls back to the window background.
+ *
+ * The drawing backends and the config loader consume these resolved values
+ * rather than re-deriving the fallbacks themselves, so the policy can be
+ * changed in one place.
+ */
+
+enum theme_element {
+	THEME_PROMPT,
+	THEME_INPUT,
+	THEME_PLACEHOLDER,
+	THEME_DEFAULT_RESULT,
+	THEME_ALTERNATE_RESULT,
+	THEME_SELECTION,
+};
+
+/*
+ * Resolve every field of the given element's theme, filling in anything the
+ * user left unset with the appropriate inherited value.  The returned theme
+ * is fully specified.
+ */
+struct text_theme theme_resolve_element(const struct entry *entry,
+                                        enum theme_element element);
+
+/*
+ * Resolve the cursor theme.  The cursor colour and the highlighted-text
+ * colour inherit as described above; the metric fields (style, thickness,
+ * em width, underline depth, corner radius and visibility) are passed
+ * through unchanged from the entry's configured cursor theme.
+ */
+struct cursor_theme theme_resolve_cursor(const struct entry *entry);
+
+#endif /* THEME_H */
