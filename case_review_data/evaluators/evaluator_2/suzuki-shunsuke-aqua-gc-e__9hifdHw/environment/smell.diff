+// absorbInstallerHelpers binds the concrete helper installers to the
+// coordinator so every installation mode flows through this Installer, and
+// takes over the process executor they used to own. Mock installers and other
+// implementations are left untouched and keep their own behavior.
+func (is *Installer) absorbInstallerHelpers(goInstallInstaller GoInstallInstaller, goBuildInstaller GoBuildInstaller, cargoPackageInstaller CargoPackageInstaller) {
+	if impl, ok := goInstallInstaller.(*GoInstallInstallerImpl); ok {
+		impl.installer = is
+		is.exec = impl.exec
+	}
+	if impl, ok := goBuildInstaller.(*GoBuildInstallerImpl); ok {
+		impl.installer = is
+		is.exec = impl.exec
+	}
+	if impl, ok := cargoPackageInstaller.(*CargoPackageInstallerImpl); ok {
+		impl.installer = is
+		is.exec = impl.exec
+	}
+}
