--- a/analyze/analyses/monos/emit.rs
+++ b/analyze/analyses/monos/emit.rs
@@ -12,6 +12,77 @@ use twiggy_traits as traits;
 use super::entry::MonosEntry;
 use super::Monos;
 
+/// A CSV record describing one monomorphization entry.
+#[cfg(feature = "emit_csv")]
+#[derive(Debug, Default, Serialize)]
+#[serde(rename_all = "PascalCase")]
+struct Record {
+    generic: Option<String>,
+    approximate_monomorphization_bloat_bytes: Option<u32>,
+    approximate_monomorphization_bloat_percent: Option<f64>,
+    total_size: Option<u32>,
+    total_size_percent: Option<f64>,
+    monomorphizations: Option<String>,
+}
+
+impl Monos {
+    /// Add the fields describing `entry` and its instantiations to the given
+    /// JSON object. `total_size` is the size of the whole binary.
+    #[cfg(feature = "emit_json")]
+    fn process_json_entry(
+        &self,
+        entry: &MonosEntry,
+        obj: &mut json::Object,
+        total_size: f64,
+    ) -> anyhow::Result<()> {
+        let get_size_percent = |size: u32| (f64::from(size)) / total_size * 100.0;
+
+        obj.field("generic", entry.name.as_str())?;
+        obj.field("approximate_monomorphization_bloat_bytes", entry.bloat)?;
+        obj.field(
+            "approximate_monomorphization_bloat_percent",
+            get_size_percent(entry.bloat),
+        )?;
+        obj.field("total_size", entry.size)?;
+        obj.field("total_size_percent", get_size_percent(entry.size))?;
+
+        let mut monos = obj.array("monomorphizations")?;
+        for (name, size, size_percent) in entry
+            .insts
+            .iter()
+            .map(|(name, size)| (name, size, get_size_percent(*size)))
+        {
+            let mut obj = monos.object()?;
+            obj.field("name", name.as_str())?;
+            obj.field("shallow_size", *size)?;
+            obj.field("shallow_size_percent", size_percent)?;
+        }
+        Ok(())
+    }
+
+    /// Build the CSV record describing `entry`. `total_size` is the size of
+    /// the whole binary.
+    #[cfg(feature = "emit_csv")]
+    fn process_csv_entry(&self, entry: &MonosEntry, total_size: f64) -> Record {
+        // Calculate a percent value for a given u32 size.
+        let get_size_percent = |size: u32| (f64::from(size)) / total_size * 100.0;
+
+        let monos = entry
+            .insts
+            .iter()
+            .map(|(name, _)| name.as_str())
+            .collect::<Vec<_>>();
+        Record {
+            generic: Some(entry.name.clone()),
+            approximate_monomorphization_bloat_bytes: Some(entry.bloat),
+            approximate_monomorphization_bloat_percent: Some(get_size_percent(entry.bloat)),
+            total_size: Some(entry.size),
+            total_size_percent: Some(get_size_percent(entry.size)),
+            monomorphizations: Some(monos.join(", ")),
+        }
+    }
+}
