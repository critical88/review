+impl DominatorTree {
+    /// Add the rows for the item `id` and its children in the dominator tree
+    /// to the given table, up to the configured depth and row limits.
+    #[cfg(feature = "emit_text")]
+    fn recursive_add_rows(
+        &self,
+        table: &mut Table,
+        items: &ir::Items,
+        dominator_tree: &BTreeMap<ir::Id, Vec<ir::Id>>,
+        depth: u32,
+        mut row: &mut u32,
+        opts: &opt::Dominators,
+        id: ir::Id,
+    ) {
+        assert_eq!(id == items.meta_root(), depth == 0);
+
+        if *row > opts.max_rows() || depth > opts.max_depth() {
+            return;
+        }
+
+        if depth > 0 {
+            self.add_text_item(items, depth, id, table);
+        }
+
+        if let Some(children) = dominator_tree.get(&id) {
+            let mut children = children.to_vec();
+            children.sort_by(|a, b| items.retained_size(*b).cmp(&items.retained_size(*a)));
+            for child in children {
+                *row += 1;
+                self.recursive_add_rows(
+                    table,
+                    items,
+                    dominator_tree,
+                    depth + 1,
+                    &mut row,
+                    &opts,
+                    child,
+                );
+            }
+        }
+    }
+
+    /// Add a table row for the item `id` at the given depth.
+    #[cfg(feature = "emit_text")]
+    fn add_text_item(&self, items: &ir::Items, depth: u32, id: ir::Id, table: &mut Table) {
+        let size = items.retained_size(id);
+        let size_percent =
+            (f64::from(items.retained_size(id))) / (f64::from(items.size())) * 100.0;
+
+        let mut label = String::with_capacity(
+            depth as usize * 4 + items[id].name().len() + "⤷ ".len(),
+        );
+        for _ in 2..depth {
+            label.push_str("    ");
+        }
+        if depth != 1 {
+            label.push_str("  ⤷ ");
+        }
+        label.push_str(items[id].name());
+
+        table.add_row(vec![size.to_string(), format!("{:.2}%", size_percent), label]);
+    }
+
+    /// Recursively add the JSON object for the item `id` and its children.
+    #[cfg(feature = "emit_json")]
+    fn recursive_add_children(
+        &self,
+        items: &ir::Items,
+        opts: &opt::Dominators,
+        dominator_tree: &BTreeMap<ir::Id, Vec<ir::Id>>,
+        id: ir::Id,
+        obj: &mut json::Object,
+    ) -> anyhow::Result<()> {
+        self.add_json_item(items, id, obj)?;
+
+        if let Some(children) = dominator_tree.get(&id) {
+            let mut children = children.to_vec();
+            children.sort_by(|a, b| items.retained_size(*b).cmp(&items.retained_size(*a)));
+
+            let mut arr = obj.array("children")?;
+            for child in children {
+                let mut obj = arr.object()?;
+                self.recursive_add_children(items, opts, dominator_tree, child, &mut obj)?;
+            }
+        }
+
+        Ok(())
+    }
+
+    /// Add the fields describing the item `id` to the given JSON object.
+    #[cfg(feature = "emit_json")]
+    fn add_json_item(&self, items: &ir::Items, id: ir::Id, obj: &mut json::Object) -> anyhow::Result<()> {
+        obj.field("name", items[id].name())?;
+
+        let shallow_size = items[id].size();
+        let shallow_size_percent = f64::from(shallow_size) / f64::from(items.size()) * 100.0;
+        obj.field("shallow_size", shallow_size)?;
+        obj.field("shallow_size_percent", shallow_size_percent)?;
+
+        let retained_size_percent =
+            f64::from(items.retained_size(id)) / f64::from(items.size()) * 100.0;
+        obj.field("retained_size", items.retained_size(id))?;
+        obj.field("retained_size_percent", retained_size_percent)?;
+        Ok(())
+    }
+
+    /// Recursively serialize the CSV record for the item `id` and its
+    /// children.
+    #[cfg(feature = "emit_csv")]
+    fn recursive_add_csv_children(
+        &self,
+        items: &ir::Items,
+        opts: &opt::Dominators,
+        dominator_tree: &BTreeMap<ir::Id, Vec<ir::Id>>,
+        id: ir::Id,
+        wtr: &mut csv::Writer<&mut dyn io::Write>,
+    ) -> anyhow::Result<()> {
+        self.add_csv_item(items, id, wtr)?;
+        if let Some(children) = dominator_tree.get(&id) {
+            let mut children = children.to_vec();
+            children.sort_by(|a, b| items.retained_size(*b).cmp(&items.retained_size(*a)));
+            for child in children {
+                self.recursive_add_csv_children(items, opts, dominator_tree, child, wtr)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// Serialize the CSV record describing the item `id`.
+    #[cfg(feature = "emit_csv")]
+    fn add_csv_item(
+        &self,
+        items: &ir::Items,
+        id: ir::Id,
+        wtr: &mut csv::Writer<&mut dyn io::Write>,
+    ) -> anyhow::Result<()> {
+        let (shallow_size, shallow_size_percent) = (
+            items[id].size(),
+            f64::from(items[id].size()) / f64::from(items.size()) * 100.0,
+        );
+        let (retained_size, retained_size_percent) = (
+            items.retained_size(id),
+            f64::from(items.retained_size(id)) / f64::from(items.size()) * 100.0,
+        );
+        let idom = if let Some(idom) = items.immediate_dominators().get(&id) {
+            idom.serializable()
+        } else {
+            id.serializable()
+        };
+
+        let rc = CsvRecord {
+            id: Some(items[id].id().serializable()),
+            name: items[id].name().to_string(),
+            shallow_size,
+            shallow_size_percent,
+            retained_size,
+            retained_size_percent,
+            immediate_dominator: Some(idom),
+        };
+
+        wtr.serialize(rc)?;
+        wtr.flush()?;
+        Ok(())
+    }
+}
