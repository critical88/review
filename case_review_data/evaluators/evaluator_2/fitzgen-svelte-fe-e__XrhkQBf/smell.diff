+impl Paths {
+    /// This is used to collect the `ir::Id` values for the top-most path
+    /// entries, based on the given options.
+    fn starting_positions(
+        &self,
+        items: &ir::Items,
+        opts: &opt::Paths,
+    ) -> anyhow::Result<Vec<ir::Id>> {
+        // If arguments were given, search for matches depending on whether or
+        // not these should be treated as regular expressions. Otherwise,
+        // collect the starting positions based on the direction we will be
+        // traversing.
+        let functions = opts.functions();
+        let args_given = !functions.is_empty();
+
+        let res: Vec<ir::Id> = if args_given {
+            if opts.using_regexps() {
+                // Collect Id's for the arguments that were given, treating
+                // them as regular expressions.
+                let regexps = regex::RegexSet::new(functions)?;
+                let mut matches = Vec::new();
+                for item in items.iter() {
+                    if regexps.is_match(item.name()) {
+                        matches.push(item.id());
+                    }
+                }
+                matches
+            } else {
+                // Collect Id's for the arguments that were given, treating
+                // them as exact names.
+                let mut matches = Vec::new();
+                for s in functions {
+                    if let Some(item) = items.get_item_by_name(s) {
+                        matches.push(item.id());
+                    }
+                }
+                matches
+            }
+        } else if opts.descending() {
+            // Collect Id's if no arguments are given and we are descending
+            // the retaining paths: start from the meta root's neighbors,
+            // largest first.
+            let mut roots: Vec<ir::Id> = items.neighbors(items.meta_root()).collect();
+            roots.sort_by(|a, b| items[*b].size().cmp(&items[*a].size()));
+            roots
+        } else {
+            // Collect Id's if no arguments are given and we are ascending
+            // the retaining paths: start from every item but the meta root,
+            // largest first.
+            let mut sorted_items: Vec<ir::Id> = Vec::new();
+            for item in items.iter() {
+                if item.id() != items.meta_root() {
+                    sorted_items.push(item.id());
+                }
+            }
+            sorted_items.sort_by(|a, b| items[*b].size().cmp(&items[*a].size()));
+            sorted_items
+        };
+
+        Ok(res)
+    }
