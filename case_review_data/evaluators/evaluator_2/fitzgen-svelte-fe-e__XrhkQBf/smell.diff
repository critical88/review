+/// The measurement of one ranked item, shared by the text, JSON, and CSV
+/// emitters: the item's own sizes and shares of the whole binary, and its
+/// name.
+struct ItemMeasurement {
+    /// The item's own (shallow) size.
+    shallow_size: u32,
+    /// The shallow size as a percentage of the whole binary.
+    shallow_size_share: f64,
+    /// The item's retained size, when retained sizes were requested.
+    retained_size: Option<u32>,
+    /// The retained size as a percentage of the whole binary, when retained
+    /// sizes were requested.
+    retained_size_share: Option<f64>,
+    /// The name of the item.
+    name: String,
+}
+
+impl Top {
+    /// Measure one ranked item against the whole binary. The `retained`
+    /// parameter must only be `true` when retained sizes have been computed.
+    fn item_measurement(
+        &self,
+        items: &ir::Items,
+        id: ir::Id,
+        retained: bool,
+    ) -> ItemMeasurement {
+        let shallow_size = items[id].size();
+        let shallow_size_share = (f64::from(shallow_size)) / (f64::from(items.size())) * 100.0;
+
+        // Retained sizes are only available when they were computed up front,
+        // so the retained columns are only measured on request.
+        let (retained_size, retained_size_share) = if retained {
+            let retained_size = items.retained_size(id);
+            let retained_size_share =
+                (f64::from(retained_size)) / (f64::from(items.size())) * 100.0;
+            (Some(retained_size), Some(retained_size_share))
+        } else {
+            (None, None)
+        };
+
+        ItemMeasurement {
+            shallow_size,
+            shallow_size_share,
+            retained_size,
+            retained_size_share,
+            name: items[id].name().to_string(),
+        }
+    }
+}
