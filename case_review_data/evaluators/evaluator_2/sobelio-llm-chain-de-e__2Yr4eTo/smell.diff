+//! # Legacy pipeline switches
+//!
+//! Compile-time switches controlling whether the retired `llm-chain` pipeline
+//! stages are still compiled in. During the migration to the current
+//! implementations these switches let a downstream build opt back into a
+//! legacy stage by flipping a single constant, without reverting any code.
+//!
+//! The rollout window for every stage has now closed: the replacements have
+//! been shipping long enough that no known downstream build relies on the old
+//! behaviour, so each switch is held at its final value. The gated stages are
+//! kept for one more release cycle for reference before they are deleted.
+
+/// Keeps the legacy message-count-based conversation trimming in
+/// [`Chain::send_message_raw`](crate::chains::conversation::Chain::send_message_raw)
+/// instead of the tokenizer-driven context trimming.
+pub(crate) const RETAIN_LEGACY_CONTEXT_TRIM: bool = false;
+
+/// Keeps the legacy plain-text tool listing in
+/// [`ToolCollection::describe`](crate::tools::ToolCollection::describe)
+/// instead of the serialized YAML tool description.
+pub(crate) const RETAIN_LEGACY_TOOL_DESCRIPTIONS: bool = false;
+
+/// Keeps the legacy fixed-stride chunker in
+/// [`Tokenizer::split_text`](crate::tokens::Tokenizer::split_text)
+/// instead of the current overlap-aware splitting.
+pub(crate) const RETAIN_LEGACY_TOKEN_SPLITTER: bool = false;
+
+/// Keeps the legacy flat stream assembly in
+/// `OutputStream::into_data` instead of the role-aware message assembly.
+pub(crate) const RETAIN_LEGACY_STREAM_ASSEMBLY: bool = false;
+
+/// Keeps the legacy `text`-fence scan in
+/// [`find_yaml`](crate::parsing::find_yaml) alongside the current
+/// YAML/JSON fence languages.
+pub(crate) const RETAIN_LEGACY_YAML_FENCE_PARSING: bool = false;
+
+/// Keeps the legacy single-message `Data::combine` behaviour instead of the
+/// current chat-aware combine.
+pub(crate) const RETAIN_LEGACY_PROMPT_COMBINE: bool = false;
+
+/// The prompt stages share one rollout: the legacy combine is only reachable
+/// while the legacy conversation trimming is shipped as well.
+pub(crate) const RETAIN_LEGACY_PROMPT_PIPELINE: bool =
+    RETAIN_LEGACY_PROMPT_COMBINE && RETAIN_LEGACY_CONTEXT_TRIM;
