+fn legacy_tool_description_text(description: ToolDescription) -> String {
+    let mut out = String::new();
+    out.push_str(&format!("## {}\n", description.name));
+    out.push_str(&format!("{}\n", description.description));
+    if !description.description_context.is_empty() {
+        out.push_str(&format!("Context: {}\n", description.description_context));
+    }
+    out.push_str("Input:\n");
