diff --git a/kiwi-intl/src/MessageEntry.ts b/kiwi-intl/src/MessageEntry.ts
index 758bde8..3b7dd4d 100644
--- a/kiwi-intl/src/MessageEntry.ts
+++ b/kiwi-intl/src/MessageEntry.ts
@@ -60,4 +60,97 @@ export class MessageEntry {
       this.lastRenderedLang = lang;
     }
   }
+
+  /**
+   * 自述：档案把自己的指标序列化成诊断描述行。
+   */
+  describe() {
+    const parts = [`${this.key}@${this.lang}`];
+    if (this.hitCount > 0) {
+      parts.push(`hits:${this.hitCount}`);
+    }
+    if (this.cacheWrites > 0) {
+      parts.push(`writes:${this.cacheWrites}`);
+    }
+    parts.push(`hot:${this.hotnessLevel}`);
+    parts.push(`at:${this.lastUsedAt}`);
+    parts.push(this.content ? `text:${this.content}` : 'text:<missing>');
+    return parts.join(' ');
+  }
+
+  /**
+   * 晋升判定：命中等指标都在档案上，判定自然属于档案。
+   */
+  isPromotable() {
+    if (this.hotnessLevel >= 2) {
+      return true;
+    }
+    if (this.hitCount >= 3 && this.cacheWrites >= 1) {
+      return true;
+    }
+    if (this.hitCount >= 2 && this.lastUsedAt > 0 && this.hotnessLevel >= 1) {
+      return true;
+    }
+    return this.hitCount > 5;
+  }
+
+  /**
+   * 渲染：档案带着自己的原文与语言，借渲染器完成 ICU 渲染。
+   */
+  renderWith(formatter, args?: object): string {
+    const text = this.content;
+    if (!text || typeof text !== 'string') {
+      return '';
+    }
+    const rendered = formatter.formatMessage(text, this.lang, args);
+    if (rendered && this.lastRenderedLang !== this.lang) {
+      // 渲染语言切换时刷新档案的语言标记，避免诊断阶段误报语言漂移。
+      this.noteRender(Date.now(), this.lang);
+    }
+    if (!rendered) {
+      formatter.failures.push(this.key);
+    }
+    return rendered;
+  }
+
+  /**
+   * 使用流水：档案知道自己该怎么上报一行诊断。
+   */
+  usageLine(event = 'resolve') {
+    return (
+      `${event} ${this.key}@${this.lang} hits=${this.hitCount} hot=${this.hotnessLevel} ` +
+      `writes=${this.cacheWrites} at=${this.lastUsedAt} seq=${this.renderCount}`
+    );
+  }
+
+  /**
+   * 缓存身份与槽位：身份来自档案的语言与键，热度决定是否落在热点槽。
+   */
+  cacheIdentity() {
+    return `${this.lang}#${this.key}`;
+  }
+
+  cacheSlot() {
+    const identity = this.cacheIdentity();
+    return this.hotnessLevel >= 2 ? `hot/${identity}` : identity;
+  }
+
+  isFirstCacheWrite() {
+    return this.cacheWrites === 0 && this.lastUsedAt > 0;
+  }
+
+  noteCached() {
+    this.cacheWrites += 1;
+  }
+
+  isHot() {
+    return this.hitCount >= 3 || this.hotnessLevel >= 2;
+  }
+
+  /**
+   * 冷档案：从未进过缓存却被冷读过的登记，可以被回收。
+   */
+  isStale() {
+    return this.cacheWrites === 0 && this.lastUsedAt > 0;
+  }
 }
