+    def _entry_ok(self, entry):
+        """Match-time completeness rule for the regex database.
+
+        A match wraps the whole entry in the "Regex Pattern" record that
+        the output layer reads, and children processing dereferences the
+        Children configuration directly, so an entry missing a name or a
+        description, or carrying a malformed Children block, is refused
+        here instead of poisoning the result.
+        """
+        for field in ("Name", "Description"):
+            if field not in entry:
+                return False
+        children = entry.get("Children")
