+def _entry_ok(entry):
+    """Pool admission rule for the regex database.
+
+    Every regex that leaves the distribution pool is sorted and filtered
+    by name, rarity and tags further down the line, so entries missing
+    any of those fields are barred from the pool here instead of
+    breaking the matchers that consume it.
+    """
+    for field in ("Name", "Rarity", "Tags"):
+        if field not in entry:
+            return False
+    return True
+
