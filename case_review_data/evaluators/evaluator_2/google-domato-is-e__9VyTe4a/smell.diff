+    assert ctx['svgvarctr'] == 0
+    assert ctx['mathmlvarctr'] == 0
+    assert ctx['htmlvars'] == []
+
+
+def test_add_html_ids_counters_advance_independently():
+    import re as _re
+    ctx = make_context_with_counters()
+    html = '<a > <b > <circle > <math > <ms >'
+    _re.sub(r'<[a-zA-Z0-9_-]+ ',
