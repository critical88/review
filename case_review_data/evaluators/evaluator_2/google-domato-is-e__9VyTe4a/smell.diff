+def mini_html_grammar():
+    grammar = Grammar()
+    text = ('<bodyelements> = <simpleelement>\n'
+            '<simpleelement> = <htmlvarshape>\n'
+            '<htmlvarshape> = <lt>div <gt>hello<lt>/div<gt>\n')
+    grammar.parse_from_string(text)
+    return grammar
