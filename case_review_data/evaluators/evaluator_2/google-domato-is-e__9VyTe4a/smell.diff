+    assert ctx['svgvarctr'] == 1
+    assert ctx['htmlvars'][0]['type'] == 'SVGCircleElement'
+
+
+def test_add_html_ids_for_mathml_tag():
+    import re as _re
+    ctx = make_context_with_counters()
+    out = _re.sub(r'<[a-zA-Z0-9_-]+ ',
+                  lambda m: generator.add_html_ids(m, ctx),
+                  '<ms > ')
