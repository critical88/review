+        assert required in _HTML_TYPES
+
+
+def test_html_keys_and_values_are_wellformed():
+    for tag, type_name in _HTML_TYPES.items():
+        assert isinstance(tag, str) and tag
+        assert isinstance(type_name, str) and type_name
