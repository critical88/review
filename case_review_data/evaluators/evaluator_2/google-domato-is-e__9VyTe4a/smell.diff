+
+def mini_js_grammar():
+    grammar = Grammar()
+    text = ('!begin lines\n'
+            'doWork(<jsobj>);\n'
+            '!end lines\n'
+            '<jsobj> = 7\n'
+            '<root root=true> = <lines count=3>\n')
+    grammar.parse_from_string(text)
+    return grammar
