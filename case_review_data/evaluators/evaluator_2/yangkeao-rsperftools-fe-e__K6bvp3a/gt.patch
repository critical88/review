+/// Strip the profiler's own frames from a resolved backtrace.
+///
+/// A sample is captured from within `perf_signal_handler`, so the resolved
+/// backtrace begins with that frame and the trampoline immediately following
+/// it. Both are artifacts of the sampling mechanism rather than frames from
+/// the profiled program, so they are dropped before a report is built. This
+/// knowledge belongs to the profiler, which defines and registers the signal
+/// handler, so the live frames are passed here rather than reconstructed in
+/// the report layer.
+pub(crate) fn scrub_signal_handler_frames(frames: &mut Vec<Vec<Symbol>>) {
+    let mut index = 0;
+    while index < frames.len() {
+        let is_signal_handler = frames[index].iter().any(|symbol| {
+            // macOS prepends an underscore even with `#[no_mangle]`
+            matches!(
+                &*symbol.name(),
+                "perf_signal_handler" | "_perf_signal_handler"
+            )
+        });
+
+        if is_signal_handler {
+            // Drop this frame together with the one immediately following it.
+            let end = (index + 2).min(frames.len());
+            frames.drain(index..end);
+        } else {
+            index += 1;
+        }
+    }
+}
+
