+
+        assert!(frames.is_empty());
+    }
+
+    #[test]
+    fn scrub_handles_handler_in_the_middle() {
+        let mut frames = vec![
+            group(&["a"]),
+            group(&["perf_signal_handler"]),
+            group(&["__restore_rt"]),
+            group(&["b"]),
+        ];
+        scrub_signal_handler_frames(&mut frames);
+
+        assert_eq!(frames.len(), 2);
+        assert_eq!(&frames[0][0].name(), "a");
+        assert_eq!(&frames[1][0].name(), "b");
+    }
+
+    #[test]
+    fn scrub_pairs_handler_with_next_even_when_resolved_empty() {
+        // The frame following the signal handler may resolve to no symbols; it
+        // must still be dropped as the "next" raw frame, preserving the
+        // original raw-frame pairing rather than shifting onto a later frame.
+        let mut frames = vec![
+            group(&["perf_signal_handler"]),
+            group(&[]),
+            group(&["worker"]),
+        ];
+        scrub_signal_handler_frames(&mut frames);
+
+        assert_eq!(frames.len(), 1);
+        assert_eq!(&frames[0][0].name(), "worker");
+    }
+
+    #[test]
+    fn scrub_recognizes_macos_underscore_name() {
+        let mut frames = vec![
+            group(&["_perf_signal_handler"]),
+            group(&["__restore_rt"]),
+            group(&["worker"]),
+        ];
+        scrub_signal_handler_frames(&mut frames);
+
+        assert_eq!(frames.len(), 1);
+        assert_eq!(&frames[0][0].name(), "worker");
+    }
+
+    #[test]
+    fn scrub_leaves_unrelated_frames_untouched() {
+        let mut frames = vec![group(&["a"]), group(&["b"]), group(&["c"])];
+        scrub_signal_handler_frames(&mut frames);
+
+        assert_eq!(frames.len(), 3);
+    }
 }
