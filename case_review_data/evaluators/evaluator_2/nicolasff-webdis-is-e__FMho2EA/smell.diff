 #include <pthread.h>
@@ -145,3 +147,27 @@ integer_length(long long int i) {
 
 	return sz;
 }
+
+/* Shared WebSocket error renderer, used by the output formats that do not
+ * define their own error encoding (e.g. msgpack or custom types). The
+ * message is plain text so that any client can read it. */
+char *
+format_default_ws_error(int http_status, const char *msg,
+		size_t msg_sz, size_t *out_sz) {
+
+	/* e.g. "error 403: Forbidden" */
+	int code_len = integer_length(http_status);
+	size_t prefix_sz = 6 + code_len + 2;
+	char *ret = malloc(prefix_sz + msg_sz);
+
+	if(!ret) {
+		*out_sz = 0;
+		return NULL;
+	}
+
+	snprintf(ret, prefix_sz + 1, "error %d: ", http_status);
+	memcpy(ret + prefix_sz, msg, msg_sz);
+
+	*out_sz = prefix_sz + msg_sz;
+	return ret;
+}
