 #include "http.h"
 
 #include <string.h>
@@ -116,3 +117,46 @@ custom_array(struct cmd *cmd, const redisReply *r, size_t *sz) {
 
 	return ret;
 }
+
+/* custom types are only served over HTTP, through extensions such as
+ * .txt or .png: the WebSocket slots are kept for the format provider to
+ * be complete but are never used in practice. */
+static struct cmd *
+custom_type_ws_extract(struct http_client *c, const char *p, size_t sz) {
+
+	(void)c; /* client */
+	(void)p; /* payload */
+	(void)sz; /* payload size */
+
+	return NULL;
+}
+
+/* render a WebSocket error with the shared implementation; custom types
+ * have no error encoding of their own. */
+static char *
+custom_type_ws_error(int http_status, const char *msg, size_t msg_sz, size_t *out_sz) {
+
+	return format_default_ws_error(http_status, msg, msg_sz, out_sz);
+}
+
+/* apply the client-supplied output wrapper; a custom type body cannot
+ * be wrapped, so it is handed back unchanged. */
+static char *
+custom_type_wrap_body(char *body, const char *wrapper) {
+
+	(void)wrapper; /* custom type output does not support wrappers */
+
+	return body;
+}
+
+/* custom type format provider: HTTP replies for the .bin/.txt/... set of
+ * extensions, plus the same WebSocket codec slots carried by every other
+ * format. */
+const struct format_provider format_provider_custom = {
+	.out = {
+		.reply = custom_type_reply,
+		.wrap_body = custom_type_wrap_body,
+	},
+	.ws_extract = custom_type_ws_extract,
+	.ws_error = custom_type_ws_error,
+};
diff --git a/src/formats/format.h b/src/formats/format.h
new file mode 100644
index 0000000..638b405
--- /dev/null
+++ b/src/formats/format.h
@@ -0,0 +1,50 @@
+#ifndef FORMATS_FORMAT_H
+#define FORMATS_FORMAT_H
+
+#include <stddef.h>
+#include <hiredis/hiredis.h>
+#include <hiredis/async.h>
+
+struct cmd;
+struct http_client;
+
+/* Callback signatures shared by the output formats. */
+typedef void (*formatting_fun)(redisAsyncContext *, void *, void *);
+typedef char *(*ws_error_fun)(int http_status, const char *msg,
+		size_t msg_sz, size_t *out_sz);
+typedef struct cmd *(*ws_extract_fun)(struct http_client *c,
+		const char *p, size_t sz);
+
+/* HTTP output capabilities: serialize a Redis reply as a response body
+ * and apply the client-supplied output wrapper (e.g. for JSONP) to it. */
+struct format_output {
+	formatting_fun reply;
+	char *(*wrap_body)(char *body, const char *wrapper);
+};
+
+/* Complete set of capabilities offered by a registered output format:
+ * HTTP output as well as the WebSocket codec used to parse incoming
+ * frames and to render protocol errors. Every output format bundled
+ * with Webdis must be able to fill every slot. */
+struct format_provider {
+	struct format_output out;
+	ws_extract_fun ws_extract;
+	ws_error_fun ws_error;
+};
+
+/* One provider per output format. */
+extern const struct format_provider format_provider_json;
+extern const struct format_provider format_provider_raw;
+extern const struct format_provider format_provider_custom;
+
+#ifdef MSGPACK
+extern const struct format_provider format_provider_msgpack;
+#endif
+
+/* Shared capability implementations, for formats that do not bring
+ * their own version of a slot. */
+char *
+format_default_ws_error(int http_status, const char *msg,
+		size_t msg_sz, size_t *out_sz);
+
+#endif
