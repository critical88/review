+        adaptive_call(get_dataset, role)
+
+
+def test_get_dataset_loads_train_and_test_splits(
+        monkeypatch, torchvision_recorder):
+    sentinel = object()
+    _stub_user_groups(monkeypatch, sentinel)
+    role = get_dataset_role('mnist', num_users=8, iid=1)
+    adaptive_call(get_dataset, role)
+    mnist = torchvision_recorder['mnist']
+    train_flags = [record['train'] for record in mnist.calls]
+    assert train_flags == [True, False]
+    assert all(record['download'] is True for record in mnist.calls)
+
+
+def test_dataset_loader_sets_a_transform(
+        monkeypatch, torchvision_recorder):
+    sentinel = object()
+    _stub_user_groups(monkeypatch, sentinel)
+    role = get_dataset_role('mnist', num_users=8, iid=1)
+    adaptive_call(get_dataset, role)
+    mnist = torchvision_recorder['mnist']
+    assert all(record['transform'] is not None for record in mnist.calls)
+
+
+def test_mnist_sampler_receives_exact_user_count(
+        monkeypatch, torchvision_recorder):
+    sentinel = object()
+    calls = _stub_user_groups(monkeypatch, sentinel)
+    role = get_dataset_role('mnist', num_users=33, iid=0, unequal=0)
+    adaptive_call(get_dataset, role)
+    assert calls['mnist_noniid'][1] == 33
+
