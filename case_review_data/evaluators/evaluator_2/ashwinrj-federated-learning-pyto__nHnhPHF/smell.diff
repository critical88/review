+++ b/src/tests/_support.py
@@ -0,0 +1,345 @@
+# -*- coding: utf-8 -*-
+"""Shared helpers for the Federated-Learning-PyTorch test suite.
+
+The suite exercises the repository through behavior-level outcomes so that it
+stays valid while the internal component wiring evolves. Two helpers matter:
+
+* synthetic datasets stand in for the torchvision datasets so no network
+  access or real image downloads are needed;
+* ``adaptive_call`` introspects a component's signature and supplies the
+  values the caller cares about, so tests can invoke the production
+  components without pinning the exact parameter grouping of one particular
+  revision.
+"""
+
+import argparse
+import inspect
+import itertools
+
+import numpy as np
+import torch
+from torch.utils.data import Dataset
+
+# ---------------------------------------------------------------------------
+# Experiment configuration fixtures
+# ---------------------------------------------------------------------------
+
+# Mirrors the defaults declared by src/options.py::args_parser.
+CLI_DEFAULTS = {
+    'epochs': 10,
+    'num_users': 100,
+    'frac': 0.1,
+    'local_ep': 10,
+    'local_bs': 10,
+    'lr': 0.01,
+    'momentum': 0.5,
+    'model': 'mlp',
+    'kernel_num': 9,
+    'kernel_sizes': '3,4,5',
+    'num_channels': 1,
+    'norm': 'batch_norm',
+    'num_filters': 32,
+    'max_pool': 'True',
+    'dataset': 'mnist',
+    'num_classes': 10,
+    'gpu': None,
+    'optimizer': 'sgd',
+    'iid': 1,
+    'unequal': 0,
+    'stopping_rounds': 10,
+    'verbose': 1,
+    'seed': 1,
+}
+
+
+def values_namespace(**overrides):
+    """Return an argparse.Namespace carrying every experiment setting."""
+    values = dict(CLI_DEFAULTS)
+    values.update(overrides)
+    return argparse.Namespace(**values)
+
+
+# The local training knobs used by the update loop, in a fast small scale.
+TRAINING_OVERRIDES = {
+    'epochs': 1,
+    'num_users': 20,
+    'frac': 0.5,
+    'local_ep': 1,
+    'local_bs': 10,
+    'lr': 0.05,
+    'verbose': 1,
+    'optimizer': 'sgd',
+    'num_classes': 3,
+    'num_channels': 1,
+    'num_filters': 32,
+    'dataset': 'mnist',
+    'model': 'mlp',
+    'gpu': None,
+    'seed': 7,
+}
+
+
+def expected_data_dir(dataset_name):
+    """Mirror the dataset root selection used by the repository runners.
+
+    ``mnist`` and ``cifar`` select their canonical directory and any other
+    name falls back to the fmnist directory while still loading MNIST data,
+    which is the behavior pinned by ``utils.get_dataset``.
+    """
+    if dataset_name == 'cifar':
+        return '../data/cifar/'
+    if dataset_name == 'mnist':
+        return '../data/mnist/'
+    return '../data/fmnist/'
+
+
+# ---------------------------------------------------------------------------
+# Synthetic datasets
+# ---------------------------------------------------------------------------
+
+
+class SyntheticImageDataset(Dataset):
+    """A small deterministic image/label dataset for the training loop."""
+
+    def __init__(self, n=100, image_shape=(1, 8, 8), num_classes=3, seed=7):
+        generator = torch.Generator().manual_seed(seed)
+        self.images = torch.randn(n, *image_shape, generator=generator)
+        self.labels = torch.randint(0, num_classes, (n,), generator=generator)
+
+    def __len__(self):
+        return len(self.labels)
+
+    def __getitem__(self, index):
+        return self.images[index], self.labels[index]
+
+    def label_counts(self):
+        counts = torch.bincount(self.labels.flatten().long())
+        return counts
+
+
+class ShardDatasetStub:
+    """Stands in for a torchvision dataset during user-data sampling.
+
+    The user-group samplers read ``len(dataset)`` and the label tensor
+    ``dataset.train_labels`` only, so no real image data is required.
+    """
+
+    def __init__(self, size, labels, num_classes=10, seed=7):
+        self._size = size
+        generator = torch.Generator().manual_seed(seed)
+        if labels is None:
+            labels = torch.randint(0, num_classes, (size,), generator=generator)
+        else:
+            assert len(labels) == size
+        if not isinstance(labels, torch.Tensor):
+            labels = torch.tensor(labels, dtype=torch.long)
+        self.train_labels = labels
+
+    def __len__(self):
+        return self._size
+
+
+class RecordingLogger:
+    """A duck-typed replacement for ``tensorboardX.SummaryWriter``."""
+
+    def __init__(self):
+        self.scalars = []
+
+    def add_scalar(self, tag, value):
+        self.scalars.append((tag, float(value)))
+
+
+class ConstantModel(torch.nn.Module):
+    """A model that always returns the same logits for every input."""
+
+    def __init__(self, num_classes=3, bias_class=0):
+        super(ConstantModel, self).__init__()
+        self.logits = torch.zeros(1, num_classes)
+        self.logits[0, bias_class] = 5.0
+
+    def forward(self, x):
+        batch = x.shape[0] if x.dim() > 0 else 1
+        return self.logits.expand(batch, -1)
+
+
+# ---------------------------------------------------------------------------
+# Signature-adaptive component invocation
+# ---------------------------------------------------------------------------
+
+_SPEC_MODULES = None
+
+
+def _candidate_modules():
+    global _SPEC_MODULES
+    if _SPEC_MODULES is None:
+        import options
+        import sampling
+        import utils
+        import update
+        import models
+        _SPEC_MODULES = [utils, update, models, options, sampling]
+    return _SPEC_MODULES
+
+
+def _spec_candidates(known):
+    """Classes whose constructor consumes exclusively known settings."""
+    candidates = []
+    for module in _candidate_modules():
+        for name in dir(module):
+            obj = getattr(module, name)
+            if not inspect.isclass(obj):
+                continue
+            try:
+                params = list(inspect.signature(obj).parameters)
+            except (TypeError, ValueError):
+                continue
+            if not params:
+                continue
+            if all(p in known for p in params):
+                candidates.append((obj, params))
+    candidates.sort(key=lambda item: len(item[1]), reverse=True)
+    return [obj for obj, _ in candidates]
+
+
+def _build_spec(cls, mapping):
+    """Instantiate ``cls`` from the mapped experiment values."""
+    kwargs = {}
+    for name, param in inspect.signature(cls).parameters.items():
+        if param.kind in (param.VAR_POSITIONAL, param.VAR_KEYWORD):
+            continue
+        if name in ('self', 'cls'):
+            continue
+        if name in mapping:
+            kwargs[name] = mapping[name]
+        elif param.default is not inspect._empty:
+            continue
+        else:
+            return None
+    return cls(**kwargs)
+
+
+def adaptive_call(fn, mapping, max_attempts=48):
+    """Call ``fn`` with keyword arguments derived from ``mapping``.
+
+    Parameters present in the signature under a name in ``mapping`` receive
+    the mapped value. Remaining required parameters are resolved with
+    duck-typed candidates: a settings namespace carrying every experiment
+    value, or grouping classes discovered from the production modules. This
+    keeps the tests behavior-level while the grouping of settings between
+    components evolves. Every candidate is a genuine invocation of the
+    production code; the first grouping the component accepts is returned,
+    and a failure of all candidates is re-raised as a test failure.
+    """
+
+    def split(signature):
+        kwargs = {}
+        unresolved = []
+        for name, param in signature.parameters.items():
+            if param.kind in (param.VAR_POSITIONAL, param.VAR_KEYWORD):
+                continue
+            if name in ('self', 'cls'):
+                continue
+            if name in mapping:
+                kwargs[name] = mapping[name]
+            elif param.default is not inspect._empty:
+                continue
+            else:
+                unresolved.append(name)
+        return kwargs, unresolved
+
+    signature = inspect.signature(fn)
+    kwargs, unresolved = split(signature)
+    if not unresolved:
+        return fn(**kwargs)
+
+    known = set(CLI_DEFAULTS) | set(mapping)
+    namespace = values_namespace(**{k: v for k, v in mapping.items()
+                                    if k in CLI_DEFAULTS})
+    first_error = None
+    attempts = 0
+    for candidate in [namespace] + _spec_candidates(known):
+        if attempts >= max_attempts:
+            break
+        if candidate is namespace:
+            instance = namespace
+        else:
+            instance = _build_spec(candidate, mapping)
+            if instance is None:
+                continue
+        attempts += 1
+        attempt_kwargs = dict(kwargs)
+        for name in unresolved:
+            attempt_kwargs[name] = instance
+        try:
+            return fn(**attempt_kwargs)
+        except (TypeError, AttributeError) as exc:
+            # The candidate grouping does not fit this component; try the
+            # next one. Any other exception is genuine component behavior
+            # and must propagate immediately.
+            if first_error is None:
+                first_error = exc
+    raise AssertionError(
+        'unable to call {} with {}; first error: {!r}'.format(
+            getattr(fn, '__name__', fn), sorted(mapping), first_error))
+
+
+# ---------------------------------------------------------------------------
+# Role-specific value pools
+# ---------------------------------------------------------------------------
+
+
+def get_dataset_role(dataset_name='mnist', num_users=20, iid=1, unequal=0):
+    values = dict(TRAINING_OVERRIDES)
+    values.update({
+        'dataset': dataset_name,
+        'num_users': num_users,
+        'iid': iid,
+        'unequal': unequal,
+        'data_dir_root': expected_data_dir(dataset_name),
+        'data_root': expected_data_dir(dataset_name),
+    })
+    return values
+
+
+def details_role():
+    values = dict(TRAINING_OVERRIDES)
+    values['model'] = 'mlp'
+    values['model_name'] = 'mlp'
+    return values
+
+
+def local_update_role(dataset, idxs, logger, **overrides):
+    values = dict(TRAINING_OVERRIDES)
+    values.update({
+        'dataset': dataset,
+        'idxs': idxs,
+        'logger': logger,
+    })
+    values.update(overrides)
+    return values
+
+
+def test_inference_role(model, test_dataset, **overrides):
+    values = dict(TRAINING_OVERRIDES)
+    values.update({
+        'model': model,
+        'test_dataset': test_dataset,
+    })
+    values.update(overrides)
+    return values
+
+
+def cnn_role(model_kind='mnist'):
+    values = dict(TRAINING_OVERRIDES)
+    if model_kind == 'mnist':
+        values.update({'num_channels': 3, 'num_classes': 4, 'model': 'cnn'})
+    elif model_kind == 'fmnist':
+        values.update({'num_channels': 1, 'num_classes': 10, 'model': 'cnn'})
+    else:
+        values.update({'num_channels': 3, 'num_classes': 4, 'model': 'cnn'})
+    return values
+
+
+def seed_everything(seed=1234):
+    np.random.seed(seed)
+    torch.manual_seed(seed)
