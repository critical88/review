+# ---------------------------------------------------------------------------
+# average_weights
+# ---------------------------------------------------------------------------
+
+
+def state_dicts():
+    first = {
+        'w': torch.tensor([1.0, 2.0, 3.0]),
+        'b': torch.tensor([0.0]),
+    }
+    second = {
+        'w': torch.tensor([3.0, 4.0, 11.0]),
+        'b': torch.tensor([2.0]),
+    }
+    third = {
+        'w': torch.tensor([5.0, 6.0, 27.0]),
+        'b': torch.tensor([4.0]),
+    }
+    return first, second, third
+
+
+def test_average_of_two_state_dicts():
+    first, second, _ = state_dicts()
+    averaged = average_weights([first, second])
+    assert torch.allclose(averaged['w'], torch.tensor([2.0, 3.0, 7.0]))
+    assert torch.allclose(averaged['b'], torch.tensor([1.0]))
+
+
+def test_average_of_three_state_dicts():
+    first, second, third = state_dicts()
+    averaged = average_weights([first, second, third])
+    assert torch.allclose(averaged['w'], torch.tensor([3.0, 4.0, 41.0 / 3]))
+    assert torch.allclose(averaged['b'], torch.tensor([2.0]))
+
+
+def test_average_of_single_state_dict_returns_equivalent_weights():
+    first, _, _ = state_dicts()
+    averaged = average_weights([first])
+    assert torch.allclose(averaged['w'], first['w'])
+    assert torch.allclose(averaged['b'], first['b'])
+
+
+def test_average_weights_does_not_mutate_inputs():
+    first, second, third = state_dicts()
+    originals = copy.deepcopy([first, second, third])
+    average_weights([first, second, third])
+    assert torch.equal(first['w'], originals[0]['w'])
+    assert torch.equal(second['w'], originals[1]['w'])
+    assert torch.equal(third['b'], originals[2]['b'])
+
+
+def test_average_weights_preserves_key_order_of_first_model():
+    first, second, _ = state_dicts()
+    averaged = average_weights([first, second])
+    assert list(averaged.keys()) == ['w', 'b']
+
+
+# ---------------------------------------------------------------------------
+# get_dataset (driven through monkeypatched torchvision constructors)
+# ---------------------------------------------------------------------------
+
+
+class RecordingTorchvision:
+    """Replaces a torchvision dataset class and records constructor calls."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __call__(self, root, train=True, download=True, transform=None):
+        record = {
+            'root': root,
+            'train': train,
+            'download': download,
+            'transform': transform,
+        }
+        self.calls.append(record)
+        return object()
+
+    @property
+    def last_root(self):
+        return self.calls[-1]['root']
+
+
+@pytest.fixture
+def torchvision_recorder(monkeypatch):
+    mnist = RecordingTorchvision()
+    cifar = RecordingTorchvision()
+    monkeypatch.setattr(utils.datasets, 'MNIST', mnist)
+    monkeypatch.setattr(utils.datasets, 'CIFAR10', cifar)
+    monkeypatch.setattr(utils.transforms, 'Compose', lambda steps: tuple(steps))
+    return {'mnist': mnist, 'cifar': cifar}
+
+
+def _stub_user_groups(monkeypatch, sentinel):
+    """Replace the samplers as seen by ``utils`` with recording stubs."""
+    calls = {}
+
+    def factory(name, result):
+        def sampler(dataset, num_users):
+            calls[name] = (dataset, num_users)
+            return result
+        return sampler
+
+    monkeypatch.setattr(utils, 'mnist_iid',
+                        factory('mnist_iid', {'i': sentinel}))
+    monkeypatch.setattr(utils, 'mnist_noniid',
+                        factory('mnist_noniid', {'n': sentinel}))
+    monkeypatch.setattr(utils, 'mnist_noniid_unequal',
+                        factory('mnist_noniid_unequal', {'u': sentinel}))
+    monkeypatch.setattr(utils, 'cifar_iid',
+                        factory('cifar_iid', {'c': sentinel}))
+    monkeypatch.setattr(utils, 'cifar_noniid',
+                        factory('cifar_noniid', {'x': sentinel}))
+    return calls
+
+
+def test_mnist_load_calls_mnist_constructor_with_mnist_root(
+        monkeypatch, torchvision_recorder):
+    sentinel = object()
+    calls = _stub_user_groups(monkeypatch, sentinel)
+    role = get_dataset_role('mnist', num_users=12, iid=1)
+    train_dataset, test_dataset, user_groups = adaptive_call(get_dataset, role)
+    mnist = torchvision_recorder['mnist']
+    assert len(mnist.calls) == 2
+    assert all(record['root'] == '../data/mnist/' for record in mnist.calls)
+    assert user_groups == {'i': sentinel}
+    assert calls['mnist_iid'] == (train_dataset, 12)
+
+
+def test_cifar_load_uses_cifar_constructor_and_sampler(
+        monkeypatch, torchvision_recorder):
+    sentinel = object()
+    calls = _stub_user_groups(monkeypatch, sentinel)
+    role = get_dataset_role('cifar', num_users=9, iid=1)
+    train_dataset, _, user_groups = adaptive_call(get_dataset, role)
+    cifar = torchvision_recorder['cifar']
+    assert len(cifar.calls) == 2
+    assert cifar.last_root == '../data/cifar/'
+    assert torchvision_recorder['mnist'].calls == []
+    assert user_groups == {'c': sentinel}
+    assert calls['cifar_iid'] == (train_dataset, 9)
+
+
+def test_fmnist_load_still_loads_plain_mnist_data(
+        monkeypatch, torchvision_recorder):
+    sentinel = object()
+    calls = _stub_user_groups(monkeypatch, sentinel)
+    role = get_dataset_role('fmnist', num_users=15, iid=0)
+    train_dataset, _, user_groups = adaptive_call(get_dataset, role)
+    mnist = torchvision_recorder['mnist']
+    # fmnist has no dedicated downloader: MNIST images are used, placed in
+    # the fmnist directory.
+    assert len(mnist.calls) == 2
+    assert all(record['root'] == '../data/fmnist/' for record in mnist.calls)
+    assert calls['mnist_noniid'] == (train_dataset, 15)
+    assert user_groups == {'n': sentinel}
+
+
+def test_unknown_dataset_name_still_loads_mnist_from_fmnist_dir(
+        monkeypatch, torchvision_recorder):
+    sentinel = object()
+    _stub_user_groups(monkeypatch, sentinel)
+    role = get_dataset_role('weird_dataset', num_users=5, iid=1)
+    _, _, user_groups = adaptive_call(get_dataset, role)
+    mnist = torchvision_recorder['mnist']
+    assert len(mnist.calls) == 2
+    assert all(record['root'] == '../data/fmnist/' for record in mnist.calls)
+    assert user_groups == {'i': sentinel}
+
+
+def test_noniid_unequal_mnist_routes_to_unequal_sampler(
+        monkeypatch, torchvision_recorder):
+    sentinel = object()
+    calls = _stub_user_groups(monkeypatch, sentinel)
