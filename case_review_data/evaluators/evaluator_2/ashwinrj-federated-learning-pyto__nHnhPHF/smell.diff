+def build_optimizer(model_params, lr, optimizer, momentum=0.5):
+    """ Returns the optimizer for the given model parameters.
+
+    Shared by the federated local trainer and the plain baseline
+    so both paths construct their optimizer alike.
+    """
+
+    if optimizer == 'sgd':
+        return torch.optim.SGD(model_params, lr=lr,
+                               momentum=momentum)
+    elif optimizer == 'adam':
+        return torch.optim.Adam(model_params, lr=lr,
+                                weight_decay=1e-4)
