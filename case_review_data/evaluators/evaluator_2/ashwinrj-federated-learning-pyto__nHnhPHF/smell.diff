+# -*- coding: utf-8 -*-
+"""Behavior tests for the experiment option parser."""
+
+import argparse
+
+import pytest
+
+from options import args_parser
+
+from _support import CLI_DEFAULTS
+
+
+@pytest.fixture(autouse=True)
+def _with_argv(monkeypatch):
+    monkeypatch.setattr('sys.argv', ['federated_main.py'])
+
+
+@pytest.mark.parametrize('option,value', sorted(CLI_DEFAULTS.items()))
+def test_default_matches_documented_value(option, value):
+    args = args_parser()
+    assert getattr(args, option) == value
+
+
+def test_parser_returns_namespace():
+    args = args_parser()
+    assert isinstance(args, argparse.Namespace)
+
+
+def test_unknown_option_is_rejected(monkeypatch):
+    monkeypatch.setattr('sys.argv', ['federated_main.py', '--no-such-option'])
+    with pytest.raises(SystemExit) as excinfo:
+        args_parser()
+    assert excinfo.value.code == 2
+
+
+@pytest.mark.parametrize('flag,value', [
+    ('--epochs', 3),
+    ('--num_users', 7),
+    ('--frac', 0.5),
+    ('--local_ep', 2),
+    ('--local_bs', 4),
+    ('--lr', 0.2),
+    ('--optimizer', 'adam'),
+    ('--model', 'mlp'),
+    ('--dataset', 'fmnist'),
+    ('--num_classes', 5),
+    ('--kernel_num', 11),
+    ('--iid', 0),
+    ('--unequal', 1),
+    ('--seed', 99),
+])
+def test_option_overrides_default(flag, value, monkeypatch):
+    monkeypatch.setattr('sys.argv', ['federated_main.py', flag, str(value)])
+    args = args_parser()
+    option = flag.lstrip('-')
+    assert getattr(args, option) == value
+
+
+@pytest.mark.parametrize('flag,value,expected_type', [
+    ('--epochs', 5, int),
+    ('--frac', 0.25, float),
+    ('--lr', 0.1, float),
+    ('--dataset', 'cifar', str),
+    ('--iid', 0, int),
+])
+def test_option_types(flag, value, expected_type, monkeypatch):
+    monkeypatch.setattr('sys.argv', ['federated_main.py', flag, str(value)])
+    args = args_parser()
+    assert isinstance(getattr(args, flag.lstrip('-')), expected_type)
+
+
+def test_gpu_defaults_to_none_for_cpu_execution():
+    args = args_parser()
+    assert args.gpu is None
+
+
+def test_unparsed_string_option_kernel_sizes_default():
+    args = args_parser()
+    assert isinstance(args.kernel_sizes, str)
+    assert args.kernel_sizes == '3,4,5'
