+    _, _, user_groups = adaptive_call(get_dataset, role)
+    assert calls['mnist_noniid_unequal'][1] == 6
+    assert user_groups == {'u': sentinel}
+
+
+def test_noniid_cifar_unequal_is_not_implemented(
+        monkeypatch, torchvision_recorder):
+    sentinel = object()
+    _stub_user_groups(monkeypatch, sentinel)
