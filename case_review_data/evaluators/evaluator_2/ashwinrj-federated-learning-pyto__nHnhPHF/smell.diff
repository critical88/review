+# -*- coding: utf-8 -*-
+"""Behavior tests for the neural network architectures."""
+
+import math
+
+import pytest
+import torch
+
+import models
+from models import MLP
+
+from _support import adaptive_call, cnn_role, seed_everything
+
+
+# ---------------------------------------------------------------------------
+# MLP
+# ---------------------------------------------------------------------------
+
+
+def test_mlp_flattens_input_and_preserves_batch():
+    seed_everything(5)
+    net = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    out = net(torch.randn(4, 1, 8, 8))
+    assert out.shape == (4, 3)
+
+
+def test_mlp_outputs_normalized_probabilities():
+    seed_everything(5)
+    net = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    net.eval()
+    out = net(torch.randn(4, 1, 8, 8))
+    sums = out.sum(dim=1)
+    assert torch.allclose(sums, torch.ones(4), atol=1e-5)
+
+
+def test_mlp_input_layer_matches_declared_geometry():
+    net = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    assert net.layer_input.in_features == 64
+    assert net.layer_hidden.out_features == 3
+
+
+def test_mlp_hidden_layer_uses_declared_width():
+    net = MLP(dim_in=64, dim_hidden=17, dim_out=3)
+    assert net.layer_input.out_features == 17
+
+
+def test_mlp_dropout_layer_is_part_of_the_stack():
+    net = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    assert isinstance(net.dropout, torch.nn.Dropout)
+
+
+# ---------------------------------------------------------------------------
+# Convolutional architectures
+# ---------------------------------------------------------------------------
+
+
+def construct_cnn(model_class, role):
+    seed_everything(7)
+    return adaptive_call(model_class, role)
+
+
+def test_cnn_mnist_uses_configured_input_channels():
+    net = construct_cnn(models.CNNMnist, cnn_role('mnist'))
+    assert net.conv1.in_channels == 3
+    assert net.conv1.out_channels == 10
+
+
+def test_cnn_mnist_uses_configured_output_classes():
+    net = construct_cnn(models.CNNMnist, cnn_role('mnist'))
+    assert net.fc2.out_features == 4
+
+
+def test_cnn_mnist_forward_returns_log_probabilities_batch():
+    net = construct_cnn(models.CNNMnist, cnn_role('mnist'))
+    net.eval()
+    out = net(torch.randn(2, 3, 28, 28))
+    assert out.shape == (2, 4)
+    assert torch.allclose(out.exp().sum(dim=1), torch.ones(2), atol=1e-4)
+
+
+def test_cnn_mnist_is_a_valid_torch_module():
+    net = construct_cnn(models.CNNMnist, cnn_role('mnist'))
+    assert isinstance(net, torch.nn.Module)
+
+
+def test_cnn_fashion_uses_fixed_geometry():
+    net = construct_cnn(models.CNNFashion_Mnist, cnn_role('fmnist'))
+    assert net.fc.out_features == 10
+    assert net.layer1[0].in_channels == 1
+
+
+def test_cnn_fashion_forward_returns_logits_batch():
+    net = construct_cnn(models.CNNFashion_Mnist, cnn_role('fmnist'))
+    net.eval()
+    out = net(torch.randn(3, 1, 28, 28))
+    assert out.shape == (3, 10)
+
+
+def test_cnn_fashion_ignores_channel_and_class_knobs_for_geometry():
+    # The fmnist network pins its own layer sizes regardless of the knobs.
+    net = construct_cnn(models.CNNFashion_Mnist, dict(cnn_role('fmnist'),
+                                                      num_channels=3,
+                                                      num_classes=4))
+    assert net.layer1[0].in_channels == 1
+    assert net.fc.out_features == 10
+
+
+def test_cnn_cifar_uses_configured_output_classes():
+    net = construct_cnn(models.CNNCifar, cnn_role('cifar'))
+    assert net.fc3.out_features == 4
+
+
+def test_cnn_cifar_forward_returns_log_probabilities():
+    net = construct_cnn(models.CNNCifar, cnn_role('cifar'))
+    net.eval()
+    out = net(torch.randn(2, 3, 32, 32))
+    assert out.shape == (2, 4)
+    assert torch.allclose(out.exp().sum(dim=1), torch.ones(2), atol=1e-4)
+
+
+def test_cnn_cifar_expects_three_input_channels():
+    net = construct_cnn(models.CNNCifar, cnn_role('cifar'))
+    assert net.conv1.in_channels == 3
+
+
+def test_cnn_mnist_dropout_between_convolutions():
+    net = construct_cnn(models.CNNMnist, cnn_role('mnist'))
+    assert isinstance(net.conv2_drop, torch.nn.Dropout2d)
