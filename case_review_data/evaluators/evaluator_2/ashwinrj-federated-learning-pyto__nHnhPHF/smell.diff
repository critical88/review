@@ -0,0 +1,263 @@
+# -*- coding: utf-8 -*-
+"""Behavior tests for the local training and evaluation components."""
+
+import math
+
+import pytest
+import torch
+from torch.utils.data import RandomSampler
+
+from models import MLP
+from update import DatasetSplit, LocalUpdate
+from update import test_inference as run_test_inference
+
+from _support import (
+    ConstantModel,
+    RecordingLogger,
+    SyntheticImageDataset,
+    adaptive_call,
+    local_update_role,
+    seed_everything,
+)
+from _support import test_inference_role as inference_role_values
+
+
+@pytest.fixture
+def dataset():
+    # 100 samples keeps every derived batch size at least one.
+    return SyntheticImageDataset(n=100, image_shape=(1, 8, 8),
+                                num_classes=3, seed=7)
+
+
+@pytest.fixture
+def logger():
+    return RecordingLogger()
+
+
+# ---------------------------------------------------------------------------
+# DatasetSplit
+# ---------------------------------------------------------------------------
+
+
+def test_dataset_split_length_matches_index_list(dataset):
+    split = DatasetSplit(dataset, [2, 5, 9])
+    assert len(split) == 3
+
+
+def test_dataset_split_returns_tensors(dataset):
+    split = DatasetSplit(dataset, [1, 2])
+    image, label = split[0]
+    assert torch.is_tensor(image)
+    assert torch.is_tensor(label)
+    assert torch.equal(image, dataset.images[1])
+    assert torch.equal(label, dataset.labels[1])
+
+
+def test_dataset_split_coerces_indices_to_int(dataset):
+    split = DatasetSplit(dataset, ['0', 1, 2.0])
+    assert split.idxs == [0, 1, 2]
+
+
+def test_dataset_split_is_a_torch_dataset(dataset):
+    from torch.utils.data import Dataset
+    assert isinstance(DatasetSplit(dataset, [0]), Dataset)
+
+
+# ---------------------------------------------------------------------------
+# LocalUpdate construction and loader slicing
+# ---------------------------------------------------------------------------
+
+
+def make_local_update(dataset, logger, **overrides):
+    role = local_update_role(dataset, list(range(100)), logger, **overrides)
+    return adaptive_call(LocalUpdate, role)
+
+
+def inference_role(model, dataset, **overrides):
+    return inference_role_values(model, dataset, **overrides)
+
+
+def test_local_update_splits_local_indexes_80_10_10(dataset, logger):
+    update = make_local_update(dataset, logger)
+    train = set(update.trainloader.dataset.idxs)
+    valid = set(update.validloader.dataset.idxs)
+    test = set(update.testloader.dataset.idxs)
+    assert len(train) == 80
+    assert len(valid) == 10
+    assert len(test) == 10
+
+
+def test_local_update_split_covers_all_indexes(dataset, logger):
+    update = make_local_update(dataset, logger)
+    union = (set(update.trainloader.dataset.idxs)
+             | set(update.validloader.dataset.idxs)
+             | set(update.testloader.dataset.idxs))
+    assert union == set(range(100))
+
+
+def test_local_update_split_is_ordered(dataset, logger):
+    # The split follows the incoming index order: train first, then
+    # validation, then test.
+    update = make_local_update(dataset, logger)
+    train = update.trainloader.dataset.idxs
+    assert train[:5] == [0, 1, 2, 3, 4]
+
+
+def test_local_update_train_batch_size_matches_setting(dataset, logger):
+    update = make_local_update(dataset, logger, local_bs=4)
+    assert update.trainloader.batch_size == 4
+
+
+def test_local_update_train_loader_shuffles_by_default(dataset, logger):
+    update = make_local_update(dataset, logger)
+    assert isinstance(update.trainloader.sampler, RandomSampler)
+
+
+def test_local_update_uses_cpu_when_no_gpu(dataset, logger):
+    update = make_local_update(dataset, logger, gpu=None)
+    assert update.device == 'cpu'
+
+
+def test_local_update_criterion_is_nll_loss(dataset, logger):
+    update = make_local_update(dataset, logger)
+    assert isinstance(update.criterion, torch.nn.NLLLoss)
+
+
+def test_local_update_keeps_subset_dataset(dataset, logger):
+    update = make_local_update(dataset, logger)
+    assert update.trainloader.dataset.dataset is dataset
+
+
+# ---------------------------------------------------------------------------
+# LocalUpdate.update_weights
+# ---------------------------------------------------------------------------
+
+
+def test_update_weights_returns_state_dict_and_loss(dataset, logger):
+    update = make_local_update(dataset, logger, local_ep=1)
+    model = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    seed_everything(3)
+    state, loss = update.update_weights(model=model, global_round=0)
+    assert set(state.keys()) == set(model.state_dict().keys())
+    assert isinstance(loss, float)
+    assert math.isfinite(loss)
+
+
+def test_update_weights_actually_trains_the_model(dataset, logger):
+    update = make_local_update(dataset, logger, local_ep=1, lr=0.5)
+    model = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    before = {k: v.clone() for k, v in model.state_dict().items()}
+    seed_everything(3)
+    update.update_weights(model=model, global_round=0)
+    changed = [k for k, v in model.state_dict().items()
+               if not torch.equal(v, before[k])]
+    assert changed
+
+
+def test_update_weights_logs_one_scalar_per_batch(dataset, logger):
+    update = make_local_update(dataset, logger, local_bs=10)
+    model = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    seed_everything(3)
+    update.update_weights(model=model, global_round=2)
+    assert len(logger.scalars) == 8
+    assert {tag for tag, _ in logger.scalars} == {'loss'}
+
+
+def test_update_weights_verbose_prints_round_header(dataset, logger, capsys):
+    update = make_local_update(dataset, logger, verbose=1)
+    model = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    seed_everything(3)
+    update.update_weights(model=model, global_round=4)
+    printed = capsys.readouterr().out
+    assert 'Global Round : 4' in printed
+
+
+def test_update_weights_quiet_mode_prints_nothing(dataset, logger, capsys):
+    update = make_local_update(dataset, logger, verbose=0)
+    model = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    seed_everything(3)
+    update.update_weights(model=model, global_round=0)
+    printed = capsys.readouterr().out
+    assert 'Global Round' not in printed
+
+
+def test_update_weights_uses_sgd_for_sgd_setting(dataset, logger):
+    update = make_local_update(dataset, logger, optimizer='sgd')
+    model = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    seed_everything(3)
+    update.update_weights(model=model, global_round=0)
+    assert True  # completing a round under sgd is the observable contract
+
+
+def test_train_val_test_returns_exact_split_sizes(dataset, logger):
+    update = make_local_update(dataset, logger)
+    role = local_update_role(dataset, list(range(100)), logger)
+    trainloader, validloader, testloader = adaptive_call(
+        update.train_val_test, role)
+    assert len(trainloader.dataset) == 80
+    assert len(validloader.dataset) == 10
+    assert len(testloader.dataset) == 10
+
+
+# ---------------------------------------------------------------------------
+# LocalUpdate.inference and test_inference
+# ---------------------------------------------------------------------------
+
+
+def test_inference_accuracy_with_constant_model(dataset, logger):
+    update = make_local_update(dataset, logger)
+    model = ConstantModel(num_classes=3, bias_class=0)
+    accuracy, loss = update.inference(model=model)
+    # inference runs on the local test split: the last tenth of the indexes
+    test_labels = dataset.labels[90:]
+    expected = float((test_labels == 0).sum()) / float(len(test_labels))
+    assert accuracy == pytest.approx(expected)
+    assert math.isfinite(loss)
+
+
+def test_inference_returns_python_numbers(dataset, logger):
+    update = make_local_update(dataset, logger)
+    model = ConstantModel(num_classes=3, bias_class=2)
+    accuracy, loss = update.inference(model=model)
+    assert isinstance(accuracy, float)
+    assert isinstance(loss, float)
+    assert 0.0 <= accuracy <= 1.0
+    assert math.isfinite(loss)
+
+
+def test_test_inference_accuracy_with_constant_model(dataset):
+    model = ConstantModel(num_classes=3, bias_class=1)
+    counts = dataset.label_counts()
+    expected = float(counts[1]) / 100.0
+    role = inference_role(model, dataset)
+    accuracy, loss = adaptive_call(run_test_inference, role)
+    assert accuracy == pytest.approx(expected)
+    assert math.isfinite(loss)
+
+
+def test_test_inference_runs_on_plain_dataset(dataset):
+    model = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    role = inference_role(model, dataset)
+    accuracy, loss = adaptive_call(run_test_inference, role)
+    assert 0.0 <= accuracy <= 1.0
+    assert math.isfinite(loss)
+
+
+def test_test_inference_accuracy_in_range_for_trained_model(dataset, logger):
+    update = make_local_update(dataset, logger, local_ep=1)
+    model = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    seed_everything(3)
+    update.update_weights(model=model, global_round=0)
+    role = inference_role(model, dataset)
+    accuracy, loss = adaptive_call(run_test_inference, role)
+    assert 0.0 <= accuracy <= 1.0
+    assert math.isfinite(loss)
+
+
+def test_inference_after_local_training_stays_in_range(dataset, logger):
+    update = make_local_update(dataset, logger, local_ep=1)
+    model = MLP(dim_in=64, dim_hidden=6, dim_out=3)
+    seed_everything(3)
+    update.update_weights(model=model, global_round=0)
+    accuracy, loss = update.inference(model=model)
+    assert 0.0 <= accuracy <= 1.0
diff --git a/src/tests/test_utils.py b/src/tests/test_utils.py
