new file mode 100644
index 0000000..985bf6d
--- /dev/null
+++ b/src/tests/test_sampling.py
@@ -0,0 +1,146 @@
+# -*- coding: utf-8 -*-
+"""Behavior tests for the federated user-group samplers."""
+
+import numpy as np
+import pytest
+
+from sampling import (
+    cifar_iid,
+    cifar_noniid,
+    mnist_iid,
+    mnist_noniid,
+    mnist_noniid_unequal,
+)
+
+from _support import ShardDatasetStub, seed_everything
+
+
+def sorteds(values):
+    return sorted(int(v) for v in values)
+
+
+@pytest.mark.parametrize('sampler,total,users', [
+    (mnist_iid, 600, 3),
+    (mnist_iid, 500, 5),
+    (cifar_iid, 500, 5),
+    (cifar_iid, 300, 3),
+])
+def test_iid_sampler_partitions_data_evently(sampler, total, users):
+    seed_everything(11)
+    dataset = ShardDatasetStub(total, labels=None, seed=11)
+    groups = sampler(dataset, users)
+    per_user = total // users
+    assert sorted(groups.keys()) == list(range(users))
+    for client, values in groups.items():
+        assert len(values) == per_user
+    union = set()
+    for values in groups.values():
+        union.update(int(v) for v in values)
+    assert len(union) == total
+
+
+def test_iid_groups_are_mutually_disjoint():
+    seed_everything(23)
+    dataset = ShardDatasetStub(600, labels=None, seed=23)
+    groups = mnist_iid(dataset, 3)
+    flattened = [int(v) for values in groups.values() for v in values]
+    assert len(flattened) == len(set(flattened)) == 600
+
+
+def test_iid_sampling_is_reproducible_under_same_seed():
+    seed_everything(31)
+    dataset = ShardDatasetStub(400, labels=None, seed=31)
+    first = mnist_iid(dataset, 4)
+    seed_everything(31)
+    second = mnist_iid(dataset, 4)
+    assert {k: sorteds(v) for k, v in first.items()} == {
+        k: sorteds(v) for k, v in second.items()}
+
+
+def test_mnist_noniid_assigns_two_shards_per_user():
+    seed_everything(17)
+    labels = np.random.RandomState(3).randint(0, 10, size=60000)
+    dataset = ShardDatasetStub(60000, labels=labels)
+    groups = mnist_noniid(dataset, 5)
+    for values in groups.values():
+        assert len(values) == 600          # 2 shards x 300 images
+    flattened = [int(v) for values in groups.values() for v in values]
+    unique = set(flattened)
+    assert len(flattened) == 3000
+    assert len(unique) == 3000             # shard sets are disjoint
+    assert min(unique) >= 0 and max(unique) < 60000
+
+
+def test_mnist_noniid_shards_are_label_pure():
+    seed_everything(19)
+    labels = np.random.RandomState(4).randint(0, 10, size=60000)
+    dataset = ShardDatasetStub(60000, labels=labels)
+    groups = mnist_noniid(dataset, 4)
+    labels_available = np.asarray(labels)
+    for values in groups.values():
+        shard_labels = set(int(labels_available[int(v)]) for v in values)
+        assert len(shard_labels) <= 2     # two shards, each label-sorted
+
+
+def test_mnist_noniid_unequal_every_client_gets_data():
+    seed_everything(29)
+    labels = np.random.RandomState(5).randint(0, 10, size=60000)
+    dataset = ShardDatasetStub(60000, labels=labels)
+    groups = mnist_noniid_unequal(dataset, 3)
+    collected = []
+    for values in groups.values():
+        assert len(values) >= 50          # never less than one shard
+        assert np.asarray(values).dtype.kind in 'iuf'
+        collected.extend(int(v) for v in values)
+    assert len(collected) == len(set(collected))
+    assert min(collected) >= 0 and max(collected) < 60000
+
+
+def test_mnist_noniid_unequal_sizes_can_differ():
+    seed_everything(37)
+    labels = np.random.RandomState(6).randint(0, 10, size=60000)
+    dataset = ShardDatasetStub(60000, labels=labels)
+    groups = mnist_noniid_unequal(dataset, 6)
+    sizes = [len(np.asarray(v)) for v in groups.values()]
+    assert max(sizes) / max(min(sizes), 1) > 1.0 or len(set(sizes)) > 1
+
+
+def test_mnist_noniid_is_reproducible_under_same_seed():
+    seed_everything(41)
+    labels = np.random.RandomState(7).randint(0, 10, size=60000)
+    dataset = ShardDatasetStub(60000, labels=labels)
+    first = mnist_noniid(dataset, 3)
+    seed_everything(41)
+    second = mnist_noniid(dataset, 3)
+    assert {k: sorteds(v) for k, v in first.items()} == {
+        k: sorteds(v) for k, v in second.items()}
+
+
+def test_cifar_noniid_assigns_two_shards_per_user():
+    seed_everything(43)
+    labels = np.random.RandomState(8).randint(0, 10, size=50000)
+    dataset = ShardDatasetStub(50000, labels=labels)
+    groups = cifar_noniid(dataset, 4)
+    for values in groups.values():
+        assert len(values) == 500          # 2 shards x 250 images
+    flattened = [int(v) for values in groups.values() for v in values]
+    assert len(flattened) == len(set(flattened)) == 2000
+    assert min(flattened) >= 0 and max(flattened) < 50000
+
+
+def test_cifar_noniid_shards_are_label_pure():
+    seed_everything(47)
+    labels = np.random.RandomState(9).randint(0, 10, size=50000)
+    dataset = ShardDatasetStub(50000, labels=labels)
+    groups = cifar_noniid(dataset, 3)
+    labels_available = np.asarray(labels)
+    for values in groups.values():
+        shard_labels = set(int(labels_available[int(v)]) for v in values)
+        assert len(shard_labels) <= 2
+
+
+def test_iid_sampler_returns_sets_or_arrays_per_family():
+    seed_everything(53)
+    dataset = ShardDatasetStub(300, labels=None, seed=53)
+    groups = cifar_iid(dataset, 3)
+    assert all(hasattr(values, '__iter__') for values in groups.values())
