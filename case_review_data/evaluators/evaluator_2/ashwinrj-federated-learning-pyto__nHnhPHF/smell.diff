+@pytest.mark.parametrize('iid', [1, 0])
+def test_exp_details_reports_iid_setting(capsys, iid):
+    role = details_role()
+    role['iid'] = iid
+    role['frac'] = 0.3
+    result = adaptive_call(exp_details, role)
+    assert result is None
+    printed = capsys.readouterr().out
+    assert ('Non-IID' in printed) == (iid == 0)
+    assert '0.3' in printed
+
+
+def test_exp_details_reports_model_optimizer_and_epochs(capsys):
+    role = details_role()
+    role.update({'model': 'mlpX', 'model_name': 'mlpX',
+                 'optimizer': 'adam', 'lr': 0.02, 'epochs': 6})
+    adaptive_call(exp_details, role)
+    printed = capsys.readouterr().out
+    assert 'mlpX' in printed
+    assert 'adam' in printed
+    assert '0.02' in printed
+    assert '6' in printed
+
+
+def test_exp_details_reports_local_batch_size_and_epochs(capsys):
+    role = details_role()
+    role.update({'local_bs': 12, 'local_ep': 3})
+    adaptive_call(exp_details, role)
+    printed = capsys.readouterr().out
+    assert '12' in printed
+    assert '3' in printed
