+# -*- coding: utf-8 -*-
+"""Pytest bootstrap for the Federated-Learning-PyTorch test suite.
+
+The production modules in this repository import each other as top level
+modules (``from options import args_parser``), so the ``src`` directory that
+contains them has to be importable from the test modules.
+"""
+
+import os
+import sys
+
+SRC_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+if SRC_DIR not in sys.path:
+    sys.path.insert(0, SRC_DIR)
