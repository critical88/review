+# -*- coding: utf-8 -*-
+"""Safety tests for the experiment entry scripts.
+
+The runner scripts guard their training procedure behind the main bourne
+guard; importing them must never start an experiment.
+"""
+
+import os
+
+
+def read_source(path):
+    here = os.path.dirname(os.path.abspath(__file__))
+    with open(os.path.join(here, '..', path), 'r') as handle:
+        return handle.read()
+
+
+def test_federated_main_import_does_not_start_training():
+    import federated_main  # noqa: F401
+
+
+def test_baseline_main_import_does_not_start_training():
+    import baseline_main  # noqa: F401
+
+
+def test_federated_main_guards_the_training_procedure():
+    source = read_source('federated_main.py')
+    assert "if __name__ == '__main__':" in source
+
+
+def test_baseline_main_guards_the_training_procedure():
+    source = read_source('baseline_main.py')
+    assert "if __name__ == '__main__':" in source
+
+
+def test_federated_main_writes_result_objects_under_save(tmp_path, monkeypatch):
+    # The training loop persists its loss/accuracy records; the save helper
+    # stays wired into the federated runner.
+    source = read_source('federated_main.py')
+    assert 'pickle.dump' in source and 'save/objects' in source
+
+
+def test_baseline_main_saves_a_loss_plot(tmp_path):
+    source = read_source('baseline_main.py')
+    assert 'savefig' in source
