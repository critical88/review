+    // which is a server-side copy plus a source delete under the hood.
+    promote: (fromPath, toPath, cb) => {
+      turboBucket
+        .file(fromPath)
+        .move(turboBucket.file(toPath), (err) => cb(err ?? null))
+    },
+    remove: (artifactPath, cb) => {
+      turboBucket.file(artifactPath).delete((err) => cb(err ?? null))
+    },
+    // Returns every object name under the team prefix.
+    listArtifacts: (team, cb) => {
+      turboBucket.getFiles({ prefix: `${team}/` }, (err, files) => {
+        if (err) {
+          cb(err as Error)
+          return
+        }
+        cb(
+          null,
+          (files ?? []).map((file) => file.name),
+        )
+      })
+    },
+    // GCS tracks no access time; the object's `updated` timestamp is the
+    // closest value the shared maintenance pipeline can age on.
+    getModifiedTime: (artifactPath, cb) => {
+      turboBucket
+        .file(artifactPath)
+        .getMetadata()
+        .then(([metadata]) => {
+          const updated = (metadata as { updated?: string }).updated
+          cb(null, updated ? new Date(updated).getTime() : undefined)
+        })
+        .catch((err) => cb(err as Error))
+    },
   }
 }
