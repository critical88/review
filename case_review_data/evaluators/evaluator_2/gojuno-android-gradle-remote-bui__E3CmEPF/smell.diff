+/// Operation that executes a command on the remote machine.
+pub struct RemoteCommandOperation {
+    remote_command: String,
+    config: Config,
+    project_dir_on_remote_machine: String,
+    phase: Option<&'static str>,
+    command_readers: Option<Vec<BusReader<Result<RemoteCommandOk, RemoteCommandErr>>>>,
+    bus: Option<Bus<Result<RemoteCommandOk, RemoteCommandErr>>>,
+}
+
+impl RemoteCommandOperation {
+    pub fn new(
+        remote_command: String,
+        config: Config,
+        project_dir_on_remote_machine: String,
+        number_of_readers: usize,
+    ) -> RemoteCommandOperation {
+        let mut bus: Bus<Result<RemoteCommandOk, RemoteCommandErr>> = Bus::new(1);
+        let mut readers: Vec<BusReader<Result<RemoteCommandOk, RemoteCommandErr>>> =
+            Vec::with_capacity(number_of_readers);
+
+        for _ in 0..number_of_readers {
+            readers.push(bus.add_rx())
+        }
+
+        RemoteCommandOperation {
+            remote_command,
+            config,
+            project_dir_on_remote_machine,
+            phase: None,
+            command_readers: Some(readers),
+            bus: Some(bus),
+        }
+    }
+
+    /// Bus readers that observe the remote command result.
+    pub fn take_command_readers(
+        &mut self,
+    ) -> Vec<BusReader<Result<RemoteCommandOk, RemoteCommandErr>>> {
+        self.command_readers
+            .take()
+            .expect("Remote command operation readers are not available.")
+    }
+}
+
+impl RemoteOperation for RemoteCommandOperation {
+    fn prepare(&mut self) {
+        self.phase = Some(self.phase_label());
+    }
+
+    fn run(&mut self) -> OperationSignal {
+        let mut bus = self
