@@ -0,0 +1,130 @@
+use std::process::Command;
+use std::time::Duration;
+
+use crossbeam_channel::unbounded;
+use crossbeam_channel::Receiver;
+use crossbeam_channel::Sender;
+
+use crate::sync::PullMode;
+
+/// Completion values that every remote operation hands back to its caller
+/// once the background part of the work is done.
+#[derive(Debug, Eq, PartialEq, Clone)]
+pub struct OperationOutcome {
+    pub duration: Duration,
+    pub message: Option<String>,
+    pub phase: Option<&'static str>,
+}
+
+/// A handle to one started remote operation. `completion` yields the final
+/// [`OperationOutcome`] when the background work is done.
+#[derive(Debug, Clone)]
+pub struct OperationSignal {
+    pub(crate) completion: Receiver<OperationOutcome>,
+}
+
+impl OperationSignal {
+    /// Start a signal whose completion is already known.
+    pub fn completed(outcome: OperationOutcome) -> OperationSignal {
+        let (sender, receiver): (Sender<OperationOutcome>, Receiver<OperationOutcome>) =
+            unbounded();
+        sender
+            .send(outcome)
+            .expect("Could not send operation outcome");
+        OperationSignal {
+            completion: receiver,
+        }
+    }
+
+    /// Create a pending signal and hand back the sender used to finish it.
+    pub fn pending() -> (Sender<OperationOutcome>, OperationSignal) {
+        let (sender, receiver): (Sender<OperationOutcome>, Receiver<OperationOutcome>) =
+            unbounded();
+        (sender, OperationSignal {
+            completion: receiver,
+        })
+    }
+}
+
+/// Everything the remote machine has to be able to do for Mainframer:
+/// move the project to or from it, describe its layout, and run a command.
+///
+/// Every operation follows the same template: `prepare` records what the
+/// operation needs, `run` starts the actual remote work, and `finish`
+/// consolidates the outcome once the background work is done.
+pub trait RemoteOperation {
+    /// Record everything the operation needs before it starts.
+    fn prepare(&mut self);
+
+    /// Start the remote work and return a handle for its completion.
+    fn run(&mut self) -> OperationSignal;
+
+    /// Wait for the started work and consolidate its outcome.
+    fn finish(&self, signal: &OperationSignal) -> OperationOutcome;
+
+    /// Host name of the remote machine this operation targets.
+    fn remote_host(&self) -> String;
+
+    /// Directory of the project on the remote machine.
+    fn project_dir_on_remote_machine(&self) -> String;
+
+    /// Human readable phase this operation represents.
+    fn phase_label(&self) -> &'static str;
+
+    /// `rsync` arguments that exclude files from the local to remote transfer.
+    fn local_to_remote_exclude_arguments(&self, rsync_command: &mut Command);
+
+    /// `rsync` arguments that exclude files from the remote to local transfer.
+    fn remote_to_local_exclude_arguments(&self, rsync_command: &mut Command);
+
+    /// Compression level for the local to remote transfer.
+    fn push_compression(&self) -> i8;
+
+    /// Compression level for the remote to local transfer.
+    fn pull_compression(&self) -> i8;
+
+    /// Configured pull mode for this operation.
+    fn pull_mode(&self) -> PullMode;
+
+    /// Shell snippet that executes the operation's command on the remote machine.
+    fn remote_command_string(&self) -> String;
+}
+
+/// Remote operations that move files between the local and the remote machine.
+pub trait FileTransferOperation: RemoteOperation {}
+
+/// Remote operations that run a command on the remote machine.
+pub trait CommandOperation: RemoteOperation {}
+
+/// Run a complete file transfer: prepare it, start it and wait for the result.
+pub fn execute_transfer<T: FileTransferOperation>(
+    operation: &mut T,
+) -> OperationOutcome {
+    operation.prepare();
+    let signal = operation.run();
+    operation.finish(&signal)
+}
+
+/// Prepare a file transfer and start it without waiting for completion.
+pub fn start_transfer<T: FileTransferOperation>(
+    operation: &mut T,
+) -> OperationSignal {
+    operation.prepare();
+    operation.run()
+}
+
+/// Prepare a remote command and start it without waiting for completion.
+pub fn prepare_and_start_command<T: CommandOperation>(
+    operation: &mut T,
+) -> OperationSignal {
+    operation.prepare();
+    operation.run()
+}
+
+/// Consolidate the outcome of an operation that was started earlier.
+pub fn complete(
+    operation: &dyn RemoteOperation,
+    signal: &OperationSignal,
+) -> OperationOutcome {
+    operation.finish(signal)
+}
