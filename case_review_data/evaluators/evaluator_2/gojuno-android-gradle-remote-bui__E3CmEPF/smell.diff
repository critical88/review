+        outcome.phase = self.phase;
+        outcome
+    }
+
+    fn remote_host(&self) -> String {
+        self.config.remote.host.clone()
+    }
+
+    fn project_dir_on_remote_machine(&self) -> String {
+        self.project_dir_on_remote_machine.clone()
+    }
+
+    fn phase_label(&self) -> &'static str {
+        "Execution"
+    }
+
+    fn local_to_remote_exclude_arguments(&self, rsync_command: &mut std::process::Command) {
+        // Command execution does not transfer files, but every remote operation
+        // has to describe its exclude arguments.
+        let _ = rsync_command;
+    }
+
+    fn remote_to_local_exclude_arguments(&self, rsync_command: &mut std::process::Command) {
+        let _ = rsync_command;
+    }
+
+    fn push_compression(&self) -> i8 {
+        self.config.push.compression
+    }
+
+    fn pull_compression(&self) -> i8 {
+        self.config.pull.compression
+    }
