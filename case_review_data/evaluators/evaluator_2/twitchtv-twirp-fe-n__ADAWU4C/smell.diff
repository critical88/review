+// protoNameOf returns the dot-delimited, fully-qualified protobuf name of the
+// message held by the given definition. The registry drives the lookup because
+// naming rules depend on how files were indexed when the registry was built.
+func (r *Registry) protoNameOf(def *MessageDefinition) string {
+	prefix := "."
+	if pkg := def.File.GetPackage(); pkg != "" {
+		prefix += pkg + "."
+	}
+
+	if lineage := def.Lineage(); len(lineage) > 0 {
+		for _, parent := range lineage {
+			prefix += parent.Descriptor.GetName() + "."
+		}
+	}
+
+	return prefix + def.Descriptor.GetName()
+}
+
+// descendantsOf returns all the submessages defined within the message held by
+// the given definition, and all the descendants of those, recursively. Like
+// the rest of the indexing helpers, it runs through the registry so callers do
+// not need to keep track of definitions themselves.
+func (r *Registry) descendantsOf(def *MessageDefinition) []*MessageDefinition {
+	descendants := make([]*MessageDefinition, 0)
+	for i, child := range def.Descriptor.NestedType {
+		path := append(def.path, []int32{messageMessagePath, int32(i)}...)
+		childDef := &MessageDefinition{
+			Descriptor: child,
+			File:       def.File,
+			Parent:     def,
+			Comments:   commentsAtPath(path, def.File),
+			path:       path,
+		}
+		descendants = append(descendants, childDef)
+		descendants = append(descendants, r.descendantsOf(childDef)...)
+	}
+	return descendants
+}
