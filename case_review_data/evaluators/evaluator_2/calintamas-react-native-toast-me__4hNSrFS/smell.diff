index 0000000..7cb0e66
--- /dev/null
+++ b/src/ToastManager.tsx
@@ -0,0 +1,753 @@
+import React from 'react';
+import {
+  Animated,
+  Dimensions,
+  GestureResponderEvent,
+  Keyboard,
+  KeyboardEvent,
+  LayoutChangeEvent,
+  PanResponder,
+  PanResponderGestureState,
+  Platform
+} from 'react-native';
+
+import { ErrorToast } from './components/ErrorToast';
+import { InfoToast } from './components/InfoToast';
+import { SuccessToast } from './components/SuccessToast';
+import {
+  ReactChildren,
+  ToastAnimationConfig,
+  ToastConfig,
+  ToastData,
+  ToastHideParams,
+  ToastOptions,
+  ToastPosition,
+  ToastRef,
+  ToastShowParams,
+  ToastSingleAnimationConfig,
+  ToastSpringAnimationConfig
+} from './types';
+import { noop } from './utils/func';
+import { bound } from './utils/number';
+import { isIOS } from './utils/platform';
+
+type ToastRefObj = {
+  current: ToastRef | null;
+};
+
+type Log = (...args: unknown[]) => void;
+
+type PanningRef = React.MutableRefObject<boolean>;
+
+export type ToastSession = {
+  log: Log;
+  panning: PanningRef;
+  options: Required<ToastOptions>;
+  initialOptions: Required<ToastOptions>;
+  applyData: (data: ToastData) => void;
+  applyOptions: (options: Required<ToastOptions>) => void;
+  applyVisibility: (visible: boolean) => void;
+  cancelAutoHideTimer: () => void;
+};
+
+export type TimerSession = {
+  log: Log;
+  onTimeout: () => void;
+  delayMs: number;
+};
+
+export type SwipeSession = {
+  log: Log;
+  panning: PanningRef;
+  position: ToastPosition;
+  animate: (toValue: number) => void;
+  onHide: () => void;
+  onRestorePosition: () => void;
+};
+
+export type GestureSession = {
+  animatedValue: React.RefObject<Animated.Value>;
+  computeNewAnimatedValueForGesture: (gesture: PanResponderGestureState) => number;
+  onDismiss: () => void;
+  onRestore: () => void;
+  onStart: () => void;
+  onEnd: () => void;
+  disable?: boolean;
+};
+
+/**
+ * Central coordinator for the whole toast pipeline.
+ *
+ * Every part of the library funnels through here: instance registration and
+ * the imperative `Toast.show()` / `Toast.hide()` gateway, the presentation
+ * options and defaults, the auto-hide timer, the keyboard tracking, the
+ * layout measurement, the slide animation, the swipe gestures and the toast
+ * render config resolution. Keeping it all in one place makes sure every
+ * consumer observes the same lifecycle rules.
+ */
+export class ToastManager {
+  // ---------------------------------------------------------------------------
+  // Toast instance registry & imperative gateway
+  // ---------------------------------------------------------------------------
+
+  private static toastRefs: ToastRefObj[] = [];
+
+  /**
+   * Adds a ref to the end of the registry, which will be used to show the
+   * toasts until its ref becomes null.
+   */
+  static registerToastRef(newRef: ToastRef) {
+    ToastManager.toastRefs.push({
+      current: newRef
+    });
+  }
+
+  /**
+   * Removes the passed in ref from the registry using a strict equality check.
+   */
+  static unregisterToastRef(oldRef: ToastRef | null) {
+    ToastManager.toastRefs = ToastManager.toastRefs.filter(
+      (r) => r.current !== oldRef
+    );
+  }
+
+  /**
+   * Get the active Toast instance ref, by priority.
+   * The "highest" Toast in the `View` hierarchy has the highest priority.
+   */
+  static activeToast(): ToastRef | null {
+    const reversePriority = [...ToastManager.toastRefs].reverse();
+    const activeRef = reversePriority.find((ref) => ref?.current !== null);
+    if (!activeRef) {
+      return null;
+    }
+    return activeRef.current;
+  }
+
+  static showToast(params: ToastShowParams) {
+    ToastManager.activeToast()?.show(params);
+  }
+
+  static hideToast(params?: ToastHideParams) {
+    ToastManager.activeToast()?.hide(params);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Presentation defaults & options resolution
+  // ---------------------------------------------------------------------------
+
+  static readonly defaultData: ToastData = {
+    text1: undefined,
+    text2: undefined
+  };
+
+  static readonly defaultAnimationConfig: ToastSpringAnimationConfig = {
+    type: 'spring',
+    friction: 8
+  };
+
+  static readonly defaultOptions: Required<ToastOptions> = {
+    type: 'success',
+    text1Style: null,
+    text2Style: null,
+    position: 'top',
+    autoHide: true,
+    swipeable: true,
+    visibilityTime: 4000,
+    topOffset: 40,
+    bottomOffset: 40,
+    keyboardOffset: 10,
+    avoidKeyboard: true,
+    onShow: noop,
+    onHide: noop,
+    onPress: noop,
+    props: {},
+    animationConfig: ToastManager.defaultAnimationConfig
+  };
+
+  static mergeOptions(
+    baseOptions: Record<string, unknown>,
+    overrides: Record<string, unknown>
+  ) {
+    const mergedOptions = {
+      ...baseOptions
+    };
+    Object.entries(overrides).forEach(([key, value]) => {
+      if (value !== null && value !== undefined) {
+        mergedOptions[key] = value;
+      }
+    });
+    return mergedOptions;
+  }
+
+  static resolveShowParams(
+    params: ToastShowParams,
+    initialOptions: Required<ToastOptions>
+  ) {
+    const {
+      text1 = ToastManager.defaultData.text1,
+      text2 = ToastManager.defaultData.text2,
+      type = initialOptions.type,
+      text1Style = initialOptions.text1Style,
+      text2Style = initialOptions.text2Style,
+      position = initialOptions.position,
+      autoHide = initialOptions.autoHide,
+      visibilityTime = initialOptions.visibilityTime,
+      topOffset = initialOptions.topOffset,
+      bottomOffset = initialOptions.bottomOffset,
+      keyboardOffset = initialOptions.keyboardOffset,
+      avoidKeyboard = initialOptions.avoidKeyboard,
+      onShow = initialOptions.onShow,
+      onHide = initialOptions.onHide,
+      onPress = initialOptions.onPress,
+      swipeable = initialOptions.swipeable,
+      props = initialOptions.props,
+      animationConfig = initialOptions.animationConfig
+    } = params;
+
+    const data = {
+      text1,
+      text2
+    };
+    const options = ToastManager.mergeOptions(initialOptions, {
+      type,
+      text1Style,
+      text2Style,
+      position,
+      autoHide,
+      visibilityTime,
+      topOffset,
+      bottomOffset,
+      keyboardOffset,
+      avoidKeyboard,
+      onShow,
+      onHide,
+      onPress,
+      swipeable,
+      props,
+      animationConfig
+    }) as Required<ToastOptions>;
+
+    return {
+      data,
+      options
+    };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Presentation lifecycle state machine
+  // ---------------------------------------------------------------------------
+
+  private toastSession?: ToastSession;
+
+  bindToast(session: ToastSession) {
+    this.toastSession = session;
+  }
+
+  presentToast(params: ToastShowParams) {
+    const session = ToastManager.requireToastSession(this);
+    session.log(`Showing with params: ${JSON.stringify(params)}`);
+    // TODO: validate input
+    // TODO: use a queue when Toast is already visible
+    const { data, options } = ToastManager.resolveShowParams(
+      params,
+      session.initialOptions
+    );
+    session.applyData(data);
+    session.applyOptions(options);
+    session.applyVisibility(true);
+    options.onShow(params);
+  }
+
+  dismissToast() {
+    const session = ToastManager.requireToastSession(this);
+    session.log('Hiding');
+    session.applyVisibility(false);
+    session.cancelAutoHideTimer();
+    session.options.onHide();
+  }
+
+  runAutoHide() {
+    const session = ToastManager.requireToastSession(this);
+    if (session.panning.current) {
+      session.log('Auto hiding was blocked due to panning');
+    } else {
+      session.log('Auto hiding');
+      session.applyVisibility(false);
+      session.options.onHide();
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Auto-hide timer scheduling
+  // ---------------------------------------------------------------------------
+
+  private timerSession?: TimerSession;
+  private timerId?: NodeJS.Timeout;
+
+  bindTimer(session: TimerSession) {
+    this.timerSession = session;
+  }
+
+  startTimer() {
+    const { log, onTimeout, delayMs } = ToastManager.requireTimerSession(this);
+    this.clearTimer();
+    this.timerId = setTimeout(() => {
+      onTimeout();
+      log('Running timer', this.timerId);
+      this.timerId = undefined;
+    }, delayMs);
+    log('Starting timer', this.timerId);
+  }
+
+  clearTimer() {
+    const { log } = ToastManager.requireTimerSession(this);
+    if (this.timerId) {
+      log('Clearing timer', this.timerId);
+      clearTimeout(this.timerId);
+      this.timerId = undefined;
+    }
+  }
+
+  timerActive() {
+    return this.timerId !== undefined;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Keyboard position tracking
+  // ---------------------------------------------------------------------------
+
+  private didShowListener?: ReturnType<typeof Keyboard.addListener>;
+  private didHideListener?: ReturnType<typeof Keyboard.addListener>;
+
+  attachKeyboard(
+    onShow: (event: KeyboardEvent) => void,
+    onHide: () => void
+  ) {
+    if (!isIOS()) {
+      return;
+    }
+    this.didShowListener = Keyboard.addListener('keyboardDidShow', onShow);
+    this.didHideListener = Keyboard.addListener('keyboardDidHide', onHide);
+  }
+
+  detachKeyboard() {
+    this.didShowListener?.remove();
+    this.didHideListener?.remove();
+    this.didShowListener = undefined;
+    this.didHideListener = undefined;
+  }
+
+  // ---------------------------------------------------------------------------
+  // View layout measurement
+  // ---------------------------------------------------------------------------
+
+  static layoutValue(event: LayoutChangeEvent, key: 'height' | 'width') {
+    return event?.nativeEvent?.layout?.[key] ?? 0;
+  }
+
+  static viewDimensions(
+    event: LayoutChangeEvent,
+    {
+      heightOffset = 0,
+      widthOffset = 0
+    }: { heightOffset?: number; widthOffset?: number } = {}
+  ) {
+    const height =
+      ToastManager.layoutValue(event, 'height') + heightOffset;
+    const width = ToastManager.layoutValue(event, 'width') + widthOffset;
+    return {
+      height,
+      width
+    };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Slide animation & rendering math
+  // ---------------------------------------------------------------------------
+
+  static readonly nativeDriverActive: boolean = Platform.select({
+    ios: true,
+    default: false
+  });
+
+  static additiveInverse(values: number[]) {
+    return values.map((i) => -i);
+  }
+
+  static animationFor(
+    config: ToastAnimationConfig | undefined,
+    phase: 'enter' | 'exit'
+  ): ToastSingleAnimationConfig {
+    if (!config) {
+      return ToastManager.defaultAnimationConfig;
+    }
+    if ('type' in config) {
+      return config;
+    }
+    return config[phase] ?? ToastManager.defaultAnimationConfig;
+  }
+
+  static translateYRangeFor({
+    position,
+    height,
+    topOffset,
+    bottomOffset,
+    keyboardHeight,
+    keyboardOffset,
+    avoidKeyboard
+  }: {
+    position: ToastPosition;
+    height: number;
+    topOffset: number;
+    bottomOffset: number;
+    keyboardHeight: number;
+    keyboardOffset: number;
+    avoidKeyboard: boolean;
+  }) {
+    const offset = position === 'bottom' ? bottomOffset : topOffset;
+    const keyboardAwareOffset =
+      position === 'bottom' && avoidKeyboard
+        ? keyboardHeight + keyboardOffset
+        : 0;
+
+    const range = [-(height * 2), Math.max(offset, keyboardAwareOffset)];
+    const outputRange =
+      position === 'bottom' ? ToastManager.additiveInverse(range) : range;
+
+    return outputRange;
+  }
+
+  static slideAnimationStyles(
+    animatedValue: Animated.Value,
+    params: {
+      position: ToastPosition;
+      height: number;
+      topOffset: number;
+      bottomOffset: number;
+      keyboardHeight: number;
+      keyboardOffset: number;
+      avoidKeyboard: boolean;
+    }
+  ) {
+    const translateY = animatedValue.interpolate({
+      inputRange: [0, 1],
+      outputRange: ToastManager.translateYRangeFor(params)
+    });
+    const opacity = animatedValue.interpolate({
+      inputRange: [0, 0.7, 1],
+      outputRange: [0, 1, 1]
+    });
+    return {
+      opacity,
+      transform: [
+        {
+          translateY
+        }
+      ]
+    };
+  }
+
+  static slideAnimationTo(
+    animatedValue: Animated.Value,
+    animationConfig: ToastAnimationConfig | undefined,
+    toValue: number
+  ) {
+    const animation = ToastManager.animationFor(
+      animationConfig,
+      toValue === 1 ? 'enter' : 'exit'
+    );
+
+    if (animation.type === 'timing') {
+      const { type: _type, ...timingConfig } = animation;
+      Animated.timing(animatedValue, {
+        ...timingConfig,
+        toValue,
+        useNativeDriver: ToastManager.nativeDriverActive
+      }).start();
+    } else {
+      const { type: _type, ...springConfig } = animation;
+      Animated.spring(animatedValue, {
+        ...springConfig,
+        toValue,
+        useNativeDriver: ToastManager.nativeDriverActive
+      }).start();
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Swipe gesture physics & responder
+  // ---------------------------------------------------------------------------
+
+  /**
+   * Produces a positive damping value.
+   *
+   * To note: `moveY` becomes negative when going off-screen. By making sure the value
+   * produced is always positive, we avoid issues like: https://github.com/calintamas/react-native-toast-message/issues/280
+   */
+  static dampingFor(
+    gesture: PanResponderGestureState,
+    position: ToastPosition
+  ) {
+    const { moveY } = gesture;
+
+    switch (position) {
+      case 'bottom': {
+        const { height: screenHeight } = Dimensions.get('screen');
+        return Math.abs(screenHeight - moveY);
+      }
+      case 'top':
+        return Math.abs(moveY);
+      default:
+        throw new Error(`Toast position: ${position} not implemented`);
+    }
+  }
+
+  static animatedValueFor(
+    gesture: PanResponderGestureState,
+    position: ToastPosition,
+    damping: number
+  ) {
+    const boundValue = (val: number) => bound(val, 0, 2);
+    const { dy } = gesture;
+
+    switch (position) {
+      case 'bottom':
+        return boundValue(1 - dy / damping);
+      case 'top':
+        return boundValue(1 + dy / damping);
+      default:
+        throw new Error(`Toast position: ${position} not implemented`);
+    }
+  }
+
+  static swipeDismisses(
+    newAnimatedValue: number,
+    gesture: PanResponderGestureState
+  ) {
+    const dismissThreshold = 0.65;
+    const { vy, dy } = gesture;
+    return (
+      newAnimatedValue <= dismissThreshold ||
+      (Math.abs(vy) >= dismissThreshold && dy < 0)
+    );
+  }
+
+  static shouldStartPanOnStart() {
+    return true;
+  }
+
+  static shouldStartPanOnMove(
+    _event: GestureResponderEvent,
+    gesture: PanResponderGestureState
+  ) {
+    // Fixes onPress handler
+    // https://github.com/calintamas/react-native-toast-message/issues/113
+    const offset = 2;
+    return Math.abs(gesture.dx) > offset || Math.abs(gesture.dy) > offset;
+  }
+
+  private gestureSession?: GestureSession;
+
+  bindGesture(session: GestureSession) {
+    this.gestureSession = session;
+  }
+
+  createResponder() {
+    const manager = this;
+    return PanResponder.create({
+      onStartShouldSetPanResponder: ToastManager.shouldStartPanOnStart,
+      onPanResponderGrant: () => manager.onGestureGrant(),
+      onMoveShouldSetPanResponder: ToastManager.shouldStartPanOnMove,
+      onMoveShouldSetPanResponderCapture: ToastManager.shouldStartPanOnMove,
+      onPanResponderMove: (event: GestureResponderEvent, gesture: PanResponderGestureState) =>
+        manager.onGestureMove(event, gesture),
+      onPanResponderRelease: (event: GestureResponderEvent, gesture: PanResponderGestureState) =>
+        manager.onGestureRelease(event, gesture),
+      onPanResponderTerminate: () => manager.onGestureTerminate()
+    });
+  }
+
+  onGestureGrant() {
+    const session = ToastManager.requireGestureSession(this);
+    if (session.disable) return;
+    session.onStart();
+  }
+
+  onGestureMove(_event: GestureResponderEvent, gesture: PanResponderGestureState) {
+    const session = ToastManager.requireGestureSession(this);
+    if (session.disable) return;
+
+    const newAnimatedValue = session.computeNewAnimatedValueForGesture(gesture);
+
+    session.animatedValue.current?.setValue(newAnimatedValue);
+  }
+
+  onGestureRelease(
+    _event: GestureResponderEvent,
+    gesture: PanResponderGestureState
+  ) {
+    const session = ToastManager.requireGestureSession(this);
+    session.onEnd();
+
+    if (session.disable) return;
+
+    const newAnimatedValue = session.computeNewAnimatedValueForGesture(gesture);
+    if (ToastManager.swipeDismisses(newAnimatedValue, gesture)) {
+      session.onDismiss();
+    } else {
+      session.onRestore();
+    }
+  }
+
+  onGestureTerminate() {
+    const session = ToastManager.requireGestureSession(this);
+    session.onEnd();
+    if (session.disable) return;
+    session.onRestore();
+  }
+
+  // ---------------------------------------------------------------------------
+  // Swipe visual session (panning flags, restore / dismiss animation)
+  // ---------------------------------------------------------------------------
+
+  private swipeSession?: SwipeSession;
+
+  bindSwipe(session: SwipeSession) {
+    this.swipeSession = session;
+  }
+
+  onSwipeStart() {
+    const session = ToastManager.requireSwipeSession(this);
+    session.log('Swipe, pan start');
+    session.panning.current = true;
+  }
+
+  onSwipeEnd() {
+    const session = ToastManager.requireSwipeSession(this);
+    session.log('Swipe, pan end');
+    session.panning.current = false;
+  }
+
+  onSwipeDismiss() {
+    const session = ToastManager.requireSwipeSession(this);
+    session.log('Swipe, dismissing');
+    session.animate(0);
+    session.onHide();
+  }
+
+  onSwipeRestore() {
+    const session = ToastManager.requireSwipeSession(this);
+    session.log('Swipe, restoring to original position');
+    session.animate(1);
+    session.onRestorePosition();
+  }
+
+  swipeAnimatedValueFor(gesture: PanResponderGestureState) {
+    const session = ToastManager.requireSwipeSession(this);
+    const damping = ToastManager.dampingFor(gesture, session.position);
+    return ToastManager.animatedValueFor(gesture, session.position, damping);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Toast render config resolution
+  // ---------------------------------------------------------------------------
+
+  static readonly defaultRenderers: ToastConfig = {
+    success: (props) => <SuccessToast {...props} />,
+    error: (props) => <ErrorToast {...props} />,
+    info: (props) => <InfoToast {...props} />
+  };
+
+  static rendererFor(type: ToastOptions['type'], config?: ToastConfig) {
+    const toastRenderers = {
+      ...ToastManager.defaultRenderers,
+      ...config
+    };
+    const ToastRenderer = type == null ? undefined : toastRenderers[type];
+
+    if (!ToastRenderer) {
+      throw new Error(
+        `Toast type: '${type}' does not exist. You can add it via the 'config' prop on the Toast instance. Learn more: https://github.com/calintamas/react-native-toast-message/blob/master/README.md`
+      );
+    }
+
+    return ToastRenderer;
+  }
+
+  static renderToast({
+    data,
+    options,
+    config,
+    isVisible,
+    show,
