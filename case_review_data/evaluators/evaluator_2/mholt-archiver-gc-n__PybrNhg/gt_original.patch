-		openFlags |= os.O_TRUNC
-	} else {
-		openFlags |= os.O_EXCL // refuse to clobber what's already on disk
-	}
-	dst, err := os.OpenFile(destPath, openFlags, perm)
-	if err != nil {
-		return err
-	}
-
-	if _, err := io.Copy(dst, src); err != nil {
-		dst.Close()
-		return err
-	}
-	return dst.Close()
-}
