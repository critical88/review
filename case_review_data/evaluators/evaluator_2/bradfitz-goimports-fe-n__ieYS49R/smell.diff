+// Copyright 2013 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package main
+
+import (
+	"golang.org/x/tools/imports"
+)
+
+// A session owns the settings and the progress of one goimports run:
+// the reporting modes selected on the command line, the formatter
+// options, and the error tally that decides the exit status.
+type session struct {
+	// reporting modes, selected with -l, -w and -d
+	list   bool
+	write  bool
+	doDiff bool
+
+	// whether this run reads standard input rather than named paths
+	stdin bool
+
+	// formatter settings, seeded from the command-line defaults
+	opts imports.Options
+
+	// files we had to give up on
+	failures int
+}
+
+// newSession captures the command-line shape of one run.
+func newSession(list, write, doDiff, stdin bool, opts imports.Options) *session {
+	return &session{
+		list:   list,
+		write:  write,
+		doDiff: doDiff,
+		stdin:  stdin,
+		opts:   opts,
+	}
+}
+
+// optionsFor reports the formatter settings one input should use.
+// Standard input is never a complete file, so fragment mode is forced
+// for it; the settings of the run are left untouched.
+func (s *session) optionsFor() *imports.Options {
+	opts := s.opts
+	if s.stdin {
+		opts.Fragment = true
+	}
+	return &opts
+}
+
+// failed reports whether any file had to be given up on.
+func (s *session) failed() bool {
+	return s.failures > 0
+}
