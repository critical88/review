+// Copyright 2013 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package main
+
+import (
+	"bytes"
+	"fmt"
+	"go/scanner"
+	"io"
+	"io/ioutil"
+)
+
+// A report owns the streams a run writes to: formatted results, diffs
+// and diagnostics all go through it.  It also carries a handle to the
+// run it reports for, so that the reporting modes stay within reach
+// while an outcome is being written up.
+type report struct {
+	out    io.Writer
+	errOut io.Writer
+	sess   *session
+}
+
+// newReport prepares the report streams for a run.
+func newReport(out, errOut io.Writer, sess *session) *report {
+	return &report{out: out, errOut: errOut, sess: sess}
+}
+
+// deliverResult presents the outcome for one processed file.  The
+// run's reporting modes decide between listing the file, writing its
+// formatted text back, showing a diff, and the plain formatted text
+// itself.
+func (r *report) deliverResult(fh *sourceFile) error {
+	s := r.sess
+	if !bytes.Equal(fh.data, fh.rendered) {
+		// formatting has changed
+		if s.list {
+			fmt.Fprintln(r.out, fh.display)
+		}
+		if s.write {
+			if err := ioutil.WriteFile(fh.display, fh.rendered, 0); err != nil {
+				return err
+			}
+		}
+		if s.doDiff {
+			if err := r.showDiff(fh); err != nil {
+				return err
+			}
+		}
+	}
+
+	if !s.list && !s.write && !s.doDiff {
+		_, err := r.out.Write(fh.rendered)
+		return err
+	}
+
+	return nil
+}
+
+// showDiff writes a unified diff between the original and the
+// formatted text of one file, in gofmt's format.
+func (r *report) showDiff(fh *sourceFile) error {
+	data, err := diff(fh.data, fh.rendered)
+	if err != nil {
+		return fmt.Errorf("computing diff: %s", err)
+	}
+	fmt.Printf("diff %s gofmt/%s\n", fh.display, fh.display)
+	_, _ = r.out.Write(data)
+	return nil
+}
+
+// noteProblem reports a failure on the diagnostics stream and keeps
+// the run's error tally in sync so the exit status comes out right.
+func (r *report) noteProblem(s *session, err error) {
+	if err == nil {
+		return
+	}
+	scanner.PrintError(r.errOut, err)
+	s.failures++
+}
