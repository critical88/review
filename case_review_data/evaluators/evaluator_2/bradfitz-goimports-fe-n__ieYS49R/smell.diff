@@ -0,0 +1,137 @@
+// Copyright 2013 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package main
+
+import (
+	"io/ioutil"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/tools/imports"
+)
+
+// A walker finds the files a run should look at — the paths named on
+// the command line and the Go files below them — and runs each one
+// through the formatter.
+type walker struct {
+	rep *report
+}
+
+// newWalker prepares the traversal for a run.
+func newWalker(rep *report) *walker {
+	return &walker{rep: rep}
+}
+
+// paths processes each command-line argument in turn: directories are
+// walked recursively, anything else is treated as a single file.
+func (w *walker) paths(s *session, args []string) {
+	for i := 0; i < len(args); i++ {
+		path := args[i]
+		switch dir, err := os.Stat(path); {
+		case err != nil:
+			w.rep.noteProblem(s, err)
+		case dir.IsDir():
+			w.walkDir(s, path)
+		default:
+			if err := w.processFile(s, path); err != nil {
+				w.rep.noteProblem(s, err)
+			}
+		}
+	}
+}
+
+// walkDir visits every Go file under path.
+func (w *walker) walkDir(s *session, path string) {
+	filepath.Walk(path, func(p string, fi os.FileInfo, err error) error {
+		return w.visitFile(s, p, fi, err)
+	})
+}
+
+// visitFile processes one candidate discovered by a walk. Walk
+// errors and per-file failures are reported, but never stop the walk.
+func (w *walker) visitFile(s *session, path string, fi os.FileInfo, err error) error {
+	if err == nil && isGoFile(fi) {
+		err = w.processFile(s, path)
+	}
+	if err != nil {
+		w.rep.noteProblem(s, err)
+	}
+	return nil
+}
+
+// formatStdin handles the no-argument invocation: standard input is
+// read into the work record, formatted as a fragment, and the outcome
+// is presented under the run's reporting modes.
+func (w *walker) formatStdin(s *session, fh *sourceFile) error {
+	src, err := ioutil.ReadAll(os.Stdin)
+	if err != nil {
+		return err
+	}
+	fh.data = src
+
+	opts := s.opts
+	if s.stdin {
+		opts.Fragment = true
+	}
+	res, err := imports.Process(fh.display, fh.data, &opts)
+	if err != nil {
+		return err
+	}
+	fh.rendered = res
+
+	// without an explicit reporting mode the formatted text simply
+	// goes to the output stream
+	if !s.list && !s.write && !s.doDiff {
+		_, err := w.rep.out.Write(fh.rendered)
+		return err
+	}
+	return w.rep.deliverResult(fh)
+}
+
+// open reads the file at path into a work record.
+func (w *walker) open(path string) (*sourceFile, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	src, err := ioutil.ReadAll(f)
+	if err != nil {
+		return nil, err
+	}
+	return &sourceFile{display: path, data: src}, nil
+}
+
+// processFile runs one file through the formatter and hands the
+// result to the reporting layer.
+func (w *walker) processFile(s *session, path string) error {
+	fh, err := w.open(path)
+	if err != nil {
+		return err
+	}
+	if err := w.rerender(s, fh); err != nil {
+		return err
+	}
+	return w.rep.deliverResult(fh)
+}
+
+// rerender formats the text stored in one work record and keeps the
+// result next to it.
+func (w *walker) rerender(s *session, fh *sourceFile) error {
+	res, err := imports.Process(fh.display, fh.data, s.optionsFor())
+	if err != nil {
+		return err
+	}
+	fh.rendered = res
+	return nil
+}
+
+// isGoFile reports whether fi names a Go source file worth looking at.
+func isGoFile(fi os.FileInfo) bool {
+	// ignore non-Go files
+	name := fi.Name()
+	return !fi.IsDir() && !strings.HasPrefix(name, ".") && strings.HasSuffix(name, ".go")
+}
