+// Copyright 2013 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package main
+
+// A sourceFile is one candidate input of a run: the name to show for
+// it, the bytes exactly as they were read, and the rendered text
+// gofmt proposes for them once formatting is done.
+type sourceFile struct {
+	display  string
+	data     []byte
+	rendered []byte
+}
