diff --git a/src/wd.rs b/src/wd.rs
index 433162d..9981544 100644
--- a/src/wd.rs
+++ b/src/wd.rs
@@ -12,11 +12,61 @@ use std::time::Duration;
 use url::{ParseError, Url};
 use webdriver::command::TimeoutsParameters;
 
+/// A command that carries vendor-specific routing and transport requirements.
+///
+/// WebDriver deployments increasingly sit behind vendor-managed infrastructure
+/// ( Selenium grids, cloud browser farms, vendor admin consoles ) where a
+/// command may have to be sent somewhere other than the endpoint implied by
+/// the WebDriver base URL, or where additional vendor headers ( proxy
+/// authorizations, tenant identifiers, trace tokens ) must accompany the
+/// request.
+///
+/// Commands defined against the standard WebDriver endpoints simply carry
+/// the default transport behavior: they target the URL produced from the
+/// WebDriver base URL and attach no additional headers.
+pub trait VendorRequestCommand: Debug {
+    /// The URL this command should be sent to, if the request must bypass the
+    /// endpoint reached through the WebDriver base URL.
+    fn vendor_url(&self) -> Option<url::Url>;
+
+    /// Additional headers that must be attached to the outgoing request for
+    /// this command.
+    fn vendor_headers(&self) -> Vec<(String, String)>;
+}
+
+/// Blanket implementation for &T, for better ergonomics.
+impl<T> VendorRequestCommand for &T
+where
+    T: VendorRequestCommand + ?Sized,
+{
+    fn vendor_url(&self) -> Option<Url> {
+        T::vendor_url(self)
+    }
+
+    fn vendor_headers(&self) -> Vec<(String, String)> {
+        T::vendor_headers(self)
+    }
+}
+
+/// Blanket implementation for Box<T>, for better ergonomics.
+impl<T> VendorRequestCommand for Box<T>
+where
+    T: VendorRequestCommand + ?Sized,
+{
+    fn vendor_url(&self) -> Option<Url> {
+        T::vendor_url(self)
+    }
+
+    fn vendor_headers(&self) -> Vec<(String, String)> {
+        T::vendor_headers(self)
+    }
+}
