+/// Encodes and attempts to write the ext value as the explicit `(`ty`, `len`, `data`)` triple: the
+/// ext metadata built from the given length and type id, followed by the payload itself.
+///
+/// # Errors
+///
+/// This function returns Error with an underlying I/O error if unable to properly write the ext
+/// value. Interruption errors are handled internally by silent operation restarting.
+fn write_ext_value<W>(wr: &mut W, ty: i8, len: u32, data: &[u8]) -> Result<(), Error>
+    where W: Write
+{
