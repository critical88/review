diff --git a/rmp/src/encode/ext.rs b/rmp/src/encode/ext.rs
index 8b13789..36fb222 100644
--- a/rmp/src/encode/ext.rs
+++ b/rmp/src/encode/ext.rs
@@ -1 +1,43 @@
+use super::{write_marker, RmpWrite, ValueWriteError};
+use crate::Marker;
 
+/// Encodes and attempts to write the ext meta header: the marker, the payload size and the type id.
+///
+/// Both the payload size and the application type id are taken explicitly, mirroring the
+/// `write_ext_meta` primitive, with the payload itself remaining the caller's business.
+///
+/// # Errors
+///
+/// This function will return `ValueWriteError` on any I/O error occurred while writing either the
+/// marker or the data.
+pub(super) fn write_ext_header<W: RmpWrite>(wr: &mut W, len: u32, ty: i8) -> Result<(), ValueWriteError<W::Error>> {
+    let marker = ext_len_marker(len);
+
+    write_marker(wr, marker)?;
+    if marker == Marker::Ext8 {
+        wr.write_data_u8(len as u8)?;
+    } else if marker == Marker::Ext16 {
+        wr.write_data_u16(len as u16)?;
+    } else if marker == Marker::Ext32 {
+        wr.write_data_u32(len)?;
+    }
+
+    wr.write_data_i8(ty)?;
+
+    Ok(())
+}
+
+/// Encodes and attempts to write the most efficient ext length implementation for the given ext
+/// payload size, returning the marker used.
+pub(super) fn ext_len_marker(len: u32) -> Marker {
+    match len {
+        1 => Marker::FixExt1,
+        2 => Marker::FixExt2,
+        4 => Marker::FixExt4,
+        8 => Marker::FixExt8,
+        16 => Marker::FixExt16,
+        0..=255 => Marker::Ext8,
+        256..=65535 => Marker::Ext16,
+        _ => Marker::Ext32,
+    }
+}
