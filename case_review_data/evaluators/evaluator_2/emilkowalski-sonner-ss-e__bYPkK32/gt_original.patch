diff --git a/src/options.ts b/src/options.ts
new file mode 100644
index 0000000..057d29e
--- /dev/null
+++ b/src/options.ts
@@ -0,0 +1,75 @@
+import type { CSSProperties } from 'react';
+
+import { getAsset } from './assets';
+import type { ToastIcons, ToasterProps, ToastT, ToastTypes } from './types';
+
+// Everything that decides how a toast inherits its presentation options lives
+// in this module. The layers that can carry a value are, from most specific to
+// least specific: the toast record itself, the `toastOptions` the <Toaster>
+// was configured with, and the props of the <Toaster>. Every helper below
+// spells out which layer wins for the option it is responsible for, so adding
+// or changing an inheritable option only ever touches this one place.
+
+// The <Toaster> wires its own props into every toast it renders, and its
+// `toastOptions` are the more specific layer for the toasts of that toaster:
+// they win whenever they carry a value.
+export const getWiredToastOptions = (
+  toastOptions: ToasterProps['toastOptions'],
+  duration: ToasterProps['duration'],
+  closeButton: ToasterProps['closeButton'],
+) => {
+  return {
+    duration: toastOptions?.duration ?? duration,
+    closeButton: toastOptions?.closeButton ?? closeButton,
+  };
+};
+
+// Default lifetime of a toasts (in ms)
+const TOAST_LIFETIME = 4000;
+
+// A toast lives as long as it says, otherwise as long as its toaster says,
+// and when nobody says anything it gets the default lifetime above.
+export const getToastDuration = (toast: ToastT, durationFromToaster: number | undefined) => {
+  return toast.duration || durationFromToaster || TOAST_LIFETIME;
+};
+
+// `closeButton` is tri-state: unset on the toast means "do what the toaster does".
+export const getToastCloseButton = (toast: ToastT, closeButtonFromToaster: boolean | undefined) => {
+  return toast.closeButton ?? closeButtonFromToaster;
+};
+
+// A toast renders inverted when the toast itself or the toaster it belongs to
+// asks for it. `invert` is tri-state like `closeButton`: unset on the toast
+// means "do what the toaster does".
+export const getToastInvert = (toast: ToastT, toasterInvert: boolean | undefined) => {
+  return toast.invert || toasterInvert;
+};
+
+// Rich colors are the colored variant of a type: green success, red error and so
+// on. The toast opts in itself or, when it doesn't care, the toaster decides.
+export const getToastRichColors = (toast: ToastT, defaultRichColors: boolean | undefined) => {
+  return toast.richColors ?? defaultRichColors;
+};
+
+// Only toasts that don't bring their own JSX and are not opted out of the
+// built-in styling are rendered with it. Everything else is on its own.
+export const getToastStyled = (toast: ToastT, toasterUnstyled: boolean | undefined) => {
+  return !Boolean(toast.jsx || toast.unstyled || toasterUnstyled);
+};
+
+// Which icon a toast renders with is decided in steps: an icon the toast carries
+// itself wins, then the icons the toaster was configured with, and only then the
+// built-in asset for the type of the toast.
+export const getToastIcon = (toast: ToastT, toastType: ToastTypes | undefined, icons?: ToastIcons) => {
+  return toast.icon || icons?.[toastType] || getAsset(toastType);
+};
+
+// The styles of the cancel and action buttons of the description. A style set
+// on the toast itself wins over the one the toaster was configured with.
+export const getToastCancelButtonStyle = (toast: ToastT, toasterCancelButtonStyle: CSSProperties | undefined) => {
+  return toast.cancelButtonStyle || toasterCancelButtonStyle;
+};
+
+export const getToastActionButtonStyle = (toast: ToastT, toasterActionButtonStyle: CSSProperties | undefined) => {
+  return toast.actionButtonStyle || toasterActionButtonStyle;
+};
