+// The presentation options a toast record carries with it. An update doesn't
+// restate them: it keeps what the toast was created with unless the update sets
+// its own value, so subscribers and `getHistory()` keep seeing the same toast
+// and not a stripped down copy of it.
+const getStoredPresentation = (stored: ToastT, update: ExternalToast) => {
+  return {
+    richColors: update.richColors ?? stored.richColors,
+    invert: update.invert ?? stored.invert,
+    unstyled: update.unstyled ?? stored.unstyled,
+    closeButton: update.closeButton ?? stored.closeButton,
+    classNames: update.classNames ?? stored.classNames,
+    // `icon: null` removes the icon of a toast, so a value that is set on the
+    // update always wins here instead of falling back to the stored one.
+    icon: update.icon !== undefined ? update.icon : stored.icon,
+  };
+};
