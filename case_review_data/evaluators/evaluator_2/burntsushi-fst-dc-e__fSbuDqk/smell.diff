+/// Compile steps shared by every `Builder` entry point. They thread the writer,
+/// node registry and last compiled address explicitly, together with the pieces
+/// of the node being compiled.
+///
+/// Serializes one node and records it in the registry, returning the address
+/// at which it was written.
+fn builder_compile_node<W: io::Write>(
+    wtr: &mut CountingWriter<W>,
+    registry: &mut Registry,
+    last_addr: &mut CompiledAddr,
+    is_final: bool,
+    final_output: Output,
+    trans: &[Transition],
+) -> Result<CompiledAddr> {
+    if is_final && trans.is_empty() && final_output.is_zero() {
+        return Ok(EMPTY_ADDRESS);
+    }
+    let entry = registry.entry(is_final, final_output, trans);
+    if let RegistryEntry::Found(ref addr) = entry {
+        return Ok(*addr);
+    }
+    let start_addr = wtr.count() as CompiledAddr;
+    Node::compile(&mut *wtr, *last_addr, start_addr, is_final, final_output, trans)?;
+    *last_addr = wtr.count() as CompiledAddr - 1;
+    if let RegistryEntry::NotFound(cell) = entry {
+        cell.insert(*last_addr);
+    }
+    Ok(*last_addr)
+}
+
+/// Compiles and drains every unfinished node below `istate`, from the deepest
+/// to the shallowest.
+fn builder_compile_from<W: io::Write>(
+    wtr: &mut CountingWriter<W>,
+    registry: &mut Registry,
+    last_addr: &mut CompiledAddr,
+    unfinished: &mut UnfinishedNodes,
+    istate: usize,
+) -> Result<()> {
+    let mut addr = NONE_ADDRESS;
+    while istate + 1 < unfinished.len() {
+        let node = if addr == NONE_ADDRESS {
+            unfinished.pop_empty()
+        } else {
+            unfinished.pop_freeze(addr)
+        };
+        addr = builder_compile_node(
+            wtr,
+            registry,
+            last_addr,
+            node.is_final,
+            node.final_output,
+            &node.trans,
+        )?;
+        assert!(addr != NONE_ADDRESS);
+    }
+    unfinished.top_last_freeze(addr);
+    Ok(())
+}
+
+/// Compiles the final root node and returns its address.
+fn builder_compile_root<W: io::Write>(
+    wtr: &mut CountingWriter<W>,
+    registry: &mut Registry,
+    last_addr: &mut CompiledAddr,
+    unfinished: &mut UnfinishedNodes,
+) -> Result<CompiledAddr> {
+    let root_node = unfinished.pop_root();
+    builder_compile_node(
+        wtr,
+        registry,
+        last_addr,
+        root_node.is_final,
+        root_node.final_output,
+        &root_node.trans,
+    )
+}
