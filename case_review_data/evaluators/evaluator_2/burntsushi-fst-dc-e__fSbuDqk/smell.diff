+/// Overwrites a cached node with the pieces of a builder node supplied by the
+/// caller of the registry.
+fn reg_node_store(
+    node: &mut BuilderNode,
+    is_final: bool,
+    final_output: Output,
+    trans: &[Transition],
+) {
+    node.is_final = is_final;
+    node.final_output = final_output;
+    node.trans.clear();
+    node.trans.extend(trans.iter());
