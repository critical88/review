+    root_addr: CompiledAddr,
+    mut value: u64,
+    key: &mut Vec<u8>,
+) -> bool {
+    let mut addr = root_addr;
+    while value != 0 || !node_is_final(version, data, addr) {
+        let ntrans = node_transition_count(version, data, addr);
+        let mut chosen = None;
+        for i in 0..ntrans {
