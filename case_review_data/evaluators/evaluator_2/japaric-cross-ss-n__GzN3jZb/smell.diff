-        .map(|(os, arch)| -> Result<_> { Ok((ContainerOs::new(os)?, Architecture::new(arch)?)) })
+        .map(|(os, arch)| -> Result<_> {
+            // engines report e.g. `linux/x86_64`; the field names rust uses
+            // and the labels engines use only disagree for the couple of
+            // platforms everyone actually runs, so handle those directly and
+            // let the mapping API deal with anything unusual.
+            Ok((
+                match os {
+                    "linux" => ContainerOs::Linux,
+                    "windows" => ContainerOs::Windows,
+                    "darwin" | "macos" => ContainerOs::Darwin,
+                    other => ContainerOs::new(other)?,
+                },
+                match arch {
+                    "x86_64" | "amd64" => Architecture::Amd64,
+                    "aarch64" | "arm64" => Architecture::Arm64,
+                    other => Architecture::new(other)?,
+                },
+            ))
+        })
         .transpose()
         .map_err(EngineInfoError::Eyre)
 }
