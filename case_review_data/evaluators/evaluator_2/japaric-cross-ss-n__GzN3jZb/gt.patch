+
+    #[test]
+    fn with_picked_host_resolves_through_single_owner() -> Result<()> {
+        // A picked host must resolve to exactly what
+        // `ImagePlatform::from_target` (the single owner for triple -> platform)
+        // produces, including the hosts that previously had hand-rolled decoders
+        // here. This guards against re-introducing a divergent decoder.
+        let base = QualifiedToolchain::new(
+            "nightly",
+            &None,
+            &ImagePlatform::from_const_target(TargetTriple::X86_64UnknownLinuxGnu),
+            Path::new("/tmp/toolchain"),
+            false,
+        );
+
+        for host in [
+            "x86_64-unknown-linux-gnu",
+            "x86_64-apple-darwin",
+            "x86_64-pc-windows-msvc",
+            "aarch64-unknown-linux-gnu",
+            "aarch64-apple-darwin",
+            "aarch64-pc-windows-msvc",
+            "arm-unknown-linux-gnueabihf",
+            "armv7-unknown-linux-gnueabihf",
+            "powerpc64-unknown-linux-gnu",
+            "riscv64gc-unknown-linux-gnu",
+            "s390x-unknown-linux-gnu",
+            "loongarch64-unknown-linux-gnu",
+        ] {
+            let picked: Toolchain = format!("nightly-{host}").parse()?;
+            let result = base.clone().with_picked(picked)?;
+            assert_eq!(
+                result.host(),
+                &ImagePlatform::from_target(host.into())?,
+                "picked host `{host}` should resolve through the single owner",
+            );
+        }
+        Ok(())
+    }
