+// mixInitiationTranscript mixes the sender's static public key and the
+// message's ephemeral public key into the transcript, deriving the initial
+// chain key.
+func (device *Device) mixInitiationTranscript(msg *MessageInitiation, hash *[blake2s.Size]byte, chainKey *[blake2s.Size]byte) {
+	mixHash(hash, &InitialHash, device.staticIdentity.publicKey[:])
+	mixHash(hash, hash, msg.Ephemeral[:])
+	mixKey(chainKey, &InitialChainKey, msg.Ephemeral[:])
+}
+
+// decryptInitiationStatic decrypts the peer's static public key from the
+// initiation message, advancing the transcript. It reports whether the
+// static field authenticated correctly.
+func (device *Device) decryptInitiationStatic(msg *MessageInitiation, hash *[blake2s.Size]byte, chainKey *[blake2s.Size]byte) (peerPK NoisePublicKey, ok bool) {
+	// decrypt static key
+
+	var key [chacha20poly1305.KeySize]byte
+	ss, err := device.staticIdentity.privateKey.sharedSecret(msg.Ephemeral)
+	if err != nil {
+		return peerPK, false
+	}
+	KDF2(chainKey, &key, chainKey[:], ss[:])
+	aead, _ := chacha20poly1305.New(key[:])
+	_, err = aead.Open(peerPK[:0], ZeroNonce[:], msg.Static[:], hash[:])
+	if err != nil {
+		return peerPK, false
+	}
+	mixHash(hash, hash, msg.Static[:])
+	return peerPK, true
+}
+
+// verifyInitiationTimestamp decrypts and authenticates the initiation
+// timestamp using the peer's precomputed static-static secret, advancing the
+// transcript, and evaluates the replay and flood conditions for the message.
+func (device *Device) verifyInitiationTimestamp(handshake *Handshake, msg *MessageInitiation, hash *[blake2s.Size]byte, chainKey *[blake2s.Size]byte) (timestamp tai64n.Timestamp, replay bool, flood bool, ok bool) {
+	handshake.mutex.RLock()
+	defer handshake.mutex.RUnlock()
+
+	// verify identity
+
+	if isZero(handshake.precomputedStaticStatic[:]) {
+		return timestamp, false, false, false
+	}
+	var key [chacha20poly1305.KeySize]byte
+	KDF2(
+		chainKey,
+		&key,
+		chainKey[:],
+		handshake.precomputedStaticStatic[:],
+	)
+	aead, _ := chacha20poly1305.New(key[:])
+	_, err := aead.Open(timestamp[:0], ZeroNonce[:], msg.Timestamp[:], hash[:])
+	if err != nil {
+		return timestamp, false, false, false
+	}
+	mixHash(hash, hash, msg.Timestamp[:])
+
+	// protect against replay & flood
+
+	replay = !timestamp.After(handshake.lastTimestamp)
+	flood = time.Since(handshake.lastInitiationConsumption) <= HandshakeInitationRate
+	return timestamp, replay, flood, true
+}
