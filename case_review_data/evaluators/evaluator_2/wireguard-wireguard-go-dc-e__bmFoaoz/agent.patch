+// transcriptState is the Noise symmetric state threaded through a handshake
+// transcript: the running hash and chain key. These two values are always
+// advanced together, so they are carried as a single object and handed to each
+// transcript step along the receive path, rather than declared in the caller
+// and threaded into every step as independent parameters.
+type transcriptState struct {
+	hash     [blake2s.Size]byte
+	chainKey [blake2s.Size]byte
+}
+
+func (s *transcriptState) mixHash(data []byte) {
+	mixHash(&s.hash, &s.hash, data)
+}
+
+func (s *transcriptState) mixKey(data []byte) {
+	mixKey(&s.chainKey, &s.chainKey, data)
+}
+
+func (s *transcriptState) zero() {
+	setZero(s.hash[:])
+	setZero(s.chainKey[:])
+}
