+static int find_by_name(const void *a, const void *b)
+{
+	const char *name = a;
+	const struct uftrace_symbol *sym = *(const struct uftrace_symbol **)b;
+
+	return strcmp(name, sym->name);
+}
+
+static struct uftrace_symbol *find_sym_by_name(struct find_func_data *data,
+					       struct uftrace_symtab *symtab)
+{
+	const char *name = data->name;
+	size_t i;
+
+	if (symtab->name_sorted) {
+		struct uftrace_symbol **psym;
+
+		psym = bsearch(name, symtab->sym_names, symtab->nr_sym, sizeof(*psym), find_by_name);
+		if (psym)
+			return *psym;
+
+		return NULL;
+	}
+
+	for (i = 0; i < symtab->nr_sym; i++) {
+		struct uftrace_symbol *sym = &symtab->sym[i];
+
+		if (!strcmp(name, sym->name))
+			return sym;
+	}
+
+	return NULL;
+}
+
