+// ackQueryOrigin acknowledges a received query back to the node that issued
+// it, using the originator address, port and node name carried by the query,
+// and relays a copy of the ack for redundancy.
+func (s *Serf) ackQueryOrigin(
+	queryLTime LamportTime,
+	queryID uint32,
+	originAddr []byte,
+	originPort uint16,
+	originNode string,
+	relayFactor uint8,
+) {
+	ack := messageQueryResponse{
+		LTime: queryLTime,
+		ID:    queryID,
+		From:  s.config.NodeName,
+		Flags: queryFlagAck,
+	}
+	raw, err := encodeMessage(messageQueryResponseType, &ack, s.msgpackUseNewTimeFormat)
+	if err != nil {
+		s.logger.Printf("[ERR] serf: failed to format ack: %v", err)
+		return
+	}
+	if err := s.deliverQueryMessage(raw, originAddr, int(originPort), originNode); err != nil {
+		s.logger.Printf("[ERR] serf: failed to send ack: %v", err)
+	}
+	if err := s.relayResponse(relayFactor, originAddr, int(originPort), originNode, &ack); err != nil {
+		s.logger.Printf("[ERR] serf: failed to relay ack: %v", err)
+	}
+}
+
+// deliverQueryMessage sends an already encoded message directly over UDP to
+// the peer at the given address, port and node name.
+func (s *Serf) deliverQueryMessage(
+	raw []byte,
+	replyAddr []byte,
+	replyPort int,
+	replyNode string,
+) error {
+	udpAddr := net.UDPAddr{IP: replyAddr, Port: replyPort}
+	addr := memberlist.Address{
+		Addr: udpAddr.String(),
+		Name: replyNode,
+	}
+	return s.memberlist.SendToAddress(addr, raw)
+}
+
+// sendQueryResponse delivers a raw encoded response directly to the
+// originator of the query it belongs to using the originator's reply address,
+// port and node name, then relays a copy for redundancy.
+func (s *Serf) sendQueryResponse(
+	queryLTime LamportTime,
+	queryID uint32,
+	replyAddr []byte,
+	replyPort uint16,
+	replyNode string,
+	relayFactor uint8,
+	raw []byte,
+	resp messageQueryResponse,
+) error {
+	if err := s.deliverQueryMessage(raw, replyAddr, int(replyPort), replyNode); err != nil {
+		return err
+	}
+	return s.relayResponse(relayFactor, replyAddr, int(replyPort), replyNode, &resp)
+}
+
