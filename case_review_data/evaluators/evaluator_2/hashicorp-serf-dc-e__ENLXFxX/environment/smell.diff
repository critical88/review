+// forwardRelayedMessage sends the unwrapped payload of a relayed message on
+// to the destination address, port and node name carried by its header.
+func (d *delegate) forwardRelayedMessage(
+	destIP net.IP,
+	destPort int,
+	destNode string,
+	raw []byte,
+) {
+	udpAddr := net.UDPAddr{IP: destIP, Port: destPort}
+	addr := memberlist.Address{
+		Addr: udpAddr.String(),
+		Name: destNode,
+	}
