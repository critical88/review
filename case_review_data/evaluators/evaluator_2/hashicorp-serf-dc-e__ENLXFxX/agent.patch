+// nodeAddress names a node's reply endpoint by bundling the network address
+// (IP and port) used to reach it with that node's name. It is the single unit
+// a query carries so that every node that handles the query — or relays a
+// copy of a response, or an acknowledgement for redundancy through peers —
+// can route replies back to the originator. The address and port travel
+// together because a network destination is meaningless split apart, and the
+// name rides along so memberlist can label the recipient on the final hop.
+//
+// The wire representations keep their historical layout (messageQuery's
+// Addr/Port/SourceNode fields and relayHeader's DestAddr/DestName); nodeAddress
+// holds the same values once they have been decoded off the wire and up until
+// they are re-encoded for another hop, so the address, port and name no longer
+// need to be threaded through every handler as independently-coordinated
+// values.
+type nodeAddress struct {
+	Addr net.IP
+	Port uint16
+	Name string
+}
+
+// sendToNode delivers an already-encoded message directly over UDP to the node
+// at the given reply endpoint, addressing it by its IP, port and name.
+// Forwarding a relayed message, delivering a direct query response, and
+// relaying a copy of a response through a peer are the same operation from
+// memberlist's point of view, so they share this single entry point instead of
+// each rebuilding the target address from its individual parts.
+func (s *Serf) sendToNode(dest nodeAddress, raw []byte) error {
+	udpAddr := net.UDPAddr{IP: dest.Addr, Port: int(dest.Port)}
+	return s.memberlist.SendToAddress(memberlist.Address{
+		Addr: udpAddr.String(),
+		Name: dest.Name,
+	}, raw)
+}
+
