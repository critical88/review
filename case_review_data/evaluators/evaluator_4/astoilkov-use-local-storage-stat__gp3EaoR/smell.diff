--- /dev/null
+++ b/src/StorageItem.ts
@@ -0,0 +1,48 @@
+import type { PersistentStore } from './PersistentStore.js'
+
+// the per instance snapshot of one key: the raw string is memoized so that an
+// unchanged value is not parsed twice and the parsed value is cached because
+// `useSyncExternalStore` requires a stable reference between renders
+export class StorageItem<T = undefined> {
+    // the hook re-keys its snapshot on every render so that changing the key
+    // reads and writes under the new key
+    key: string
+    readonly store: PersistentStore
+    readonly defaultValue: T | undefined
+    readonly parse: (value: string) => unknown
+    readonly stringify: (value: unknown) => string
+
+    string: string | null | undefined
+    parsed: T | undefined
+
+    constructor(
+        key: string,
+        store: PersistentStore,
+        defaultValue: T | undefined,
+        parse: (value: string) => unknown,
+        stringify: (value: unknown) => string,
+    ) {
+        this.key = key
+        this.store = store
+        this.defaultValue = defaultValue
+        this.parse = parse
+        this.stringify = stringify
+    }
+
+    // reads the raw string stored under this key. when the storage area is
+    // unreachable the fallback records the default value instead
+    readStored(): string | null {
+        const key = this.key
+
+        let string: string | null = null
+        try {
+            string = this.store.areaResolver().getItem(key)
+        } catch {
+            if (!this.store.fallback.has(key)) {
+                this.store.fallback.set(key, this.defaultValue)
+            }
+        }
+
+        return string
+    }
+}
