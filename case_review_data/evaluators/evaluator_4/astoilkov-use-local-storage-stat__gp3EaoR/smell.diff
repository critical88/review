@@ -0,0 +1,60 @@
+import type { StorageItem } from './StorageItem.js'
+
+// the storage side of `useLocalStorageState()`: it owns the raw string area and
+// the in memory fallback used when that area throws an error
+//
+// kept as one class so that all `useLocalStorageState()` instances share the
+// same storage policy
+export class PersistentStore {
+    // resolves the `localStorage` global — lazily, on every access, because:
+    // - reading from `localStorage` can throw:
+    //   - in Firefox, `localStorage` is `null` when `dom.storage.enabled` is set to
+    //     `false` in `about:config`:
+    //     https://github.com/astoilkov/use-local-storage-state/issues/80
+    //   - in Safari, accessing `localStorage` throws "SecurityError: The operation is
+    //     insecure." when cookies are disabled
+    readonly areaResolver: () => Storage = () => localStorage
+
+    // the in memory fallback used when `localStorage` throws an error
+    readonly fallback: Map<string, unknown> = new Map<string, unknown>()
+
+    // a wrapper around `JSON.parse()` that supports "undefined" value. otherwise,
+    // `JSON.parse(JSON.stringify(undefined))` returns the string "undefined" not the
+    // value `undefined`
+    readonly parseDefault: (value: string) => unknown = (value: string) =>
+        value === 'undefined' ? undefined : JSON.parse(value)
+
+    readonly stringifyDefault: (value: unknown) => string = JSON.stringify
+
+    // writes `item.defaultValue` into the storage area the first time the key is
+    // seen and keeps the caller's snapshot in sync so that the next read doesn't
+    // need to parse again
+    //
+    // store default value in localStorage:
+    // - initial issue: https://github.com/astoilkov/use-local-storage-state/issues/26
+    //   issues that were caused by incorrect initial and secondary implementations:
+    //   - https://github.com/astoilkov/use-local-storage-state/issues/30
+    //   - https://github.com/astoilkov/use-local-storage-state/issues/33
+    persistDefault(item: StorageItem<unknown>, stringify: (value: unknown) => string): void {
+        // reasons for `localStorage` to throw an error:
+        // - maximum quota is exceeded
+        // - under Mobile Safari (since iOS 5) when the user enters private mode
+        //   `localStorage.setItem()` will throw
+        // - trying to access localStorage object when cookies are disabled in Safari
+        //   throws "SecurityError: The operation is insecure."
+        goodTry(() => {
+            const string = stringify(item.defaultValue)
+            this.areaResolver().setItem(item.key, string)
+            item.string = string
+            item.parsed = item.defaultValue
+        })
+    }
+}
+
+export const sharedStore = new PersistentStore()
+
+const goodTry = <T,>(tryFn: () => T): T | undefined => {
+    try {
+        return tryFn()
+    } catch {}
+}
