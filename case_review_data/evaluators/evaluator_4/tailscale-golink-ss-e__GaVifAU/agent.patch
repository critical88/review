diff --git a/shortname.go b/shortname.go
new file mode 100644
index 0000000..7affac8
--- /dev/null
+++ b/shortname.go
@@ -0,0 +1,36 @@
+// Copyright 2022 Tailscale Inc & Contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package golink
+
+import (
+	"net/url"
+	"strings"
+)
+
+// linkPunctuation is the trailing punctuation stripped from a short name
+// before lookup. Users frequently paste links from documents or chat with a
+// stray period, comma, parenthesis, or bracket attached; folding it off here
+// keeps those from becoming distinct links.
+const linkPunctuation = ".,()[]{}"
+
+// trimTrailingPunctuation removes trailing linkPunctuation from s.
+func trimTrailingPunctuation(s string) string {
+	return strings.TrimRight(s, linkPunctuation)
+}
+
+// canonicalShortName reduces a short link name to the single form the database
+// matches and stores against. It is the only place that decides how a short
+// name is matched, so changes to any of these rules live here:
+//
+//   - case-insensitive: names are folded to lower case, so "Foo", "foo", and
+//     "FOO" resolve to the same link.
+//   - dashes-ignored: dashes are removed, so "foo-bar" and "foobar" collide.
+//   - escaped: the result is path-escaped so it is a safe storage key.
+//
+// Every database lookup, save, delete, stat record, and the new-link shadow
+// check in serveSave routes through this function so the matching rule stays
+// in one place.
+func canonicalShortName(short string) string {
+	return strings.ReplaceAll(url.PathEscape(strings.ToLower(short)), "-", "")
+}
