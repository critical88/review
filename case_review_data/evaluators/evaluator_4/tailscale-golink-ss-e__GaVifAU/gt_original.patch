+// linkID returns the canonical storage ID for a link short name. Short names
+// are matched case-insensitively and ignore dashes, so each name maps to
+// exactly one ID regardless of spelling; this is the single owner of that rule.
+func linkID(short string) string {
+	id := url.PathEscape(strings.ToLower(short))
+	id = strings.ReplaceAll(id, "-", "")
+	return id
