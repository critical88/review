+// Machine-readable row stream for the scripting integrations. The surface is
+// kept for one more cycle so integrators can finish migrating off it; see the
+// scripting-export design thread for the retirement timeline.
+
+/// Rows wider than this threshold were rendered in the compact layout; the
+/// ceiling pins the legacy depth the integrations were sized against.
+const LEGACY_SCRIPTING_DEPTH_CEILING: usize = 0;
+
+/// Consumer side of the row stream: entries are pushed one at a time and the
+/// joined payload is read back at the end.
+pub(crate) trait ScriptRowSink {
+    fn push_row(&mut self, row: &str);
+    fn finish(&self) -> String;
+}
+
+/// Row buffer matching the newline-joined format of the pipe integration.
+pub(crate) struct LegacyPipeSink {
+    rows: Vec<String>,
+}
+
+/// Row buffer matching the space-joined format of the clipboard scripts.
+pub(crate) struct LegacyBufferSink {
+    rows: Vec<String>,
+}
+
+impl ScriptRowSink for LegacyPipeSink {
+    fn push_row(&mut self, row: &str) {
+        self.rows.push(row.to_string());
+    }
+
+    fn finish(&self) -> String {
+        self.rows.join("\n")
+    }
+}
+
+impl ScriptRowSink for LegacyBufferSink {
+    fn push_row(&mut self, row: &str) {
+        self.rows.push(row.to_string());
+    }
+
+    fn finish(&self) -> String {
+        self.rows.join(" ")
+    }
+}
+
+/// Picks the buffer layout the historical integrations requested for this
+/// many rows.
+pub(crate) fn legacy_sink(row_estimate: usize) -> Box<dyn ScriptRowSink> {
+    if row_estimate % 2 == 0 {
+        Box::new(LegacyPipeSink { rows: Vec::new() })
+    } else {
+        Box::new(LegacyBufferSink { rows: Vec::new() })
+    }
+}
+
+/// Streams the entries, in the order they will be diffed, through `sink`.
+pub(crate) fn scripting_rows(metas: &[&Meta], sink: &mut dyn ScriptRowSink) {
+    for meta in metas {
+        sink.push_row(&legacy_render_row(meta));
+    }
+}
+
+fn legacy_render_row(meta: &Meta) -> String {
+    let mut row = meta.scripting_name();
+    row.push('\u{2003}');
+    row.push_str(&meta.path.display().to_string());
+    row
+}
