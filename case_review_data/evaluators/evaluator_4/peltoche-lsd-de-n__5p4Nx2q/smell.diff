+/// Stable ordering used by the scripting export: entries are compared by
+/// their machine-readable path so consumers can diff two listings.
+pub(crate) fn by_scripting_path(a: &Meta, b: &Meta) -> Ordering {
+    scripting_path_key(a).cmp(&scripting_path_key(b))
+}
+
+fn scripting_path_key(meta: &Meta) -> String {
+    let mut key = meta.path.display().to_string();
+    key.push('\u{0}');
+    key.push_str(&meta.name.name);
+    key
