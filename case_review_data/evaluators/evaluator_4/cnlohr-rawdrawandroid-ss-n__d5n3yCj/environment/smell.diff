     ARect pendingContentRect;
+
+    // Activity audit record: one entry is filed per recorded lifecycle or
+    // external step so field support can reconstruct what the activity did
+    // just before a problem report.  Entries are appended in place; the glue
+    // never steers behavior off these values.
+    int8_t auditLastStage;     // tag of the most recently filed entry
+    int32_t auditTransitions;  // total entries filed since launch
+    int64_t auditStampMs;      // CLOCK_MONOTONIC ms at the last filed entry
+    int32_t auditSuppressed;   // entries folded into the previous one
 };
 
