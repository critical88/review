+enum {
+    /**
+     * Audit-stage tags for activity-audit entries that do not map one-to-one
+     * onto an APP_CMD_* value.  Entries are also filed from outside the glue
+     * (USB permission flow, WebView shim, UI-thread dispatch), so those sites
+     * share this tag space.
+     */
+    AUDIT_STAGE_USB_EVENT = 100,
+    AUDIT_STAGE_WEBVIEW_EVENT = 101,
+    AUDIT_STAGE_UI_DISPATCH = 102,
+    AUDIT_STAGE_LAUNCH = 103,
+    AUDIT_STAGE_RESTORED = 104,
+    AUDIT_STAGE_TEARDOWN = 105,
+    AUDIT_STAGE_ANOMALOUS = 106,
+};
