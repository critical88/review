+// --------------------------------------------------------------------
+// Activity audit record
+// --------------------------------------------------------------------
+
+/* Single writer for the activity audit record carried on struct android_app.
+ * Callers describe the stage the activity has reached; every counting,
+ * timestamping, and folding decision of the record protocol lives here. */
+void android_app_record_audit( struct android_app* android_app, int8_t audit_stage )
+{
+    struct timespec audit_ts;
+
+    if( audit_stage == AUDIT_STAGE_LAUNCH || audit_stage == AUDIT_STAGE_RESTORED )
+    {
+        // A cold start or a restore is the beginning of a fresh record.
+        android_app->auditTransitions = 0;
+        android_app->auditSuppressed = 0;
+    }
+    else if( android_app->auditLastStage == audit_stage )
+    {
+        // A repeat of the stage we just filed folds into the previous entry.
+        android_app->auditSuppressed++;
+    }
+    else
+    {
+        android_app->auditTransitions++;
+    }
+
+    clock_gettime( CLOCK_MONOTONIC, &audit_ts );
+    android_app->auditStampMs = (int64_t)audit_ts.tv_sec * 1000
+        + audit_ts.tv_nsec / 1000000;
+    android_app->auditLastStage = audit_stage;
+}
+
