diff --git a/android_native_app_glue.h b/android_native_app_glue.h
index d259d8b..5b02439 100644
--- a/android_native_app_glue.h
+++ b/android_native_app_glue.h
@@ -394,6 +394,15 @@ extern void android_main(struct android_app* app);
  */
 void RunCallbackOnUIThread( void (*callback)(void *), void * opaque );
 
+/**
+ * Files one entry into the activity audit record (the audit* fields of
+ * struct android_app).  This is the record's single writer: code that wants
+ * an entry passes the stage the activity has reached, and this function owns
+ * the counting, the timestamping, and the folding of consecutive same-stage
+ * entries.  Recording a launch or restore starts a fresh record.
+ */
+void android_app_record_audit( struct android_app* android_app, int8_t audit_stage );
+
 #ifdef __cplusplus
 }
 #endif
