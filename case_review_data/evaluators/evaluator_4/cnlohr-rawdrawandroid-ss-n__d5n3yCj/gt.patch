+/* ================================================================== */
+/* Activity audit filing -- the single owner of the count/fold/tag    */
+/* decision behind every audit entry.  The audit fields themselves    */
+/* stay on struct android_app (they are the record field support       */
+/* reads); only the writes are funneled here, so a change to how a    */
+/* recorded step is filed is made in this one place instead of being  */
+/* re-spelled in each lifecycle callback, the command path, the USB   */
+/* permission flow, and the WebView shim.                            */
+/* ================================================================== */
+
+void android_audit_stamp( struct android_app * app )
+{
+    struct timespec audit_ts;
+    clock_gettime( CLOCK_MONOTONIC, &audit_ts );
+    app->auditStampMs = (int64_t)audit_ts.tv_sec * 1000
+        + audit_ts.tv_nsec / 1000000;
+}
+
+void android_audit_tag( struct android_app * app, int8_t stage )
+{
+    app->auditLastStage = stage;
+}
+
+void android_audit_fold( struct android_app * app )
+{
+    app->auditSuppressed += 1;
+}
+
+void android_audit_count( struct android_app * app, int8_t stage )
+{
+    app->auditLastStage = stage;
+    app->auditTransitions += 1;
+}
+
+void android_audit_count_if_stamped( struct android_app * app, int8_t stage )
+{
+    app->auditLastStage = stage;
+    app->auditTransitions += app->auditStampMs ? 1 : 0;
+}
+
+void android_audit_fold_duplicate( struct android_app * app, int8_t stage )
+{
+    if( app->auditLastStage != stage )
+        app->auditTransitions += 1;
+    else
+        app->auditSuppressed += 1;
+    app->auditLastStage = stage;
+}
+
+void android_audit_fold_poll( struct android_app * app, int8_t stage )
+{
+    app->auditSuppressed += ( app->auditLastStage == stage );
+    app->auditLastStage = stage;
+}
+
+void android_audit_clear_suppressed( struct android_app * app, int8_t stage )
+{
+    app->auditLastStage = stage;
+    app->auditSuppressed = 0;
+}
+
+void android_audit_reset( struct android_app * app, int8_t stage )
+{
+    app->auditLastStage = stage;
+    app->auditTransitions = 0;
+    app->auditSuppressed = 0;
+}
