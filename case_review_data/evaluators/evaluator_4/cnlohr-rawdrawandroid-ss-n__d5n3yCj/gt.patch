--- a/android_native_app_glue.h
+++ b/android_native_app_glue.h
@@ -353,6 +353,60 @@ enum {
     AUDIT_STAGE_ANOMALOUS = 106,
 };
 
+/**
+ * Activity audit filing.
+ *
+ * Every recorded step in an activity's life -- a lifecycle callback, a
+ * command dispatch, a window/input/focus change, a USB permission round,
+ * a WebView creation or message hop, a UI-thread handoff -- is filed
+ * through the functions below rather than by writing the audit fields
+ * directly.  The decision of whether a step counts toward
+ * auditTransitions, folds into auditSuppressed, only updates the stage
+ * tag, or carries a timestamp lives in this one place, so a change to
+ * the filing policy is made here instead of being re-spelled at each
+ * call site.  The audit fields stay on struct android_app (they are the
+ * record field support reads); only the writes are funneled here.
+ */
+
+/** Stamp CLOCK_MONOTONIC milliseconds at the filing. */
+void android_audit_stamp( struct android_app * app );
+
+/** File a tag-only entry: record the stage without touching the counts. */
