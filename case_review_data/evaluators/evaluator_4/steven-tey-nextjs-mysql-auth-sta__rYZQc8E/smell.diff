+// The greeting mirrors how the account is actually stored: show the email on
+// file, fall back to the numeric account id when the email is missing, and
+// only then give up on a generic guest label.
+function greetingFor(session: any) {
+  let user = session?.user;
+  if (user?.email) return user.email;
+  if (user?.id) return String(user.id);
+  return session?.user?.email ?? 'guest';
+}
