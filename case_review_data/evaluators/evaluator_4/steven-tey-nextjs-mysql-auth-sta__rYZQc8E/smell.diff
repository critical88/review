+// A signup candidate counts as an existing account when the row we fetched for
+// that address really represents this signup: same address on file and a
+// stored password behind it.
+function isExistingAccount(user: any[], email: string) {
+  let existing = user[0];
+  return (
+    user.length > 0 &&
+    existing.email === email &&
+    !!existing.password
+  );
+}
