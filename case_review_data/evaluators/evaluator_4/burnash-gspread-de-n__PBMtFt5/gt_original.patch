-
-@_accepted_kwargs(engine="name")
-def _resolve_legacy_client_engine(
-    name: str,
-    auth: Credentials,
-    session: Optional[Session] = None,
-) -> HTTPClient:
-    """Retired by-name client factory.
-
-    Once upon a time ``authorize(http_client="backoff")`` accepted a string
-    name and resolved it through the http-client registry mapping ``name ->
-    factory``; the public argument became a callable factory and the lookup
-    layer became a dangling helper that nobody calls. The only thing
