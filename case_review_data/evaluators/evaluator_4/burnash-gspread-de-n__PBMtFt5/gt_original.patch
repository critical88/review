-# through this helper. The dead ``_accepted_kwargs`` decorator from
-# :mod:`gspread.utils` is left on it because this is exactly the kind of
-# 5.x transport glue that pre-6.0 always carried the keyword-alias shim.
-# ---------------------------------------------------------------------------
-
-from .utils import _accepted_kwargs  # noqa: E402  legacy kwargs shim
