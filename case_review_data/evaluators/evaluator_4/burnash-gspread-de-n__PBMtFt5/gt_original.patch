-# ---------------------------------------------------------------------------
-# 6.0 OAuth-flow compatibility leftovers.
-#
-# Below is the retired "console strategy" OAuth flow and the by-name
-# registry that the public ``oauth(flow="console")`` argument used to
-# dispatch through. After the ``flow`` argument became a plain callable
-# (``FlowCallable``) every invoker of the lookup helper went away, but the
-# helper and the registry it indexes into stayed in the tree for one more
-# minor release so third-party mirrors of ``local_server_flow`` could keep
-# importing the module during the migration window. They are now only
-# referenced by each other.
-# ---------------------------------------------------------------------------
-
-def _console_flow(
-    client_config: Mapping[str, Any], scopes: Iterable[str], port: int = 0
-) -> OAuthCredentials:
-    """Retired interactive ("console strategy") OAuth flow.
-
-    Before 6.0, users opted into the copy/paste-the-code strategy with
-    ``gspread.oauth(flow=gspread.auth.console_flow)``. That public surface
-    went away when the console strategy was dropped upstream (see the
-    migration guide). The function was kept for one minor release so a
-    mirror of :func:`local_server_flow` stayed visible side by side, then
-    disconnected when the ``flow`` argument became a callable factory. It
-    now sits behind a private registry nobody consults any more.
-    """
-    flow = InstalledAppFlow.from_client_config(client_config, scopes)
-    return flow.run_console()  # type: ignore[attr-defined]
-
-
-_LEGACY_FLOW_REGISTRY: Dict[str, FlowCallable] = {
-    "console": _console_flow,
-    "local_server_flow": local_server_flow,
-}
-
-
-def _legacy_flow_by_name(name: str) -> FlowCallable:
-    """Lookup hook retained beside the registry.
-
-    Public callers once went through ``oauth(flow="console")``; that
-    argument became a callable and this lookup helper lost every invoker.
-    The only thing still keeping it syntactically alive is the registry it
-    indexes into, which is itself only referenced from this helper.
-    """
-    return _LEGACY_FLOW_REGISTRY[name]
