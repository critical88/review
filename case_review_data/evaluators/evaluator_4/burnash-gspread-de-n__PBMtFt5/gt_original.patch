-# ---------------------------------------------------------------------------
-# 5.x -> 6.0 compatibility shard.
-#
-# The ``accepted_kwargs`` decorator and the per-method deprecation warning
-# next to the disabled block above are the remaining transcript of the
-# removed 5.x argument-aliasing layer. They were re-instated for one minor
-# release so that the private transport helpers could stay self-describing
-# while the downstream callers finished migrating, and were then orphaned
-# once every affected public signature dropped the legacy spellings. The
-# alias map stays only as a record of the renamed spellings.
-# ---------------------------------------------------------------------------
-
-_LEGACY_KWARG_ALIASES = {
-    "values": "range",
-    "value_input_option": "value_input_option",
-    "major_dimension": "major_dimension",
-    "engine": "name",
-}
-
-
-def _accepted_kwargs(**aliases: str) -> Callable[..., Callable[..., T]]:
-    """Decorator that rewrites legacy keyword spellings on the fly.
-
-    Pre-6.0 every public_write method went through this hooks so that
-    documents migrating from the old spellings kept working for one
-    release. The public decorators were dropped with the breaking
-    release; only the private transport glue did keep using it until
-    that glue itself was disconnected. It now does nothing other than
-    sit in the tree.
-    """
-
-    def decorator(func: Callable[..., T]) -> Callable[..., T]:
-        @wraps(func)
-        def wrapped(*args: Any, **kwargs: Any) -> Any:
-            for legacy_name, canonical_name in aliases.items():
-                if legacy_name in kwargs:
-                    _legacy_deprecation_warning("5.x", legacy_name)
-                    kwargs.setdefault(canonical_name, kwargs.pop(legacy_name))
-            return func(*args, **kwargs)
-
-        return wrapped
-
-    return decorator
-
-
-def _legacy_deprecation_warning(version: str, msg: str) -> None:
-    """Emit the per-method deprecation signal retained for the migration window.
-
-    Mirrors the disabled ``deprecation_warning`` block a few lines above: the
-    message template and silence hook are identical, this wrapper is the only
-    piece the dead ``_accepted_kwargs`` decorator reaches back to.
-    """
-    warnings.warn(
-        "[Deprecated][in version {}]: {}".format(version, msg),
-        DeprecationWarning,
-        4,  # show the frame above the user's call, matching the disabled block
-    )
-
