+package report
+
+import (
+	"encoding/json"
+	"encoding/xml"
+
+	"github.com/securego/gosec/v2/report/junit"
+	"github.com/securego/gosec/v2/report/sarif"
+	"github.com/securego/gosec/v2/report/sonar"
+)
+
+// renderJUnit serializes the scan report as junit xml, one test suite per rule
+func (r *Renderer) renderJUnit() error {
+	junitXMLStruct := junit.GenerateReport(r.data)
+	raw, err := xml.MarshalIndent(junitXMLStruct, "", "\t")
+	if err != nil {
+		return err
+	}
+
+	xmlHeader := []byte("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
+	return r.emit(append(xmlHeader, raw...))
+}
+
+// renderSonar serializes the scan report as a sonarqube issue import
+func (r *Renderer) renderSonar() error {
+	si, err := sonar.GenerateReport(r.rootPaths, r.data)
+	if err != nil {
+		return err
+	}
+	raw, err := json.MarshalIndent(si, "", "\t")
+	if err != nil {
+		return err
+	}
+	return r.emit(raw)
+}
+
+// renderSARIF serializes the scan report in the sarif 2.1.0 schema
+func (r *Renderer) renderSARIF() error {
+	return sarif.WriteReport(r.out, r.data, r.rootPaths)
+}
