+	"io"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/gookit/color"
+
+	"github.com/securego/gosec/v2"
+	"github.com/securego/gosec/v2/issue"
+)
+
+// Renderer is the central output coordinator of gosec. It runs a scan report
+// through the whole presentation pipeline: it normalizes the finding stream,
+// applies the reporting suppression policy, owns the presentation issue order
+// and renders the result in every output format supported by the tool.
+type Renderer struct {
+	out         io.Writer
+	data        *gosec.ReportInfo
+	format      string
+	enableColor bool
+	rootPaths   []string
+
+	// presentation color schemes used by the text rendering
+	errorScheme   color.Style
+	warningScheme color.Style
+	defaultScheme color.Style
+}
+
+// NewRenderer instantiate a Renderer that pipelines the report data of a scan
+// into the configured output format.
+func NewRenderer(w io.Writer, data *gosec.ReportInfo) *Renderer {
+	r := &Renderer{
+		out:  w,
+		data: data,
+	}
+	r.initColorSchemes()
+	return r
+}
+
+// forFormat selects the output format the scan report is rendered in.
+// An unknown or empty format falls back to the text rendering.
+func (r *Renderer) forFormat(format string) *Renderer {
+	r.format = format
+	return r
+}
+
+// withColor enables or disables the colorization of the text rendering.
+func (r *Renderer) withColor(enableColor bool) *Renderer {
+	r.enableColor = enableColor
+	return r
+}
+
+// withRootPaths sets the root paths the scan was started from. They drive the
+// path normalization of the formats that report relative locations.
+func (r *Renderer) withRootPaths(rootPaths []string) *Renderer {
+	r.rootPaths = rootPaths
+	return r
+}
+
+// CreateReport generates a report based for the supplied issues and metrics given
+// the specified format. The formats currently accepted are: json, yaml, csv, junit-xml, html, sonarqube, golint and text.
+func CreateReport(w io.Writer, format string, enableColor bool, rootPaths []string, data *gosec.ReportInfo) error {
+	renderer := NewRenderer(w, data).
+		forFormat(format).
+		withColor(enableColor).
+		withRootPaths(rootPaths)
+	return renderer.Render()
+}
+
+// Render renders the scan report in the selected output format. Unknown or
+// empty formats are rendered as plain text.
+func (r *Renderer) Render() error {
+	r.applySuppressionPolicy()
+	switch r.format {
+	case "json":
+		return r.renderJSON()
+	case "yaml":
+		return r.renderYAML()
+	case "csv":
+		return r.renderCSV()
+	case "junit-xml":
+		return r.renderJUnit()
+	case "html":
+		return r.renderHTML()
+	case "text":
+		return r.renderText()
+	case "sonarqube":
+		return r.renderSonar()
+	case "golint":
+		return r.renderGolint()
+	case "sarif":
+		return r.renderSARIF()
+	default:
+		return r.renderText()
+	}
+}
+
+// applySuppressionPolicy keeps the handling of `#nosec` annotations in one
+// place. json and sarif keep the suppression annotations of every finding so
+// audits can review them, while every other format only reports findings that
+// are not suppressed.
+func (r *Renderer) applySuppressionPolicy() {
+	if r.format != "json" && r.format != "sarif" {
+		r.data.Issues = r.filterOutSuppressedIssues(r.data.Issues)
+	}
+}
+
+// filterOutSuppressedIssues returns the issues without any suppression
+func (r *Renderer) filterOutSuppressedIssues(issues []*issue.Issue) []*issue.Issue {
+	nonSuppressedIssues := []*issue.Issue{}
+	for _, issue := range issues {
+		if len(issue.Suppressions) == 0 {
+			nonSuppressedIssues = append(nonSuppressedIssues, issue)
+		}
+	}
+	return nonSuppressedIssues
+}
+
+// OrderIssuesForReport sorts the issues into the canonical presentation order
+// of gosec reports, so every output format presents the findings the same way.
+func OrderIssuesForReport(issues []*issue.Issue) {
+	slices.SortFunc(issues, func(i, j *issue.Issue) int {
+		return -cmp.Or(
+			cmp.Compare(i.Severity, j.Severity),
+			cmp.Compare(i.What, j.What),
+			cmp.Compare(i.File, j.File),
+			cmp.Compare(IssueLeadingLine(i.Line), IssueLeadingLine(j.Line)),
+		)
+	})
+}
+
+// IssueLeadingLine extracts the leading line number of an issue position range
+func IssueLeadingLine(s string) int {
+	lineNumber, _ := strconv.Atoi(strings.Split(s, "-")[0])
+	return lineNumber
+}
