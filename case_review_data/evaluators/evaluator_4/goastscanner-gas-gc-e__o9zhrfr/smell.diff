+
+package report
+
+import (
+	"bufio"
+	"bytes"
+	_ "embed" // use go embed to import the report templates
+	"fmt"
+	htmltemplate "html/template"
+	"strconv"
+	"strings"
+	texttemplate "text/template"
+
+	"github.com/gookit/color"
+
+	"github.com/securego/gosec/v2/issue"
+)
+
+//go:embed template.txt
+var textTemplateContent string
+
+//go:embed template.html
+var htmlTemplateContent string
+
+// renderText renders the scan report with the plain text template, colored on
+// request
+func (r *Renderer) renderText() error {
+	t, e := r.textPattern()
+	if e != nil {
+		return e
+	}
+
+	return t.Execute(r.out, r.data)
+}
+
+// renderHTML renders the scan report with the standalone html template
+func (r *Renderer) renderHTML() error {
+	t, e := r.htmlPattern()
+	if e != nil {
+		return e
+	}
+
+	return t.Execute(r.out, r.data)
+}
+
+// textPattern compiles the plain text template together with its rendering
+// functions
+func (r *Renderer) textPattern() (*texttemplate.Template, error) {
+	return texttemplate.
+		New("gosec").
+		Funcs(r.textFuncMap()).
+		Parse(textTemplateContent)
+}
+
+// htmlPattern compiles the standalone html template
+func (r *Renderer) htmlPattern() (*htmltemplate.Template, error) {
+	return htmltemplate.New("gosec").Parse(htmlTemplateContent)
+}
+
+// textFuncMap collects the template functions of the text rendering. Without
+// colorization the theme functions return the given content untouched.
+func (r *Renderer) textFuncMap() texttemplate.FuncMap {
+	if r.enableColor {
+		return texttemplate.FuncMap{
+			"highlight": r.highlightFinding,
+			"danger":    color.Danger.Render,
+			"notice":    color.Notice.Render,
+			"success":   color.Success.Render,
+			"printCode": r.renderCodeSnippet,
+		}
+	}
+
+	// by default those functions return the given content untouched
+	return texttemplate.FuncMap{
+		"highlight": func(t string, s issue.Score, ignored bool) string {
+			return t
+		},
+		"danger":    fmt.Sprint,
+		"notice":    fmt.Sprint,
+		"success":   fmt.Sprint,
+		"printCode": r.renderCodeSnippet,
+	}
+}
+
+// initColorSchemes centralizes the severity palettes of the text rendering
+func (r *Renderer) initColorSchemes() {
+	r.errorScheme = color.New(color.FgLightWhite, color.BgRed)
+	r.warningScheme = color.New(color.FgBlack, color.BgYellow)
+	r.defaultScheme = color.New(color.FgWhite, color.BgBlack)
+}
+
+// highlightFinding returns content t colored based on Score
+func (r *Renderer) highlightFinding(t string, s issue.Score, ignored bool) string {
+	if ignored {
+		return r.defaultScheme.Sprint(t)
+	}
+	switch s {
+	case issue.High:
+		return r.errorScheme.Sprint(t)
+	case issue.Medium:
+		return r.warningScheme.Sprint(t)
+	default:
+		return r.defaultScheme.Sprint(t)
+	}
+}
+
+// renderCodeSnippet prints the code snippet from the issue by adding a marker to the affected line
+func (r *Renderer) renderCodeSnippet(issue *issue.Issue) string {
+	start, end := r.issueCodeRange(issue.Line)
+	scanner := bufio.NewScanner(strings.NewReader(issue.Code))
+	var buf bytes.Buffer
+	line := start
+	for scanner.Scan() {
+		codeLine := scanner.Text()
+		if strings.HasPrefix(codeLine, strconv.Itoa(line)) && line <= end {
+			codeLine = "  > " + codeLine + "\n"
+			line++
+		} else {
+			codeLine = "    " + codeLine + "\n"
+		}
+		buf.WriteString(codeLine)
+	}
+	return buf.String()
+}
+
+// issueCodeRange extract the start and the end line numbers from a issue line
+func (r *Renderer) issueCodeRange(line string) (int, int) {
+	parts := strings.Split(line, "-")
+	start := parts[0]
+	end := start
+	if len(parts) > 1 {
+		end = parts[1]
+	}
+	s, err := strconv.Atoi(start)
+	if err != nil {
+		return -1, -1
+	}
+	e, err := strconv.Atoi(end)
+	if err != nil {
+		return -1, -1
+	}
+	return s, e
+}
