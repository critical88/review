+
+package report
+
+import (
+	"encoding/csv"
+	"encoding/json"
+	"fmt"
+	"io"
+	"strings"
+
+	"go.yaml.in/yaml/v3"
+
+	"github.com/securego/gosec/v2"
+	"github.com/securego/gosec/v2/issue"
+)
+
+// renderJSON serializes the scan report as indented json
+func (r *Renderer) renderJSON() error {
+	raw, err := json.MarshalIndent(r.data, "", "\t")
+	if err != nil {
+		return err
+	}
+	return r.emit(raw)
+}
+
+// renderYAML serializes the scan report as yaml
+func (r *Renderer) renderYAML() error {
+	raw, err := yaml.Marshal(r.data)
+	if err != nil {
+		return err
+	}
+	return r.emit(raw)
+}
+
+// WriteJSON write a report in json format to the output writer
+func WriteJSON(w io.Writer, data *gosec.ReportInfo) error {
+	return NewRenderer(w, data).renderJSON()
+}
+
+// emit writes one fully rendered report payload to the output stream, so every
+// byte oriented format shares the same stream error handling.
+func (r *Renderer) emit(raw []byte) error {
+	_, err := r.out.Write(raw)
+	return err
+}
+
+// WriteYAML write a report in yaml format to the output writer
+func WriteYAML(w io.Writer, data *gosec.ReportInfo) error {
+	return NewRenderer(w, data).renderYAML()
+}
+
+// WriteCSV write a report in csv format to the output writer
+func WriteCSV(w io.Writer, data *gosec.ReportInfo) error {
+	return NewRenderer(w, data).renderCSV()
+}
+
+// WriteGolint write a report in golint format to the output writer
+func WriteGolint(w io.Writer, data *gosec.ReportInfo) error {
+	return NewRenderer(w, data).renderGolint()
+}
+
+// WriteHTML write a report in html format to the output writer
+func WriteHTML(w io.Writer, data *gosec.ReportInfo) error {
+	return NewRenderer(w, data).renderHTML()
+}
+
+// WriteText write a report in text format to the output writer
+func WriteText(w io.Writer, data *gosec.ReportInfo, enableColor bool) error {
+	return NewRenderer(w, data).withColor(enableColor).renderText()
+}
+
+// renderCSV renders every non suppressed finding as one csv record
+func (r *Renderer) renderCSV() error {
+	out := csv.NewWriter(r.out)
+	for _, issue := range r.data.Issues {
+		err := out.Write(r.csvRecord(issue))
+		if err != nil {
+			return err
+		}
+	}
+	// csv.Writer buffers its output, so write errors only surface on flush.
+	out.Flush()
+	return out.Error()
+}
+
+// csvRecord assembles the column values of a single finding
+func (r *Renderer) csvRecord(issue *issue.Issue) []string {
+	return []string{
+		issue.File,
+		issue.Line,
+		issue.What,
+		issue.Severity.String(),
+		issue.Confidence.String(),
+		issue.Code,
+		issue.Cwe.SprintID(),
+	}
+}
+
+// renderGolint renders the findings in the golint message style
+func (r *Renderer) renderGolint() error {
+	// Output Sample:
+	// /tmp/main.go:11:14: [CWE-310] RSA keys should be at least 2048 bits (Rule:G403, Severity:MEDIUM, Confidence:HIGH)
+
+	for _, issue := range r.data.Issues {
+		_, err := fmt.Fprintf(r.out, "%s:%s:%s: %s (Rule:%s, Severity:%s, Confidence:%s)\n",
+			issue.File,
+			r.issuePositionStart(issue.Line),
+			issue.Col,
+			r.golintCweLabel(issue),
+			issue.RuleID,
+			issue.Severity.String(),
+			issue.Confidence.String(),
+		)
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// golintCweLabel prefixes the finding description with its CWE identifier
+// whenever the rule reports one
+func (r *Renderer) golintCweLabel(issue *issue.Issue) string {
+	if issue.Cwe != nil && issue.Cwe.ID != "" {
+		return fmt.Sprintf("[%s] %s", issue.Cwe.SprintID(), issue.What)
+	}
+	return issue.What
+}
+
+// issuePositionStart reduces an issue line range to its start position, because
+// the golint style only anchors a finding at its first line
+func (r *Renderer) issuePositionStart(line string) string {
+	// issue.Line uses "start-end" format for multiple line detection.
+	return strings.Split(line, "-")[0]
+}
