diff --git a/lib/mount.c b/lib/mount.c
index a6dd501..b7b0578 100644
--- a/lib/mount.c
+++ b/lib/mount.c
@@ -601,6 +601,73 @@ int setup_auto_unmount(const char *mountpoint, int quiet)
 	// Note: fds[1] doesn't get FD_CLOEXEC
 }
 
+/*
+ * Publish a successfully created mount to the session: the channel fd
+ * and the mountpoint belong to the mount result, so finish them here.
+ */
+void fuse_session_mount_publish(struct fuse_session *se, int fd,
+				char *mountpoint)
+{
+	se->fd = fd;
+	se->mountpoint = mountpoint;
+}
+
+/*
+ * Finish the mount channel for a session after the direct fsmount() or
+ * the fusermount3 fallback: adopt the auto-unmount comm socket (or
+ * spawn the auto-unmount helper), reap the helper when the socket is
+ * not kept, and invalidate the channel state the session keeps when
+ * the mount failed.
+ *
+ * Returns the fd the session should publish, -1 when the mount failed.
+ */
+int fuse_session_mount_unwind(struct fuse_session *se,
+			      const char *mountpoint, int fd, int err,
+			      int mountfd, int sock_fd, pid_t fusermount_pid)
+{
+	if (sock_fd >= 0) {
+		if (err == 0 && se->mo->auto_unmount) {
+			/*
+			 * Under auto_unmount fusermount3 --sync-init stays alive
+			 * until this socket closes (its unmount trigger), so
+			 * closing it now would unmount early and waitpid() would
+			 * hang. Keep it; fuse_session_destroy() closes it.
+			 */
+			se->auto_unmount_fd = sock_fd;
+		} else {
+			close(sock_fd);
+			/* Reap fusermount3 child process to prevent zombie */
+			if (fusermount_pid > 0)
+				waitpid(fusermount_pid, NULL, 0);
+		}
+	} else if (err == 0 && se->mo->auto_unmount) {
+		/*
+		 * Direct fsmount(), no fusermount3 in the picture - spawn the
+		 * helper that unmounts once its socket closes.
+		 */
+		se->auto_unmount_fd = setup_auto_unmount(mountpoint, 0);
+		if (se->auto_unmount_fd < 0) {
+			fuse_kern_umount_mountfd(mountfd);
+			err = -EIO;
+		}
+	}
+
+	if (mountfd >= 0)
+		close(mountfd);
+
+	if (err < 0) {
+		/* Close fd first to unblock worker thread */
+		if (fd >= 0)
+			close(fd);
+		fd = -1;
+		se->fd = -1;
+		se->error = err;
+		se->is_sync_init = false;
+	}
+
+	return fd;
+}
+
 static int fuse_mount_fusermount(const char *mountpoint, const struct mount_opts *mo,
 		const char *opts, int quiet)
 {
