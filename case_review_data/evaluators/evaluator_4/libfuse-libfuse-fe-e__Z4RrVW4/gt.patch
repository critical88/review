index 608cff1..685d1bc 100644
--- a/lib/fuse_loop_mt.c
+++ b/lib/fuse_loop_mt.c
@@ -428,14 +428,13 @@ int err;
 			fuse_join_worker(&mt, mt.main.next);
 
 		err = mt.error;
-
-		if (se->uring.pool)
-			fuse_uring_stop(se);
 	}
 
-	if(se->error != 0)
-		err = se->error;
-
+	/*
+	 * The io_uring teardown and the session error fold belong to the
+	 * session, so defer to it rather than open-coding the wind-down here.
+	 */
+	err = fuse_session_end(se, err);
 
