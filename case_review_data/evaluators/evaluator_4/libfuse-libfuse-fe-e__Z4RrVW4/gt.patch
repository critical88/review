diff --git a/lib/fuse_i.h b/lib/fuse_i.h
index f93bca7..31205b6 100644
--- a/lib/fuse_i.h
+++ b/lib/fuse_i.h
@@ -277,6 +277,20 @@ int fuse_session_loop_mt_312(struct fuse_session *se, struct fuse_loop_config *c
 /* the pre-3.19 loop, for callers that need the caller's thread to serve */
 int fuse_session_loop_30(struct fuse_session *se);
 
+/**
+ * Wind down the session-owned runtime once a loop has stopped and fold any
+ * recorded session error into the loop's return value.
+ *
+ * The session record owns the io_uring pool and the error status set by
+ * fuse_session_exit()/teardown, so this post-loop cleanup belongs with the
+ * rest of the session lifecycle rather than open-coded in each loop
+ * coordinator.
+ *
+ * @return the loop's status: the caller's result, unless the session
+ *         recorded a non-zero error, in which case that error wins.
+ */
+int fuse_session_end(struct fuse_session *se, int res);
+
 /**
  * Internal verifier for the given config.
  *
diff --git a/lib/fuse_loop.c b/lib/fuse_loop.c
index 1d239bf..8ae1aca 100644
--- a/lib/fuse_loop.c
+++ b/lib/fuse_loop.c
@@ -43,12 +43,11 @@ int fuse_session_loop_30(struct fuse_session *se)
 		/* No error, just the length of the most recently read
 		   request */
 		res = 0;
-	if(se->error != 0)
-		res = se->error;
-
-	if (se->uring.pool)
-		fuse_uring_stop(se);
-	return res;
+	/*
+	 * The io_uring teardown and the session error fold belong to the
+	 * session, so defer to it rather than open-coding the wind-down here.
+	 */
+	return fuse_session_end(se, res);
 }
 
