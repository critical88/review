diff --git a/lib/fuse_lowlevel.c b/lib/fuse_lowlevel.c
index b24934f..ca39c70 100644
--- a/lib/fuse_lowlevel.c
+++ b/lib/fuse_lowlevel.c
@@ -5421,6 +5421,27 @@ int fuse_session_exited(struct fuse_session *se)
 	return exited ? 1 : 0;
 }
 
+/*
+ * The session record owns the io_uring pool (se->uring.pool) and the error
+ * status (se->error) that fuse_session_exit() and the teardown paths set, so
+ * the post-loop wind-down belongs here, with the rest of the session
+ * lifecycle, instead of being open-coded in every loop coordinator.
+ *
+ * fuse_session_loop_30() stops the io_uring unconditionally; this matches
+ * that, so the multi-threaded loop no longer needs to gate it on whether
+ * its own worker start succeeded.
+ */
+int fuse_session_end(struct fuse_session *se, int res)
+{
+	if (se->uring.pool)
+		fuse_uring_stop(se);
+
+	if (se->error != 0)
+		res = se->error;
+
+	return res;
+}
