@@ -0,0 +1,53 @@
+from . import VecEnvWrapper
+from baselines.bench.monitor import ResultsWriter
+import numpy as np
+import time
+
+class VecResultsRecorder(VecEnvWrapper):
+    """
+    A vectorized wrapper that keeps track of the episodic quantities of the
+    batched environments - per-environment episode returns and lengths - and
+    summarizes each finished episode into a results file, reusing the same
+    writer and file format as the per-environment results files.
+    """
+
+    def __init__(self, venv, filename=None, info_keywords=()):
+        VecEnvWrapper.__init__(self, venv)
+        self.tstart = time.time()
+        self.eprets = None
+        self.eplens = None
+        self.epcount = 0
+        if filename:
+            self.results_writer = ResultsWriter(filename, header={'t_start': self.tstart},
+                extra_keys=info_keywords)
+        else:
+            self.results_writer = None
+        self.info_keywords = info_keywords
+
+    def reset(self):
+        obs = self.venv.reset()
+        self.eprets = np.zeros(self.num_envs, 'f')
+        self.eplens = np.zeros(self.num_envs, 'i')
+        return obs
+
+    def step_wait(self):
+        obs, rews, dones, infos = self.venv.step_wait()
+        self.eprets += rews
+        self.eplens += 1
+
+        for i in range(len(dones)):
+            if dones[i]:
+                epinfo = {
+                    'r': float(self.eprets[i]),
+                    'l': int(self.eplens[i]),
+                    't': round(time.time() - self.tstart, 6),
+                }
+                for k in self.info_keywords:
+                    epinfo[k] = infos[i][k]
+                self.epcount += 1
+                self.eprets[i] = 0
+                self.eplens[i] = 0
+                if self.results_writer:
+                    self.results_writer.write_row(epinfo)
+
+        return obs, rews, dones, infos
