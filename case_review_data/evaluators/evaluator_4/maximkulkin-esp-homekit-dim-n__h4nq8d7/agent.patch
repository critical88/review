+/* ---- homekit_value lifecycle ---- */
+static void test_values(void) {
+    /* bool equal/copy */
+    homekit_value_t a = HOMEKIT_BOOL(true), b_reg = HOMEKIT_BOOL(false);
+    CHECK(homekit_value_equal(&a, &b_reg) == false);
+    homekit_value_t b2; homekit_value_copy(&b2, &a);
+    CHECK(homekit_value_equal(&a, &b2) == true);
+    homekit_value_destruct(&b2);
+
+    /* uint8 */
+    homekit_value_t u = HOMEKIT_UINT8(200);
+    homekit_value_t uc; homekit_value_copy(&uc, &u);
+    CHECK(uc.uint8_value == 200);
+    CHECK(homekit_value_equal(&u, &uc) == true);
+    homekit_value_destruct(&uc);
+
+    /* uint16/32/64/int compare/copy through int_value */
+    homekit_value_t u16 = HOMEKIT_UINT16(60000);
+    homekit_value_t i16; homekit_value_copy(&i16, &u16);
+    CHECK(homekit_value_equal(&u16, &i16) == true);
+    homekit_value_destruct(&i16);
+
+    homekit_value_t u32a = HOMEKIT_UINT32(123456), u32b = HOMEKIT_UINT32(123457);
+    CHECK(homekit_value_equal(&u32a, &u32b) == false);
+    homekit_value_t i32; homekit_value_copy(&i32, &u32a);
+    CHECK(homekit_value_equal(&u32a, &i32) == true);
+    homekit_value_destruct(&i32);
+
+    homekit_value_t u64a = HOMEKIT_UINT64(9999999999ULL), u64b = HOMEKIT_UINT64(10000000000ULL);
+    CHECK(homekit_value_equal(&u64a, &u64b) == false);
+    homekit_value_t i64; homekit_value_copy(&i64, &u64a);
+    CHECK(homekit_value_equal(&u64a, &i64) == true);
+    homekit_value_destruct(&i64);
+
+    /* float equal/not-equal */
+    homekit_value_t f1 = HOMEKIT_FLOAT(12.5), f2 = HOMEKIT_FLOAT(12.5), f3 = HOMEKIT_FLOAT(12.6);
+    CHECK(homekit_value_equal(&f1, &f2) == true);
+    CHECK(homekit_value_equal(&f1, &f3) == false);
+
+    /* different formats are never equal */
+    homekit_value_t iv = HOMEKIT_INT(0);
+    CHECK(homekit_value_equal(&iv, &u) == false);
+
+    /* string: static copy shares the pointer, dynamic copy duplicates */
+    homekit_value_t sstatic = HOMEKIT_STRING_("static-str");
+    sstatic.is_static = true;
+    homekit_value_t sc; homekit_value_copy(&sc, &sstatic);
+    CHECK(sc.string_value == sstatic.string_value);
+    CHECK(homekit_value_equal(&sstatic, &sc) == true);
+    homekit_value_destruct(&sc); /* static: must not free */
+
+    /* string dynamic copy: strdup a heap copy so destruct releases only it */
+    char *dynstr = strdup("dynamic-str");
+    homekit_value_t sdyn = HOMEKIT_STRING_(dynstr);
+    sdyn.is_static = false;
+    homekit_value_t sc2; homekit_value_copy(&sc2, &sdyn);
+    CHECK(sc2.string_value != sdyn.string_value);
+    CHECK(strcmp(sc2.string_value, sdyn.string_value) == 0);
+    CHECK(homekit_value_equal(&sdyn, &sc2) == true);
+    homekit_value_destruct(&sc2); /* frees the strdup'd copy only */
+    CHECK(strcmp(sdyn.string_value, "dynamic-str") == 0);
+
+    /* string inequality */
+    homekit_value_t sA = HOMEKIT_STRING_("apple"), sB = HOMEKIT_STRING_("banana");
+    sA.is_static = true; sB.is_static = true;
+    CHECK(homekit_value_equal(&sA, &sB) == false);
+
+    /* data: static (shared) and dynamic (duplicated) copies */
+    unsigned char dbin[8] = {0,1,2,3,4,5,6,7};
+    homekit_value_t dstat = HOMEKIT_DATA(dbin, 8);
+    dstat.is_static = true;
+    homekit_value_t dc; homekit_value_copy(&dc, &dstat);
+    CHECK(dc.data_value == dstat.data_value && dc.data_size == 8);
+    CHECK(homekit_value_equal(&dstat, &dc) == true);
+    homekit_value_destruct(&dc);
+
+    unsigned char *ddata = malloc(8);
+    memcpy(ddata, dbin, 8);
+    homekit_value_t ddyn = HOMEKIT_DATA(ddata, 8);
+    ddyn.is_static = false;
+    homekit_value_t dc2; homekit_value_copy(&dc2, &ddyn);
+    CHECK(dc2.data_value != ddyn.data_value && dc2.data_size == 8);
+    CHECK(memcmp(dc2.data_value, ddyn.data_value, 8) == 0);
+    CHECK(homekit_value_equal(&ddyn, &dc2) == true);
+    homekit_value_destruct(&dc2);
+    unsigned char dbin2[8] = {0,1,2,3,4,5,6,8};
+    homekit_value_t ddiff = HOMEKIT_DATA(dbin2, 8); ddiff.is_static = true;
+    CHECK(homekit_value_equal(&ddyn, &ddiff) == false);
+    homekit_value_destruct(&ddyn); /* frees the heap buffer ddyn owns */
+
+    /* tlv: static (shared) and dynamic (cloned) copies */
+    tlv_values_t *tv = tlv_new();
+    tlv_add_string_value(tv, 1, "pair");
+    homekit_value_t tstat = HOMEKIT_TLV(tv); tstat.is_static = true;
+    homekit_value_t tc; homekit_value_copy(&tc, &tstat);
+    CHECK(tc.tlv_values == tv);
+    homekit_value_destruct(&tc); /* static: no free */
+
+    homekit_value_t tdyn = HOMEKIT_TLV(tv); tdyn.is_static = false;
+    homekit_value_t tc2; homekit_value_copy(&tc2, &tdyn);
+    CHECK(tc2.tlv_values != tv);
+    CHECK(homekit_value_equal(&tdyn, &tc2) == true);
+    homekit_value_destruct(&tc2); /* frees the clone */
+    CHECK(tlv_get_value(tv, 1) != NULL); /* original still valid */
+
+    /* tlv inequality */
+    tlv_values_t *tv2 = tlv_new();
+    tlv_add_string_value(tv2, 1, "pair!");
+    homekit_value_t tne = HOMEKIT_TLV(tv2); tne.is_static = true;
+    CHECK(homekit_value_equal(&tdyn, &tne) == false);
+    tlv_free(tv2);
+
+    /* tlv NULL vs non-NULL and NULL vs NULL equality */
+    homekit_value_t tnull_stat = HOMEKIT_TLV(NULL); tnull_stat.is_static = true;
+    tlv_values_t *tv3 = tlv_new();
+    homekit_value_t tnull_stat2 = HOMEKIT_TLV(tv3); tnull_stat2.is_static = true;
+    CHECK(homekit_value_equal(&tnull_stat, &tnull_stat2) == false);
+    homekit_value_t tnull_stat3 = HOMEKIT_TLV(NULL); tnull_stat3.is_static = true;
+    CHECK(homekit_value_equal(&tnull_stat, &tnull_stat3) == true);
+    tlv_free(tv3);
+
+    /* null value: is_null copy + equality */
+    homekit_value_t nullval = HOMEKIT_NULL();
+    homekit_value_t nc; homekit_value_copy(&nc, &nullval);
+    CHECK(nc.is_null == true);
+    CHECK(homekit_value_equal(&nullval, &nc) == true);
+    homekit_value_destruct(&nc);
+    CHECK(homekit_value_equal(&nullval, &a) == false); /* null != non-null */
+
+    homekit_value_destruct(&tdyn); /* dynamic tlv owner: frees tv exactly once */
+    free(dynstr);
+
+    /* clone allocates + copies + is freed */
+    char *clonestr = strdup("cloned-str");
+    homekit_value_t toClone = HOMEKIT_STRING_(clonestr);
+    toClone.is_static = false;
+    homekit_value_t *clone = homekit_value_clone(&toClone);
+    CHECK(clone && clone->string_value != toClone.string_value);
+    CHECK(strcmp(clone->string_value, "cloned-str") == 0);
+    homekit_value_free(clone); /* frees clone's string + the clone struct */
+    free(clonestr);
+
