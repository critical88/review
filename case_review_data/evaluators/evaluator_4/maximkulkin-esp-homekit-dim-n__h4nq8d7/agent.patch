+/* ---- json ---- */
+static void test_json(void) {
+    char buf[256];
+    json_stream js;
+    json_init(&js, (uint8_t*)buf, sizeof(buf), NULL, NULL);
+
+    json_object_start(&js);
+    json_string(&js, "name");
+    json_string(&js, "lightbulb");
+    json_string(&js, "value");
+    json_integer(&js, 42);
+    json_string(&js, "on");
+    json_boolean(&js, true);
+    json_object_end(&js);
+    buf[js.pos] = 0;
+    CHECK(strcmp(buf, "{\"name\":\"lightbulb\",\"value\":42,\"on\":true}") == 0);
+
+    json_reset(&js);
+    json_array_start(&js);
+    json_uint8(&js, 5);
+    json_uint16(&js, 1000);
+    json_uint32(&js, 4000000000u);
+    json_float(&js, 3.14);
+    json_array_end(&js);
+    buf[js.pos] = 0;
+    CHECK(strstr(buf, "3.14") != NULL);
+    CHECK(strstr(buf, "4000000000") != NULL);
+    CHECK(strstr(buf, "1000") != NULL);
+
+    /* null as an array item renders as "null" */
+    json_reset(&js);
+    json_array_start(&js);
+    json_null(&js);
+    json_array_end(&js);
+    buf[js.pos] = 0;
+    CHECK(strcmp(buf, "[null]") == 0);
+
+    /* error state is sticky: object_end without a start errors and halts */
+    json_reset(&js);
+    json_object_end(&js);
+    CHECK(js.state == JSON_STATE_ERROR);
+    size_t pos_before = js.pos;
+    json_string(&js, "x");
+    CHECK(js.pos == pos_before);
+
+    /* nested object inside array */
+    json_reset(&js);
+    json_array_start(&js);
+    json_object_start(&js);
+    json_string(&js, "k");
+    json_integer(&js, 1);
+    json_object_end(&js);
+    json_array_end(&js);
+    buf[js.pos] = 0;
+    CHECK(strcmp(buf, "[{\"k\":1}]") == 0);
+
+    /* bare boolean from START state */
+    json_reset(&js);
+    json_boolean(&js, false);
+    buf[js.pos] = 0;
+    CHECK(strcmp(buf, "false") == 0);
+
+    /* bare integer from START state */
+    json_reset(&js);
+    json_integer(&js, -7);
+    buf[js.pos] = 0;
+    CHECK(strcmp(buf, "-7") == 0);
+}
