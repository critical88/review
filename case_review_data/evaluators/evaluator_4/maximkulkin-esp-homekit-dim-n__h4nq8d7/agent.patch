+/* ---- bitset ---- */
+static void test_bitset(void) {
+    bitset_t *bs = bitset_new(32);
+    CHECK(!bitset_isset(bs, 5));
+    bitset_set(bs, 5);
+    CHECK(bitset_isset(bs, 5));
+    CHECK(!bitset_isset(bs, 6));
+    bitset_set(bs, 31);
+    CHECK(bitset_isset(bs, 31));
+    /* out-of-range set must not alter any valid bit */
+    bitset_set(bs, 40);
+    CHECK(bitset_isset(bs, 5));   /* bit 5 unchanged */
+    CHECK(bitset_isset(bs, 31)); /* bit 31 unchanged */
+    CHECK(!bitset_isset(bs, 0)); /* bit 0 never set */
+    bitset_clear(bs, 5);
+    CHECK(!bitset_isset(bs, 5));
+    CHECK(bitset_isset(bs, 31));
+    bitset_set(bs, 0);
+    CHECK(bitset_isset(bs, 0));
+    bitset_clear(bs, 0);
+    CHECK(!bitset_isset(bs, 0));
+    bitset_clear_all(bs);
+    CHECK(!bitset_isset(bs, 0));
+    CHECK(!bitset_isset(bs, 5));
+    CHECK(!bitset_isset(bs, 31));
+    bitset_free(bs);
+
+    /* 16-bit boundary survives set/clear across the full span */
+    bitset_t *bs2 = bitset_new(16);
+    bitset_set(bs2, 7);
+    bitset_set(bs2, 8);
+    CHECK(bitset_isset(bs2, 7) && bitset_isset(bs2, 8));
+    bitset_clear(bs2, 7);
+    CHECK(!bitset_isset(bs2, 7) && bitset_isset(bs2, 8));
+    bitset_free(bs2);
+}
