+/* ---- tlv ---- */
+static void test_tlv(void) {
+    tlv_values_t *v = tlv_new();
+    CHECK(v != NULL);
+    CHECK(tlv_add_value(v, 1, (const byte*)"hello", 5) == 0);
+    CHECK(tlv_add_string_value(v, 2, "world") == 0);
+    tlv_t *g = tlv_get_value(v, 1);
+    CHECK(g && g->size == 5 && memcmp(g->value, "hello", 5) == 0);
+    tlv_t *g2 = tlv_get_value(v, 2);
+    CHECK(g2 && g2->size == 5 && memcmp(g2->value, "world", 5) == 0);
+    CHECK(tlv_get_value(v, 99) == NULL);
+
+    /* integer round-trips little-endian, multi-byte */
+    CHECK(tlv_add_integer_value(v, 3, 4, 0x01020304) == 0);
+    tlv_t *gi = tlv_get_value(v, 3);
+    CHECK(gi && gi->size == 4);
+    CHECK(gi->value[0] == 0x04 && gi->value[1] == 0x03 &&
+          gi->value[2] == 0x02 && gi->value[3] == 0x01);
+    CHECK(tlv_get_integer_value(v, 3, -1) == 0x01020304);
+    /* missing integer returns default */
+    CHECK(tlv_get_integer_value(v, 88, 12345) == 12345);
+
+    /* zero-byte integer decodes as 0 (no bytes accumulated); kept out of the
+     * formatted list below so the round-trip is well-sized */
+    tlv_values_t *zi = tlv_new();
+    CHECK(tlv_add_integer_value(zi, 4, 0, 0x55) == 0);
+    CHECK(tlv_get_integer_value(zi, 4, -1) == 0);
+    tlv_free(zi);
+
+    /* format -> parse round trip */
+    size_t need = 0;
+    CHECK(tlv_format(v, NULL, &need) == TLV_ERROR_INSUFFICIENT_SIZE);
+    CHECK(need > 0);
+    byte *buf = malloc(need);
+    CHECK(tlv_format(v, buf, &need) == 0);
+    tlv_values_t *v2 = tlv_new();
+    CHECK(tlv_parse(buf, need, v2) == 0);
+    tlv_t *p1 = tlv_get_value(v2, 1);
+    CHECK(p1 && p1->size == 5 && memcmp(p1->value, "hello", 5) == 0);
+    CHECK(tlv_get_integer_value(v2, 3, -1) == 0x01020304);
+    free(buf);
+    tlv_free(v2);
+
+    /* string retrieval copies (caller frees) */
+    char *str = tlv_get_string_value(v, 2);
+    CHECK(str && strcmp(str, "world") == 0);
+    free(str);
+    CHECK(tlv_get_string_value(v, 77) == NULL);
+
+    /* chunked value > 255 bytes survives format/parse */
+    tlv_values_t *cv = tlv_new();
+    byte big[600];
+    memset(big, 0xAB, sizeof(big));
+    CHECK(tlv_add_value(cv, 7, big, sizeof(big)) == 0);
+    size_t cneed = 0;
+    tlv_format(cv, NULL, &cneed);
+    byte *cbuf = malloc(cneed);
+    CHECK(tlv_format(cv, cbuf, &cneed) == 0);
+    tlv_values_t *cv2 = tlv_new();
+    CHECK(tlv_parse(cbuf, cneed, cv2) == 0);
+    tlv_t *cp = tlv_get_value(cv2, 7);
+    CHECK(cp && cp->size == sizeof(big) && memcmp(cp->value, big, sizeof(big)) == 0);
+    free(cbuf);
+    tlv_free(cv2);
+    tlv_free(cv);
+
+    /* nested tlv survives add/get */
+    tlv_values_t *outer = tlv_new();
+    tlv_values_t *inner = tlv_new();
+    tlv_add_string_value(inner, 9, "nested");
+    CHECK(tlv_add_tlv_value(outer, 10, inner) == 0);
+    tlv_values_t *got = tlv_get_tlv_value(outer, 10);
+    CHECK(got != NULL);
+    tlv_t *nt = tlv_get_value(got, 9);
+    CHECK(nt && nt->size == 6 && memcmp(nt->value, "nested", 6) == 0);
+    tlv_free(got);
+    tlv_free(inner);
+    tlv_free(outer);
+
+    /* empty value (type, len 0): stored and retrieved with size 0 */
+    tlv_values_t *ev = tlv_new();
+    CHECK(tlv_add_value(ev, 5, (const byte*)"", 0) == 0);
+    tlv_t *eg = tlv_get_value(ev, 5);
+    CHECK(eg && eg->size == 0);
+    tlv_free(ev);
+
+    tlv_free(v);
+}
