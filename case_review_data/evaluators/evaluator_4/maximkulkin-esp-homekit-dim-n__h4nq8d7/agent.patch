+/* Host-side unit test harness for esp-homekit pure modules.
+ * Tiny assert/counting framework exercising base64, bitset, json, query_params,
+ * tlv and the homekit_value lifecycle (copy/destruct/equal/clone, default
+ * getter/setter) across every homekit_format_t. No ESP SDK touched. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <homekit/types.h>
+#include <homekit/tlv.h>
+#include "base64.h"
+#include "bitset.h"
+#include "json.h"
+#include "query_params.h"
+
+/* functions present in the sources but not exposed in their public headers */
+extern unsigned char base64_decode_char(unsigned char c);
+extern char *tlv_get_string_value(const tlv_values_t *values, byte type);
+
+static int g_tests = 0;
+static int g_failures = 0;
+
+#define CHECK(cond)                                                     \
+    do {                                                                \
+        g_tests++;                                                      \
+        long _c = (long)(cond);                                         \
+        if (!(_c)) {                                                    \
+            g_failures++;                                               \
+            printf("not ok %d - %s (line %d)\n", g_tests, #cond, __LINE__); \
+        } else {                                                        \
+            printf("ok %d - %s\n", g_tests, #cond);                     \
+        }                                                               \
+    } while (0)
+
+#define REGISTER_DONE() printf("1..%d\n", g_tests)
+
+/* ---- base64 ---- */
+static void test_base64(void) {
+    unsigned char enc[64];
+    unsigned char dec[64];
+    const char *in = "Hello esp-homekit!";
+    size_t n = strlen(in);
+    size_t es = base64_encoded_size((const unsigned char*)in, n);
+    CHECK(es == ((n + 2) / 3 * 4));
+    int e = base64_encode((const unsigned char*)in, n, enc);
+    CHECK(e == (int)es);
+    size_t ds = base64_decoded_size(enc, es);
+    CHECK(ds == n);
+    int d = base64_decode(enc, es, dec);
+    CHECK(d == (int)n);
+    CHECK(memcmp(dec, in, n) == 0);
+
+    /* empty input round-trips to nothing */
+    CHECK(base64_encoded_size((const unsigned char*)"", 0) == 0);
+    CHECK(base64_encode((const unsigned char*)"", 0, enc) == 0);
+
+    /* one byte -> "XX==" */
+    unsigned char one[8] = {0};
+    const unsigned char b1 = 'f';
+    CHECK(base64_encode(&b1, 1, one) == 4);
+    CHECK(one[0] == 'Z' && one[2] == '=' && one[3] == '=');
+    CHECK(base64_decoded_size(one, 4) == 1);
+    unsigned char back1[8];
+    CHECK(base64_decode(one, 4, back1) == 1);
+    CHECK(back1[0] == 'f');
+
+    /* two bytes -> "XXY=" */
+    unsigned char two[8] = {0};
+    const unsigned char b2[2] = {'f', 'o'};
+    CHECK(base64_encode(b2, 2, two) == 4);
+    CHECK(two[0] == 'Z' && two[3] == '=');
+    unsigned char back2[8];
+    CHECK(base64_decode(two, 4, back2) == 2);
+    CHECK(memcmp(back2, "fo", 2) == 0);
+
+    /* decode char table sanity */
+    CHECK(base64_decode_char('A') == 0);
+    CHECK(base64_decode_char('a') == 26);
+    CHECK(base64_decode_char('0') == 52);
+    CHECK(base64_decode_char('+') == 62);
+    CHECK(base64_decode_char('/') == 63);
+    CHECK(base64_decode_char('=') == 64);
+
+    /* odd / invalid encoded size rejected */
+    CHECK(base64_decode((const unsigned char*)"ABC", 3, dec) == -1);
+    CHECK(base64_decode((const unsigned char*)"ABCD", 4, dec) == 3);
+
+    /* longer 5-byte boundary (size%3==2) encodes to 8 chars, round-trips */
+    const unsigned char five[5] = {0x10, 0x20, 0x30, 0x40, 0x50};
+    unsigned char enc5[16];
+    int e5 = base64_encode(five, 5, enc5);
+    CHECK(e5 == 8);
+    unsigned char dec5[8];
+    CHECK(base64_decode(enc5, 8, dec5) == 5);
+    CHECK(memcmp(dec5, five, 5) == 0);
+}
