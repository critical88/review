+/* ---- query_params ----
+ * The iterator yields one parameter per string: it stops at the first
+ * '&' (the separator is not consumed/skipped) or '#'. These tests pin that
+ * actual behavior so the smell refactor must preserve it. */
+static void test_query_params(void) {
+    query_param_iterator_t it; query_param_t p;
+
+    char s[] = "a=1&b=2&c";
+    CHECK(query_param_iterator_init(&it, s, strlen(s)) == 0);
+    CHECK(query_param_iterator_next(&it, &p));
+    CHECK(p.name_len == 1 && memcmp(p.name, "a", 1) == 0);
+    CHECK(p.value_len == 1 && p.value && memcmp(p.value, "1", 1) == 0);
+    CHECK(!query_param_iterator_next(&it, &p)); /* left sitting on '&' -> false */
+
+    /* fragment terminates iteration immediately */
+    char s2[] = "x=10#ignored&y=20";
+    CHECK(query_param_iterator_init(&it, s2, strlen(s2)) == 0);
+    CHECK(query_param_iterator_next(&it, &p));
+    CHECK(p.name_len == 1 && memcmp(p.name, "x", 1) == 0);
+    CHECK(p.value_len == 2 && p.value && memcmp(p.value, "10", 2) == 0);
+    CHECK(!query_param_iterator_next(&it, &p)); /* left on '#' -> false */
+
+    /* empty string yields no params */
+    char s3[] = "";
+    CHECK(query_param_iterator_init(&it, s3, 0) == 0);
+    CHECK(!query_param_iterator_next(&it, &p));
+
+    /* only a fragment yields no params */
+    char s4[] = "#frag";
+    CHECK(query_param_iterator_init(&it, s4, strlen(s4)) == 0);
+    CHECK(!query_param_iterator_next(&it, &p));
+
+    /* value present up to a fragment */
+    char s5[] = "k=v#frag";
+    CHECK(query_param_iterator_init(&it, s5, strlen(s5)) == 0);
+    CHECK(query_param_iterator_next(&it, &p));
+    CHECK(p.name_len == 1 && memcmp(p.name, "k", 1) == 0);
+    CHECK(p.value_len == 1 && p.value && memcmp(p.value, "v", 1) == 0);
+    CHECK(!query_param_iterator_next(&it, &p));
+
+    /* empty value (trailing '=') reported as no value */
+    char s6[] = "key=";
+    CHECK(query_param_iterator_init(&it, s6, strlen(s6)) == 0);
+    CHECK(query_param_iterator_next(&it, &p));
+    CHECK(p.name_len == 3 && memcmp(p.name, "key", 3) == 0);
+    CHECK(p.value == NULL && p.value_len == 0);
+    CHECK(!query_param_iterator_next(&it, &p));
+
+    /* name with no '=' reports name only */
+    char s7[] = "noeq";
+    CHECK(query_param_iterator_init(&it, s7, strlen(s7)) == 0);
+    CHECK(query_param_iterator_next(&it, &p));
+    CHECK(p.name_len == 4 && memcmp(p.name, "noeq", 4) == 0);
+    CHECK(p.value == NULL && p.value_len == 0);
+    CHECK(!query_param_iterator_next(&it, &p));
+}
