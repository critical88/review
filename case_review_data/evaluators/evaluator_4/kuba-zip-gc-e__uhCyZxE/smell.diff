+
+/* Resets the session's active cipher keys to their initial values. */
+static void zip_entry_enc_reset(struct zip_t *zip) {
+  zip->entry.enc_key0 = 305419896;
+  zip->entry.enc_key1 = 591751049;
+  zip->entry.enc_key2 = 878082192;
+}
+
+/*
+ * Computes a single-byte "raw" CRC32 update without the initial/final
+ * complement that mz_crc32 applies.  PKWARE encryption requires this
+ * uncomplemented variant for key derivation.
+ */
+static mz_uint32 zip_crc32_raw(mz_uint32 crc, mz_uint8 c) {
+  return ~(mz_uint32)mz_crc32(~crc, &c, 1);
+}
+
+/* Advances the session's active cipher keys by one plaintext byte. */
+static void zip_entry_enc_update(struct zip_t *zip, mz_uint8 c) {
+  zip->entry.enc_key0 = zip_crc32_raw(zip->entry.enc_key0, c);
+  zip->entry.enc_key1 = zip->entry.enc_key1 + (zip->entry.enc_key0 & 0xFF);
+  zip->entry.enc_key1 = zip->entry.enc_key1 * 134775813 + 1;
+  zip->entry.enc_key2 = zip_crc32_raw(zip->entry.enc_key2,
+                                      (mz_uint8)(zip->entry.enc_key1 >> 24));
+}
+
+/* Derives the next keystream byte from the session's active keys. */
+static mz_uint8 zip_entry_enc_keystream(struct zip_t *zip) {
+  mz_uint32 temp = (mz_uint16)(zip->entry.enc_key2 | 2);
+  return (mz_uint8)((temp * (temp ^ 1)) >> 8);
+}
+
+/*
+ * Initializes the session's active cipher keys from the session password and
+ * derives the key schedule from it.
+ */
+static void zip_entry_enc_password(struct zip_t *zip) {
+  const char *password = zip ? zip->password : NULL;
+  zip_entry_enc_reset(zip);
+  if (password) {
+    while (*password) {
+      zip_entry_enc_update(zip, (mz_uint8)*password);
+      password++;
+    }
+  }
+}
+
+/* Decrypts a single ciphertext byte with the session's active keys. */
+static mz_uint8 zip_entry_enc_decrypt(struct zip_t *zip, mz_uint8 c) {
+  mz_uint8 k = zip_entry_enc_keystream(zip);
+  mz_uint8 dec = (mz_uint8)(c ^ k);
+  zip_entry_enc_update(zip, dec);
+  return dec;
+}
+#endif /* ZIP_ENABLE_INFLATE || ZIP_ENABLE_DEFLATE */
