+	switch (p->plan) {
+	case SI_CHECKPOINT: plan = "checkpoint";
+		break;
+	case SI_COMPACTION: plan = "compaction";
+		break;
+	case SI_GC: plan = "gc";
+		break;
+	case SI_EXPIRE: plan = "expire";
+		break;
+	case SI_NODEGC: plan = "node gc";
+		break;
+	case SI_BACKUP:
+	case SI_BACKUPEND: plan = "backup";
+		break;
+	}
+	if (p->node) {
+		ss_trace(t, "%s <%" PRIu32 ":%020" PRIu64 ".db>",
+		         plan, id, p->node->id);
+	} else {
+		ss_trace(t, "%s <%" PRIu32 ">",
+		         plan, id);
+	}
+	return 0;
+}
+
+siplannerrc
+sc_plan(scdb *db, siplan *plan)
+{
+	/*
+	 * Build the next maintenance plan of a registered database.
+	 * The planner queue, the node index and the matching
+	 * conditions of every operation are handled here.
+	 */
+	si *index = db->index;
+	siplanner *p = &index->p;
+	siplannerrc rc = SI_PNONE;
+	sinode *n = NULL;
+	ssrqnode *pn = NULL;
+	sslist *i;
+
+	si_lock(index);
+	switch (plan->plan) {
+	case SI_CHECKPOINT: {
+		/* try to peek a node which has min
+		 * lsn <= required value
+		*/
+		while ((pn = ss_rqprev(&p->memory, pn))) {
+			n = sscast(pn, sinode, nodememory);
+			if (n->i0.lsnmin <= plan->a) {
+				if (n->flags & SI_LOCK) {
+					rc = SI_PRETRY;
+					continue;
+				}
+				goto match;
+			}
+		}
+		break;
+	}
+	case SI_COMPACTION: {
+		/* try to peek a node with a biggest in-memory index */
+
+		/* calculate peek wm */
+		double cache_per_node =
+			(double)index->scheme.compaction.cache /
+			(double)index->n;
+		if (cache_per_node >= index->scheme.compaction.node_size)
+			cache_per_node = index->scheme.compaction.node_size;
+		while ((pn = ss_rqprev(&p->memory, pn))) {
+			n = sscast(pn, sinode, nodememory);
+			if (n->flags & SI_LOCK)
+				continue;
+			if (n->used >= cache_per_node)
+				goto match;
+			rc = SI_PNONE;
+			goto out;
+		}
+		rc = SI_PNONE;
+		break;
+	}
+	case SI_NODEGC: {
+		/* node delayed gc */
+		if (sslikely(index->gc_count == 0)) {
+			rc = SI_PNONE;
+			goto out;
+		}
+		rc = SI_PNONE;
+		ss_listforeach(&index->gc, i) {
+			sinode *gn = sscast(i, sinode, gc);
+			if (sslikely(si_noderefof(gn) == 0)) {
+				ss_listunlink(&gn->gc);
+				index->gc_count--;
+				plan->node = gn;
+				rc = SI_PMATCH;
+				goto out;
+			}
+			rc = SI_PRETRY;
+		}
+		break;
+	}
+	case SI_GC: {
+		/* try to peek a node with a biggest in-memory index
+		 * which is ready for gc */
+		while ((pn = ss_rqprev(&p->memory, pn))) {
+			n = sscast(pn, sinode, nodememory);
+			sdindexheader *h = n->index.h;
+			if (sslikely(h->dupkeys == 0) || (h->dupmin >= plan->a))
+				continue;
+			uint32_t used = (h->dupkeys * 100) / h->keys;
+			if (used >= plan->b) {
+				if (n->flags & SI_LOCK) {
+					rc = SI_PRETRY;
+					continue;
+				}
+				goto match;
+			}
+		}
+		break;
+	}
+	case SI_EXPIRE: {
+		/* full scan */
+		uint32_t now = ss_timestamp();
+		while ((pn = ss_rqprev(&p->memory, pn))) {
+			n = sscast(pn, sinode, nodememory);
+			sdindexheader *h = n->index.h;
+			if (h->tsmin == UINT32_MAX)
+				continue;
+			uint32_t diff = now - h->tsmin;
+			if (sslikely(diff >= plan->a)) {
+				if (n->flags & SI_LOCK) {
+					rc = SI_PRETRY;
+					continue;
+				}
+				goto match;
+			}
+		}
+		break;
+	}
+	case SI_BACKUP: {
+		/* try to peek a node which has bsn <= required
+		 * value
+		*/
+		while ((pn = ss_rqprev(&p->memory, pn))) {
+			n = sscast(pn, sinode, nodememory);
+			if (n->backup < plan->a) {
+				if (n->flags & SI_LOCK) {
+					rc = SI_PRETRY;
+					continue;
+				}
+				goto match;
+			}
+		}
+		if (rc)
+			break;
+		if (index->backup < plan->a) {
+			plan->plan = SI_BACKUPEND;
+			plan->node = 0;
+			rc = SI_PMATCH;
+			goto out;
+		}
+		rc = SI_PNONE;
+		break;
+	}
+	default:
+		rc = -1;
+		break;
+	}
+out:
+	si_unlock(index);
+	return rc;
+match:
+	si_nodelock(n);
+	plan->node = n;
+	si_unlock(index);
+	return SI_PMATCH;
+}
