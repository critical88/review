diff --git a/sophia/scheduler/sc_log.c b/sophia/scheduler/sc_log.c
new file mode 100644
index 0000000..fdad016
--- /dev/null
+++ b/sophia/scheduler/sc_log.c
@@ -0,0 +1,78 @@
+
+/*
+ * sophia database
+ * sphia.org
+ *
+ * Copyright (c) Dmitry Simonenko
+ * BSD License
+*/
+
+#include <libss.h>
+#include <libsf.h>
+#include <libsr.h>
+#include <libso.h>
+#include <libsv.h>
+#include <libsd.h>
+#include <libsw.h>
+#include <libsi.h>
+#include <libsy.h>
+#include <libsc.h>
+
+int
+sc_logmaint(swmanager *wm, scworker *w, int gc)
+{
+	if (gc == 0) {
+		/* log rotation:
+		 * check whether the active log file reached the
+		 * rotation watermark and switch to a new file
+		*/
+		ss_trace(&w->trace, "%s", "log rotation");
+		if (ssunlikely(! wm->conf.enable))
+			return 0;
+		ss_spinlock(&wm->lock);
+		assert(wm->n > 0);
+		sw *log = sscast(wm->list.prev, sw, link);
+		int ready = ss_gcrotateready(&log->gc, wm->conf.rotatewm);
+		ss_spinunlock(&wm->lock);
+		if (ready) {
+			int rc = sw_managerrotate(wm);
+			if (ssunlikely(rc == -1))
+				return -1;
+		}
+		return 0;
+	}
+	/* log garbage-collection:
+	 * sweep the completed log files, stop as soon as
+	 * garbage-collection is disabled or no garbage is left
+	*/
+	ss_trace(&w->trace, "%s", "log gc");
+	if (ssunlikely(! wm->conf.enable))
+		return 0;
+	for (;;) {
+		ss_spinlock(&wm->lock);
+		if (ssunlikely(! wm->gc)) {
+			ss_spinunlock(&wm->lock);
+			return 0;
+		}
+		sw *current = NULL;
+		sslist *i;
+		ss_listforeach(&wm->list, i) {
+			sw *l = sscast(i, sw, link);
+			if (sslikely(! ss_gcgarbage(&l->gc)))
+				continue;
+			ss_listunlink(&l->link);
+			wm->n--;
+			current = l;
+			break;
+		}
+		ss_spinunlock(&wm->lock);
+		if (current) {
+			int rc = sw_remove(wm, current);
+			if (ssunlikely(rc == -1))
+				return -1;
+		} else {
+			break;
+		}
+	}
+	return 0;
+}
