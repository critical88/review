+// bufferedBytes returns the number of payload bytes currently held in the
+// ring. It takes an unshared snapshot of the ring descriptor and scans the
+// live slots, so the result is an approximation on a busy stream.
+func (s *stream) bufferedBytes() int {
+	r := s.bufferRing
+	var total int
+	for i := 0; i < r.size; i++ {
+		idx := (r.head + i) & r.mask
+		total += len(r.bufs[idx])
+	}
+	return total
+}
