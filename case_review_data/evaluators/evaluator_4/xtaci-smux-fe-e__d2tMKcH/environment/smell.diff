+// streamConsumed records receive-side bookkeeping for a stream after n bytes
+// have been consumed by the reader, and returns the number of consumed bytes
+// that should be announced to the peer in a window update, or 0 when no
+// window update is due.
+//
+// The caller must hold the stream's bufferLock, so the per-stream counters stay
+// consistent with the buffer it mirrors.
+func (s *Session) streamConsumed(st *stream, n int) uint32 {
+	st.numRead += uint32(n)
+	st.incr += uint32(n)
+
+	// send window update if the increased bytes exceed half of the buffer size
+	// or this is the initial read.
+	if st.incr >= st.windowUpdateThreshold || st.numRead == uint32(n) {
+		notifyConsumed := st.numRead
+		st.incr = 0
+		return notifyConsumed
+	}
+	return 0
+}
+
+// streamWindow computes the current send window for a stream. ok is false if
+// the peer claims to have consumed more than it received, which indicates
+// malformed remote data.
+//
+// All window state lives on the stream, so the session simply mediates the
+// arithmetic the write path needs.
+func (s *Session) streamWindow(st *stream) (win int32, windowOk bool) {
+	// per stream sliding window control
+	// [.... [consumed... numWritten] ... win... ]
+	// [.... [consumed...................+rmtwnd]]
+	// note:
+	// even if uint32 overflow, this math still works:
+	// eg1: uint32(0) - uint32(math.MaxUint32) = 1
+	// eg2: int32(uint32(0) - uint32(1)) = -1
+	//
+	// basically, you can take it as a MODULAR ARITHMETIC
+	inflight := int32(atomic.LoadUint32(&st.numWritten) - atomic.LoadUint32(&st.peerConsumed))
+	if inflight < 0 { // security check for malformed data
+		return 0, false
+	}
+
+	// make sure you understand 'win' is calculated in modular arithmetic(2^32(4GB))
+	win = int32(atomic.LoadUint32(&st.peerWindow)) - inflight
+	return win, true
+}
