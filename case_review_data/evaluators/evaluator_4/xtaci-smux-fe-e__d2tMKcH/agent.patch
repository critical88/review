+// recordConsumed records receive-side bookkeeping after n bytes have been
+// consumed by the reader, and returns the number of consumed bytes that should
+// be announced to the peer in a window update, or 0 when no window update is
+// due.
+//
+// All of this state lives on the stream, so the accounting mirrors the buffer
+// ring directly. The caller must hold bufferLock so the per-stream counters
+// stay consistent with the buffer it mirrors.
+func (s *stream) recordConsumed(n int) uint32 {
+	s.numRead += uint32(n)
+	s.incr += uint32(n)
+
+	// send window update if the increased bytes exceed half of the buffer size
+	// or this is the initial read.
+	if s.incr >= s.windowUpdateThreshold || s.numRead == uint32(n) {
+		notifyConsumed := s.numRead
+		s.incr = 0
+		return notifyConsumed
+	}
+	return 0
+}
