index 168ed1b..e901395 100644
--- a/shaper.go
+++ b/shaper.go
@@ -180,3 +180,26 @@ func (sq *shaperQueue) IsEmpty() bool {
 func (sq *shaperQueue) Len() int {
 	return int(atomic.LoadInt64(&sq.count))
 }
+
+// pendingBacklog reports how many write requests and payload bytes are
+// currently queued, walking the round-robin list and summing the payload
+// bytes waiting in every stream's heap.
+func (sq *shaperQueue) pendingBacklog() (queuedFrames uint64, queuedBytes uint64) {
+	sq.mu.Lock()
+	defer sq.mu.Unlock()
+
+	// total number of queued write requests
+	queuedFrames = uint64(atomic.LoadInt64(&sq.count))
+
+	for elem := sq.rrList.Front(); elem != nil; elem = elem.Next() {
+		sid, _ := elem.Value.(uint32)
+		h := sq.streams[sid]
+		if h == nil {
+			continue
+		}
+		for i := 0; i < h.Len(); i++ {
+			queuedBytes += uint64(len((*h)[i].frame.data))
+		}
+	}
+	return queuedFrames, queuedBytes
+}
