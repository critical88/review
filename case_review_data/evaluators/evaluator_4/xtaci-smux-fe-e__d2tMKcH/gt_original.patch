 	}
-	return total
+	return 0
+}
+
+// sendWindow computes the current send window for this stream. ok is false if
+// the peer claims to have consumed more than it received, which indicates
+// malformed remote data.
+//
+// note:
+// even if uint32 overflow, this math still works:
+// eg1: uint32(0) - uint32(math.MaxUint32) = 1
+// eg2: int32(uint32(0) - uint32(1)) = -1
+//
+// basically, you can take it as a MODULAR ARITHMETIC
+func (s *stream) sendWindow() (win int32, windowOk bool) {
+	inflight := int32(atomic.LoadUint32(&s.numWritten) - atomic.LoadUint32(&s.peerConsumed))
+	if inflight < 0 { // security check for malformed data
+		return 0, false
+	}
+
+	// make sure you understand 'win' is calculated in modular arithmetic(2^32(4GB))
+	win = int32(atomic.LoadUint32(&s.peerWindow)) - inflight
+	return win, true
+}
+
+// stats returns a point-in-time accounting view of the stream. Values are
+// sampled without taking the stream's lock, so they describe an approximation
+// of the state at some recent instant.
+func (s *stream) stats() StreamAccounting {
+	var acc StreamAccounting
+	acc.ID = s.id
+	acc.BytesRead = uint64(s.numRead)
+	acc.BytesWritten = uint64(s.numWritten)
+	acc.Inflight = s.numWritten - s.peerConsumed
+	acc.PeerWindow = s.peerWindow
+	acc.BytesBuffered = s.bufferRing.bufferedBytes()
+
+	select {
+	case <-s.chFinEvent:
+		acc.ReadClosed = true
+	default:
+	}
+
+	select {
+	case <-s.chWriteClosed:
+		acc.WriteClosed = true
+	default:
+	}
+
+	select {
+	case <-s.die:
+		acc.Closed = true
+	default:
+	}
+
+	return acc
 }
 
