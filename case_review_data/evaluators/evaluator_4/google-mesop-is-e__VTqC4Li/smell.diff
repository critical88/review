diff --git a/mesop/server/session_backend.py b/mesop/server/session_backend.py
new file mode 100644
index 0000000..f788b88
--- /dev/null
+++ b/mesop/server/session_backend.py
@@ -0,0 +1,143 @@
+"""Shared interface for session-scoped server stores.
+
+Mesop keeps two kinds of session-scoped server state:
+
+- state session backends, which cache server-side app state between requests
+  (see `mesop.server.state_session`);
+- the pending-cookie token cache, which hands a signed one-time token for
+  cookies queued during an event handler back to the browser
+  (see `mesop.server.server`).
+
+Both deal in opaque tokens that carry a payload for a bounded lifetime, so
+this module defines the single `SessionBackend` interface that every
+session-scoped store must implement. Backend authors only need to learn one
+interface, and framework code can treat every store uniformly instead of
+wiring each one by hand.
+"""
+
+import abc
+import re
+import secrets
+from typing import TYPE_CHECKING, Any, Protocol
+
+from mesop.dataclass_utils import (
+  serialize_dataclass,
+  update_dataclass_from_json,
+)
+from mesop.exceptions import MesopException
+
+if TYPE_CHECKING:
+  from mesop.runtime.context import PendingCookie
+
+States = dict[type[Any], object]
+
+# Matches tokens produced by secrets.token_urlsafe: base64url alphabet only.
+_VALID_TOKEN_RE = re.compile(r"^[A-Za-z0-9_-]+$")
+
+
+class SessionBackend(Protocol):
+  """Interface for session-scoped server stores.
+
+  Every session-scoped store must be able to persist and restore server-side
+  state, mint and admit session tokens, encode the state payload, redeem
+  one-time tokens, and discard stale sessions.
+  """
+
+  # --- Application state persistence ---
+
+  def restore(self, token: str, states: States):
+    """Gets the saved state from the given token and updates the given state."""
+    raise NotImplementedError()
+
+  def save(self, token: str, states: States):
+    """Saves state to the backend with the given token."""
+    raise NotImplementedError()
+
+  # --- Session housekeeping ---
+
+  def clear_stale_sessions(self):
+    """Deletes unused session data."""
+    raise NotImplementedError()
+
+  # --- Token lifecycle ---
+
+  def issue_token(self) -> str:
+    """Returns a fresh opaque token for addressing a stored session value."""
+    raise NotImplementedError()
+
+  def validate_token(self, token: str) -> bool:
+    """Returns whether the token is structurally valid for this backend."""
+    raise NotImplementedError()
+
+  # --- State payload codec ---
+
+  def encode_states(self, states: States) -> list[str]:
+    """Encodes app state into the payload this backend stores."""
+    raise NotImplementedError()
+
+  def decode_states(self, states: States, payload: list[str]):
+    """Updates the given state in place from a payload produced by encode."""
+    raise NotImplementedError()
+
+  # --- One-time redemption ---
+
+  def put(self, cookies: "list[PendingCookie]") -> str:
+    """Stores a one-time value and returns the token that redeems it."""
+    raise NotImplementedError()
+
+  def pop(self, token: str) -> "list[PendingCookie] | None":
+    """Redeems and discards the value stored under the given token."""
+    raise NotImplementedError()
+
+
+class BaseStateSessionBackend(SessionBackend, abc.ABC):
+  """Template-method base for session backends.
+
+  Subclasses plug in the persistence mechanism (restore/save/clear) while
+  token minting, token admission, and the state payload codec are shared by
+  every backend.
+  """
+
+  @abc.abstractmethod
+  def restore(self, token: str, states: States):
+    """Gets the saved state from the given token and updates the given state."""
+    raise NotImplementedError()
+
+  @abc.abstractmethod
+  def save(self, token: str, states: States):
+    """Saves state to the backend with the given token."""
+    raise NotImplementedError()
+
+  @abc.abstractmethod
+  def clear_stale_sessions(self):
+    """Deletes unused session data."""
+    raise NotImplementedError()
+
+  def issue_token(self) -> str:
+    """Returns a fresh opaque token for addressing a stored session value."""
+    return secrets.token_urlsafe(16)
+
+  def validate_token(self, token: str) -> bool:
+    """Returns whether the token is structurally valid for this backend."""
+    return bool(_VALID_TOKEN_RE.match(token))
+
+  def encode_states(self, states: States) -> list[str]:
+    """Encodes app state into the payload this backend stores."""
+    return [serialize_dataclass(state) for state in states.values()]
+
+  def decode_states(self, states: States, payload: list[str]):
+    """Updates the given state in place from a payload produced by encode."""
+    for state, serialized_state in zip(states.values(), payload):
+      update_dataclass_from_json(state, serialized_state)
+
+  def put(self, cookies: "list[PendingCookie]") -> str:
+    """Session state backends do not redeem pending cookies."""
+    raise MesopException(
+      f"{type(self).__name__} does not store pending cookies."
+    )
+
+  def pop(self, token: str) -> "list[PendingCookie] | None":
+    """Session state backends do not redeem pending cookies."""
+    raise MesopException(
+      f"{type(self).__name__} does not redeem pending cookies."
+    )
