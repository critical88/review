-// Shared registry for starter template convention rules.
+// Starter template conventions shared by the validation and GHES sync scripts.
 //
-// The template conventions (where a starter template keeps its metadata, how
-// icon references resolve, and how templates are classified) are contributed as
-// named rules by the script that owns them. Consumers select the concrete rule
-// serving each convention slot through the "templateRules" map in their
-// settings.json, so scripts must agree on both the slot keys and the
-// registered rule names.
+// Every rule that decides where a starter template keeps its data, how an
+// icon reference resolves, or how a template is classified lives here, so a
+// change to a convention is made in a single place.
 
-export interface TemplateRule {
-  (...args: any[]): any;
+import { basename, join } from "path";
+
+// Starter templates keep their metadata at properties/<id>.properties.json
+export function propertiesPathFor(folder: string, templateId: string): string {
+  return join(folder, "properties", `${templateId}.properties.json`);
+}
+
+// Starter workflow files always live next to their properties folder
+export function workflowPathFor(folder: string, templateId: string): string {
+  return join(folder, `${templateId}.yml`);
+}
+
+// Embedded icon references use the `octicon <name>` form
+export function iconRefIsOcticon(iconName: string): boolean {
+  return /^octicon\s+/.test(iconName);
+}
+
+// The validation pass only treats `octicon <name>` (with trailing whitespace)
+// as embedded; GHES sync treats any `octicon`-prefixed reference as embedded.
+// The two flavors are intentionally kept apart until the convention is
+// deliberately unified.
+export function ghesIconIsEmbedded(iconName: string): boolean {
+  return iconName.startsWith("octicon");
 }
 
-const templateRuleTable: { [name: string]: TemplateRule } = {};
+// Locally stored icons live in the shared icons folder
+export function svgIconPath(iconName: string): string {
+  return join("../../icons", `${iconName}.svg`);
+}
+
+// The embedded octicon name is everything after `octicon `
+export function octiconNameFromRef(iconName: string): string | null {
+  const match = iconName.match(/^octicon\s+(.*)/);
+  return match ? match[1] : null;
+}
+
+// Blank templates are exempt from the category rules
+export function isBlankTemplate(workflowPath: string): boolean {
+  return workflowPath.endsWith("blank.yml");
+}
+
+// Deployment templates must declare a creator
+export function isDeploymentFolder(path: string): boolean {
+  return basename(path).toLowerCase() == 'deployments';
+}
 
-export function registerTemplateRule(name: string, rule: TemplateRule): void {
-  templateRuleTable[name] = rule;
+// A partner template is published under a partner creator account
+export function isPartnerCreator(creator: string, partners: Set<string>): boolean {
+  return partners.has(creator.toLowerCase());
 }
 
-export function templateRuleFor(resolvedName: string): TemplateRule {
