+/// The pack of construction facts shared by every fetcher for a single
+/// (crate, target) resolution attempt.
+///
+/// Bundling these into one value means `Fetcher::new` and the helpers
+/// around it receive a single carrier rather than enumerating the same
+/// elements on every signature. When the constructor needs a new fact,
+/// it grows here once instead of being threaded through every call
+/// along the fetch pipeline.
+#[derive(Clone)]
+pub struct FetchContext {
+    /// Crate name being fetched.
+    pub name: CompactString,
+    /// Version being fetched.
+    pub version: CompactString,
+    /// Repository URL, if known from the manifest.
+    pub repo: Option<String>,
+    /// Target triple, e.g. `x86_64-unknown-linux-gnu`.
+    pub target: String,
+    /// Resolved package metadata (pkg-url, bin-dir, signing, ...).
+    pub meta: PkgMeta,
+    /// Extra target-derived template values, fed into `leon` rendering.
+    pub target_related_info: Arc<dyn leon::Values + Send + Sync>,
+    /// Cache shared by every fetcher resolving the same crate so the
+    /// repo-info lookup is computed at most once.
+    pub repo_info_cache: Arc<OnceCell<Option<RepoInfo>>>,
+    /// How the fetcher must treat package signatures.
+    pub signature_policy: SignaturePolicy,
+}
+
 #[async_trait::async_trait]
 pub trait Fetcher: Send + Sync {
-    /// Create a new fetcher from the crate and target facts
+    /// Create a new fetcher from the crate and target facts carried in
+    /// `ctx`.
     #[allow(clippy::new_ret_no_self)]
-    fn new(
-        client: Client,
-        gh_api_client: GhApiClient,
-        name: CompactString,
-        version: CompactString,
-        repo: Option<String>,
-        target: String,
-        meta: PkgMeta,
-        target_related_info: Arc<dyn leon::Values + Send + Sync>,
-        repo_info_cache: Arc<OnceCell<Option<RepoInfo>>>,
-        signature_policy: SignaturePolicy,
-    ) -> Arc<dyn Fetcher>
+    fn new(client: Client, gh_api_client: GhApiClient, ctx: FetchContext) -> Arc<dyn Fetcher>
     where
         Self: Sized;
 
