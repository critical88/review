+/// Register the fetcher produced by `resolver` for one target, honouring
+/// the strategy filters of this resolution.
+fn push_fetcher_handle(
+    handles: &mut Vec<Arc<dyn Fetcher>>,
+    resolver: Resolver,
+    filter_fetcher_by_name_predicate: fn(&'static str) -> bool,
+    client: Client,
+    gh_api_client: GhApiClient,
+    name: &str,
+    version: &str,
+    repo: Option<&str>,
+    target: &str,
+    meta: &PkgMeta,
+    target_related_info: &Arc<dyn leon::Values + Send + Sync>,
+    repo_info_cache: &Arc<OnceCell<Option<RepoInfo>>>,
+    signature_policy: SignaturePolicy,
+) {
+    let fetcher = resolver(
+        client,
+        gh_api_client,
+        name.to_compact_string(),
+        version.to_compact_string(),
+        repo.map(ToString::to_string),
+        target.to_string(),
+        meta.clone(),
+        target_related_info.clone(),
+        repo_info_cache.clone(),
+        signature_policy,
+    );
+
+    if let Some(disabled_strategies) = meta.disabled_strategies.as_deref() {
+        if disabled_strategies.contains(&fetcher.strategy()) {
+            return;
+        }
+    }
+
+    if filter_fetcher_by_name_predicate(fetcher.fetcher_name()) {
+        handles.push(fetcher);
+    }
+}
