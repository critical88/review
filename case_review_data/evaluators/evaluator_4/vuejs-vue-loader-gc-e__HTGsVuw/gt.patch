+/**
+ * CSS Modules code generation for a compiled single file component.
+ *
+ * For each `<style module>` block, vue-loader emits an import of the compiled
+ * css module, assigns it into a shared `cssModules` object (attached to the
+ * component as `__cssModules`), and — when hot reload is active — installs a
+ * per-style accept handler that refreshes the binding. This module assembles
+ * that source text; the coordinator (the `SFCLoader` entry) owns the shared
+ * `cssModules` declaration and the `__cssModules` prop attachment, and appends
+ * what this returns to the generated module. The identifiers referenced here
+ * (`cssModules`, `__VUE_HMR_RUNTIME__`, `module.hot`) resolve at runtime in the
+ * generated module's scope.
+ */
+
+export function genCSSModulesCode(opts: {
+  index: number
+  request: string
+  moduleName: string | boolean
+  id: string
+  needsHotReload: boolean
+}): string {
+  const { index, request, moduleName, id, needsHotReload } = opts
+  const styleVar = `style${index}`
+  let code = `\nimport ${styleVar} from ${request}`
+
+  // inject variable
+  const name = typeof moduleName === 'string' ? moduleName : '$style'
+  code += `\ncssModules["${name}"] = ${styleVar}`
+
+  if (needsHotReload) {
+    code += `
+if (module.hot) {
+  module.hot.accept(${request}, () => {
+    cssModules["${name}"] = ${styleVar}
+    __VUE_HMR_RUNTIME__.rerender("${id}")
+  })
+}`
+  }
+
+  return code
+}
