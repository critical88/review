@@ -0,0 +1,40 @@
+/**
+ * Hot Module Replacement code generation for a compiled single file component.
+ *
+ * This module emits the runtime HMR wiring that gets inlined into the proxy
+ * module vue-loader produces for a `.vue` request: it registers the component
+ * under an HMR id so edits to its script reload it in place, and — when a
+ * separate template request exists — accepts that request so that editing the
+ * `<template>` alone only rerenders. The snippets reference identifiers
+ * (`__exports__`, `__VUE_HMR_RUNTIME__`, `render`, `module.hot`, `api`) that
+ * live in the generated module's scope; this module only assembles the source
+ * text the coordinator appends to that module.
+ */
+
+// __VUE_HMR_RUNTIME__ is injected to global scope by @vue/runtime-core
+export function genHotReloadCode(opts: {
+  id: string
+  templateRequest?: string
+}): string {
+  const { id, templateRequest } = opts
+  return `
+/* hot reload */
+if (module.hot) {
+  __exports__.__hmrId = "${id}"
+  const api = __VUE_HMR_RUNTIME__
+  module.hot.accept()
+  if (!api.createRecord('${id}', __exports__)) {
+    api.reload('${id}', __exports__)
+  }
+  ${templateRequest ? genTemplateHotReloadCode(id, templateRequest) : ''}
+}
+`
+}
+
+function genTemplateHotReloadCode(id: string, request: string) {
+  return `
+  module.hot.accept(${request}, () => {
+    api.rerender('${id}', render)
+  })
+`
+}
