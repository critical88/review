+/*
+ * Report one module's current values in the tsar --check "key=value" format.
+ * The check consumers (console, tcp uplink, alert tooling) all depend on the
+ * exact walk below, so it is kept as one routine per module sample.
+ */
+static void
+print_module_check_state(struct module *mod)
+{
+    double           *st_array;
+    char             *mod_name;
+    struct mod_info  *info = mod->info;
+    char              opt[LEN_128] = {0};
+    char             *n_record;
+    char             *token;
+    char             *s_token;
+    int               j, k;
+
+    if (!mod->enable) {
+        return;
+    }
+    /* get mod name */
+    mod_name = strstr(mod->opt_line, "--");
+    if (mod_name) {
+        mod_name += 2;
+    }
+
+    n_record = strdup(mod->record);
+    token = strtok(n_record, ITEM_SPLIT);
+
+    for (j = 0; j < mod->n_item; j++) {
+        memset(opt, 0, sizeof(opt));
+        if (token) {
+            s_token = strpbrk(token, ITEM_SPSTART);
+            if (s_token) {
+                strncat(opt, token, s_token - token);
+                strcat(opt, ":");
+            }
+        }
+        st_array = &mod->st_array[j * mod->n_col];
+        for (k = 0; k < mod->n_col; k++) {
+            if (mod->spec) {
