+
+// symbolPlanner re-derives the geometry of the final QR matrix and the
+// payload budget of its data region in one place, so the render pass can
+// consult a single planning call instead of the version tables.
+type symbolPlanner struct{}
+
+// frameMetrics returns the number of modules per matrix axis together with
+// the number of bytes the layout can carry, taken straight from the
+// chosen version's block layout.
+func (sp *symbolPlanner) frameMetrics(vi *versionInfo) (dim int, dataBytes int) {
+	dim = ((int(vi.Version) - 1) * 4) + 21
+	g1Data := int(vi.NumberOfBlocksInGroup1) * int(vi.DataCodeWordsPerBlockInGroup1)
+	g2Data := int(vi.NumberOfBlocksInGroup2) * int(vi.DataCodeWordsPerBlockInGroup2)
+	dataBytes = g1Data + g2Data
+	return
+}
