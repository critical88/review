+// digitPlan coaches which bar pattern a digit contributes at each position
+// of an EAN 13 symbol: the left hand side alternates the odd and even
+// variants following the parity row encoded by the lead digit.
+type digitPlan struct {
+	parity []bool
+}
+
+func newDigitPlan(num encodedNumber) *digitPlan {
+	return &digitPlan{parity: num.CheckSum}
+}
+
+// barsAt returns the bar pattern for the digit num at the given content
+// position, choosing the left hand variant from the plan's parity pattern.
+func (dp *digitPlan) barsAt(cpos int, num encodedNumber) []bool {
+	if cpos < 7 { // Left
+		if dp.parity[cpos-1] {
+			return num.LeftEven
+		}
+		return num.LeftOdd
+	}
+	return num.Right
+}
+
 func encodeEAN13(code string) *utils.BitList {
 	result := new(utils.BitList)
 	result.AddBit(true, false, true)
 
-	var firstNum []bool
+	var plan *digitPlan
 	for cpos, r := range code {
 		num, ok := encoderTable[r]
 		if !ok {
 			return nil
 		}
 		if cpos == 0 {
-			firstNum = num.CheckSum
+			plan = newDigitPlan(num)
 			continue
 		}
 
-		var data []bool
-		if cpos < 7 { // Left
-			if firstNum[cpos-1] {
-				data = num.LeftEven
-			} else {
-				data = num.LeftOdd
-			}
-		} else {
-			data = num.Right
-		}
-
 		if cpos == 7 {
 			result.AddBit(false, true, false, true, false)
 		}
-		result.AddBit(data...)
+		result.AddBit(plan.barsAt(cpos, num)...)
 	}
 	result.AddBit(true, false, true)
 	return result
