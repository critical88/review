-// The capture handling only processes events while the input pipeline
-// requested relative mouse mode. Reading the display state locally keeps the
-// capture policy out of the screen event loop.
-static bool
-sc_mouse_capture_is_relative_mode(struct sc_mouse_capture *mc) {
-    struct sc_screen *screen = mc->screen;
-
-    // The capture state must handle the window exposed by its own screen,
-    // and the mouse processor must be properly initialized
-    assert(&screen->mc == mc);
-    assert(screen->window);
-    assert(screen->im.mp && screen->im.mp->ops);
-
-    return screen->im.mp && screen->im.mp->relative_mode;
-}
