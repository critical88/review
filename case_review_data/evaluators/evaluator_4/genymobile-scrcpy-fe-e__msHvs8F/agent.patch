diff --git a/app/src/screen.c b/app/src/screen.c
index a622725..31f6863 100644
--- a/app/src/screen.c
+++ b/app/src/screen.c
@@ -1326,3 +1326,38 @@ sc_screen_convert_window_to_frame_coords(struct sc_screen *screen,
 
     return result;
 }
+
+// Return true if the point is located outside of the displayed content
+// rectangle (i.e. on the black borders)
+bool
+sc_screen_is_point_outside_content(struct sc_screen *screen, int32_t x,
+                                   int32_t y) {
+    return x < screen->rect.x
+        || x >= screen->rect.x + screen->rect.w
+        || y < screen->rect.y
+        || y >= screen->rect.y + screen->rect.h;
+}
+
+// Compute the position of the virtual finger mirroring a window point through
+// the center of the displayed content.
+struct sc_point
+sc_screen_get_vfinger_position(struct sc_screen *screen, int32_t x, int32_t y,
+                               bool invert_x, bool invert_y) {
+    // The window must expose the content, the content rectangle must be
+    // initialized and the device frame must be known for the pointer and its
+    // mirror to be meaningful
+    assert(screen->window);
+    assert(screen->rect.w && screen->rect.h);
+    assert(screen->frame_size.width && screen->frame_size.height);
+
+    struct sc_point position =
+        sc_screen_convert_window_to_frame_coords(screen, x, y);
+
+    if (invert_x) {
+        position.x = screen->frame_size.width - position.x;
+    }
+    if (invert_y) {
+        position.y = screen->frame_size.height - position.y;
+    }
+    return position;
+}
