+// return true if the point (in window coordinates) is located outside of the
+// displayed content rectangle (i.e. on the black borders)
+bool
+sc_screen_is_point_outside_content(struct sc_screen *screen,
+                                   int32_t x, int32_t y);
+
+// compute the position (in frame coordinates) of the virtual finger mirroring
+// a window point through the center of the displayed content
+//
+// When invert_x (resp. invert_y) is set, the point is mirrored with respect to
+// the vertical (resp. horizontal) axis of symmetry in the middle of the frame.
+struct sc_point
+sc_screen_get_vfinger_position(struct sc_screen *screen, int32_t x, int32_t y,
+                               bool invert_x, bool invert_y);
+
 #endif
