 func init() {
 	// Merge language subs with the default one.
 	// TODO: Find better way so all langs are merged automatically and better
@@ -311,3 +315,61 @@ var bgSub = map[rune]string{
 	'ю': "yu",
 	'я': "ya",
 }
+
+// languageSubstitutionStage applies the substitution table of the requested
+// language during the language phase of the pipeline.
+type languageSubstitutionStage struct{ noopStage }
+
+func (languageSubstitutionStage) StageName() string { return "language substitution" }
+
+// SubstituteLanguage substitutes string chars with the rune substitution map
+// of the selected language. Languages are caught by ISO 3166-1, ISO 639-1:2002
+// and ISO 639-3:2007 codes.
+func (languageSubstitutionStage) SubstituteLanguage(s string, lang string) string {
+	switch strings.ToLower(lang) {
+	case "bg", "bgr":
+		return SubstituteRune(s, bgSub)
+	case "cs", "ces":
+		return SubstituteRune(s, csSub)
+	case "de", "deu":
+		return SubstituteRune(s, deSub)
+	case "en", "eng":
+		return SubstituteRune(s, enSub)
+	case "es", "spa":
+		return SubstituteRune(s, esSub)
+	case "fi", "fin":
+		return SubstituteRune(s, fiSub)
+	case "fr", "fra":
+		return SubstituteRune(s, frSub)
+	case "gr", "el", "ell":
+		return SubstituteRune(s, grSub)
+	case "hu", "hun":
+		return SubstituteRune(s, huSub)
+	case "id", "idn", "ind":
+		return SubstituteRune(s, idSub)
+	case "it", "ita":
+		return SubstituteRune(s, itSub)
+	case "kz", "kk", "kaz":
+		return SubstituteRune(s, kkSub)
+	case "nb", "nob":
+		return SubstituteRune(s, nbSub)
+	case "nl", "nld":
+		return SubstituteRune(s, nlSub)
+	case "nn", "nno":
+		return SubstituteRune(s, nnSub)
+	case "pl", "pol":
+		return SubstituteRune(s, plSub)
+	case "pt", "prt", "pt-br", "br", "bra", "por":
+		return SubstituteRune(s, ptSub)
+	case "ro", "rou":
+		return SubstituteRune(s, roSub)
+	case "sl", "slv":
+		return SubstituteRune(s, slSub)
+	case "sv", "swe":
+		return SubstituteRune(s, svSub)
+	case "tr", "tur":
+		return SubstituteRune(s, trSub)
+	default: // fallback to "en" if lang not found
+		return SubstituteRune(s, enSub)
+	}
+}
