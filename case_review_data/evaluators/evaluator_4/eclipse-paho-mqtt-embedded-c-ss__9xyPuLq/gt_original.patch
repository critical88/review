diff --git a/MQTTPacket/src/MQTTWireStats.c b/MQTTPacket/src/MQTTWireStats.c
index 7b26c09..bdf7443 100644
--- a/MQTTPacket/src/MQTTWireStats.c
+++ b/MQTTPacket/src/MQTTWireStats.c
@@ -14,6 +14,7 @@
  *    Sample Contributor - wire activity accounting for support dumps
  *******************************************************************************/
 
+#include "MQTTPacket.h"
 #include "MQTTWireStats.h"
 
 /* The single, shared wire activity accounting record. */
@@ -29,13 +30,120 @@ MQTTWireStats wireStats = {0};
 void MQTTWireStats_note(int outbound, unsigned char packettype, int wirelen)
 {
 	if (outbound)
-	{
-		wireStats.sentCount[packettype]++;
-		wireStats.bytesOut += wirelen;
-	}
+		MQTTWireStats_noteSent(packettype, wirelen);
 	else
+		MQTTWireStats_noteReceived(packettype, wirelen);
+}
+
+/**
+ * Notes the connect packet which begins a new session: the session-scoped
+ * parts of the accounting record are cleared here, so that a session's
+ * accounting only covers packets for that session.
+ * @param wirelen the total number of wire bytes in the connect packet
+ */
+void MQTTWireStats_beginSession(int wirelen)
+{
+	int i;
+
+	for (i = 0; i < MQTTWIRESTATS_TYPE_COUNT; ++i)
 	{
-		wireStats.receivedCount[packettype]++;
-		wireStats.bytesIn += wirelen;
+		wireStats.sentCount[i] = 0;
+		wireStats.receivedCount[i] = 0;
 	}
+	wireStats.bytesOut = 0;
+	wireStats.bytesIn = 0;
+	wireStats.payloadBytesOut = 0;
+	wireStats.payloadBytesIn = 0;
+	wireStats.highWaterPayload = 0;
+	wireStats.framesIn = 0;
+	wireStats.decodedTopics = 0;
+	wireStats.sessionStarts++;
+	wireStats.sentCount[CONNECT]++;
+	wireStats.bytesOut += wirelen;
+}
+
+/**
+ * Notes a packet serialized onto the wire.
+ * @param packettype the MQTT packet type
+ * @param wirelen the total number of wire bytes in the packet
+ */
+void MQTTWireStats_noteSent(unsigned char packettype, int wirelen)
+{
+	wireStats.sentCount[packettype]++;
+	wireStats.bytesOut += wirelen;
+}
+
+/**
+ * Notes a packet decoded from the wire.
+ * @param packettype the MQTT packet type
+ * @param wirelen the total number of wire bytes in the packet
+ */
+void MQTTWireStats_noteReceived(unsigned char packettype, int wirelen)
+{
+	wireStats.receivedCount[packettype]++;
+	wireStats.bytesIn += wirelen;
+}
+
+/**
+ * Notes a publish packet serialized onto the wire, including the payload.
+ * @param payloadlen the number of application payload bytes in the packet
+ * @param wirelen the total number of wire bytes in the packet
+ */
+void MQTTWireStats_notePublished(int payloadlen, int wirelen)
+{
+	MQTTWireStats_noteSent(PUBLISH, wirelen);
+	wireStats.payloadBytesOut += (unsigned long)payloadlen;
+	if ((unsigned long)payloadlen > wireStats.highWaterPayload)
+		wireStats.highWaterPayload = (unsigned long)payloadlen;
+}
+
+/**
+ * Notes a publish packet delivered from the wire, including the payload.
+ * @param payloadlen the number of application payload bytes in the packet
+ * @param wirelen the total number of wire bytes in the packet
+ */
+void MQTTWireStats_noteDelivered(int payloadlen, int wirelen)
+{
+	MQTTWireStats_noteReceived(PUBLISH, wirelen);
+	wireStats.payloadBytesIn += (unsigned long)payloadlen;
+	if ((unsigned long)payloadlen > wireStats.highWaterPayload)
+		wireStats.highWaterPayload = (unsigned long)payloadlen;
+}
+
+/**
+ * Notes a packet decoded from the wire which carried a list of topic filters
+ * or granted QoS entries.
+ * @param packettype the MQTT packet type
+ * @param entries the number of decoded list entries
+ * @param wirelen the total number of wire bytes in the packet
+ */
+void MQTTWireStats_noteDecoded(unsigned char packettype, int entries, int wirelen)
+{
+	MQTTWireStats_noteReceived(packettype, wirelen);
+	wireStats.decodedTopics += (unsigned long)entries;
+}
+
+/**
+ * Notes a packet turned away before its decoding completed.
+ */
+void MQTTWireStats_noteReject(void)
+{
+	wireStats.rejects++;
+}
+
+/**
+ * Notes a complete frame accepted from a transport.
+ */
+void MQTTWireStats_noteFrame(void)
+{
+	wireStats.framesIn++;
+}
+
+/**
+ * Notes the packet type an operator most recently looked at.
+ * @param packettype the MQTT packet type
+ */
+void MQTTWireStats_noteInspected(unsigned char packettype)
+{
+	wireStats.lastInspected = packettype;
 }
