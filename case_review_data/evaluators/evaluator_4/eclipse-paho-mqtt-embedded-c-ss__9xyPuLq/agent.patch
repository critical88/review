diff --git a/MQTTPacket/src/MQTTWireStats.c b/MQTTPacket/src/MQTTWireStats.c
index 7b26c09..ee4808d 100644
--- a/MQTTPacket/src/MQTTWireStats.c
+++ b/MQTTPacket/src/MQTTWireStats.c
@@ -19,14 +19,19 @@
 /* The single, shared wire activity accounting record. */
 MQTTWireStats wireStats = {0};
 
-/**
- * Notes a packet which has been serialized, or decoded, as part of its normal
- * path through the packet layer.
- * @param outbound 1 if the packet was serialized for sending, 0 if it was decoded
- * @param packettype the MQTT packet type
- * @param wirelen the total number of wire bytes in the packet
+/*
+ * This is the sole owner of the wire activity accounting policy.  Every
+ * mutation of the record below goes through these functions, so a change to
+ * what is counted (and how) is made here once, rather than being repeated in
+ * every serialize/deserialize function that consumes the record.
  */
-void MQTTWireStats_note(int outbound, unsigned char packettype, int wirelen)
+
+/* The "a packet on the wire is counted sent/received and contributes its
+ * length to the session byte total" decision lives here.  Policy about which
+ * packets contribute to the byte totals - for example, excluding keep-alive
+ * traffic from bytesOut/bytesIn while still counting the packets - is a one-
+ * line change in this function rather than a sweep of every caller. */
+void MQTTWireStats_note(int outbound, unsigned char packettype, unsigned long wirelen)
 {
 	if (outbound)
 	{
@@ -39,3 +44,62 @@ void MQTTWireStats_note(int outbound, unsigned char packettype, int wirelen)
 		wireStats.bytesIn += wirelen;
 	}
 }
+
+
+void MQTTWireStats_notePayload(int outbound, int payloadlen)
+{
+	unsigned long len = (unsigned long)payloadlen;
+	if (outbound)
+		wireStats.payloadBytesOut += len;
+	else
+		wireStats.payloadBytesIn += len;
+	if (len > wireStats.highWaterPayload)
+		wireStats.highWaterPayload = len;
+}
+
+
+void MQTTWireStats_noteTopics(int count)
+{
+	wireStats.decodedTopics += (unsigned long)count;
+}
+
+
+void MQTTWireStats_noteFrame(void)
+{
+	wireStats.framesIn++;
+}
+
+
+void MQTTWireStats_noteReject(void)
+{
+	wireStats.rejects++;
+}
+
+
+void MQTTWireStats_noteInspected(unsigned char packettype)
+{
+	wireStats.lastInspected = packettype;
+}
+
+
+void MQTTWireStats_beginSession(void)
+{
+	int i;
+
+	/* clear the session-scoped counters before the new session's packets are tallied */
+	for (i = 0; i < MQTTWIRESTATS_TYPE_COUNT; ++i)
+	{
+		wireStats.sentCount[i] = 0;
+		wireStats.receivedCount[i] = 0;
+	}
+	wireStats.bytesOut = 0;
+	wireStats.bytesIn = 0;
+	wireStats.payloadBytesOut = 0;
+	wireStats.payloadBytesIn = 0;
+	wireStats.highWaterPayload = 0;
+	wireStats.framesIn = 0;
+	wireStats.decodedTopics = 0;
+
+	/* boot-scoped: survives a session reset so the number of connect attempts is totalled */
+	wireStats.sessionStarts++;
+}
diff --git a/MQTTPacket/src/MQTTWireStats.h b/MQTTPacket/src/MQTTWireStats.h
index 3e4f106..27fc392 100644
--- a/MQTTPacket/src/MQTTWireStats.h
+++ b/MQTTPacket/src/MQTTWireStats.h
@@ -28,6 +28,12 @@ extern "C" {
  * Wire activity accounting record for the embedded client.  It is kept in
  * one place so that a support dump can report on the traffic handled by the
  * packet layer without needing a full logging implementation.
+ *
+ * The fields below are part of the record's public, dumpable layout: support
+ * tooling reads them directly.  They must only be written from the accounting
+ * functions in MQTTWireStats.c, however, so that the accounting policy lives
+ * in one place rather than being scattered across the serialize/deserialize
+ * functions that consume it.
  */
 typedef struct
 {
@@ -48,7 +54,57 @@ typedef struct
 /** The single, shared wire activity accounting record. */
 extern MQTTWireStats wireStats;
 
-void MQTTWireStats_note(int outbound, unsigned char packettype, int wirelen);
+/*
+ * Accounting policy entry points.  Everything that mutates the record goes
+ * through these, so a change to "what is counted and how" is made once in
+ * MQTTWireStats.c instead of being repeated in every packet source.
+ */
+
+/**
+ * Notes a packet that crossed the wire: bumps the per-type sent/received
+ * counter and adds the packet's wire length to the running byte total.
+ * This is the single owner of the byte-total decision, so policy about which
+ * packets contribute to the byte totals (for example, excluding keep-alive
+ * traffic) is changed here, once, rather than at each caller.
+ * @param outbound 1 if the packet was serialized for sending, 0 if it was decoded
+ * @param packettype the MQTT packet type
+ * @param wirelen the total number of wire bytes in the packet
+ */
+void MQTTWireStats_note(int outbound, unsigned char packettype, unsigned long wirelen);
+
+/**
+ * Notes an application payload that was published or delivered, updating the
+ * payload byte totals and the largest single payload seen.
+ * @param outbound 1 if the payload was serialized for sending, 0 if it was decoded
+ * @param payloadlen the number of payload bytes
+ */
+void MQTTWireStats_notePayload(int outbound, int payloadlen);
+
+/**
+ * Notes topic filters or granted QoS slots that were decoded as part of a
+ * (un)subscribe or suback packet.
+ * @param count the number of slots decoded
+ */
+void MQTTWireStats_noteTopics(int count);
+
+/** Notes a complete frame accepted from a transport, decoded or not. */
+void MQTTWireStats_noteFrame(void);
+
+/** Notes a packet turned away before decoding completed. */
+void MQTTWireStats_noteReject(void);
+
+/**
+ * Notes the packet type most recently rendered for an operator by the
+ * formatting/dump path.
+ * @param packettype the MQTT packet type
+ */
+void MQTTWireStats_noteInspected(unsigned char packettype);
+
+/**
+ * Begins a new session: zeroes the session-scoped counters and records that
+ * another connect packet began a session.
+ */
+void MQTTWireStats_beginSession(void);
 
 #if defined(__cplusplus) /* If this is a C++ compiler, use C linkage */
 }
