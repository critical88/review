+
+// Viewport math for the fixed-scale draw path: the inline panel insets used
+// by the renderer before the svg element is sized by its container. When the
+// padded box collapses the padding falls back to the raw scale factors.
+function viewportPadding(width: number, height: number): { [key: string]: number } {
+  const pad = (Math.min(width, height) > 10) ? 4 : 2;
+  if (pad && ((width - (pad * 2)) < 0) && ((height - (pad * 2)) < 0)) {
+    const raw = scaleForViewport(width, height);
+    return {
+      left: 0,
+      top: 0,
+      right: (width * raw.sx),
+      bottom: (height * raw.sy)
+    };
+  }
+  return {
+    left: pad,
+    top: pad,
+    right: width - (pad * 2),
+    bottom: height - (pad * 2)
+  };
+}
+
+// Scale factors of the padded viewport against the raw requested size.
+function scaleForViewport(width: number, height: number): { [key: string]: number } {
+  const box = viewportPadding(width, height);
+  const sx = width ? (box.right - box.left) / width : 1;
+  const sy = height ? (box.bottom - box.top) / height : 1;
+  return { sx, sy };
 }
