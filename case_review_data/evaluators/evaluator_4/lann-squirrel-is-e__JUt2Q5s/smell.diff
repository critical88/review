+// SqlRunner is the unified interface for every execution target squirrel can
+// run a query against.
+//
+// Instead of forcing callers to juggle the small per-capability interfaces,
+// one interface describes everything a statement target may ever be asked to
+// do: the synchronous Exec/Query/QueryRow family, their context counterparts,
+// and the prepare family used by the statement cache. Every place that used
+// to pin one narrow capability now accepts (or requires) SqlRunner, so a
+// runner can be passed around freely without capability-specific signatures.
+type SqlRunner interface {
+	ExecerContext
+	QueryerContext
+	QueryRowerContext
+	Prepare(query string) (*sql.Stmt, error)
+	PrepareContext(ctx context.Context, query string) (*sql.Stmt, error)
+}
