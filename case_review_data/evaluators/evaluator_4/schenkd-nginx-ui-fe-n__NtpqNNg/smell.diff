@@ -0,0 +1,103 @@
+"""Tests for application creation and configuration selection."""
+import flask
+
+from app import create_app
+from config import Config, DevConfig, WorkingConfig, config as config_map
+
+
+class TestCreateApp(object):
+    def test_returns_flask_application(self):
+        application = create_app('default')
+        assert isinstance(application, flask.Flask)
+
+    def test_debug_disabled_for_default_config(self):
+        application = create_app('default')
+        assert application.debug is False
+
+    def test_debug_enabled_for_dev_config(self):
+        application = create_app('dev')
+        assert application.debug is True
+
+    def test_secret_key_generated(self):
+        application = create_app('default')
+        assert application.config['SECRET_KEY']
+
+    def test_secret_key_is_sixty_four_bytes_of_hex(self):
+        application = create_app('default')
+        secret = application.config['SECRET_KEY']
+        assert len(secret) == 128
+        int(secret, 16)
+
+    def test_secret_key_is_shared_within_process(self):
+        first = create_app('default')
+        second = create_app('default')
+        assert first.config['SECRET_KEY'] == second.config['SECRET_KEY']
+
+    def test_default_nginx_paths(self):
+        application = create_app('default')
+        assert application.config['NGINX_PATH'] == '/etc/nginx'
+        assert application.config['CONFIG_PATH'] == '/etc/nginx/conf.d'
+
+
+class TestBlueprints(object):
+    def test_ui_blueprint_mounted_at_root(self, app):
+        with app.test_request_context():
+            assert flask.url_for('ui.index') == '/'
+
+    def test_api_blueprint_mounted_under_api(self, app):
+        with app.test_request_context():
+            assert flask.url_for('api.get_domains') == '/api/domains'
+            assert flask.url_for('api.get_domain', name='example.com') == '/api/domain/example.com'
+
+    def test_ui_index_route_registered(self, app):
+        rules = [r.rule for r in app.url_map.iter_rules()]
+        assert '/' in rules
+
+    def test_api_routes_registered(self, app):
+        rules = [r.rule for r in app.url_map.iter_rules()]
+        assert '/api/domains' in rules
+        assert '/api/config/<name>' in rules
+        assert '/api/domain/<name>' in rules
+        assert '/api/domain/<name>/enable' in rules
+
+    def test_known_methods_registered(self, app):
+        by_rule = {}
+        for rule in app.url_map.iter_rules():
+            by_rule.setdefault(rule.rule, set()).update(rule.methods)
+        assert 'GET' in by_rule['/api/domains']
+        assert 'POST' in by_rule['/api/config/<name>']
+        assert 'DELETE' in by_rule['/api/domain/<name>']
+        assert 'PUT' in by_rule['/api/domain/<name>']
+        assert 'POST' in by_rule['/api/domain/<name>/enable']
+
+
+class TestConfigModule(object):
+    def test_config_map_contains_dev_and_default(self):
+        assert config_map['dev'] is DevConfig
+        assert config_map['default'] is WorkingConfig
+
+    def test_dev_config_inherits_working_config(self):
+        assert issubclass(DevConfig, Config)
+        assert issubclass(WorkingConfig, Config)
+
+    def test_working_config_disables_debug(self):
+        assert WorkingConfig.DEBUG is False
+
+    def test_config_defines_init_app(self):
+        assert callable(Config.init_app)
+        assert callable(DevConfig.init_app)
+
+    def test_init_app_is_a_no_op(self, app):
+        # init_app must not raise for any registered config.
+        for config_class in config_map.values():
+            config_class.init_app(app)
+
+
+class TestMomentExtension(object):
+    def test_moment_extension_initialized(self, app):
+        assert 'moment' in app.extensions
+
+    def test_index_renders_moment_assets(self, client):
+        response = client.get('/')
+        assert response.status_code == 200
+        assert b'moment' in response.data
