+"""Tests for the UI index page delivered by app.ui.views.index."""
+import os
+import re
+
+CONFIG_ITEM = re.compile(r'<div class="config item">([^<]+)</div>')
+
+
+class TestIndexPage(object):
+    def test_returns_home_page(self, client):
+        response = client.get('/')
+        assert response.status_code == 200
+        assert b'<title>Nginx UI</title>' in response.data
+
+    def test_lists_regular_files_only(self, client, nginx_paths):
+        with open(os.path.join(nginx_paths['nginx'], 'nginx.conf'), 'w') as f:
+            f.write('events {}')
+        os.mkdir(os.path.join(nginx_paths['nginx'], 'sites-available'))
+        os.mkdir(os.path.join(nginx_paths['nginx'], 'modules-enabled'))
+
+        response = client.get('/')
+        names = CONFIG_ITEM.findall(response.data.decode('utf-8'))
+        assert names == ['nginx.conf']
+
+    def test_lists_all_files_regardless_of_order(self, client, nginx_paths):
+        for name in ('nginx.conf', 'koi-encrypted.cert', 'mime.types'):
+            with open(os.path.join(nginx_paths['nginx'], name), 'w') as f:
+                f.write('data')
+
+        response = client.get('/')
+        assert sorted(CONFIG_ITEM.findall(response.data.decode('utf-8'))) == [
+            'koi-encrypted.cert', 'mime.types', 'nginx.conf',
+        ]
+
+    def test_empty_nginx_directory_renders_no_menu_entries(self, client):
+        response = client.get('/')
+        assert response.status_code == 200
+        assert CONFIG_ITEM.findall(response.data.decode('utf-8')) == []
+
+    def test_files_with_dots_are_preserved_verbatim(self, client, nginx_paths):
+        with open(os.path.join(nginx_paths['nginx'], 'main.v2.conf'), 'w') as f:
+            f.write('data')
+
+        response = client.get('/')
+        assert CONFIG_ITEM.findall(response.data.decode('utf-8')) == ['main.v2.conf']
+
+    def test_static_assets_referenced(self, client):
+        response = client.get('/')
+        assert b'semantic.min.css' in response.data
+        assert b'nginx.png' in response.data
+
+    def test_navigation_links_present(self, client):
+        response = client.get('/')
+        assert b'id="edit_config"' in response.data
+        assert b'id="domains"' in response.data
+
+    def test_index_content_type_is_html(self, client):
+        response = client.get('/')
+        assert response.content_type == 'text/html; charset=utf-8'
