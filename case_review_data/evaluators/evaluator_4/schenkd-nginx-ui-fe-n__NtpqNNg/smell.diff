+class TestDomainLifecycle(object):
+    def test_full_lifecycle(self, client, site_reader):
+        # create
+        assert client.post('/api/domain/example.com').status_code == 201
+        # read while disabled
+        response = client.get('/api/domain/example.com')
+        assert b'Enable' in response.data
+        # enable
+        client.post('/api/domain/example.com/enable', json={'enable': True})
+        assert site_reader.read(site_reader.path('example.com')) != ''
+        # update
+        client.put('/api/domain/example.com', json={'file': 'updated;'})
+        assert site_reader.read(site_reader.path('example.com')) == 'updated;'
+        # read while enabled
+        response = client.get('/api/domain/example.com')
+        assert b'updated;' in response.data
+        assert b'Disable' in response.data
+        # disable
+        client.post('/api/domain/example.com/enable', json={'enable': False})
+        assert site_reader.exists(site_reader.path('example.com', disabled=True))
+        # remove
+        response = client.delete('/api/domain/example.com')
+        assert response.status_code == 200
+        assert not site_reader.exists(site_reader.path('example.com', disabled=True))
+
+    def test_two_sites_manipulated_independently(self, client, site_reader):
+        client.post('/api/domain/alpha.com')
+        client.post('/api/domain/beta.com')
+        client.post('/api/domain/alpha.com/enable', json={'enable': True})
+        assert site_reader.exists(site_reader.path('alpha.com'))
+        assert site_reader.exists(site_reader.path('beta.com', disabled=True))
+
+    def test_listing_state_follows_enable_toggle(self, client, site_reader):
+        client.post('/api/domain/example.com')
+        assert 'green icon' not in client.get('/api/domains').data.decode('utf-8')
+        client.post('/api/domain/example.com/enable', json={'enable': True})
+        assert 'green icon' in client.get('/api/domains').data.decode('utf-8')
+        client.post('/api/domain/example.com/enable', json={'enable': False})
+        assert 'green icon' not in client.get('/api/domains').data.decode('utf-8')
