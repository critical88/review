@@ -0,0 +1,91 @@
+"""Writes changes to the managed site configuration files."""
+
+import io
+import os
+
+from app.api.registry import SiteRegistry
+from app.api.model import Site
+
+
+class SiteEditor(object):
+    """
+    Applies changes to the managed site configuration files.
+
+    :param registry: Registry reading the site configuration files
+    :type registry: SiteRegistry
+    """
+
+    def __init__(self, registry: SiteRegistry):
+        self.registry = registry
+
+    def create(self, name, content):
+        """
+        Creates the configuration file of the domain as a disabled site.
+
+        :param name: The domain name that corresponds to the file.
+        :type name: str
+        :param content: Rendered configuration of the new domain
+        :type content: str
+        """
+        filename = name + '.conf.disabled'
+
+        with io.open(os.path.join(self.registry.config_path, filename), 'w') as f:
+            f.write(content)
+
+    def apply_update(self, name, new_content):
+        """
+        Writes the new configuration to every file matching the name.
+
+        :param name: The domain name that corresponds to the file.
+        :type name: str
+        :param new_content: Updated configuration of the domain
+        :type new_content: str
+        """
+        for record in self.registry.scan():
+
+            if record.filename.startswith(name):
+
+                with io.open(os.path.join(record.config_path, record.filename), 'w') as f:
+                    f.write(new_content)
+
+    def remove(self, name):
+        """
+        Deletes the configuration file of the corresponding domain.
+
+        :param name: The domain name that corresponds to the file.
+        :type name: str
+
+        :return: Returns whether the configuration file was deleted.
+        :rtype: bool
+        """
+        removed = False
+
+        for record in self.registry.scan():
+
+            if record.filename.startswith(name):
+                os.remove(os.path.join(record.config_path, record.filename))
+                removed = not os.path.exists(os.path.join(record.config_path, record.filename))
+                break
+
+        return removed
+
+    def set_state(self, name, enable):
+        """
+        Activates or deactivates the configuration files matching the name.
+
+        :param name: The domain name that corresponds to the file.
+        :type name: str
+        :param enable: Whether the site is activated
+        :type enable: bool
+        """
+        for record in self.registry.scan():
+
+            if record.filename.startswith(name):
+
+                if enable:
+                    new_filename, _ = record.filename.rsplit('.', 1)
+                    os.rename(os.path.join(record.config_path, record.filename),
+                              os.path.join(record.config_path, new_filename))
+                else:
+                    os.rename(os.path.join(record.config_path, record.filename),
+                              os.path.join(record.config_path, record.filename + '.disabled'))
