+"""Tests for the site listing endpoint GET /api/domains."""
+import os
+
+
+def site_cards(html):
+    """Return the list of domain names shown on the cards, in order."""
+    import re
+
+    names = re.findall(r"fetch_domain\('([^']+)'\)", html)
+    return [name for name in names if name]
+
+
+class TestGetDomains(object):
+    def test_empty_directory_renders_no_cards(self, client):
+        response = client.get('/api/domains')
+        assert response.status_code == 200
+        assert site_cards(response.data.decode('utf-8')) == []
+        assert b'id="domain_cards"' in response.data
+
+    def test_enabled_site_is_listed(self, client, site_factory):
+        site_factory('example.com')
+        response = client.get('/api/domains')
+        assert site_cards(response.data.decode('utf-8')) == ['example.com']
+
+    def test_disabled_site_is_listed(self, client, site_factory):
+        site_factory('example.com', disabled=True)
+        response = client.get('/api/domains')
+        assert site_cards(response.data.decode('utf-8')) == ['example.com']
+
+    def test_enabled_and_disabled_both_listed(self, client, site_factory):
+        site_factory('live.com')
+        site_factory('down.com', disabled=True)
+        response = client.get('/api/domains')
+        assert site_cards(response.data.decode('utf-8')) == ['down.com', 'live.com']
+
+    def test_sites_sorted_by_name(self, client, site_factory):
+        site_factory('zebra.com')
+        site_factory('aardvark.com')
+        site_factory('mule.com')
+        response = client.get('/api/domains')
+        assert site_cards(response.data.decode('utf-8')) == [
+            'aardvark.com', 'mule.com', 'zebra.com',
+        ]
+
+    def test_sorting_is_by_domain_not_by_extension(self, client, site_factory):
+        site_factory('zulu.com', disabled=True)
+        site_factory('alpha.com')
+        response = client.get('/api/domains')
+        assert site_cards(response.data.decode('utf-8')) == ['alpha.com', 'zulu.com']
+
+    def test_enabled_site_shows_active_icon(self, client, site_factory):
+        site_factory('example.com')
+        response = client.get('/api/domains')
+        html = response.data.decode('utf-8')
+        assert 'green icon' in html
+        assert 'outline grey icon' not in html
+
+    def test_disabled_site_shows_inactive_icon(self, client, site_factory):
+        site_factory('example.com', disabled=True)
+        response = client.get('/api/domains')
+        html = response.data.decode('utf-8')
+        assert 'outline grey icon' in html
+        assert 'green icon' not in html
+
+    def test_mixed_states_show_both_icons(self, client, site_factory):
+        site_factory('live.com')
+        site_factory('down.com', disabled=True)
+        response = client.get('/api/domains')
+        html = response.data.decode('utf-8')
+        assert 'green icon' in html
+        assert 'outline grey icon' in html
+
+    def test_multi_label_domain_names_listed(self, client, site_factory):
+        site_factory('shop.example.co.uk')
+        response = client.get('/api/domains')
+        assert site_cards(response.data.decode('utf-8')) == ['shop.example.co.uk']
+
+    def test_unrelated_extensions_are_ignored(self, client, site_factory, nginx_paths):
+        with open(os.path.join(nginx_paths['config'], 'README.txt'), 'w') as f:
+            f.write('notes')
+        with open(os.path.join(nginx_paths['config'], 'backup.bak'), 'w') as f:
+            f.write('backup')
+
+        response = client.get('/api/domains')
+        assert site_cards(response.data.decode('utf-8')) == []
+
+    def test_directories_are_ignored(self, client, nginx_paths):
+        os.mkdir(os.path.join(nginx_paths['config'], 'assets.conf'))
+
+        response = client.get('/api/domains')
+        assert site_cards(response.data.decode('utf-8')) == []
+
+    def test_updated_timestamp_rendered(self, client, site_factory):
+        site_factory('example.com')
+        response = client.get('/api/domains')
+        assert b'Updated' in response.data
+
+    def test_content_of_cards_fragment(self, client, site_factory):
+        site_factory('example.com')
+        response = client.get('/api/domains')
+        assert b'id="domain_cards"' in response.data
+        assert b'onclick="fetch_domain' in response.data
+
+    def test_listing_reflects_new_file_on_second_request(self, client, site_factory):
+        assert site_cards(client.get('/api/domains').data.decode('utf-8')) == []
+        site_factory('example.com')
+        assert site_cards(client.get('/api/domains').data.decode('utf-8')) == ['example.com']
+
+    def test_listing_reflects_removed_file_on_second_request(self, client, site_factory, nginx_paths):
+        path = site_factory('example.com')
+        assert site_cards(client.get('/api/domains').data.decode('utf-8')) == ['example.com']
+        os.remove(path)
+        assert site_cards(client.get('/api/domains').data.decode('utf-8')) == []
