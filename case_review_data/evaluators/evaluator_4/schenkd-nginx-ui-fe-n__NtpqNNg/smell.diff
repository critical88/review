@@ -0,0 +1,45 @@
+"""Builds the view payload of the managed domains."""
+
+from app.api.model import Site
+from app.api.registry import SiteRegistry
+
+
+class DomainOverview(object):
+    """
+    Builds the cards and the state of the sites for the domains page.
+
+    :param registry: Registry reading the site configuration files
+    :type registry: SiteRegistry
+    """
+
+    def __init__(self, registry: SiteRegistry):
+        self.registry = registry
+
+    def cards(self):
+        """
+        Reads all site records and checks the state of the site configuration.
+
+        :return: Cards of the sites and the names of the enabled sites.
+        :rtype: tuple
+        """
+        sites_available = []
+        sites_enabled = []
+
+        for record in self.registry.scan():
+            domain, state = record.filename.rsplit('.', 1)
+
+            if state == 'conf':
+                sites_available.append({
+                    'name': domain,
+                    'time': record.modified
+                })
+                sites_enabled.append(domain)
+            elif state == 'disabled':
+                sites_available.append({
+                    'name': domain.rsplit('.', 1)[0],
+                    'time': record.modified
+                })
+
+        # sort sites by name
+        sites_available = sorted(sites_available, key=lambda _: _['name'])
+        return sites_available, sites_enabled
