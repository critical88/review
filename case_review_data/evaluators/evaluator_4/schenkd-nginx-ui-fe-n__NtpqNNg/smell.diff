+    def test_missing_site_reports_success_without_changes(self, client, site_reader):
+        response = client.post('/api/domain/missing.com/enable', json={'enable': True})
+        assert response.status_code == 200
+        assert response.get_json() == {'success': True}
+
+    def test_requires_json_content_type(self, client, site_factory):
