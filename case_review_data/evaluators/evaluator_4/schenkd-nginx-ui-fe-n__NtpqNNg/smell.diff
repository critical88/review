+"""Shared fixtures for the nginx-ui test suite.
+
+The tests drive the application exclusively through the Flask test client so
+that the HTTP contract (routes, status codes, payloads and rendered markup)
+stays the source of truth for behavior.
+"""
+import os
+import sys
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+if REPO_ROOT not in sys.path:
+    sys.path.insert(0, REPO_ROOT)
+
+import pytest
+
+from app import create_app
+
+SAMPLE_CONF = """server {
+    listen 80;
+    server_name example.com;
+}
+"""
+
+
+def make_site(app, domain, content=SAMPLE_CONF, disabled=False):
+    """Create a site configuration file inside CONFIG_PATH."""
+    suffix = '.conf.disabled' if disabled else '.conf'
+    path = os.path.join(app.config['CONFIG_PATH'], domain + suffix)
+    with open(path, 'w') as f:
+        f.write(content)
+    return path
+
+
+def read_site(app, domain, disabled=False):
+    suffix = '.conf.disabled' if disabled else '.conf'
+    path = os.path.join(app.config['CONFIG_PATH'], domain + suffix)
+    with open(path) as f:
+        return f.read()
+
+
+@pytest.fixture
+def app(tmp_path):
+    """Application instance pointed at a throwaway nginx directory."""
+    application = create_app('default')
+    nginx_root = tmp_path / 'nginx'
+    config_root = nginx_root / 'conf.d'
+    config_root.mkdir(parents=True)
+    application.config['NGINX_PATH'] = str(nginx_root)
+    application.config['CONFIG_PATH'] = str(config_root)
+    return application
+
+
+@pytest.fixture
+def client(app):
+    return app.test_client()
+
+
+@pytest.fixture
+def site_factory(app):
+    """Factory writing site files into the configured nginx tree."""
+
+    def _factory(domain, content=SAMPLE_CONF, disabled=False):
+        return make_site(app, domain, content=content, disabled=disabled)
+
+    return _factory
+
+
+@pytest.fixture
+def site_reader(app):
+    """Read helper for files inside the configured nginx tree."""
+
+    class _Reader(object):
+        def path(self, name, disabled=False):
+            suffix = '.conf.disabled' if disabled else '.conf'
+            return os.path.join(app.config['CONFIG_PATH'], name + suffix)
+
+        def nginx_path(self, name):
+            return os.path.join(app.config['NGINX_PATH'], name)
+
+        def read(self, path):
+            with open(path) as f:
+                return f.read()
+
+        def exists(self, path):
+            return os.path.exists(path)
+
+    return _Reader()
+
+
+@pytest.fixture
+def nginx_paths(app):
+    return {
+        'nginx': app.config['NGINX_PATH'],
+        'config': app.config['CONFIG_PATH'],
+    }
