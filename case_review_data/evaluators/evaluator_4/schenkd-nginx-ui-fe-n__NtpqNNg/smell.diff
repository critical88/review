+    def test_returns_rendered_configuration(self, client, site_reader):
+        with open(site_reader.nginx_path('nginx.conf'), 'w') as f:
+            f.write('worker_processes 1;')
+
+        response = client.get('/api/config/nginx.conf')
+        assert response.status_code == 200
+        assert b'worker_processes 1;' in response.data
+
+    def test_header_contains_file_name(self, client, site_reader):
+        with open(site_reader.nginx_path('nginx.conf'), 'w') as f:
+            f.write('events {}')
+
+        response = client.get('/api/config/nginx.conf')
+        assert b'<h1 class="ui header">nginx.conf</h1>' in response.data
+
+    def test_missing_file_fails(self, client):
+        response = client.get('/api/config/missing.conf')
+        assert response.status_code == 500
+
+    def test_directory_target_fails(self, client, site_reader):
+        os.mkdir(site_reader.nginx_path('modules-enabled'))
+        response = client.get('/api/config/modules-enabled')
+        assert response.status_code == 500
+
+    def test_nested_name_has_no_route(self, client):
+        response = client.get('/api/config/sub/nginx.conf')
+        assert response.status_code == 404
+
+    def test_multiline_content_preserved(self, client, site_reader):
+        content = 'line one\nline two\nline three\n'
+        with open(site_reader.nginx_path('long.conf'), 'w') as f:
+            f.write(content)
+
+        response = client.get('/api/config/long.conf')
+        assert response.status_code == 200
+        assert b'line two' in response.data
