@@ -0,0 +1,25 @@
+"""Domain records for the sites managed by the nginx-ui API."""
+
+
+class Site(object):
+    """
+    A single managed site configuration file in the nginx conf.d directory.
+
+    The record carries the raw facts of the configuration file as they were
+    found on disk. Everything a record knows is stored in its attributes.
+
+    :param config_path: Directory holding the site configuration files
+    :type config_path: str
+    :param filename: Name of the configuration file of the site
+    :type filename: str
+    :param content: Content of the configuration file
+    :type content: str
+    :param modified: Modification time of the configuration file
+    :type modified: datetime.datetime
+    """
+
+    def __init__(self, config_path, filename, content='', modified=None):
+        self.config_path = config_path
+        self.filename = filename
+        self.content = content
+        self.modified = modified
