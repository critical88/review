+        client.post('/api/domain/example.com/enable', json={'enable': True})
+        response = client.get('/api/domain/example.com')
+        assert b'Disable' in response.data
+
+    def test_disable_adds_single_disabled_suffix(self, client, site_factory, site_reader):
+        site_factory('example.com')
+        client.post('/api/domain/example.com/enable', json={'enable': False})
