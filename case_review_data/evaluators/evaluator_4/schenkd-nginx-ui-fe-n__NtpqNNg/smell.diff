+
+class TestEnableDomain(object):
+    def test_enabling_disabled_site(self, client, site_factory, site_reader):
+        site_factory('example.com', disabled=True)
+        response = client.post('/api/domain/example.com/enable', json={'enable': True})
+        assert response.status_code == 200
+        assert response.get_json() == {'success': True}
+        assert site_reader.exists(site_reader.path('example.com'))
+        assert not site_reader.exists(site_reader.path('example.com', disabled=True))
+
+    def test_disabling_enabled_site(self, client, site_factory, site_reader):
