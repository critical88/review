+"""Tests for the wsgi entry point used by the application server."""
+import flask
+
+
+class TestWsgiEntryPoint(object):
+    def test_module_exposes_application(self):
+        import wsgi
+
+        assert isinstance(wsgi.app, flask.Flask)
+
+    def test_application_uses_default_config(self):
+        import wsgi
+
+        assert wsgi.app.config['DEBUG'] is False
+        assert wsgi.app.config['NGINX_PATH'] == '/etc/nginx'
+        assert wsgi.app.config['CONFIG_PATH'] == '/etc/nginx/conf.d'
+
+    def test_application_has_secret_key(self):
+        import wsgi
+
+        assert wsgi.app.config['SECRET_KEY']
