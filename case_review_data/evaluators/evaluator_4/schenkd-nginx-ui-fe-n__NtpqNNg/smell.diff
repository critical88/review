@@ -0,0 +1,63 @@
+"""Read access to the directory of the managed site configuration files."""
+
+import datetime
+import io
+import os
+
+from app.api.model import Site
+
+
+class SiteRegistry(object):
+    """
+    Reads the managed site configuration files from the configuration directory.
+
+    :param config_path: Directory holding the site configuration files
+    :type config_path: str
+    """
+
+    def __init__(self, config_path):
+        self.config_path = config_path
+
+    def scan(self):
+        """
+        Reads all regular files of the configuration directory as site records.
+
+        :return: Site record for each regular file of the directory.
+        :rtype: list
+        """
+        records = []
+
+        for _ in os.listdir(self.config_path):
+
+            if os.path.isfile(os.path.join(self.config_path, _)):
+                records.append(Site(
+                    config_path=self.config_path,
+                    filename=_,
+                    content='',
+                    modified=datetime.datetime.fromtimestamp(os.path.getmtime(os.path.join(self.config_path, _)))
+                ))
+
+        return records
+
+    def find(self, name):
+        """
+        Reads the site record of the configuration file matching the name.
+
+        The content of the configuration file is loaded into the record.
+
+        :param name: The domain name that corresponds to the file.
+        :type name: str
+
+        :return: Site record of the configuration file or None.
+        :rtype: Site
+        """
+        for record in self.scan():
+
+            if record.filename.startswith(name):
+
+                with io.open(os.path.join(record.config_path, record.filename), 'r') as f:
+                    record.content = f.read()
+
+                return record
+
+        return None
