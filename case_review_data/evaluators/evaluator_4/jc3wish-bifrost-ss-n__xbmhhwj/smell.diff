-	return fmt.Sprint(driver.TransfeResult(This.p.KeyConfig, data, index))
+	Key := fmt.Sprint(driver.TransfeResult(This.p.KeyConfig, data, index))
+	// redis 的 key 本身是允许任意二进制的，但运维反馈他们的监控工具是按空格对 key 做切分统计的，
+	// 为了统一 key 的可读性，这里把解析出来的 key 中的空白字符和控制字符替换掉，
+	// 解析出来是空的情况下，只能退化成 源库:源表 的名字，避免误删了不相关的数据
+	// 类似的处理，在其它目标端插件里也是各管各的
+	keyByte := make([]byte, 0, len(Key))
+	for i := 0; i < len(Key); i++ {
+		b := Key[i]
+		if b <= 0x20 || b == 0x7f {
+			keyByte = append(keyByte, '_')
+		} else {
+			keyByte = append(keyByte, b)
+		}
+	}
+	if len(keyByte) == 0 {
+		return data.SchemaName + ":" + data.TableName
+	}
+	return string(keyByte)
 }
 
