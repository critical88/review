+}
+static void *ut_stack_ops_del_key_unsupported(UT_container *c, const void *key) {
+  return NULL;
+}
+static void *ut_stack_ops_at_unsupported(const UT_container *c, unsigned j) {
+  return NULL;
+}
+static void ut_stack_ops_sort_unsupported(UT_container *c, int (*cmp)(const void *, const void *)) {
+}
+static void ut_stack_ops_reverse_unsupported(UT_container *c) {
+}
+static unsigned ut_stack_ops_capacity_unsupported(const UT_container *c) {
+  return 0;
+}
+static int ut_stack_ops_vprintf_unsupported(UT_container *c, const char *fmt, va_list ap) {
+  return -1;
+}
+static const UT_ops ut_stack_ops UTCONTAINER_UNUSED = {
+  .clear = ut_stack_ops_clear,
+  .free = ut_stack_ops_free,
+  .count = ut_stack_ops_count,
+  .add_key = ut_stack_ops_add_key_unsupported,
+  .find_key = ut_stack_ops_find_key_unsupported,
+  .del_key = ut_stack_ops_del_key_unsupported,
+  .push = ut_stack_ops_push,
+  .pop = ut_stack_ops_pop,
+  .top = ut_stack_ops_top,
+  .at = ut_stack_ops_at_unsupported,
+  .capacity = ut_stack_ops_capacity_unsupported,
+  .first = ut_stack_ops_first,
+  .next = ut_stack_ops_next,
+  .sort = ut_stack_ops_sort_unsupported,
+  .reverse = ut_stack_ops_reverse_unsupported,
+  .vprintf = ut_stack_ops_vprintf_unsupported,
+};
+
+/* open an empty uniform stack-style container */
+UTCONTAINER_UNUSED
+static inline UT_container ut_stack_container_new(void) {
+  struct ut_stack_box *b = (struct ut_stack_box *)malloc(sizeof(struct ut_stack_box));
+  UT_container c;
+  if (b == NULL) {
+    c.state = NULL;
+    c.ops = NULL;
+    return c;
+  }
+  b->head = NULL;
+  c.state = b;
+  c.ops = &ut_stack_ops;
+  return c;
+}
