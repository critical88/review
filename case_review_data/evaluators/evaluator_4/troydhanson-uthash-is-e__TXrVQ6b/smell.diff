diff --git a/tests/test103.c b/tests/test103.c
new file mode 100644
index 0000000..24eaa4e
--- /dev/null
+++ b/tests/test103.c
@@ -0,0 +1,203 @@
+/*
+test103: uniform container facade (utcontainer.h)
+
+One consumer drives every facade kind through the uniform helpers, including
+members that a kind does not honor: their refusal values (NULL, 0 or -1) are
+part of the facade's contract and are checked here too.
+*/
+#include <stdio.h>
+#include <string.h>
+
+#include "uthash.h"
+#include "utarray.h"
+#include "utlist.h"
+#include "utstack.h"
+#include "utstring.h"
+#include "utringbuffer.h"
+
+static int cmp_words(const void *a, const void *b) {
+  return strcmp((const char *)a, (const char *)b);
+}
+
+static void walk(const UT_container *c, const char *tag) {
+  void *it;
+  printf("%s:", tag);
+  for (it = ut_container_first(c); it; it = ut_container_next(c, it)) {
+    printf(" %s", (char *)it);
+  }
+  printf("\n");
+}
+
+int main() {
+  UT_container c;
+  struct ut_hash_item *hit;
+  UT_array *arr;
+  UT_string *str;
+  unsigned n;
+  int rc;
+  void *v, *t;
+
+  /* -- keyed store ---------------------------------------------------- */
+  c = ut_hash_container_new();
+  printf("hash add alpha %s\n",
+         (char *)ut_container_add_key(&c, "alpha", (void *)"avoral"));
+  printf("hash add zulu %s\n",
+         (char *)ut_container_add_key(&c, "zulu", (void *)"zephyr"));
+  printf("hash add mike %s\n",
+         (char *)ut_container_add_key(&c, "mike", (void *)"marco"));
+  printf("hash re-add alpha %s\n",
+         (char *)ut_container_add_key(&c, "alpha", (void *)"aster"));
+  printf("hash find alpha %s\n", (char *)ut_container_find_key(&c, "alpha"));
+  printf("hash find nope %s\n", (char *)ut_container_find_key(&c, "nope"));
+  n = ut_container_count(&c);
+  printf("hash count %u\n", n);
+  printf("hash del zulu %s\n", (char *)ut_container_del_key(&c, "zulu"));
+  printf("hash del zulu again %s\n", (char *)ut_container_del_key(&c, "zulu"));
+  n = ut_container_count(&c);
+  printf("hash count after del %u\n", n);
+  printf("hash chain:");
+  for (hit = (struct ut_hash_item *)ut_container_first(&c); hit;
+       hit = (struct ut_hash_item *)ut_container_next(&c, hit)) {
+    printf(" %s=%s", hit->key, (char *)hit->val);
+  }
+  printf("\n");
+  ut_container_sort(&c, cmp_words);
+  printf("hash sorted:");
+  for (hit = (struct ut_hash_item *)ut_container_first(&c); hit;
+       hit = (struct ut_hash_item *)ut_container_next(&c, hit)) {
+    printf(" %s", hit->key);
+  }
+  printf("\n");
+  v = ut_container_pop(&c);
+  printf("hash pop refused %s\n", (char *)v);
+  t = ut_container_top(&c);
+  printf("hash top refused %s\n", (char *)t);
+  t = ut_container_at(&c, 0);
+  printf("hash at refused %s\n", (char *)t);
+  rc = ut_container_printf(&c, "%d", 1);
+  printf("hash printf refused %d\n", rc);
+  rc = ut_container_push(&c, (void *)"shunned");
+  printf("hash push refused %d\n", rc);
+  n = ut_container_capacity(&c);
+  printf("hash capacity refused %u\n", n);
+  ut_container_free(&c);
+
+  /* -- indexed sequence ----------------------------------------------- */
+  utarray_new(arr, &ut_ptr_icd);
+  c = ut_array_container(arr);
+  printf("array add_key refused %s\n",
+         (char *)ut_container_add_key(&c, "alpha", (void *)"shunned"));
+  printf("array find_key refused %s\n", (char *)ut_container_find_key(&c, "alpha"));
+  ut_container_push(&c, (void *)"bravo");
+  ut_container_push(&c, (void *)"alpha");
+  ut_container_push(&c, (void *)"charlie");
+  n = ut_container_count(&c);
+  printf("array count %u\n", n);
+  printf("array at 0 %s\n", (char *)ut_container_at(&c, 0));
+  printf("array at 2 %s\n", (char *)ut_container_at(&c, 2));
+  printf("array at 9 %s\n", (char *)ut_container_at(&c, 9));
+  v = ut_container_pop(&c);
+  printf("array pop %s\n", (char *)v);
+  t = ut_container_top(&c);
+  printf("array top %s\n", (char *)t);
+  walk(&c, "array walk");
+  ut_container_reverse(&c);
+  walk(&c, "array reverse refused, walk");
+  ut_container_sort(&c, cmp_words);
+  walk(&c, "array sorted");
+  ut_container_clear(&c);
+  n = ut_container_count(&c);
+  printf("array count after clear %u\n", n);
+  ut_container_free(&c);
+
+  /* -- linked sequence ------------------------------------------------ */
+  c = ut_list_container_new();
+  printf("list add_key refused %s\n",
+         (char *)ut_container_add_key(&c, "alpha", (void *)"shunned"));
+  printf("list find_key refused %s\n", (char *)ut_container_find_key(&c, "alpha"));
+  ut_container_push(&c, (void *)"bravo");
+  ut_container_push(&c, (void *)"alpha");
+  ut_container_push(&c, (void *)"charlie");
+  n = ut_container_count(&c);
+  printf("list count %u\n", n);
+  v = ut_container_pop(&c);
+  printf("list pop %s\n", (char *)v);
+  t = ut_container_top(&c);
+  printf("list top %s\n", (char *)t);
+  t = ut_container_at(&c, 0);
+  printf("list at refused %s\n", (char *)t);
+  n = ut_container_capacity(&c);
+  printf("list capacity refused %u\n", n);
+  walk(&c, "list walk");
+  ut_container_reverse(&c);
+  walk(&c, "list reversed");
+  ut_container_sort(&c, cmp_words);
+  walk(&c, "list sorted");
+  ut_container_free(&c);
+
+  /* -- lifo sequence -------------------------------------------------- */
+  c = ut_stack_container_new();
+  ut_container_push(&c, (void *)"alpha");
+  ut_container_push(&c, (void *)"bravo");
+  ut_container_push(&c, (void *)"charlie");
+  n = ut_container_count(&c);
+  printf("stack count %u\n", n);
+  printf("stack top %s\n", (char *)ut_container_top(&c));
+  v = ut_container_pop(&c);
+  printf("stack pop %s\n", (char *)v);
+  walk(&c, "stack walk");
+  ut_container_sort(&c, cmp_words);
+  walk(&c, "stack sort refused, walk");
+  t = ut_container_at(&c, 0);
+  printf("stack at refused %s\n", (char *)t);
+  rc = ut_container_printf(&c, "shunned");
+  printf("stack printf refused %d\n", rc);
+  ut_container_free(&c);
+
+  /* -- text growth ----------------------------------------------------- */
+  utstring_new(str);
+  c = ut_string_container(str);
+  rc = ut_container_printf(&c, "unit");
+  printf("string printf rc %d\n", rc);
+  rc = ut_container_printf(&c, "form");
+  printf("string printf rc %d\n", rc);
+  n = ut_container_count(&c);
+  printf("string count %u\n", n);
+  printf("string at 0 %c\n", *(char *)ut_container_at(&c, 0));
+  printf("string top %c\n", *(char *)ut_container_top(&c));
+  ut_container_push(&c, "!");
+  v = ut_container_pop(&c);
+  printf("string pop refused %s\n", (char *)v);
+  printf("string find_key refused %s\n", (char *)ut_container_find_key(&c, "alpha"));
+  n = ut_container_capacity(&c);
+  printf("string capacity refused %u\n", n);
+  printf("string walk:");
+  for (t = ut_container_first(&c); t; t = ut_container_next(&c, t)) {
+    printf("%c", *(char *)t);
+  }
+  printf("\n");
+  ut_container_free(&c);
+
+  /* -- bounded overwrite ---------------------------------------------- */
+  c = ut_ring_container_new(3);
+  ut_container_push(&c, (void *)"one");
+  ut_container_push(&c, (void *)"two");
+  ut_container_push(&c, (void *)"three");
+  ut_container_push(&c, (void *)"four");
+  n = ut_container_count(&c);
+  printf("ring count %u\n", n);
+  n = ut_container_capacity(&c);
+  printf("ring capacity %u\n", n);
+  printf("ring at 0 %s\n", (char *)ut_container_at(&c, 0));
+  printf("ring top %s\n", (char *)ut_container_top(&c));
+  walk(&c, "ring walk");
+  v = ut_container_pop(&c);
+  printf("ring pop refused %s\n", (char *)v);
+  rc = ut_container_printf(&c, "shunned");
+  printf("ring printf refused %d\n", rc);
+  ut_container_sort(&c, cmp_words);
+  walk(&c, "ring sort refused, walk");
+  ut_container_free(&c);
+
+  return 0;
+}
