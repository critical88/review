+/* ---- uniform container facade adapter ------------------------------ */
+/* UT_array wraps into a UT_container: it fills the whole uniform operation
+ * set, honoring the operations its kind can perform and publishing
+ * "unsupported" refusals for the rest. The element is the stored pointer.
+ */
+static void ut_array_ops_clear(UT_container *c) {
+  utarray_clear((UT_array*)c->state);
+}
+static void ut_array_ops_free(UT_container *c) {
+  utarray_free((UT_array*)c->state);
+}
+static unsigned ut_array_ops_count(const UT_container *c) {
+  return utarray_len((UT_array*)c->state);
+}
+static void *ut_array_ops_at(const UT_container *c, unsigned j) {
+  void *slot = utarray_eltptr((UT_array*)c->state, j);
+  return slot ? *(void**)slot : NULL;
+}
+static int ut_array_ops_push(UT_container *c, void *val) {
+  utarray_push_back((UT_array*)c->state, &val);
+  return 0;
+}
+static void *ut_array_ops_pop(UT_container *c) {
+  UT_array *a = (UT_array*)c->state;
+  void *elt = NULL;
+  if (utarray_len(a)) {
+    elt = *(void**)utarray_back(a);
+    utarray_pop_back(a);
+  }
+  return elt;
+}
+static void *ut_array_ops_top(const UT_container *c) {
+  return ut_array_ops_at(c, utarray_len((UT_array*)c->state) - 1);
+}
+static void *ut_array_ops_first(const UT_container *c) {
+  return ut_array_ops_at(c, 0);
+}
+static void *ut_array_ops_next(const UT_container *c, void *prev) {
+  UT_array *a = (UT_array*)c->state;
+  unsigned j;
+  if (!prev) return NULL;
+  for (j = 0; j < utarray_len(a); j++) {
+    if (*(void**)_utarray_eltptr(a, j) == prev) {
+      return ut_array_ops_at(c, j + 1);
+    }
+  }
+  return NULL;
+}
+static void ut_array_ops_sort(UT_container *c, int (*cmp)(const void *, const void *)) {
+  UT_array *a = (UT_array*)c->state;
+  unsigned i, j;
+  for (i = 1; i < utarray_len(a); i++) {
+    void *key = *(void**)_utarray_eltptr(a, i);
+    for (j = i; (j > 0) && (cmp(key, *(void**)_utarray_eltptr(a, j-1)) < 0); j--) {
+      *(void**)_utarray_eltptr(a, j) = *(void**)_utarray_eltptr(a, j-1);
+    }
+    *(void**)_utarray_eltptr(a, j) = key;
+  }
+}
+static void *ut_array_ops_add_key_unsupported(UT_container *c, const void *key, void *val) {
+  return NULL;
+}
+static void *ut_array_ops_find_key_unsupported(const UT_container *c, const void *key) {
+  return NULL;
+}
+static void *ut_array_ops_del_key_unsupported(UT_container *c, const void *key) {
+  return NULL;
+}
+static unsigned ut_array_ops_capacity_unsupported(const UT_container *c) {
+  return 0;
+}
+static void ut_array_ops_reverse_unsupported(UT_container *c) {
+}
+static int ut_array_ops_vprintf_unsupported(UT_container *c, const char *fmt, va_list ap) {
+  return -1;
+}
+static const UT_ops ut_array_ops UTCONTAINER_UNUSED = {
+  .clear = ut_array_ops_clear,
+  .free = ut_array_ops_free,
+  .count = ut_array_ops_count,
+  .add_key = ut_array_ops_add_key_unsupported,
+  .find_key = ut_array_ops_find_key_unsupported,
+  .del_key = ut_array_ops_del_key_unsupported,
+  .push = ut_array_ops_push,
+  .pop = ut_array_ops_pop,
+  .top = ut_array_ops_top,
+  .at = ut_array_ops_at,
+  .capacity = ut_array_ops_capacity_unsupported,
+  .first = ut_array_ops_first,
+  .next = ut_array_ops_next,
+  .sort = ut_array_ops_sort,
+  .reverse = ut_array_ops_reverse_unsupported,
+  .vprintf = ut_array_ops_vprintf_unsupported,
+};
+
+/* wrap a pointer array (UT_icd is ut_ptr_icd); the adapter takes ownership */
+UTCONTAINER_UNUSED
+static inline UT_container ut_array_container(UT_array *a) {
+  UT_container c;
+  c.state = a;
+  c.ops = &ut_array_ops;
+  return c;
+}
+
 
 #endif /* UTARRAY_H */
diff --git a/src/utcontainer.h b/src/utcontainer.h
new file mode 100644
index 0000000..0a6d9bc
--- /dev/null
+++ b/src/utcontainer.h
@@ -0,0 +1,188 @@
+/*
