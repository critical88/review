+/* ---- uniform container facade adapter ------------------------------ */
+/* A singly-linked stack of void* values wraps into a UT_container and
+ * fills the whole uniform operation set. The stack kind honors the
+ * append/lifo and traversal operations; the rest are "unsupported".
+ */
+struct ut_stack_box {
+  struct ut_stack_el *head;  /* top of stack, i.e. newest element */
+};
+struct ut_stack_el {
+  void *val;
+  struct ut_stack_el *next;  /* toward older elements */
+};
+
+static void ut_stack_ops_clear(UT_container *c) {
+  struct ut_stack_box *b = (struct ut_stack_box *)c->state;
+  struct ut_stack_el *e;
+  while ((e = b->head)) {
+    STACK_POP(b->head, e);
+    free(e);
+  }
+}
+static void ut_stack_ops_free(UT_container *c) {
+  struct ut_stack_box *b = (struct ut_stack_box *)c->state;
+  ut_stack_ops_clear(c);
+  free(b);
+}
+static unsigned ut_stack_ops_count(const UT_container *c) {
+  struct ut_stack_box *b = (struct ut_stack_box *)c->state;
+  struct ut_stack_el *e;
+  unsigned n;
+  STACK_COUNT(b->head, e, n);
+  return n;
+}
+static int ut_stack_ops_push(UT_container *c, void *val) {
+  struct ut_stack_box *b = (struct ut_stack_box *)c->state;
+  struct ut_stack_el *e = (struct ut_stack_el *)malloc(sizeof(struct ut_stack_el));
+  if (!e) return -1;
+  e->val = val;
+  STACK_PUSH(b->head, e);
+  return 0;
+}
+static void *ut_stack_ops_pop(UT_container *c) {
+  struct ut_stack_box *b = (struct ut_stack_box *)c->state;
+  struct ut_stack_el *e;
+  void *val;
+  if (!b->head) return NULL;
+  STACK_POP(b->head, e);
+  val = e->val;
+  free(e);
+  return val;
+}
+static void *ut_stack_ops_top(const UT_container *c) {
+  struct ut_stack_box *b = (struct ut_stack_box *)c->state;
+  return b->head ? b->head->val : NULL;
+}
+static void *ut_stack_ops_first(const UT_container *c) {
+  struct ut_stack_box *b = (struct ut_stack_box *)c->state;
+  struct ut_stack_el *e;
+  if (!b->head) return NULL;
+  for (e = b->head; e->next; e = e->next);   /* oldest element */
+  return e->val;
+}
+static void *ut_stack_ops_next(const UT_container *c, void *prev) {
+  struct ut_stack_box *b = (struct ut_stack_box *)c->state;
+  struct ut_stack_el *e;
+  if (!prev) return NULL;
+  for (e = b->head; e && e->next; e = e->next) {
+    if (e->next->val == prev) return e->val;  /* prev's newer neighbor */
+  }
+  return NULL;
+}
