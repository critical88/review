+  .pop = ut_list_ops_pop,
+  .top = ut_list_ops_top,
+  .at = ut_list_ops_at_unsupported,
+  .capacity = ut_list_ops_capacity_unsupported,
+  .first = ut_list_ops_first,
+  .next = ut_list_ops_next,
+  .sort = ut_list_ops_sort,
+  .reverse = ut_list_ops_reverse,
+  .vprintf = ut_list_ops_vprintf_unsupported,
+};
+
+/* open an empty uniform list-style container */
+UTCONTAINER_UNUSED
+static inline UT_container ut_list_container_new(void) {
