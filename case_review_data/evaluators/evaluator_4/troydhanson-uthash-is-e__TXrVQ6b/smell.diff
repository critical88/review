+PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR
+CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,
+EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
+PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR
+PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF
+LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING
+NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS
+SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+*/
+
+/* uniform facade over the ut* container family
+ *
+ * This header lets generic code work with any ut* container through one
+ * handle type and one operation set, so that utilities built around the
+ * facade do not have to be specialized per container.
+ *
+ * Each container header declares an adapter for its kind and a `UT_ops`
+ * value (named `<kind>_ops`) that offers the whole uniform operation set.
+ * Operations that a container kind cannot honor are published as
+ * "unsupported" bindings that simply refuse the call.
+ *
+ * The facade entry points below all dispatch through the handle's ops
+ * table; programs never reach around them.
+ */
+#ifndef UTCONTAINER_H
+#define UTCONTAINER_H
+
+#define UTCONTAINER_VERSION 2.4.0
+
+#include <stdarg.h>
+#include <stddef.h>
+
+#ifndef UTCONTAINER_UNUSED
+#ifdef __GNUC__
+#define UTCONTAINER_UNUSED __attribute__((__unused__))
+#else
+#define UTCONTAINER_UNUSED
+#endif
+#endif
+
+struct UT_container;
+typedef struct UT_container {
+    void *state;         /* the wrapped container object */
+    const struct UT_ops *ops;   /* the uniform operation set it publishes */
+} UT_container;
+
+/* the uniform operation set for containers.
+ *
+ * The members are grouped by the container vocabulary they come from:
+ * keyed stores (hash), lifo sequences (stack/array/list), indexed access
+ * (array/ring), traversal and ordering (list/hash), bounded buffers (ring),
+ * and formatted text (utstring). Every adapter fills the whole table.
+ */
+typedef struct UT_ops {
+
+    /* lifecycle */
+    void (*clear)(UT_container *c);            /* drop all elements, keep alive */
+    void (*free)(UT_container *c);             /* drop all elements, dispose */
+    unsigned (*count)(const UT_container *c); /* number of elements */
+
+    /* keyed store */
+    void *(*add_key)(UT_container *c, const void *key, void *val);  /* put; returns previous value for key */
+    void *(*find_key)(const UT_container *c, const void *key);     /* lookup; NULL if absent */
+    void *(*del_key)(UT_container *c, const void *key);            /* remove; returns removed value */
+
+    /* append/lifo */
+    int (*push)(UT_container *c, void *val);   /* append one element; 0 ok, -1 refused */
+    void *(*pop)(UT_container *c);             /* remove newest element and return it */
+    void *(*top)(const UT_container *c);       /* newest element, without removing */
+
+    /* indexed access */
+    void *(*at)(const UT_container *c, unsigned j);   /* element at position j */
+    unsigned (*capacity)(const UT_container *c);       /* fixed capacity, 0 if unbounded */
+
+    /* traversal */
+    void *(*first)(const UT_container *c);
+    void *(*next)(const UT_container *c, void *prev);
+
+    /* ordering */
+    void (*sort)(UT_container *c, int (*cmp)(const void *, const void *));
+    void (*reverse)(UT_container *c);
+
+    /* formatted text */
+    int (*vprintf)(UT_container *c, const char *fmt, va_list ap);
+} UT_ops;
+
+/* the facade entry points. Each one is a direct dispatch into the handle's
+ * uniform operation set, so callers hold one interface for every kind. */
+
+UTCONTAINER_UNUSED
+static inline void ut_container_clear(UT_container *c) {
+    c->ops->clear(c);
+}
+
+UTCONTAINER_UNUSED
+static inline void ut_container_free(UT_container *c) {
+    c->ops->free(c);
+}
+
+UTCONTAINER_UNUSED
+static inline unsigned ut_container_count(const UT_container *c) {
+    return c->ops->count(c);
+}
+
+UTCONTAINER_UNUSED
+static inline void *ut_container_add_key(UT_container *c, const void *key, void *val) {
+    return c->ops->add_key(c, key, val);
+}
+
+UTCONTAINER_UNUSED
+static inline void *ut_container_find_key(const UT_container *c, const void *key) {
+    return c->ops->find_key(c, key);
+}
+
+UTCONTAINER_UNUSED
+static inline void *ut_container_del_key(UT_container *c, const void *key) {
+    return c->ops->del_key(c, key);
+}
+
+UTCONTAINER_UNUSED
+static inline int ut_container_push(UT_container *c, void *val) {
+    return c->ops->push(c, val);
+}
+
+UTCONTAINER_UNUSED
+static inline void *ut_container_pop(UT_container *c) {
+    return c->ops->pop(c);
+}
+
+UTCONTAINER_UNUSED
+static inline void *ut_container_top(const UT_container *c) {
+    return c->ops->top(c);
+}
+
+UTCONTAINER_UNUSED
+static inline void *ut_container_at(const UT_container *c, unsigned j) {
+    return c->ops->at(c, j);
+}
+
+UTCONTAINER_UNUSED
+static inline unsigned ut_container_capacity(const UT_container *c) {
+    return c->ops->capacity(c);
+}
+
+UTCONTAINER_UNUSED
+static inline void *ut_container_first(const UT_container *c) {
+    return c->ops->first(c);
+}
+
+UTCONTAINER_UNUSED
+static inline void *ut_container_next(const UT_container *c, void *prev) {
+    return c->ops->next(c, prev);
+}
+
+UTCONTAINER_UNUSED
+static inline void ut_container_sort(UT_container *c, int (*cmp)(const void *, const void *)) {
+    c->ops->sort(c, cmp);
+}
+
+UTCONTAINER_UNUSED
+static inline void ut_container_reverse(UT_container *c) {
+    c->ops->reverse(c);
+}
+
+UTCONTAINER_UNUSED
+static inline int ut_container_printf(UT_container *c, const char *fmt, ...) {
+    int rc;
+    va_list ap;
+    va_start(ap, fmt);
+    rc = c->ops->vprintf(c, fmt, ap);
+    va_end(ap);
+    return rc;
+}
+
+#endif /* UTCONTAINER_H */
diff --git a/src/uthash.h b/src/uthash.h
index 5ce5bac..e2a92ca 100644
--- a/src/uthash.h
+++ b/src/uthash.h
@@ -30,6 +30,8 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 #include <stddef.h>   /* ptrdiff_t */
 #include <stdlib.h>   /* exit */
 
+#include "utcontainer.h"  /* uniform container facade */
+
 #if defined(HASH_NO_STDINT) && HASH_NO_STDINT
 /* The user doesn't have <stdint.h>, and must figure out their own way
    to provide definitions for uint8_t and uint32_t. */
@@ -1134,4 +1136,182 @@ typedef struct UT_hash_handle {
    unsigned hashv;                   /* result of hash-fcn(key)        */
 } UT_hash_handle;
 
+/* ---- uniform container facade adapter ------------------------------ */
+/* A string-keyed store of void* values wraps into a UT_container. The
+ * façade's uniform operation set is filled in completely; the keyed-store
+ * operations are honored and the remaining members are published as
+ * "unsupported" refusals.
+ */
+struct ut_hash_box {
+  struct ut_hash_item *items;
+  int (*sort_cmp)(const void *, const void *);  /* active during sort */
+};
+struct ut_hash_item {
+  char *key;
+  void *val;
+  struct ut_hash_box *box;
+  UT_hash_handle hh;
+};
+
+static int ut_hash_ops_sort_shim(const void *_a, const void *_b) {
+  const struct ut_hash_item *a = (const struct ut_hash_item *)_a;
+  const struct ut_hash_item *b = (const struct ut_hash_item *)_b;
+  return a->box->sort_cmp(a->val, b->val);
+}
+static void ut_hash_ops_clear(UT_container *c) {
+  struct ut_hash_box *b = (struct ut_hash_box *)c->state;
+  struct ut_hash_item *el, *tmp;
+  HASH_ITER(hh, b->items, el, tmp) {
+    HASH_DEL(b->items, el);
+    free(el->key);
+    free(el);
+  }
+}
+static void ut_hash_ops_free(UT_container *c) {
+  struct ut_hash_box *b = (struct ut_hash_box *)c->state;
+  ut_hash_ops_clear(c);
+  free(b);
+}
+static unsigned ut_hash_ops_count(const UT_container *c) {
+  return (unsigned)HASH_COUNT(((struct ut_hash_box *)c->state)->items);
+}
+/* Internal lookup for the facade's box. The box is a plain string-keyed
+ * uthash table of facade-owned items, so it hashes with uthash's canonical
+ * default algorithm and compares keys bytewise. A translation unit's own
+ * HASH_FUNCTION/HASH_KEYCMP overrides describe its tables, not this one.
+ */
+static struct ut_hash_item *ut_hash_ops_lookup(struct ut_hash_box *b,
+                                               const char *key, unsigned keylen) {
+  struct UT_hash_table *tbl;
+  struct UT_hash_handle *h;
+  unsigned hashv, bkt;
+  if (!b->items || !key) return NULL;
+  HASH_JEN(key, keylen, hashv);
+  tbl = b->items->hh.tbl;
+  HASH_TO_BKT(hashv, tbl->num_buckets, bkt);
+  for (h = tbl->buckets[bkt].hh_head; h != NULL; h = h->hh_next) {
+    if (h->hashv == hashv && h->keylen == keylen &&
+        memcmp(h->key, key, keylen) == 0) {
+      return (struct ut_hash_item *)ELMT_FROM_HH(tbl, h);
+    }
+  }
+  return NULL;
+}
+static void *ut_hash_ops_add_key(UT_container *c, const void *key, void *val) {
+  struct ut_hash_box *b = (struct ut_hash_box *)c->state;
+  struct ut_hash_item *el;
+  unsigned keylen, hashv;
+  if (!key) return NULL;
+  keylen = (unsigned)uthash_strlen((const char*)key);
+  el = ut_hash_ops_lookup(b, (const char*)key, keylen);
+  if (el) {
+    void *old = el->val;
+    el->val = val;
+    return old;
+  }
+  el = (struct ut_hash_item*)malloc(sizeof(struct ut_hash_item));
+  if (el == NULL) return NULL;
+  el->key = (char*)malloc(keylen + 1);
+  if (el->key == NULL) {
+    free(el);
+    return NULL;
+  }
+  memcpy(el->key, key, keylen);
+  el->key[keylen] = '\0';
+  el->val = val;
+  el->box = b;
+  HASH_JEN(el->key, keylen, hashv);
+  HASH_ADD_KEYPTR_BYHASHVALUE(hh, b->items, el->key, keylen, hashv, el);
+  return NULL;
+}
+static void *ut_hash_ops_find_key(const UT_container *c, const void *key) {
+  struct ut_hash_box *b = (struct ut_hash_box *)c->state;
+  struct ut_hash_item *el;
+  if (!key) return NULL;
+  el = ut_hash_ops_lookup(b, (const char*)key, (unsigned)uthash_strlen((const char*)key));
+  return el ? el->val : NULL;
+}
+static void *ut_hash_ops_del_key(UT_container *c, const void *key) {
+  struct ut_hash_box *b = (struct ut_hash_box *)c->state;
+  struct ut_hash_item *el;
+  void *val;
+  if (!key) return NULL;
+  el = ut_hash_ops_lookup(b, (const char*)key, (unsigned)uthash_strlen((const char*)key));
+  if (!el) return NULL;
+  HASH_DEL(b->items, el);
+  val = el->val;
+  free(el->key);
+  free(el);
+  return val;
+}
+static void *ut_hash_ops_first(const UT_container *c) {
+  return ((struct ut_hash_box *)c->state)->items;
+}
+static void *ut_hash_ops_next(const UT_container *c, void *prev) {
+  struct ut_hash_item *el = (struct ut_hash_item *)prev;
+  if (!el) return NULL;
+  return el->hh.next;   /* next element in application order */
+}
+static void ut_hash_ops_sort(UT_container *c, int (*cmp)(const void *, const void *)) {
+  struct ut_hash_box *b = (struct ut_hash_box *)c->state;
+  b->sort_cmp = cmp;
+  HASH_SRT(hh, b->items, ut_hash_ops_sort_shim);
+  b->sort_cmp = NULL;
+}
+static int ut_hash_ops_push_unsupported(UT_container *c, void *val) {
+  return -1;
+}
+static void *ut_hash_ops_pop_unsupported(UT_container *c) {
+  return NULL;
+}
+static void *ut_hash_ops_top_unsupported(const UT_container *c) {
+  return NULL;
+}
+static void *ut_hash_ops_at_unsupported(const UT_container *c, unsigned j) {
+  return NULL;
+}
+static unsigned ut_hash_ops_capacity_unsupported(const UT_container *c) {
+  return 0;
+}
+static void ut_hash_ops_reverse_unsupported(UT_container *c) {
+}
+static int ut_hash_ops_vprintf_unsupported(UT_container *c, const char *fmt, va_list ap) {
+  return -1;
+}
+static const UT_ops ut_hash_ops UTCONTAINER_UNUSED = {
+  .clear = ut_hash_ops_clear,
+  .free = ut_hash_ops_free,
+  .count = ut_hash_ops_count,
+  .add_key = ut_hash_ops_add_key,
+  .find_key = ut_hash_ops_find_key,
+  .del_key = ut_hash_ops_del_key,
+  .push = ut_hash_ops_push_unsupported,
+  .pop = ut_hash_ops_pop_unsupported,
+  .top = ut_hash_ops_top_unsupported,
+  .at = ut_hash_ops_at_unsupported,
+  .capacity = ut_hash_ops_capacity_unsupported,
+  .first = ut_hash_ops_first,
+  .next = ut_hash_ops_next,
+  .sort = ut_hash_ops_sort,
+  .reverse = ut_hash_ops_reverse_unsupported,
+  .vprintf = ut_hash_ops_vprintf_unsupported,
+};
+
+/* open an empty uniform store of this kind */
+UTCONTAINER_UNUSED
+static inline UT_container ut_hash_container_new(void) {
+  struct ut_hash_box *b = (struct ut_hash_box*)malloc(sizeof(struct ut_hash_box));
+  UT_container c;
+  if (b == NULL) {
+    c.state = NULL;
+    c.ops = NULL;
+    return c;
+  }
+  b->items = NULL;
+  b->sort_cmp = NULL;
+  c.state = b;
+  c.ops = &ut_hash_ops;
+  return c;
+}
+
 #endif /* UTHASH_H */
diff --git a/src/utlist.h b/src/utlist.h
index 0087551..ef8fe56 100644
--- a/src/utlist.h
+++ b/src/utlist.h
@@ -27,6 +27,9 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 #define UTLIST_VERSION 2.4.0
 
 #include <assert.h>
+#include <stdlib.h>  /* malloc, free (uniform container facade adapter) */
+
+#include "utcontainer.h"  /* uniform container facade */
 
 /*
  * This file contains macros to manipulate singly and doubly-linked lists.
@@ -1206,4 +1209,152 @@ do {
 
 #endif /* NO_DECLTYPE */
 
+/* ---- uniform container facade adapter ------------------------------ */
+/* A doubly-linked list of void* values wraps into a UT_container, filling
+ * the whole uniform operation set. Append/lifo, traversal and ordering are
+ * honored by this kind; the other members are "unsupported" refusals.
+ */
+struct ut_list_box {
+  struct ut_list_el *head;
+  int (*sort_cmp)(const void *, const void *);  /* active during sort */
+};
+struct ut_list_el {
+  void *val;
+  struct ut_list_box *box;
+  struct ut_list_el *prev, *next;
+};
+
+static int ut_list_ops_sort_shim(const void *a, const void *b) {
+  const struct ut_list_el *ea = (const struct ut_list_el *)a;
+  const struct ut_list_el *eb = (const struct ut_list_el *)b;
+  return ea->box->sort_cmp(ea->val, eb->val);
+}
+static struct ut_list_el *ut_list_ops_last(struct ut_list_box *b) {
+  struct ut_list_el *e;
+  if (!b->head) return NULL;
+  for (e = b->head; e->next; e = e->next);
+  return e;
+}
+static void ut_list_ops_clear(UT_container *c) {
+  struct ut_list_box *b = (struct ut_list_box *)c->state;
+  struct ut_list_el *e;
+  while ((e = b->head)) {
+    DL_DELETE(b->head, e);
+    free(e);
+  }
+}
+static void ut_list_ops_free(UT_container *c) {
+  struct ut_list_box *b = (struct ut_list_box *)c->state;
+  ut_list_ops_clear(c);
+  free(b);
+}
+static unsigned ut_list_ops_count(const UT_container *c) {
+  struct ut_list_box *b = (struct ut_list_box *)c->state;
+  struct ut_list_el *e;
+  unsigned n;
+  DL_COUNT(b->head, e, n);
+  return n;
+}
+static int ut_list_ops_push(UT_container *c, void *val) {
+  struct ut_list_box *b = (struct ut_list_box *)c->state;
+  struct ut_list_el *e = (struct ut_list_el*)malloc(sizeof(struct ut_list_el));
+  if (!e) return -1;
+  e->val = val;
+  e->box = b;
+  DL_APPEND(b->head, e);
+  return 0;
+}
+static void *ut_list_ops_pop(UT_container *c) {
+  struct ut_list_box *b = (struct ut_list_box *)c->state;
+  struct ut_list_el *e = ut_list_ops_last(b);
+  void *val;
+  if (!e) return NULL;
+  DL_DELETE(b->head, e);
+  val = e->val;
+  free(e);
+  return val;
+}
+static void *ut_list_ops_top(const UT_container *c) {
+  struct ut_list_el *e = ut_list_ops_last((struct ut_list_box *)c->state);
+  return e ? e->val : NULL;
+}
+static void *ut_list_ops_first(const UT_container *c) {
