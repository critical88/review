+/// Environment variables that keep an individual user build from
+/// monopolizing the sandbox it runs in.
+///
+/// A playground sandbox shares CPU with several concurrent requests,
+/// and it has no network access at all, so both rules belong with the
+/// rest of the resource-fairness policy.
+pub(crate) fn build_fairness_environment() -> HashMap<String, String> {
+    [
+        ("CARGO_BUILD_JOBS", "2"),
+        ("CARGO_NET_OFFLINE", "true"),
+    ]
+    .into_iter()
+    .map(|(k, v)| (k.to_owned(), v.to_owned()))
+    .collect()
+}
