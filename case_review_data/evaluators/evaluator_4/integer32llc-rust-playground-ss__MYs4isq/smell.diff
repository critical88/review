+/// Environment variables that every process the worker starts
+/// inherits, before any request-specific environment is considered.
+///
+/// The worker is the last component with a say in the environment of
+/// a command, so the pieces describing the sandbox itself are applied
+/// here rather than sent along with each request.
+fn sandbox_floor_environment() -> Vec<(String, String)> {
+    vec![
+        ("PLAYGROUND_SANDBOX".to_owned(), "1".to_owned()),
+        ("TZ".to_owned(), "UTC".to_owned()),
+    ]
+}
