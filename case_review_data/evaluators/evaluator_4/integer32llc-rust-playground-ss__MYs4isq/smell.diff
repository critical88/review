+use std::collections::HashMap;
+
+/// Splices a fragment of baseline environment variables into the
+/// environment map being assembled for a command.
+///
+/// Fragments can be either an owned map or a shared slice of
+/// name/value pairs; both are merged into the map under assembly.
+pub trait SpliceEnvironment {
+    fn splice_into(self, envs: &mut HashMap<String, String>);
+}
+
+impl SpliceEnvironment for HashMap<String, String> {
+    fn splice_into(self, envs: &mut HashMap<String, String>) {
+        envs.extend(self);
+    }
+}
+
+impl<'a> SpliceEnvironment for &'a [(&'a str, &'a str)] {
+    fn splice_into(self, envs: &mut HashMap<String, String>) {
+        envs.extend(self.iter().map(|(k, v)| ((*k).to_owned(), (*v).to_owned())));
+    }
+}
