 use orchestrator::worker::{listen, Error};
 use std::env;
 
+/// Seed the worker's own environment with the baseline pieces that
+/// every process inside the sandbox must be able to rely on.
+///
+/// Child processes inherit the worker's environment, and the
+/// coordinator does not send all of these with every request, so the
+/// worker has to establish them itself before it starts listening.
+fn seed_worker_environment() {
+    env::set_var("TZ", env::var("TZ").unwrap_or_else(|_| "UTC".into()));
+    env::set_var("PLAYGROUND_WORKER", "1");
+}
+
 #[tokio::main(flavor = "current_thread")]
