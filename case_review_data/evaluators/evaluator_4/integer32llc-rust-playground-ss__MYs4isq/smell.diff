+/// Environment variables describing how much runtime detail a single
+/// user request should get out of the command, so that a panic in the
+/// sandbox can be traced even though the coordinator never decides
+/// that itself.
+fn run_detail_environment(backtrace: bool) -> HashMap<String, String> {
+    let mut envs = HashMap::new();
+
+    if backtrace {
+        envs.extend(kvs!("RUST_BACKTRACE" => "1"));
+    }
+
+    envs
+}
