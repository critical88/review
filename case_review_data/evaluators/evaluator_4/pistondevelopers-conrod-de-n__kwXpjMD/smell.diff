+/// The minimum difference between two dimensions for them to be considered to have changed.
+///
+/// This is used by the deferred window-bookkeeping paths, which only care whether the window's
+/// dimensions actually changed between two consecutive updates (e.g. between the resize being
+/// received and the graph's window widget being synchronised).
+const DIMS_DIFFER_EPSILON: Scalar = 1e-6;
+
+/// Whether the two given dimensions differ by a non-negligible amount.
+///
+/// Returns `false` if both the width and the height are within `DIMS_DIFFER_EPSILON` of
+/// one another.
+pub(crate) fn dims_differ(a: Dimensions, b: Dimensions) -> bool {
+    let (dx, dy) = (a[0] - b[0], a[1] - b[1]);
+
+    // Differences smaller than a fraction of the smallest representable pixel are treated
+    // as though there was no difference at all.
+    dx.abs() >= DIMS_DIFFER_EPSILON || dy.abs() >= DIMS_DIFFER_EPSILON
+}
